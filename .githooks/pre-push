#!/bin/sh
# quorune-generated-finalization-hook
set -eu

ROOT=$(git rev-parse --show-toplevel)
if [ -x "$ROOT/.venv/bin/python" ]; then
    PYTHON="$ROOT/.venv/bin/python"
elif [ -x "$ROOT/.venv/Scripts/python.exe" ]; then
    PYTHON="$ROOT/.venv/Scripts/python.exe"
else
    echo "Quorune pre-push: create the worktree-local .venv with CPython 3.12 first." >&2
    exit 1
fi

# CI planning cannot construct its matrix when a discovered test module lacks
# exactly one primary shard. Fail quickly before the expensive corpus census.
# The finalizer also validates the reviewed architecture baseline after every
# generated writer/check, so a new typed operation cannot first fail in CI.
"$PYTHON" "$ROOT/scripts/test_shards.py" validate
"$PYTHON" "$ROOT/scripts/build_test_database.py" validate-ci-dependencies

# A deliberately named feature-branch checkpoint may be pushed before the
# generated bundle exists so GitHub can perform the expensive writers. This is
# not final publication authority: the next push must carry an exact receipt.
if [ -n "${QUORUNE_CLOUD_SOURCE_CHECKPOINT_REASON:-}" ]; then
    BRANCH=$(git branch --show-current)
    if [ -z "$BRANCH" ] || [ "$BRANCH" = "main" ]; then
        echo "Quorune pre-push: cloud source checkpoints are forbidden on main or detached HEAD." >&2
        exit 1
    fi
    "$PYTHON" "$ROOT/scripts/quick_gate.py" \
        --phase pre-corpus --base origin/main
    echo "Quorune pre-push: authorized cloud source checkpoint: $QUORUNE_CLOUD_SOURCE_CHECKPOINT_REASON"
    exit 0
fi

run_finalizer() {
    if "$PYTHON" "$ROOT/scripts/finalize_generated.py" \
        --verify-receipt "$@"; then
        echo "Quorune pre-push: generated-finalization receipt is current."
        return 0
    fi
    echo "Quorune pre-push: receipt missing or stale; running full finalization." >&2
    "$PYTHON" "$ROOT/scripts/finalize_generated.py" \
        --write --fail-on-change "$@"
}

if [ -n "${MTG_CARD_DB:-}" ]; then
    # An explicit database selection is part of the requested certification
    # identity and therefore requires a receipt bound to that exact database.
    run_finalizer --db "$MTG_CARD_DB"
else
    # Accept the exact worktree receipt before inferring another database. A
    # database-bound receipt verifies its recorded database identity, so a
    # secondary worktree does not repeat a multi-minute finalization merely
    # because the database lives in the canonical worktree.
    if "$PYTHON" "$ROOT/scripts/finalize_generated.py" --verify-receipt; then
        echo "Quorune pre-push: existing generated-finalization receipt is current."
    elif [ -f "$ROOT/data/scryfall-current.sqlite3" ]; then
        run_finalizer --db "$ROOT/data/scryfall-current.sqlite3"
    else
        echo "Quorune pre-push: no pinned card database found; database-backed compiler coverage can only be checked." >&2
        echo "Set MTG_CARD_DB or provide data/scryfall-current.sqlite3 when compiler, capability, or CardProgram behavior changed." >&2
        run_finalizer
    fi
fi
