{
  "schema_version": 6,
  "default_checks": [
    "compile",
    "python-runtime",
    "repository",
    "generated-finalization"
  ],
  "browser_focuses": {
    "combat": "@combat",
    "mana-action": "@mana-action",
    "turn-draw": "@turn-draw"
  },
  "risk_rules": [
    {
      "id": "governance-only-sources",
      "patterns": [
        "AGENTS.md",
        "README.md",
        "coverage/**",
        "docs/**"
      ],
      "risk_class": "governance_only"
    },
    {
      "id": "merge-authority-sources",
      "patterns": [
        ".github/workflows/**",
        "platform/change-impact-policy.json",
        "platform/generated-artifacts.json",
        "platform/test-shards.json",
        "scripts/build_test_database.py",
        "scripts/certification_receipt.py",
        "scripts/change_impact.py",
        "scripts/ci_plan.py",
        "scripts/ci_risk_sentinel.py",
        "scripts/compact_ci_dependencies.py",
        "scripts/finalize_generated.py",
        "scripts/generated_artifacts.py",
        "scripts/generated_owner_cache.py",
        "scripts/main_health.py",
        "scripts/main_broad_ci.py",
        "scripts/source_tree_fingerprint.py",
        "scripts/test_shards.py",
        "scripts/validate_repository.py",
        "scripts/verify_ci_needs.py",
        "scripts/verify_main_broad_ci.py",
        "scripts/verify_nightly_ci.py",
        "scripts/verify_windows_ci.py",
        "scripts/pytest_shard_plugin.py"
      ],
      "risk_class": "high_risk_source"
    },
    {
      "id": "authoritative-state-and-protocol-sources",
      "patterns": [
        "quorune/engine.py",
        "quorune/persistence.py",
        "quorune/projection.py",
        "quorune/protocol.py",
        "quorune/record*.py",
        "quorune/state.py",
        "quorune/*transaction*.py",
        "schemas/**",
        "server/**"
      ],
      "risk_class": "high_risk_source"
    },
    {
      "id": "package-boundary-sources",
      "patterns": [
        "MANIFEST.in",
        "pyproject.toml",
        "requirements*.txt",
        "scripts/verify_wheel.py"
      ],
      "risk_class": "high_risk_source"
    }
  ],
  "package_patterns": [
    "MANIFEST.in",
    "pyproject.toml",
    "requirements*.txt",
    "scripts/verify_wheel.py"
  ],
  "path_rules": [
    {
      "id": "changed-python-test",
      "patterns": [
        "tests/test_*.py"
      ],
      "collect_test_module": true
    },
    {
      "id": "compact-ci-dependency-sources",
      "patterns": [
        ".github/workflows/**",
        "examples/*.txt",
        "platform/test-shards.json",
        "quorune/carddb.py",
        "quorune/deck.py",
        "scripts/build_test_database.py",
        "scripts/compact_ci_dependencies.py",
        "scripts/compact_ci_report.py",
        "scripts/update_compact_ci_dependencies.py",
        "tests/*.py",
        "tests/fixtures/**"
      ],
      "checks": [
        "compact-ci-dependencies"
      ]
    },
    {
      "id": "python-architecture-sources",
      "patterns": [
        "quorune/**",
        "server/**",
        "scripts/**"
      ],
      "checks": [
        "architecture",
        "module-classifications"
      ]
    },
    {
      "id": "documentation-sources",
      "patterns": [
        "docs/**",
        "README.md",
        "AGENTS.md"
      ],
      "checks": [
        "documentation"
      ],
      "test_modules": [
        "test_documentation_policy"
      ]
    },
    {
      "id": "rules-sources",
      "patterns": [
        "rules/**",
        "mechanics/**",
        "quorune/rules_corpus.py",
        "quorune/rule_conformance.py",
        "quorune/rules_scheduler.py",
        "scripts/update_rules_scheduler.py"
      ],
      "checks": [
        "rules",
        "rules-scheduler"
      ]
    },
    {
      "id": "scheduler-harvest-contract",
