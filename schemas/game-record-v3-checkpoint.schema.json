{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/game-record-v3-checkpoint.schema.json",
  "title": "MTG Commander Game Record v3 checkpoint",
  "type": "object",
  "required": ["schema_version", "kind", "state_hash", "active_capabilities", "state"],
  "properties": {
    "schema_version": {"const": 3},
    "kind": {"const": "authoritative-checkpoint"},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision_id", "principal"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision_id": {"type": "string"},
          "principal": {"type": "string"},
          "actor": {"type": ["string", "null"]}
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["game_id", "config", "players", "cards", "events", "capabilities"],
      "properties": {
        "land_entry_affordability_version": { "type": "integer", "const": 1 },
        "priority_concession_stabilization_version": { "type": "integer", "const": 1 },
        "priority_concession_resume_from": { "type": "string", "minLength": 1 },
        "battlefield_entry_player_version": { "type": "integer", "const": 1 },
        "declare_attack_cast_version": {"type": "integer", "const": 1},
        "legend_rule_choice_version": {"type": "integer", "const": 1},
        "transform_timestamp_version": {"type": "integer", "const": 1},
        "face_status_timestamp_version": {"type": "integer", "const": 1},
        "face_down_departure_reveal_version": {"type": "integer", "const": 1},
        "cast_event_type_snapshot_version": {"type": "integer", "const": 1},
        "shield_counter_damage_version": {"type": "integer", "const": 1},
        "damage_prevention_result_version": {"type": "integer", "const": 1},
        "ward_discard_order_version": {"type": "integer", "const": 1},
        "evolve_entrant_lki_version": {"type": "integer", "const": 1},
        "additional_beginning_phases": {
          "type": "object",
          "required": ["pending", "active", "draws_completed"],
          "additionalProperties": false,
          "properties": {
            "pending": { "type": "integer", "minimum": 0 },
            "active": { "type": "boolean" },
            "draws_completed": { "type": "integer", "minimum": 0 }
          }
        },
        "discard_effect_origin_version": {"type": "integer", "const": 1},
        "events": {"type": "array", "maxItems": 0},
        "capabilities": {"type": "object", "maxProperties": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
