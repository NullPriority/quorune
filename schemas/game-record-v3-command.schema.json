{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/game-record-v3-command.schema.json",
  "title": "MTG Commander Game Record v3 accepted command",
  "type": "object",
  "required": [
    "sequence",
    "command_id",
    "decision_id",
    "principal",
    "actor",
    "execution",
    "action_template_id",
    "capability_id",
    "action",
    "payload",
    "normalized_payload",
    "selected_object_refs",
    "targets",
    "modes",
    "x",
    "selected_costs",
    "before_state_hash",
    "after_state_hash",
    "rng",
    "semantics_fingerprint",
    "semantics"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "command_id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
    "client_command_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "client_request_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_receipt": {"type": "object"},
    "continuation": {"type": ["object", "null"]},
    "decision_id": {"type": ["string", "null"]},
    "principal": {"type": "string"},
    "actor": {"type": ["string", "null"]},
    "execution": {"enum": ["external_decision", "planned_automatic"]},
    "capability_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {"type": "string"},
    "payload": {"type": "object"},
    "before_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rng": {"type": "object"},
    "semantics_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_template_id": {"type": ["string", "null"]},
    "normalized_payload": {"type": "object"},
    "priority_window_holds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["steps", "preserve_empty"],
        "properties": {
          "steps": {"type": "array", "uniqueItems": true, "items": {"enum": [
            "upkeep", "draw", "precombat_main", "combat", "beginning_combat", "declare_attackers",
            "declare_blockers", "first_strike_damage", "combat_damage", "end_combat", "postcombat_main",
            "end_step", "cleanup"
          ]}},
          "preserve_empty": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "selected_object_refs": {"type": "array", "items": {"type": "string"}},
    "targets": {"type": "array"},
    "modes": {"type": "array"},
    "x": {},
    "selected_costs": {"type": "object"},
    "semantics": {"type": "object"}
  },
  "additionalProperties": false
}
