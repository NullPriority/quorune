{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/game-record-v3-manifest.schema.json",
  "title": "MTG Commander Game Record v3 manifest",
  "type": "object",
  "required": [
    "schema_version",
    "record_schema_version",
    "record_type",
    "game_id",
    "engine_version",
    "format",
    "players",
    "player_count",
    "turn_order",
    "trace_level",
    "semantics_fingerprint",
    "semantics_registry",
    "scryfall",
    "final_state_hash",
    "replay",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "record_schema_version": {"const": 3},
    "record_type": {"const": "mtg-commander-game"},
    "game_id": {"type": "string", "minLength": 1},
    "engine_version": {"type": "string"},
    "state_version": {"type": "integer", "minimum": 1},
    "protocol_version": {"type": "integer", "minimum": 1},
    "format": {
      "type": "object",
      "required": ["name", "review_profile", "profile", "starting_life", "free_mulligans", "first_player_draws"],
      "properties": {
        "name": {"const": "commander"},
        "review_profile": {"const": "commander_review"},
        "profile": {"enum": ["commander_duel", "commander_multiplayer"]},
        "starting_life": {"type": "integer", "minimum": 1},
        "free_mulligans": {"type": "integer", "minimum": 0},
        "first_player_draws": {"type": "boolean"},
        "cast_source_placement_version": {"type": "integer", "const": 1},
        "explore_action_version": {"type": "integer", "const": 1},
        "transform_timestamp_version": {"type": "integer", "const": 1},
        "commander_damage_identity_version": {
          "type": "integer",
          "enum": [1, 2]
        }
      },
      "additionalProperties": true
    },
    "players": {"type": "array", "minItems": 2, "maxItems": 6},
    "player_count": {"type": "integer", "minimum": 2, "maximum": 6},
    "turn_order": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 6},
    "seed": {"type": ["integer", "null"]},
    "trace_level": {"enum": ["minimal", "standard", "debug"]},
    "semantics_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantics_registry": {
      "type": "object",
      "required": ["schema_version", "hash"],
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "card_programs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fingerprints"],
      "properties": {
        "schema_version": {"const": 2},
        "fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fingerprint",
              "trust_basis",
              "trust_closure_fingerprint",
              "strict_capability_ready"
            ],
            "properties": {
              "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "trust_basis": {
                "enum": [
                  "capability_closed",
                  "legacy_reviewed",
                  "mixed",
                  "provisional",
                  "unresolved",
                  "non_rules_governed"
                ]
              },
              "trust_closure_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "strict_capability_ready": {"type": "boolean"}
            }
          }
        }
      }
    },
    "runtime_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability_registry_fingerprint",
        "capability_evidence_fingerprint",
        "semantic_handler_registry_fingerprint",
        "semantic_handler_inventory",
        "runtime_component_registry_fingerprint",
        "runtime_component_inventory"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "capability_registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_handler_registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_handler_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "handler_id",
              "schema_version",
              "family",
              "rule_references",
              "capability_dependencies"
            ],
            "properties": {
              "operation": {"type": "string", "minLength": 1},
              "handler_id": {"type": "string", "minLength": 1},
              "schema_version": {"type": "integer", "minimum": 1},
              "family": {"type": "string", "minLength": 1},
              "rule_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "capability_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "runtime_component_registry_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_component_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "handler_id",
              "schema_version",
              "family",
              "event",
              "rule_references",
              "capability_dependencies"
            ],
            "properties": {
              "handler_id": {"type": "string", "minLength": 1},
              "schema_version": {"type": "integer", "minimum": 1},
              "family": {"type": "string", "minLength": 1},
              "event": {"type": "string", "minLength": 1},
              "rule_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "capability_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "scryfall": {"type": "object"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "ended_at": {"type": ["string", "null"]},
    "migrated_at": {"type": "string"},
    "status": {"enum": ["in_progress", "complete"]},
    "winner": {"type": ["string", "null"]},
    "draw": {"type": "boolean"},
    "final_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay": {
      "type": "object",
      "required": ["mode", "verification", "engine_version", "semantics_fingerprint"],
      "properties": {
        "mode": {"enum": ["command_replay", "commands", "legacy_snapshot"]},
        "verification": {"enum": ["not_run", "pass", "fail", "snapshot_only"]},
        "engine_version": {"type": "string"},
        "semantics_fingerprint": {"type": "string"},
        "card_program_fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["classification", "eligible"],
      "properties": {
        "classification": {"type": "string"},
        "eligible": {"type": "boolean"},
        "matchup_evidence": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
