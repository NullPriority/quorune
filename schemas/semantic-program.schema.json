{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-commander-sim.local/schemas/semantic-program-v3.json",
  "title": "Reusable semantic program v3",
  "type": "object",
  "required": [
    "key",
    "label",
    "effects",
    "oracle_id",
    "ability_id",
    "active_zone",
    "event",
    "semantic_schema_version",
    "trust_level",
    "provenance",
    "tests",
    "coverage"
  ],
  "properties": {
    "key": {"type": "string"},
    "label": {"type": "string"},
    "effects": {"type": "array", "items": {"type": "object"}},
    "destination": {"type": ["string", "null"]},
    "requires_arbiter": {"type": "boolean"},
    "notes": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "oracle_id": {"type": ["string", "null"]},
    "ability_id": {"type": "string"},
    "active_zone": {"type": "string"},
    "event": {"type": "string"},
    "semantic_schema_version": {"type": "integer", "minimum": 1},
    "trust_level": {"enum": ["trusted", "provisional", "unresolved", "intentionally_ignored"]},
    "provenance": {"type": "object"},
    "tests": {"type": "array", "items": {"type": "string"}},
    "handlers": {"type": "array", "items": {"type": "object"}},
    "target_schema": {"type": ["object", "null"]},
    "cost_schema": {"type": ["object", "null"]},
    "event_condition": {"type": ["object", "null"]},
    "trigger_limit": {
      "type": ["object", "null"],
      "properties": {"schema_version": {"const": 1}, "kind": {"const": "once_per_turn"}},
      "required": ["schema_version", "kind"],
      "additionalProperties": false
    },
    "coverage": {"type": "array", "items": {"type": "string"}},
    "capability_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capability_closure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/capability_closure"}
      ]
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "reachable",
        "profile",
        "trusted",
        "blockers",
        "registry_fingerprint",
        "evidence_fingerprint",
        "fingerprint"
      ],
      "properties": {
        "requested": {"$ref": "#/$defs/strings"},
        "reachable": {"$ref": "#/$defs/strings"},
        "profile": {"type": "string", "minLength": 1},
        "trusted": {"type": "boolean"},
        "blockers": {"$ref": "#/$defs/strings"},
        "registry_fingerprint": {"$ref": "#/$defs/sha256"},
        "evidence_fingerprint": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["capability_dependencies"],
        "properties": {
          "capability_dependencies": {"minItems": 1}
        }
      },
      "then": {
        "required": ["capability_closure"],
        "properties": {
          "capability_closure": {"$ref": "#/$defs/capability_closure"}
        }
      }
    }
  ],
  "additionalProperties": false
}
