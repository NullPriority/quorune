  "rulings": [
    {
      "oracle_id": "1389c9fa-fec2-4212-a7aa-6dfb318dc202",
      "published_at": "2025-09-19",
      "source": "wotc",
      "comment": "You can activate Bagel and Schmear's first ability with no target. In that case, you will only draw a card when it resolves."
    },
    {
      "oracle_id": "1389c9fa-fec2-4212-a7aa-6dfb318dc202",
      "published_at": "2025-09-19",
      "source": "wotc",
      "comment": "If you choose a target for the first ability and that target is illegal as the ability resolves, the ability will be removed from the stack and you will not draw a card."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "Each player tracks their speed (or lack thereof) separately. Increasing your speed has no effect on whether another player has speed."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "“Max speed — [ability]” means “As long as you have max speed, this object has [ability].” If the granted ability functions in a zone other than the battlefield, the max speed ability does too."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "Your speed doesn’t change until a spell or ability says so, such as the inherent triggered ability that cares about opponents losing life during your turn. Notably, losing control of permanents with start your engines! doesn’t affect your speed."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "If an effect needs to know what a player’s speed is and that player doesn’t have a speed, their speed is considered 0."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "Start your engines! isn’t a triggered ability. Increasing your speed to 1 is something that happens as a state-based action as soon as you control a permanent with the ability. Notably, this includes gaining control of a permanent with the ability that another player controls."
    },
    {
      "oracle_id": "eb100b3b-bc3f-48f3-8f28-bb2d80225ea9",
      "published_at": "2025-02-07",
      "source": "wotc",
      "comment": "A player “has max speed” if their speed is 4."
    },
    {
      "oracle_id": "91d4a5fe-fd6d-4b14-a63f-61b4d0ecd9c4",
      "published_at": "2016-09-20",
      "source": "wotc",
      "comment": "No player may take actions in a turn before Inventors' Fair's triggered ability checks to see if it should trigger. If you don't control three or more artifacts, it won't trigger."
    },
    {
      "oracle_id": "91d4a5fe-fd6d-4b14-a63f-61b4d0ecd9c4",
      "published_at": "2016-09-20",
      "source": "wotc",
      "comment": "If you control three artifacts as the ability resolves, you gain 1 life. The artifacts you control as the ability resolves don't have to be the same ones you controlled as it triggered. If you don't control three artifacts at that time, you won't gain life."
    },
    {
      "oracle_id": "91d4a5fe-fd6d-4b14-a63f-61b4d0ecd9c4",
      "published_at": "2016-09-20",
      "source": "wotc",
      "comment": "When using Inventors' Fair's activated ability, the number of artifacts you control is checked only as you activate it. It's not checked again as the ability resolves."
    },
    {
      "oracle_id": "91d4a5fe-fd6d-4b14-a63f-61b4d0ecd9c4",
      "published_at": "2018-01-19",
      "source": "wotc",
      "comment": "There are many important moments in the story, but the most crucial—called “story spotlights”—are shown on cards. These cards have the Planeswalker symbol in their text box; this symbol has no effect on gameplay. You can read more about these events in the official Magic fiction at http://www.mtgstory.com."
    },
    {
      "oracle_id": "08377424-619e-48ae-bc3c-fb199cd77cf9",
      "published_at": "2022-09-09",
      "source": "wotc",
      "comment": "Llanowar Loamspeaker's second ability doesn't untap the land that becomes a creature."
    },
    {
      "oracle_id": "c6de0ee9-785d-4cd8-8a7f-5bb715763131",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "After it becomes a creature, Nantuko Monastery will still have all its abilities."
    },
    {
      "oracle_id": "c6de0ee9-785d-4cd8-8a7f-5bb715763131",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "A noncreature permanent that becomes a creature can attack, and its {T} abilities can be activated, only if its controller has continuously controlled that permanent since the beginning of their most recent turn. It doesn't matter how long the permanent has been a creature. Notably, if you turn Nantuko Monastery into a creature on the turn it entered the battlefield, you won't be able to tap it for mana."
    },
    {
      "oracle_id": "c6de0ee9-785d-4cd8-8a7f-5bb715763131",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Once you activate the last ability, it doesn't matter what happens to the number of cards in your graveyard. Nantuko Monastery will remain a creature that turn even if that number falls below seven."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "Purify the Grave can't be used in response to a spell being cast with flashback or a spell that requires cards to exiled from a graveyard as an additional cost to try and counter the spell or prevent it from being cast."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "If it's your turn, and you cast a spell with flashback from your hand, you'll have priority to cast that spell again using flashback before any other player has priority to cast Purify the Grave in order to remove that card from your graveyard."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."
    },
    {
      "oracle_id": "1dafc03b-6c45-4f28-8a1f-b4f1044adc97",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it."
    }
  ]
}
