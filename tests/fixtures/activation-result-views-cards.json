  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Master Transmuter can be returned to its owner's hand to pay the cost of its activated ability.",
      "oracle_id": "da46786e-28df-4638-ab3d-121011d2f150",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "The artifact card you put onto the battlefield when the ability resolves may be the same card that you returned to your hand when you paid the cost. If so, it returns to the battlefield as a new object with no relation to its previous existence.",
      "oracle_id": "da46786e-28df-4638-ab3d-121011d2f150",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "Because targets are chosen for activated abilities before costs (such as \"Sacrifice an artifact\") are paid, Goblin Engineer's second ability can't target the artifact that will be sacrificed to pay its cost.",
      "oracle_id": "c1d6cce8-085f-42cb-8b0c-b6fbbf88b16a",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "If a card in a player's graveyard has {X} in its mana cost, X is considered to be 0.",
      "oracle_id": "c1d6cce8-085f-42cb-8b0c-b6fbbf88b16a",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it.",
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.",
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2004-12-01",
      "source": "wotc"
    },
    {
      "comment": "This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".",
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2010-06-15",
      "source": "wotc"
    },
    {
      "comment": "A land that's a Forest has the intrinsic mana ability \"{T}: Add {G}.\"",
      "oracle_id": "162572f2-1757-42e9-bd97-e6bd9a762c0e",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "comment": "As long as Ashaya is on the battlefield, it's affected by its second ability and thus its first ability counts itself.",
      "oracle_id": "162572f2-1757-42e9-bd97-e6bd9a762c0e",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "comment": "Because damage remains marked on a creature until the damage is removed as the turn ends, nonlethal damage dealt to Ashaya may become lethal if lands you control leave the battlefield during that turn.",
      "oracle_id": "162572f2-1757-42e9-bd97-e6bd9a762c0e",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "comment": "The ability that defines Ashaya's power and toughness applies in all zones, not just the battlefield.",
      "oracle_id": "162572f2-1757-42e9-bd97-e6bd9a762c0e",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "comment": "You can't play creature cards as lands; you'll still have to cast them as spells, and they'll enter the battlefield as lands (in addition to their other types).",
      "oracle_id": "162572f2-1757-42e9-bd97-e6bd9a762c0e",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "oracle_id": "e9b6a394-691c-425a-9307-76d8edc7375e",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Discarding the card is part of the cost to activate a channel ability."
    },
    {
      "oracle_id": "e9b6a394-691c-425a-9307-76d8edc7375e",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "If a channel ability requires a target, you may not activate it without a target just to discard the card."
    }
  ],
