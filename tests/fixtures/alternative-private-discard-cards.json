  "rulings": [
    {
      "comment": "You can discard an instant card, a sorcery card, a creature card with flying, or any two cards, even if one or both of those cards have the listed characteristics.",
      "oracle_id": "0fb9a928-9adb-4dc1-9761-857df7e6c643",
      "published_at": "2024-02-02",
      "source": "wotc"
    },
    {
      "comment": "If a replacement effect would try to replace a card that you can't draw, that effect can't apply.",
      "oracle_id": "1463795b-ec0c-44d6-ae1a-55f78d9843ec",
      "published_at": "2014-02-01",
      "source": "wotc"
    },
    {
      "comment": "If you draw a card, and then Spirit of the Labyrinth enters the battlefield, you won't be able to draw more cards that turn.",
      "oracle_id": "1463795b-ec0c-44d6-ae1a-55f78d9843ec",
      "published_at": "2014-02-01",
      "source": "wotc"
    },
    {
      "comment": "If you haven't drawn any cards in a turn, and a spell or ability would cause you to draw multiple cards, you'll just draw one card.",
      "oracle_id": "1463795b-ec0c-44d6-ae1a-55f78d9843ec",
      "published_at": "2014-02-01",
      "source": "wotc"
    },
    {
      "comment": "You can draw a maximum of one card on each player's turn. Subsequent card draws are ignored.",
      "oracle_id": "1463795b-ec0c-44d6-ae1a-55f78d9843ec",
      "published_at": "2014-02-01",
      "source": "wotc"
    },
    {
      "comment": "You can discard either one artifact card or two cards which may or may not be artifacts. If you really want to, you can discard two artifact cards.",
      "oracle_id": "484eeb13-fe74-45fe-b089-7beec87cfcdb",
      "published_at": "2004-12-01",
      "source": "wotc"
    },
    {
      "comment": "You can discard either one artifact card or two cards which may or may not be artifacts. If you really want to, you can discard two artifact cards.",
      "oracle_id": "939e6f71-185e-41f2-9d54-72cce06f1dce",
      "published_at": "2020-11-10",
      "source": "wotc"
    },
    {
      "comment": "The target player can discard either one land card or two cards which may or may not be lands. The player can discard one land and one other card or two land cards if they choose.",
      "oracle_id": "f947808c-a1cc-41ea-9d06-e1279a0da527",
      "published_at": "2017-03-14",
