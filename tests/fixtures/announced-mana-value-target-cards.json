  "rulings": [
    {
      "oracle_id": "a75dbe70-7e3e-446f-9a76-9fbb414f2e7c",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "Sacrificing Seal of Cleansing is the cost to activate its ability. Once you activate the ability, no player can do anything to Seal of Cleansing to stop you from activating it. Notably, if you cast Seal of Cleansing during your turn, you'll have priority to activate its ability before anyone can respond to stop you."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as an overload cost), add any cost increases, then apply any cost reductions. The mana value of the spell remains unchanged, no matter what the total cost to cast it was."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Because a spell with overload doesn't target when its overload cost is paid, it may affect permanents with hexproof or with protection from the appropriate color."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If you are instructed to cast a spell with overload \"without paying its mana cost,\" you can't choose to pay its overload cost instead."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If you don't pay the overload cost of a spell with overload, that spell will have a single target. If you pay the overload cost, the spell won't have any targets."
    },
    {
      "oracle_id": "b47b3cfe-7005-4b33-9d41-83b60808e12b",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Tameshi's first ability triggers only whenever one or more noncreature permanents are returned to hand from the battlefield. Noncreature permanent cards returned to hand from other zones do not cause this ability to trigger."
    },
    {
      "comment": "If a permanent on the battlefield has {X} in its mana cost, X is considered to be 0.",
      "oracle_id": "b1f2b26c-91b2-4f3c-9f48-6429ec3fde48",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "If the target permanent is an illegal target by the time Repeal tries to resolve, the spell doesn't resolve. You don't draw a card.",
      "oracle_id": "b1f2b26c-91b2-4f3c-9f48-6429ec3fde48",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "The mana value of a token that isn't a copy of another object is 0. A token that is a copy of another object has the same mana cost as that object.",
      "oracle_id": "b1f2b26c-91b2-4f3c-9f48-6429ec3fde48",
      "published_at": "2021-03-19",
      "source": "wotc"
    }
  ]
}
