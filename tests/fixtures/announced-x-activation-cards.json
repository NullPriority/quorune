    {
      "oracle_id": "ec439630-e18b-45f6-8034-2ecbea27772f",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "If the ability resolves, but the damage is prevented or redirected, the controller of the targeted creature will draw X cards, regardless of how much damage was dealt or what the damage was ultimately dealt to."
