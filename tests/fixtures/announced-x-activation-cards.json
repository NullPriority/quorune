  "rulings": [
    {
      "oracle_id": "a588f047-02b4-4c6b-bce2-6e4d564296ec",
      "published_at": "2009-05-01",
      "source": "wotc",
      "comment": "Once Demonspine Whip\u2019s ability resolves and gives the +X/+0 bonus to a creature, that bonus stays with that creature for the rest of the turn even if Demonspine Whip moves to another creature or leaves the battlefield."
    },
    {
      "oracle_id": "a588f047-02b4-4c6b-bce2-6e4d564296ec",
      "published_at": "2009-05-01",
      "source": "wotc",
      "comment": "If Demonspine Whip is no longer on the battlefield by the time its first ability resolves, the game checks whether it was attached to a creature at the time it left the battlefield. If it was, that creature gets the +X/+0 bonus. If it wasn\u2019t, no creature gets the bonus."
    },
    {
      "oracle_id": "a588f047-02b4-4c6b-bce2-6e4d564296ec",
      "published_at": "2009-05-01",
      "source": "wotc",
      "comment": "When the first ability resolves, the +X/+0 bonus is given to the creature that Demonspine Whip is attached to at that time, regardless of what creature (if any) it was attached to when the ability was activated. If Demonspine Whip is on the battlefield but not attached to a creature at this time, no creature gets the bonus."
    },
    {
      "oracle_id": "151d9035-c8e8-4794-8405-dc7744eb99a2",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You choose an opponent on announcement. This is not targeted, but a choice is still made. This choice is made before determining the value for X that is used in the cost."
    },
    {
      "oracle_id": "126e9140-2c05-4c00-8b01-5653456c736a",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "If Lair of the Hydra enters the battlefield at the same time as one or more other lands, it doesn't take those lands into consideration when determining how many other lands you control."
