  "rulings": [
    {
      "oracle_id": "e7564d66-767c-4cd9-a5f0-0f2488a4a74b",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "The second mode of Heliod's Intervention causes the player to gain one amount of life equal to twice X. It doesn't cause the player to gain X life then gain X life again."
    },
    {
      "oracle_id": "e1afaef7-9fa3-4662-a95f-adfb0da9fd11",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "If a creature can't attack for any reason (such as being tapped or having come under that player's control that turn), then it doesn't attack. If there's a cost associated with having a creature attack, the player isn't forced to pay that cost, so it doesn't have to attack in that case either."
    },
    {
      "oracle_id": "e1afaef7-9fa3-4662-a95f-adfb0da9fd11",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "The controller of each attacking creature still chooses which player or planeswalker that creature attacks."
    }
