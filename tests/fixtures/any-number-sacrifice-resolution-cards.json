_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Renounce","oracle_id":"72f9a6f7-ea26-438d-aafa-758239fd3681","oracle_text":"Sacrifice any number of permanents. You gain 2 life for each permanent sacrificed this way.","power":null,"produced_mana":[],"released_at":"1999-10-04","toughness":null,"type_line":"Instant"},{"cmc":4.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{B}{B}","name":"Reprocess","oracle_id":"27177cb0-1670-488e-82be-4610da5a7de3","oracle_text":"Sacrifice any number of artifacts, creatures, and/or lands. Draw a card for each permanent sacrificed this way.","power":null,"produced_mana":[],"released_at":"2011-05-14","toughness":null,"type_line":"Sorcery"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Rest in Peace","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","oracle_text":"When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.","power":null,"produced_mana":[],"released_at":"2024-04-19","toughness":null,"type_line":"Enchantment"},{"cmc":0.0,"color_identity":["B"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Swamp","oracle_id":"56719f6a-1a6c-4c0a-8d21-18f7d7350b68","oracle_text":"({T}: Add {B}.)","power":null,"produced_mana":["B"],"released_at":"2026-06-26","toughness":null,"type_line":"Basic Land — Swamp"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If Rest in Peace is destroyed by a spell, Rest in Peace will be exiled and then the spell will be put into its owner's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"If a card is discarded while Rest in Peace is on the battlefield, abilities that function when a card is discarded (such as madness) still work, even though that card never reaches a graveyard. In addition, spells or abilities that check the characteristics of a discarded card (such as Chandra Ablaze's first ability) can find that card in exile.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"While Rest in Peace is on the battlefield, abilities that trigger whenever a creature dies won't trigger because cards and tokens are never put into a player's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"As Bontu's first triggered ability resolves, you may choose to sacrifice zero other permanents.","oracle_id":"183891b0-b5ec-47f4-8d09-b9d3cfc4e7f1","published_at":"2019-05-03","source":"wotc"},{"comment":"If a second God-Eternal Bontu enters the battlefield under your control, you'll put one into your graveyard before you can sacrifice anything to the new Bontu's triggered ability.","oracle_id":"183891b0-b5ec-47f4-8d09-b9d3cfc4e7f1","published_at":"2019-05-03","source":"wotc"},{"comment":"If any abilities trigger as you sacrifice other permanents, those abilities won't be put onto the stack until after you've drawn cards.","oracle_id":"183891b0-b5ec-47f4-8d09-b9d3cfc4e7f1","published_at":"2019-05-03","source":"wotc"},{"comment":"Exiling a card using its plot ability is a special action. Once you announce you’re taking that action, no other player can respond by trying to remove that card from your hand.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"If a plotted card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"If any abilities trigger as you sacrifice permanents, those abilities won’t be put onto the stack until after you’ve drawn the appropriate number of cards.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"If you’re casting a plotted card from exile without paying its mana cost, you can’t choose to cast it for any other alternative costs. You can, however, pay additional costs, such as kicker costs. If the plotted card has any mandatory additional costs, those must still be paid to cast the spell.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"Plot abilities are written “Plot [cost],” which means “Any time you have priority during your main phase while the stack is empty, you may pay [cost] and exile this card from your hand. It becomes plotted.”","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"You can choose to sacrifice zero permanents. (That does sound an awful lot like pity, though.)","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"You can’t cast a plotted card on the same turn it became plotted. On any future turn, you may cast that card from exile without paying its mana cost during your main phase while the stack is empty.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"You sacrifice the permanents as part of the resolution of Pitiless Carnage. It isn’t an additional cost. If Pitiless Carnage is countered or never resolves, you won’t sacrifice anything.","oracle_id":"186bfdac-ce9c-476f-89b6-ef467487fca5","published_at":"2024-04-12","source":"wotc"},{"comment":"You can sacrifice zero permanents if you want to.","oracle_id":"27177cb0-1670-488e-82be-4610da5a7de3","published_at":"2004-10-04","source":"wotc"},{"comment":"You choose what to sacrifice on resolution.","oracle_id":"72f9a6f7-ea26-438d-aafa-758239fd3681","published_at":"2004-10-04","source":"wotc"},{"comment":"As Malevolent Witchkite's triggered ability resolves, you may choose to sacrifice zero permanents.","oracle_id":"aee2cd1b-9bf9-4b91-83a4-2f1dbc82dcf4","published_at":"2023-09-01","source":"wotc"},{"comment":"If any abilities trigger when you sacrifice permanents, those abilities won't be put onto the stack until after you've drawn cards. Those abilities won't trigger if you choose to sacrifice zero permanents.","oracle_id":"aee2cd1b-9bf9-4b91-83a4-2f1dbc82dcf4","published_at":"2023-09-01","source":"wotc"},{"comment":"A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"If your opponent discards a card while you control Leyline of the Void, abilities that check whether a card is discarded (such as Hollow One, or a madness ability of the discarded card) still work, even though that card never reaches that player's graveyard. In addition, spells or abilities that check the characteristics of the discarded card can find that card in exile.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"Tokens can still die while Leyline of the Void is on the battlefield.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"While Leyline of the Void is on the battlefield, nontoken creatures your opponents control won't die. They'll be exiled instead. Abilities that would trigger when those creatures die won't trigger.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
