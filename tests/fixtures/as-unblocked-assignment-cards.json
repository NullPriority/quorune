  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Assigning the creature's damage as though it weren't blocked is all or nothing. You can't use this effect to assign some of the creature's damage to a blocking creature and the rest to the defending player or planeswalker.",
      "oracle_id": "069c3c87-81a8-4d2a-ad2f-8d3243d0e3db",
      "published_at": "2021-07-23",
      "source": "wotc"
    },
    {
      "comment": "Even if it assigns damage as though it were not blocked, it will still receive damage from creatures that are blocking it.",
      "oracle_id": "069c3c87-81a8-4d2a-ad2f-8d3243d0e3db",
      "published_at": "2021-07-23",
      "source": "wotc"
    },
    {
      "comment": "If blocked by a creature with banding, the defending player decides whether or not the damage is assigned \u201cas though it weren\u2019t blocked\u201d.",
      "oracle_id": "5b5e0df8-f8f0-40a1-9814-89d73a026ad0",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "When assigning combat damage, you choose whether you want to assign all damage to blocking creatures, or if you want to assign all of it to the player or planeswalker this creature is attacking. You can\u2019t split the damage assignment between them.",
      "oracle_id": "5b5e0df8-f8f0-40a1-9814-89d73a026ad0",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "You can decide to assign damage to the defending player or planeswalker even if the blocking creature has protection from green or damage preventing effects on it.",
      "oracle_id": "5b5e0df8-f8f0-40a1-9814-89d73a026ad0",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "If blocked by a creature with banding, the defending player decides whether or not the damage is assigned \u201cas though it weren\u2019t blocked\u201d.",
      "oracle_id": "9cdf840d-314e-46ef-9c04-74f145d9e65b",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "When assigning combat damage, you choose whether you want to assign all damage to blocking creatures, or if you want to assign all of it to the player or planeswalker this creature is attacking. You can\u2019t split the damage assignment between them.",
      "oracle_id": "9cdf840d-314e-46ef-9c04-74f145d9e65b",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "You can decide to assign damage to the defending player or planeswalker even if the blocking creature has protection from green or damage preventing effects on it.",
      "oracle_id": "9cdf840d-314e-46ef-9c04-74f145d9e65b",
      "published_at": "2018-04-27",
      "source": "wotc"
    },
    {
      "comment": "Will even apply to creatures that entered the battlefield after it resolved (which obviously must have Haste in order to attack).",
      "oracle_id": "c5866507-ef3b-446a-99ea-d31d974bdb01",
      "published_at": "2006-04-01",
      "source": "wotc"
    },
    {
      "comment": "If a creature is attacking a planeswalker, assigning its damage as though it weren't blocked means the damage is assigned to the planeswalker, not to the defending player.",
      "oracle_id": "c5866507-ef3b-446a-99ea-d31d974bdb01",
      "published_at": "2008-04-01",
      "source": "wotc"
    },
    {
      "comment": "When Predatory Focus resolves, you choose whether to use its effect or not. If you choose to use it, all your creatures will deal their combat damage to the planeswalker or defending player this turn whether or not they become blocked. You can't have any of them deal combat damage to creatures that block them. If you choose not to use its effect, nothing happens.",
      "oracle_id": "c5866507-ef3b-446a-99ea-d31d974bdb01",
      "published_at": "2008-04-01",
      "source": "wotc"
    },
    {
      "comment": "You decide whether to assign a creature\u2019s combat damage as though it weren\u2019t blocked just before it assigns that damage. You may make a different choice for each creature you control\u2014that is, you may have none, some, or all of those creatures assign combat damage as though they weren\u2019t blocked.",
      "oracle_id": "cadf7be1-4a74-4163-bb2f-6bfbbb557973",
      "published_at": "2014-11-07",
      "source": "wotc"
    },
    {
      "comment": "Proud Wildbonder\u2019s last ability applies to itself as long as it still has trample.",
      "oracle_id": "e72f995e-288f-4d32-b067-ae73eea87e67",
      "published_at": "2020-04-17",
      "source": "wotc"
    },
    {
      "comment": "When assigning combat damage, you choose whether you want to assign all damage to blocking creatures and assign trample damage from that as normal, or if you want to assign all of it to the player or planeswalker the creature is attacking. You can\u2019t assign some damage to one blocker then skip other blockers.",
      "oracle_id": "e72f995e-288f-4d32-b067-ae73eea87e67",
      "published_at": "2020-04-17",
      "source": "wotc"
    },
    {
      "comment": "You can decide to assign combat damage to the defending player or planeswalker even if the blocking creature has protection from green or other damage prevention effects applying to it.",
      "oracle_id": "e72f995e-288f-4d32-b067-ae73eea87e67",
      "published_at": "2020-04-17",
      "source": "wotc"
    }
  ],
