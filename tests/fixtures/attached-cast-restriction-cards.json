  "rulings": [
    {
      "oracle_id": "9aace0d3-89e6-4254-b96f-ee3a878f2f91",
      "published_at": "2016-11-08",
      "source": "wotc",
      "comment": "The first ability of Conqueror's Flail constantly updates as the number of colors among permanents you control changes. If the number of colors decreases and the damage that was marked on the equipped creature earlier in the turn is now lethal damage, that creature is destroyed. Similarly, if its toughness becomes 0, that creature is put into its owner's graveyard."
    },
    {
      "oracle_id": "9aace0d3-89e6-4254-b96f-ee3a878f2f91",
      "published_at": "2016-11-08",
      "source": "wotc",
      "comment": "The five colors are white, blue, black, red, and green. Conqueror's Flail can't give a creature more than +5/+5. (Gold, artifact, and colorless aren't colors.)"
    },
    {
      "oracle_id": "9aace0d3-89e6-4254-b96f-ee3a878f2f91",
      "published_at": "2016-11-08",
      "source": "wotc",
      "comment": "If Conquerer's Flail is attached to a creature you control and you activate its equip ability targeting another creature you control, there's no time in between activating that ability and the resolution of that ability during which it's not attached to a creature. Assuming it's your turn, your opponents won't be able to cast spells."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "cd8ae9f2-edac-473a-8846-c08219e617c3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Can be used on artifact creatures."
    },
    {
      "oracle_id": "a75dbe70-7e3e-446f-9a76-9fbb414f2e7c",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "Sacrificing Seal of Cleansing is the cost to activate its ability. Once you activate the ability, no player can do anything to Seal of Cleansing to stop you from activating it. Notably, if you cast Seal of Cleansing during your turn, you'll have priority to activate its ability before anyone can respond to stop you."
    }
  ]
}
