      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "3e8bcb44-b875-4fe4-b96f-97a20cbfec93",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "Only the controller of Cooped Up may activate its ability."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    },
    {
      "oracle_id": "9c41b4ad-a73f-4274-9b71-9c9834910e05",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "The creature that's exiled is the creature Dreadful Apathy enchants as its last ability resolves."
    },
    {
      "oracle_id": "9c41b4ad-a73f-4274-9b71-9c9834910e05",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "If Dreadful Apathy leaves the battlefield while its last ability is on the stack, the permanent that's exiled is the one Dreadful Apathy enchanted before leaving the battlefield, even if that permanent is no longer a creature."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "093a20e5-ff14-41c7-b16c-1f745ddf6942",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Having shroud will prevent the creature from being targeted by Aura spells, but it does not remove any Auras that are already attached to the creature or stop Auras from being moved to the creature by some other method."
    },
    {
      "oracle_id": "44074791-da32-498b-879f-22192b94a9b0",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If the enchanted creature gains an ability after Utter Insignificance becomes attached to it, it will keep that ability."
    },
    {
      "oracle_id": "44074791-da32-498b-879f-22192b94a9b0",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Utter Insignificance overwrites all previous effects that set the creature's base power and toughness to specific values. Any power- or toughness-setting effects that start to apply afterward will overwrite this effect."
    },
    {
      "oracle_id": "44074791-da32-498b-879f-22192b94a9b0",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Effects that modify the creature's power and/or toughness, such as the effect of Wing It, will apply to the creature no matter when they started to take effect. The same is true for counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "44074791-da32-498b-879f-22192b94a9b0",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Because damage remains marked on a creature until the damage is removed as the turn ends, nonlethal damage dealt to a creature may become lethal if Utter Insignificance becomes attached to it during that turn."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2010-06-15",
      "source": "wotc",
      "comment": "This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\"."
    },
    {
      "oracle_id": "7c3944fa-7c86-4979-85a9-86196aa94594",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If the permanent was an Aura or an Equipment, it becomes unattached from whatever it was attached to."
    },
    {
      "oracle_id": "7c3944fa-7c86-4979-85a9-86196aa94594",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "The enchanted permanent loses any card types, subtypes, and colors it previously had. It keeps any supertypes it had and its name remains unchanged. It gains “{T}: Add {G}” and loses all other abilities from its rules text. It will still have any abilities it gained from other effects."
    }
  ]
}
