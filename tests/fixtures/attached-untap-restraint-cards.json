cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Twiddle","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","oracle_text":"You may tap or untap target artifact, creature, or land.","power":null,"produced_mana":[],"released_at":"2003-07-28","toughness":null,"type_line":"Instant"},{"cmc":3.0,"color_identity":[],"colors":[],"defense":null,"keywords":["Equip"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}","name":"Umbral Mantle","oracle_id":"44f3241f-af82-4f2e-b15d-7f279bf6e816","oracle_text":"Equipped creature has \"{3}, {Q}: This creature gets +2/+2 until end of turn.\" ({Q} is the untap symbol.)\nEquip {0}","power":null,"produced_mana":[],"released_at":"2008-05-02","toughness":null,"type_line":"Artifact \u2014 Equipment"},{"cmc":0.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Wastes","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","oracle_text":"{T}: Add {C}.","power":null,"produced_mana":["C"],"released_at":"2025-08-01","toughness":null,"type_line":"Basic Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"If a creature with an {Q} ability hasn't been under your control since your most recent turn began, you can't activate that ability, unless the creature has haste.","oracle_id":"44f3241f-af82-4f2e-b15d-7f279bf6e816","published_at":"2008-05-01","source":"wotc"},{"comment":"If the permanent is already untapped, you can't activate its {Q} ability. That's because you can't pay the \"Untap this permanent\" cost.","oracle_id":"44f3241f-af82-4f2e-b15d-7f279bf6e816","published_at":"2008-05-01","source":"wotc"},{"comment":"When you activate an {Q} ability, you untap the creature with that ability as a cost. The untap can't be responded to. (The actual ability can be responded to, of course.)","oracle_id":"44f3241f-af82-4f2e-b15d-7f279bf6e816","published_at":"2008-05-01","source":"wotc"},{"comment":"The decision whether or not to tap or untap is made on resolution. This is not a modal spell.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"},{"comment":"As long as Cultivator's Caravan isn't an artifact creature, its {T} ability can be activated if it came under your control this turn.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2016-09-20","source":"wotc"},{"comment":"Any untapped creature you control can be tapped to pay a crew cost, even one that just came under your control.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"Creatures that crew a Vehicle aren't attached to it or related in any other way. Effects that affect the Vehicle, such as by destroying it or giving it a +1/+1 counter, don't affect the creatures that crewed it.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"Each Vehicle is printed with a power and toughness, but it's not a creature. If it becomes a creature (most likely through its crew ability), it will have that power and toughness.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"For a Vehicle to be able to attack, it must be a creature as the declare attackers step begins, so the latest you can activate its crew ability to attack with it is during the beginning of combat step. For a Vehicle to be able to block, it must be a creature as the declare blockers step begins, so the latest you can activate its crew ability to block with it is during the declare attackers step. In either case, players may take actions after the crew ability resolves but before the Vehicle has been declared as an attacking or blocking creature.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"If a permanent becomes a copy of a Vehicle, the copy won't be a creature, even if the Vehicle it's copying has become an artifact creature.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"If an effect causes a Vehicle to become an artifact creature with a specified power and toughness, that effect overwrites the Vehicle's printed power and toughness.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"Once a Vehicle becomes a creature, it behaves exactly like any other artifact creature. It can't attack unless you've controlled it continuously since your turn began, it can block if it's untapped, it can be tapped to pay a Vehicle's crew cost, and so on.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"Once a player announces that they are activating a crew ability, no player may take other actions until the ability has been paid for. Notably, players can't try to stop the ability by changing a creature's power or by removing or tapping a creature.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"Vehicle is an artifact type, not a creature type. A Vehicle that's crewed won't normally have any creature type.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"When a Vehicle becomes a creature, that doesn't count as having a creature enter the battlefield. The permanent was already on the battlefield; it only changed its types. Abilities that trigger whenever a creature enters the battlefield won't trigger.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"You may activate a crew ability of a Vehicle even if it's already an artifact creature. Doing so has no effect on the Vehicle. It doesn't change its power and toughness.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"You may tap more creatures than necessary to activate a crew ability.","oracle_id":"c1eb530c-dd36-40ae-8617-6bb6969565e1","published_at":"2017-09-29","source":"wotc"},{"comment":"If the affected permanent gains an ability after Stop Cold becomes attached to it, it will keep that ability.","oracle_id":"e0206af2-8034-4351-a797-a1d996f080b5","published_at":"2024-04-12","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
