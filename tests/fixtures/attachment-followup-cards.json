  "rulings": [
    {
      "comment": "Wither applies to any damage dealt to creatures by the affected creature. This includes combat damage as well as anything that causes that creature to deal noncombat damage, such as the effect of Assert Perfection.",
      "oracle_id": "15febce7-8320-4591-9535-ef11c8adecc2",
      "published_at": "2025-11-17",
      "source": "wotc"
    },
    {
      "comment": "Quick-Draw Dagger doesn't enter the battlefield attached to a creature. Instead, the Equipment enters the battlefield and then a triggered ability attaches it to a creature. You may cast Quick-Draw Dagger even if you don't control any creatures.",
      "oracle_id": "47b4dd69-0b2a-4dc3-99e8-f572fe049327",
      "published_at": "2022-04-29",
      "source": "wotc"
    },
    {
      "comment": "If a creature gains hexproof in response to a spell or ability controlled by an opponent that only targets that creature, then when that spell or ability tries to resolve, all of its targets will be illegal. As a result, that spell or ability won't resolve and none of its effects will happen.",
      "oracle_id": "4f1b68d7-7d16-4bb1-af5f-f1708b23ca73",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "Attaching Celestial Armor to a creature that has already been blocked won't cause it to become unblocked, even if one or more of the blocking creatures don't have flying or reach.",
      "oracle_id": "4f1b68d7-7d16-4bb1-af5f-f1708b23ca73",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "You don't choose a target creature an opponent controls for Novel Nunchaku's first ability at the time it triggers. Rather, a second \"reflexive\" ability triggers when Novel Nunchaku is attached to the target creature you control this way. You choose a target for that ability as it goes on the stack. Each player may respond to this triggered ability as normal.",
      "oracle_id": "6d819742-3d02-4d60-9b10-82caa49a9d49",
      "published_at": "2026-01-27",
      "source": "wotc"
    },
    {
      "comment": "If either creature is an illegal target as Hunter's Bow's first ability tries to resolve, the creature you control won't deal damage.",
      "oracle_id": "810592fe-65f5-4c95-9d75-d6806e004903",
      "published_at": "2024-07-05",
      "source": "wotc"
    },
    {
      "comment": "Attaching an Equipment with its enters-the-battlefield triggered ability isn't the same as using its equip ability. You don't pay mana for the attachment, and the timing restrictions for equip abilities don't apply.",
      "oracle_id": "92225b59-4f39-4175-ad0d-88e96f4d906a",
      "published_at": "2023-06-16",
      "source": "wotc"
    },
    {
      "comment": "If the target creature becomes an illegal target, the Equipment remains on the battlefield unattached, and no creatures are untapped.",
      "oracle_id": "92225b59-4f39-4175-ad0d-88e96f4d906a",
      "published_at": "2023-06-16",
      "source": "wotc"
    },
    {
      "comment": "Galadhrim Bow doesn't enter the battlefield attached to a creature. Instead, the Equipment enters the battlefield and then a triggered ability attaches it to a creature. You may cast Galadhrim Bow even if you don't control any creatures.",
      "oracle_id": "92225b59-4f39-4175-ad0d-88e96f4d906a",
      "published_at": "2023-06-16",
      "source": "wotc"
    },
    {
      "comment": "Attaching Silver Shroud Costume to a creature that has already been blocked won't cause it to become unblocked.",
      "oracle_id": "b40138c3-48bc-4825-ae48-5fea95304088",
      "published_at": "2024-03-08",
      "source": "wotc"
    },
    {
      "comment": "The creature that gains indestructible due to Bladed Battle-Fan's triggered ability will keep indestructible for the duration of the turn, even if Bladed Battle-Fan later becomes unattached.",
      "oracle_id": "c4614b6c-5e77-465f-996f-504121ea8eff",
      "published_at": "2023-04-14",
      "source": "wotc"
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "If the targeted permanent is an illegal target by the time Into the Roil resolves, the entire spell doesn't resolve. You don't draw a card.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "If the target nonland permanent is an illegal target by the time Into the Roil tries to resolve, the spell doesn't resolve. You don't draw a card if it was kicked.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2020-09-25",
      "source": "wotc"
    },
    {
      "comment": "The kicker ability doesn't let you pay a kicker cost more than once.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If you put a permanent with a kicker ability onto the battlefield without casting it, you can't kick it.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If a spell's kicker cost was paid, the spell is \"kicked.\"",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If a card or token enters as a copy of a permanent, the new permanent isn't kicked, even if the original was.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "To determine a spell's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases (such as kicker), then apply any cost reductions. The spell's mana value remains unchanged, no matter what the total cost to cast it was.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If you copy a kicked spell on the stack, the copy is also kicked. If the copied spell is a permanent spell, the token the copy of that spell becomes when it enters is also kicked.",
      "oracle_id": "c2898bbd-82a4-4d26-b6ee-169b0ebe71b4",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    }
  ],
