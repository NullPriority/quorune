  "rulings": [
    {
      "oracle_id": "058062c7-071b-4b14-903d-ae8d2876b37f",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "A Dragon creature card is a creature card with the creature type Dragon, not necessarily a creature card with the word “Dragon” in its name."
    },
    {
      "oracle_id": "058062c7-071b-4b14-903d-ae8d2876b37f",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "You choose which player or planeswalker the Dragon is attacking as you put it onto the battlefield. It doesn't have to be the same player or planeswalker Minion of the Mighty is attacking."
    },
    {
      "oracle_id": "058062c7-071b-4b14-903d-ae8d2876b37f",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "The creature card is already tapped and attacking as it's put onto the battlefield. Any abilities that trigger whenever a creature becomes tapped or whenever a creature attacks won't trigger."
    },
    {
      "oracle_id": "d5b4e9fd-3df6-4d1d-8135-d7c8615b05a7",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "The pack tactics ability goes on the stack without a target. If you sacrifice another creature as it resolves, the reflexive triggered ability will trigger and choose a target for it at that time."
    },
    {
      "oracle_id": "d5b4e9fd-3df6-4d1d-8135-d7c8615b05a7",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "Use the sacrificed creature's power as it last existed on the battlefield to determine how much damage is dealt."
    },
    {
      "oracle_id": "e74c4001-d958-4d2b-b57d-c3601f01580c",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "Battle Cry Goblin's activated ability will affect only Goblins you control as it resolves. If you activate it before attacking and then create a Goblin with its triggered ability during combat, the Goblin you create will not get +1/+0."
    },
    {
      "oracle_id": "758aeca5-6ef3-4463-a65a-66b39289cc86",
      "published_at": "2007-05-01",
      "source": "wotc",
      "comment": "A first strike damage step will be created if Char-Rumbler is in combat, even if its power is 0 or less. The normal combat damage step will follow."
    },
    {
      "oracle_id": "758aeca5-6ef3-4463-a65a-66b39289cc86",
      "published_at": "2007-05-01",
      "source": "wotc",
      "comment": "If Char-Rumbler's power changes between the assignment of first-strike combat damage and the assignment of normal combat damage, Char-Rumbler will deal a different amount of damage in each combat damage step."
    },
    {
      "oracle_id": "758aeca5-6ef3-4463-a65a-66b39289cc86",
      "published_at": "2007-05-01",
      "source": "wotc",
      "comment": "Yes, Char-Rumbler's printed power is -1. While its power is -1 or 0, it simply deals no combat damage."
    },
    {
      "oracle_id": "758aeca5-6ef3-4463-a65a-66b39289cc86",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Because Char-Rumber's power is normally negative, you'll have to give it at least +2/+0 before it'll deal damage. It won't deal negative damage."
    }
  ]
