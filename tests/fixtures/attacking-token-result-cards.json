  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "If you attack with multiple creatures, Beastmaster Ascension's first ability triggers multiple times.",
      "oracle_id": "11b5308d-5bc0-4782-875f-a28be36e665d",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "If you discard Loxodon Smiter and put it onto the battlefield, you've still discarded a card. Abilities that trigger when you discard a card (such as the one from Liliana's Caress) will still trigger.",
      "oracle_id": "18ac2282-83af-4acc-b20b-6a95771da688",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "Although the tokens are attacking, they were never declared as attacking creatures (for the purposes of abilities that trigger whenever a creature attacks, for example).",
      "oracle_id": "24d22bcb-8a77-4c47-a508-6f4bc093c1d0",
      "published_at": "2019-05-03",
      "source": "wotc"
    },
    {
      "comment": "You choose which players or planeswalkers the two tokens are attacking. They don't have to be attacking the same player or planeswalker that Parhelion II is attacking, and they can each be attacking different players and/or planeswalkers.",
      "oracle_id": "24d22bcb-8a77-4c47-a508-6f4bc093c1d0",
      "published_at": "2019-05-03",
      "source": "wotc"
    },
    {
      "comment": "Although the tokens are attacking, they never were declared as attacking creatures (for purposes of abilities that trigger whenever a creature attacks, for example).",
      "oracle_id": "454a8902-8120-4373-96ee-bbf352b04e8d",
      "published_at": "2011-06-01",
      "source": "wotc"
    },
    {
      "comment": "Whenever Hero of Bladehold attacks, both abilities will trigger. You can put them onto the stack in any order. If the token-creating ability resolves first, the tokens each get +1/+0 until end of turn from the battle cry ability.",
      "oracle_id": "454a8902-8120-4373-96ee-bbf352b04e8d",
      "published_at": "2011-06-01",
      "source": "wotc"
    },
    {
      "comment": "You choose which opponent or planeswalker an opponent controls that each token is attacking when it is put onto the battlefield.",
      "oracle_id": "454a8902-8120-4373-96ee-bbf352b04e8d",
      "published_at": "2011-06-01",
      "source": "wotc"
    },
    {
