  "rulings": [
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "You can't cast a plotted card on the same turn it became plotted. On any future turn, you may cast that card from exile without paying its mana cost during your main phase while the stack is empty."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Spells that can't be countered can still be exiled by Aven Interrupter's triggered ability. They won't resolve."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Plot abilities are written \"Plot [cost],\" which means \"Any time you have priority during your main phase while the stack is empty, you may pay [cost] and exile this card from your hand. It becomes plotted.\""
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Exiling a card using its plot ability is a special action. Once you announce you're taking that action, no other player can respond by trying to remove that card from your hand."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If you're casting a plotted card from exile without paying its mana cost, you can't choose to cast it for any other alternative costs. You can, however, pay additional costs, such as kicker costs. If the plotted card has any mandatory additional costs, those must still be paid to cast the spell."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If a plotted card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If the plotted card's owner casts it, the spell has no relation to the spell that player originally cast. Any choices made for the original spell or effects affecting the original spell aren't carried over to the new one."
    },
    {
      "oracle_id": "d31fd12f-b4dd-4bc3-ace4-703dabd0f607",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If an instant or a card with flash is plotted this way, you can still cast it only when you have priority during your main phase while the stack is empty."
    },
    {
      "oracle_id": "1c747fe2-289e-492a-a846-aa77707e2dc3",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The mana value of a token that isn't a copy of another object is 0. A token that is a copy of another object has the same mana cost as that object."
    },
    {
      "oracle_id": "1c747fe2-289e-492a-a846-aa77707e2dc3",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A spell or ability that counters spells can still target Abrupt Decay. When that spell or ability resolves, Abrupt Decay won't be countered, but any additional effects of the countering spell or ability will still happen."
    },
    {
      "oracle_id": "1c747fe2-289e-492a-a846-aa77707e2dc3",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If a permanent has {X} in its mana cost, X is considered to be 0."
    },
    {
      "oracle_id": "1c747fe2-289e-492a-a846-aa77707e2dc3",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If you target a creature with ward, you may still pay the ward cost, but Abrupt Decay won't be countered even if you don't."
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""
    },
    {
      "oracle_id": "fa85c5a2-8e83-4624-a35a-a0bbf17ecbb4",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Twincast can copy any instant or sorcery spell, not just one with targets."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell has damage divided as it was cast, the division can't be changed, although the targets receiving that damage still can. The same is true of spells that distribute counters."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal)."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell that's copied is modal (that is, it says \"Choose one —\" or the like), the copy will have the same mode. A different mode can't be chosen."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell that's copied has an X whose value was determined as it was cast, the copy will have the same value of X."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The copy is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy will resolve before the original spell does."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You can't choose to pay any alternative or additional costs for the copy. However, effects based on any alternative or additional costs that were paid for the original spell are copied as though those same costs were paid for the copy."
    }
  ]
}
