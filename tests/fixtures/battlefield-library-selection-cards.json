  "rulings": [
    {
      "oracle_id": "07c82cde-f00d-4454-9df4-9286e344c9bb",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "If a card in a player's library has {X} in its mana cost, X is considered to be 0."
    },
    {
      "oracle_id": "07c82cde-f00d-4454-9df4-9286e344c9bb",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "The bonus Muxus gets is determined only as its last ability resolves. Once that happens, the bonus won't change later in the turn even if the number of Goblins you control changes."
    },
    {
      "oracle_id": "0bbcb563-09b3-499d-a9cc-3a6d7501dd81",
      "published_at": "2015-02-25",
      "source": "wotc",
      "comment": "Each of the creature cards can have mana value 3 or less. It's not the total mana value of the two cards."
    },
    {
      "oracle_id": "23320d55-80cb-4da3-a53c-8c75abdc8c8f",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "If the target card is an illegal target as Ignis Scientia's last ability resolves, it won't resolve and none of its effects will happen. You won't create a Food token even if the target card was a creature card."
    },
    {
      "oracle_id": "23320d55-80cb-4da3-a53c-8c75abdc8c8f",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "A Food token is an artifact token with \"{2}, {T}, Sacrifice this token: You gain 3 life.\""
    },
    {
      "oracle_id": "2faa8dc1-0370-458c-9aef-44f81a9b5cd5",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "Casting a Trap by paying its alternative cost doesn't change its mana cost or mana value. The only difference is the cost you actually pay."
    },
    {
      "oracle_id": "2faa8dc1-0370-458c-9aef-44f81a9b5cd5",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "Effects that increase or reduce the cost to cast a Trap will apply to whichever cost you chose to pay."
    },
    {
      "oracle_id": "2faa8dc1-0370-458c-9aef-44f81a9b5cd5",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "You may ignore a Trap's alternative cost condition and simply cast it for its normal mana cost. This is true even if its alternative cost condition has been met."
    },
    {
      "oracle_id": "2faa8dc1-0370-458c-9aef-44f81a9b5cd5",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If there are seven or fewer cards in your library, you'll look at all of them."
    },
    {
      "oracle_id": "892a83a0-a3cb-4cfb-9106-4008e4e75c0f",
      "published_at": "2025-04-04",
      "source": "wotc",
      "comment": "If a card in a library has {X} in its mana cost, X is 0 for the purpose of determining its mana value."
    },
    {
      "oracle_id": "96e5d4a1-e59f-4140-823f-a17e15ee5d8d",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "Aang, at the Crossroads's delayed triggered ability won't cause it to transform back into Aang, at the Crossroads if it has already transformed into Aang, Destined Savior, perhaps because several creatures left the battlefield in one turn."
    },
    {
      "oracle_id": "96e5d4a1-e59f-4140-823f-a17e15ee5d8d",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "Aang, at the Crossroads's delayed triggered ability triggers at the beginning of the next upkeep regardless of whose turn it is."
    },
    {
      "oracle_id": "b0060b32-b856-4ff7-a113-cec2dc8f8dc6",
      "published_at": "2014-09-20",
      "source": "wotc",
      "comment": "Because you’re not casting the creature cards, you can’t pay any additional or alternative costs. You can’t put the cards onto the battlefield face down."
    },
    {
      "oracle_id": "b0060b32-b856-4ff7-a113-cec2dc8f8dc6",
      "published_at": "2014-09-20",
      "source": "wotc",
      "comment": "You determine whether the ferocious ability applies before any creature cards are put onto the battlefield. If you put two creature cards onto the battlefield this way, those creatures enter the battlefield at the same time."
    },
    {
      "oracle_id": "b0060b32-b856-4ff7-a113-cec2dc8f8dc6",
      "published_at": "2014-09-20",
      "source": "wotc",
      "comment": "If a card you put onto the battlefield this way has {X} in its mana cost, X is considered to be 0."
    },
    {
      "oracle_id": "b0060b32-b856-4ff7-a113-cec2dc8f8dc6",
      "published_at": "2014-09-20",
      "source": "wotc",
      "comment": "Some ferocious abilities that appear on instants and sorceries use the word “instead.” These spells have an upgraded effect if you control a creature with power 4 or greater as they resolve. For these, you only get the upgraded effect, not both effects."
    },
    {
      "oracle_id": "b0060b32-b856-4ff7-a113-cec2dc8f8dc6",
      "published_at": "2014-09-20",
      "source": "wotc",
      "comment": "Ferocious abilities of instants and sorceries that don’t use the word “instead” will provide an additional effect if you control a creature with power 4 or greater as they resolve."
    },
    {
      "oracle_id": "b1a0ae56-77aa-43ad-9aa8-dc1ab779e9d9",
      "published_at": "2022-09-09",
      "source": "wotc",
      "comment": "Silverback Elder’s triggered ability resolves before the spell that caused it to trigger. The ability will resolve even if that spell is countered."
    },
    {
      "oracle_id": "cbad3570-5417-42e6-b3ef-f42194098314",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Discarding the card is part of the cost to activate a channel ability."
    },
    {
      "oracle_id": "cbad3570-5417-42e6-b3ef-f42194098314",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "If a channel ability requires a target, you may not activate it without a target just to discard the card."
    }
  ]
