  "rulings": [
    {
      "comment": "Destroying or unequipping the Echo Circlet after blockers have been declared will not undo any blocks made by the equipped creature.",
      "oracle_id": "17134950-fdb3-48d0-b541-419db673f4c9",
      "published_at": "2011-01-01",
      "source": "wotc"
    },
    {
      "comment": "Echo Circlet\u2019s effect is cumulative. If it equips a creature that can already block an additional creature, now it can block three creatures. The same is true if two Echo Circlets equip the same creature, for example.",
      "oracle_id": "17134950-fdb3-48d0-b541-419db673f4c9",
      "published_at": "2011-01-01",
      "source": "wotc"
    },
    {
      "comment": "The last ability is cumulative. If you control an additional Brave the Sands, your creatures will each be able to block three creatures, and so on.",
      "oracle_id": "4e89bd75-f59d-4f08-be51-5660fbbba3c2",
      "published_at": "2014-09-20",
      "source": "wotc"
    },
    {
      "comment": "High Ground allows you to make some complicated blocks. For example, if you\u2019re being attacked by three creatures (call them A, B, and C) and you control three creatures (X, Y, and Z), you can have X block A and B, Y block B and C, and Z block just C, among many other possible options. The defending player chooses how each blocking creature\u2019s combat damage will be divided among the creatures it\u2019s blocking.",
      "oracle_id": "b59053d5-b5f2-44aa-a29c-7f3908d86577",
      "published_at": "2007-07-15",
      "source": "wotc"
    },
    {
      "comment": "High Ground\u2019s effect is cumulative. If you have a creature that can already block an additional creature, now it can block three creatures.",
      "oracle_id": "b59053d5-b5f2-44aa-a29c-7f3908d86577",
      "published_at": "2007-07-15",
      "source": "wotc"
    },
    {
      "comment": "Abilities that allow a creature to block an additional creature are cumulative.",
      "oracle_id": "bc628018-f5d0-4bd2-91e7-ee4e4a5af9aa",
      "published_at": "2012-05-01",
      "source": "wotc"
    },
    {
      "comment": "The ability to block an additional creature is cumulative. If a creature is enchanted with two Iona\u2019s Blessings, it can block three creatures each combat. (The +2/+2 is also cumulative, but you knew that.)",
      "oracle_id": "fc5bde87-231e-424a-a8fa-cd9910a09d43",
      "published_at": "2016-01-22",
      "source": "wotc"
    }
