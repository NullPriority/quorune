  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Destroying or unequipping the Echo Circlet after blockers have been declared will not undo any blocks made by the equipped creature.",
      "oracle_id": "17134950-fdb3-48d0-b541-419db673f4c9",
      "published_at": "2011-01-01",
      "source": "wotc"
    },
    {
      "comment": "Echo Circlet\u2019s effect is cumulative. If it equips a creature that can already block an additional creature, now it can block three creatures. The same is true if two Echo Circlets equip the same creature, for example.",
      "oracle_id": "17134950-fdb3-48d0-b541-419db673f4c9",
      "published_at": "2011-01-01",
      "source": "wotc"
    },
    {
      "comment": "The last ability is cumulative. If you control an additional Brave the Sands, your creatures will each be able to block three creatures, and so on.",
      "oracle_id": "4e89bd75-f59d-4f08-be51-5660fbbba3c2",
      "published_at": "2014-09-20",
      "source": "wotc"
    },
    {
      "comment": "High Ground allows you to make some complicated blocks. For example, if you\u2019re being attacked by three creatures (call them A, B, and C) and you control three creatures (X, Y, and Z), you can have X block A and B, Y block B and C, and Z block just C, among many other possible options. The defending player chooses how each blocking creature\u2019s combat damage will be divided among the creatures it\u2019s blocking.",
      "oracle_id": "b59053d5-b5f2-44aa-a29c-7f3908d86577",
      "published_at": "2007-07-15",
      "source": "wotc"
    },
    {
      "comment": "High Ground\u2019s effect is cumulative. If you have a creature that can already block an additional creature, now it can block three creatures.",
      "oracle_id": "b59053d5-b5f2-44aa-a29c-7f3908d86577",
      "published_at": "2007-07-15",
      "source": "wotc"
    },
    {
      "comment": "Abilities that allow a creature to block an additional creature are cumulative.",
      "oracle_id": "bc628018-f5d0-4bd2-91e7-ee4e4a5af9aa",
      "published_at": "2012-05-01",
      "source": "wotc"
    },
    {
      "comment": "The ability to block an additional creature is cumulative. If a creature is enchanted with two Iona\u2019s Blessings, it can block three creatures each combat. (The +2/+2 is also cumulative, but you knew that.)",
      "oracle_id": "fc5bde87-231e-424a-a8fa-cd9910a09d43",
      "published_at": "2016-01-22",
      "source": "wotc"
    },
    {
      "oracle_id": "22517690-3ec1-49c9-951f-93eb3114423a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You can use the ability multiple times so it can block more than two creatures."
    },
    {
      "oracle_id": "22517690-3ec1-49c9-951f-93eb3114423a",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "This card now uses the Reach keyword ability to enable the blocking of flying creatures. This works because a creature with flying can only be blocked by creatures with flying or reach."
    },
    {
      "oracle_id": "25edb501-11b5-4617-8a65-2eb4869cccd5",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Act of Heroism can target an untapped creature. It still gets +2/+2 and can block an additional creature."
    },
    {
      "oracle_id": "25edb501-11b5-4617-8a65-2eb4869cccd5",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "You can cast Act of Heroism even if the target creature won't be able to block right away, perhaps because you're the attacking player."
    },
    {
      "oracle_id": "25edb501-11b5-4617-8a65-2eb4869cccd5",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Untapping an attacking creature doesn't remove it from combat."
    },
    {
      "oracle_id": "25edb501-11b5-4617-8a65-2eb4869cccd5",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "The effects of Act of Heroism are cumulative. If multiples resolve targeting the same creature, that creature can block that many additional creatures this turn."
    },
    {
      "oracle_id": "da95382c-0536-49aa-a0db-3b52926bf559",
      "published_at": "2013-09-15",
      "source": "wotc",
      "comment": "Coastline Chimera's activated ability is cumulative. Activating it a second time will allow it to block three creatures, and so on."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    }
  ],
