ess":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["Enchant"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}","name":"Sinister Possession","oracle_id":"6ee431f3-64ec-4015-8f5a-9c2ac6004ebd","oracle_text":"Enchant creature\nWhenever enchanted creature attacks or blocks, its controller loses 2 life.","power":null,"produced_mana":[],"released_at":"2013-05-03","toughness":null,"type_line":"Enchantment — Aura"},{"cmc":5.0,"color_identity":["R"],"colors":[],"defense":null,"keywords":["Devoid"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}{R}","name":"Turn Against","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","oracle_text":"Devoid (This card has no color.)\nGain control of target creature until end of turn. Untap that creature. It gains haste until end of turn.","power":null,"produced_mana":[],"released_at":"2015-10-02","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Defender"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Wall of Glare","oracle_id":"a59897cb-7ead-494a-a1d0-c9baf79bf18b","oracle_text":"Defender (This creature can't attack.)\nThis creature can block any number of creatures.","power":"0","produced_mana":[],"released_at":"1999-06-07","toughness":"5","type_line":"Creature — Wall"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"A card with devoid is just colorless. It’s not colorless and the colors of mana in its mana cost.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Cards with devoid use frames that are variations of the transparent frame traditionally used for Eldrazi. The top part of the card features some color over a background based on the texture of the hedrons that once imprisoned the Eldrazi. This coloration is intended to aid deckbuilding and game play.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Devoid works in all zones, not just on the battlefield.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Gaining control of a creature doesn’t cause you to gain control of any Auras or Equipment attached to it.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"If a card loses devoid, it will still be colorless. This is because effects that change an object’s color (like the one created by devoid) are considered before the object loses devoid.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Other cards and abilities can give a card with devoid color. If that happens, it’s just the new color, not that color and colorless.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Turn Against can target any creature, even one that’s untapped or one you already control.","oracle_id":"634d6357-af76-4e25-8c63-81522bc726f5","published_at":"2015-08-25","source":"wotc"},{"comment":"Carnage Gladiator’s ability triggers whenever any creature blocks, regardless of who controls that creature or which creature it blocked.","oracle_id":"7d8e20e5-6456-43f5-9188-263b54c0a923","published_at":"2017-03-14","source":"wotc"},{"comment":"If a creature can block multiple creatures and does so, Carnage Gladiator’s ability triggers only once.","oracle_id":"7d8e20e5-6456-43f5-9188-263b54c0a923","published_at":"2017-03-14","source":"wotc"},{"comment":"If you are the attacking creature's controller, you lose 2 life and gain 2 life. You won't lose the game if your life total is 0 in between these two events.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2020-04-17","source":"wotc"},{"comment":"Parasitic Impetus causes you to gain life, not the attacking creature's controller.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2020-04-17","source":"wotc"},{"comment":"Attacking with a goaded creature doesn't cause it to stop being goaded. If there is an additional combat phase that turn, or if another player gains control of it before it stops being goaded, it must attack again if able.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2023-06-30","source":"wotc"},{"comment":"Being goaded isn't an ability the creature has. Once it's been goaded, it must attack as detailed above even if it loses all abilities.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2023-06-30","source":"wotc"},{"comment":"If a creature you control has been goaded by multiple opponents, it must attack one of your opponents that hasn't goaded it, as that fulfills the maximum number of goad requirements. If a creature you control has been goaded by each of your opponents, the creature must attack an opponent (rather than a planeswalker or battle), but you choose which opponent it attacks.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2023-06-30","source":"wotc"},{"comment":"If the creature doesn't meet any of the above exceptions and can attack, it must attack a player other than the controller of the spell or ability that goaded it if able. If the creature can't attack any of those players but could otherwise attack, it must attack a planeswalker an opponent controls, a battle an opponent controls, or a player who goaded it.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2023-06-30","source":"wotc"},{"comment":"If, during a player's declare attackers step, a creature that player controls that's been goaded is tapped, is affected by a spell or ability that says it can't attack, or hasn't been under that player's control continuously since the turn began (and doesn't have haste), then it doesn't attack. If there's a cost associated with having a creature attack a player, its controller isn't forced to pay that cost, so it doesn't have to attack that player.","oracle_id":"ff3de07d-86c3-49e1-9de0-97c85301ff93","published_at":"2023-06-30","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
