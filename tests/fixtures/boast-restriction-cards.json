  "rulings": [
    {
      "oracle_id": "d0d4ab83-8b9b-49cd-86b8-720abd0550f4",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "A boast ability can be activated at any point after the creature with that ability has been declared as an attacker. This can be before blockers are declared, after blockers are declared but before combat damage is dealt, during combat after combat damage is dealt, during the postcombat main phase, during the end step, or, in some unusual cases, during the cleanup step."
    },
    {
      "oracle_id": "d0d4ab83-8b9b-49cd-86b8-720abd0550f4",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "You can activate Axgard Braggart's boast ability even if Axgard Braggart is already untapped. You'll still put a +1/+1 counter on it."
    },
    {
      "oracle_id": "d0d4ab83-8b9b-49cd-86b8-720abd0550f4",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "If an effect adds additional combat phases to a turn and a creature with a boast ability attacks more than once during that turn, its boast ability can still be activated only once."
    },
    {
      "oracle_id": "d0d4ab83-8b9b-49cd-86b8-720abd0550f4",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "If a creature with a boast ability is put onto the battlefield attacking, it was never declared as an attacker. Its boast ability can't be activated that turn."
    },
    {
      "oracle_id": "d0d4ab83-8b9b-49cd-86b8-720abd0550f4",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "If it's not your turn and you gain control of a creature with a boast ability after that creature attacked, you can activate that creature's boast ability if it hasn't been activated yet that turn."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."
    },
    {
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it."
    },
    {
      "oracle_id": "b9227f38-7db7-4ea1-9482-94e5de3984fe",
      "published_at": "2021-02-05",
