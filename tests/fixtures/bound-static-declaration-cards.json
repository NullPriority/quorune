land.","power":null,"produced_mana":[],"released_at":"2003-07-28","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["First strike"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}{B}","name":"Vampire Hexmage","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","oracle_text":"First strike\nSacrifice this creature: Remove all counters from target permanent.","power":"2","produced_mana":[],"released_at":"2020-08-07","toughness":"1","type_line":"Creature \u2014 Vampire Shaman"},{"cmc":4.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}","name":"Vedalken Orrery","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","oracle_text":"You may cast spells as though they had flash.","power":null,"produced_mana":[],"released_at":"2022-07-08","toughness":null,"type_line":"Artifact"},{"cmc":3.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":["Flying"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{U}","name":"Wind Drake","oracle_id":"d6ffdaf0-ac08-4de9-bbce-2eab2f86bcca","oracle_text":"Flying","power":"2","produced_mana":[],"released_at":"2016-09-30","toughness":"2","type_line":"Creature \u2014 Drake"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"A permanent is any object on the battlefield, including tokens and lands. Spells and emblems aren\u2019t permanents.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"Ascend on a permanent isn\u2019t a triggered ability and doesn\u2019t use the stack. Players can respond to a spell that will give you your tenth permanent, but they can\u2019t respond to you getting the city\u2019s blessing once you control that tenth permanent. This means that if your tenth permanent is a land you play, players can\u2019t respond before you get the city\u2019s blessing.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"Gaining the city\u2019s blessing after a Detective you control has become blocked won\u2019t cause that Detective to become unblocked.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"If you cast a spell with ascend, you don't get the city\u2019s blessing until it resolves. Players may respond to that spell by trying to change whether you get the city\u2019s blessing.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"If you control ten permanents but don\u2019t control a permanent or resolving spell with ascend, you don\u2019t get the city\u2019s blessing. For example, if you control ten permanents, lose control of two, then cast Detective of the Month, you won\u2019t have the city\u2019s blessing.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"If your tenth permanent enters the battlefield and then a permanent leaves the battlefield immediately afterwards (most likely due to the \u201clegend rule\u201d or due to being a creature with 0 toughness), you get the city\u2019s blessing before it leaves the battlefield.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"Once you have the city\u2019s blessing, you have it for the rest of the game, even if you lose control of some or all your permanents. The city\u2019s blessing isn\u2019t a permanent itself and can\u2019t be removed by any effect.","oracle_id":"10d1d6ca-95f8-48da-8798-37c8aadb1f1f","published_at":"2024-02-02","source":"wotc"},{"comment":"If, during a player's declare attackers step, a creature is tapped, is affected by a spell or ability that says it can't attack, or hasn't been under that player's control continuously since the turn began (and doesn't have haste), then it doesn't attack. If there's a cost associated with having a creature attack, the player isn't forced to pay that cost, so it doesn't have to attack in that case either.","oracle_id":"2fc6305e-e75e-478a-826b-49f655ed832c","published_at":"2011-09-22","source":"wotc"},{"comment":"Once a creature you control has become blocked, putting a +1/+1 counter on it won't cause it to become unblocked.","oracle_id":"366a218e-84d3-4cf9-bbc8-f2f8ecce92a3","published_at":"2017-09-29","source":"wotc"},{"comment":"The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2004-12-01","source":"wotc"},{"comment":"This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2010-06-15","source":"wotc"},{"comment":"The decision whether or not to tap or untap is made on resolution. This is not a modal spell.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"If the enchanted creature is both of the listed colors, it will get both bonuses.","oracle_id":"90d2e092-6eb8-4d13-bdad-19e7325a8b36","published_at":"2008-05-01","source":"wotc"},{"comment":"Effects that modify a creature's power and/or toughness, such as the effect of Bleeding Edge, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness.","oracle_id":"a9be16d1-5e53-4b85-8921-c6fe9473f923","published_at":"2019-05-03","source":"wotc"},{"comment":"If the affected creature gains an ability after Kasmina's Transmutation becomes attached to it, it will keep that ability.","oracle_id":"a9be16d1-5e53-4b85-8921-c6fe9473f923","published_at":"2019-05-03","source":"wotc"},{"comment":"Kasmina's Transmutation overwrites all previous effects that set the creature's base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Kasmina's Transmutation becomes attached to a creature will overwrite this effect.","oracle_id":"a9be16d1-5e53-4b85-8921-c6fe9473f923","published_at":"2019-05-03","source":"wotc"},{"comment":"Clue is an artifact type. Even though it appears on some cards with other permanent types, it's never a creature type, a land type, or anything but an artifact type.","oracle_id":"c206bdcb-d2c4-4bda-a979-6c0627ef8f73","published_at":"2024-02-02","source":"wotc"},{"comment":"If an effect refers to a Clue, it means any Clue artifact, not just a Clue artifact token. For example, you can sacrifice Wrench to pay for Alquist Proft, Master Sleuth's activated ability.","oracle_id":"c206bdcb-d2c4-4bda-a979-6c0627ef8f73","published_at":"2024-02-02","source":"wotc"},{"comment":"Some abilities trigger \"whenever you sacrifice a Clue\". Those abilities trigger whenever you sacrifice a Clue for any reason, not just to activate a Clue's activated ability.","oracle_id":"c206bdcb-d2c4-4bda-a979-6c0627ef8f73","published_at":"2024-02-02","source":"wotc"},{"comment":"Some spells and abilities that investigate may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't create any Clue tokens.","oracle_id":"c206bdcb-d2c4-4bda-a979-6c0627ef8f73","published_at":"2024-02-02","source":"wotc"},{"comment":"You can't sacrifice a Clue to pay multiple costs. For example, you can't sacrifice a Clue token to activate its own ability and also to activate Alquist Proft, Master Sleuth's ability.","oracle_id":"c206bdcb-d2c4-4bda-a979-6c0627ef8f73","published_at":"2024-02-02","source":"wotc"},{"comment":"Any permanent can be targeted by the second ability, not just one with counters on it.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"},{"comment":"Vampire Hexmage's ability can't target a permanent card in a zone other than the battlefield, such as a suspended card.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
