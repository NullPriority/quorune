  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "“Landwalk abilities” are abilities such as “forestwalk” or “legendary landwalk” that have “walk” in the name.",
      "oracle_id": "5d13386e-faac-4440-96c3-11c60872ceec",
      "published_at": "2006-05-01",
      "source": "wotc"
    },
    {
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "Aetherflame Wall can block creatures with shadow and creatures without shadow.",
      "oracle_id": "6bb24767-687e-4ff6-b7ac-3bf969f4dfeb",
      "published_at": "2006-09-25",
      "source": "wotc"
    },
    {
      "comment": "If Aetherflame Wall gains shadow, it won't be able to block any creatures (not even those with shadow).",
      "oracle_id": "6bb24767-687e-4ff6-b7ac-3bf969f4dfeb",
      "published_at": "2006-09-25",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.",
      "oracle_id": "6ccb3ac8-0509-431b-a196-d3cbf4fa80ae",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Multiple instances of shadow on the same creature are redundant.",
      "oracle_id": "6ccb3ac8-0509-431b-a196-d3cbf4fa80ae",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Once a creature has been blocked, that creature remains blocked and will deal and be dealt combat damage even if it gains or loses shadow or if the blocking creature gains or loses shadow.",
      "oracle_id": "6ccb3ac8-0509-431b-a196-d3cbf4fa80ae",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "The decision whether or not to tap or untap is made on resolution. This is not a modal spell.",
      "oracle_id": "773ad2ef-5acc-49ea-8d85-056330e87039",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.",
      "oracle_id": "773ad2ef-5acc-49ea-8d85-056330e87039",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "If the enchanted creature has shadow, it won’t be able to block any creatures (not even those with shadow).",
      "oracle_id": "97e7778f-971c-4425-8f6d-f4ff3fae000f",
      "published_at": "2006-09-25",
      "source": "wotc"
    },
    {
      "comment": "The enchanted creature can block creatures with shadow and creatures without shadow.",
      "oracle_id": "97e7778f-971c-4425-8f6d-f4ff3fae000f",
      "published_at": "2006-09-25",
      "source": "wotc"
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Masako allows tapped creatures to block only if they could otherwise block. It doesn’t allow creatures that “can’t block” to block, nonflying creatures to block fliers, etc.",
      "oracle_id": "bb9e77c0-eb94-4bba-9b71-1935be280b75",
      "published_at": "2004-12-01",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.",
      "oracle_id": "cb754749-a769-4c9c-b62b-4972dfc5069f",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Multiple instances of shadow on the same creature are redundant.",
      "oracle_id": "cb754749-a769-4c9c-b62b-4972dfc5069f",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Once a creature has been blocked, that creature remains blocked and will deal and be dealt combat damage even if it gains or loses shadow or if the blocking creature gains or loses shadow.",
      "oracle_id": "cb754749-a769-4c9c-b62b-4972dfc5069f",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.",
      "oracle_id": "f8c9cb9f-3a37-4004-9cde-f51ca5579e1a",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Multiple instances of shadow on the same creature are redundant.",
      "oracle_id": "f8c9cb9f-3a37-4004-9cde-f51ca5579e1a",
      "published_at": "2021-03-19",
      "source": "wotc"
