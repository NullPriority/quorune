  "rulings": [
    {
      "comment": "You can't choose multiple creature types, such as \"Cat Warrior.\" A Cat Warrior is both a Cat and a Warrior. It's affected by anything that affects either type and unaffected by things that affect non-Cat or non-Warrior creatures.",
      "oracle_id": "ccaa44f2-96be-44e2-884f-c31baa3908d5",
      "published_at": "2017-08-25",
      "source": "wotc"
    },
    {
      "comment": "Once Kindred Dominance begins to resolve, no players may take other actions until it's done. Notably, players can't try to save their creatures after you've chosen a creature type.",
      "oracle_id": "ccaa44f2-96be-44e2-884f-c31baa3908d5",
      "published_at": "2017-08-25",
      "source": "wotc"
    },
    {
      "comment": "You must choose an existing creature type, such as Vampire or Cat. Card types such as \"artifact\" can't be chosen.",
      "oracle_id": "ccaa44f2-96be-44e2-884f-c31baa3908d5",
      "published_at": "2017-08-25",
      "source": "wotc"
    },
    {
      "oracle_id": "25fc3bc2-d852-4f52-9adb-c7e35c06f3af",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "You must choose a creature type, such as Elf or Shaman. You can't choose other card types such as artifact or supertypes such as legendary."
    },
    {
      "oracle_id": "25fc3bc2-d852-4f52-9adb-c7e35c06f3af",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "The player whose turn it is chooses a creature type first, followed by each other player in turn order. Then, all creature cards that have one or more of the chosen types are returned to the battlefield at the same time."
    },
    {
      "oracle_id": "25fc3bc2-d852-4f52-9adb-c7e35c06f3af",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "Any player may choose a creature type that's already been chosen. Doing so won't affect which creature cards are returned to the battlefield."
    },
    {
      "oracle_id": "25fc3bc2-d852-4f52-9adb-c7e35c06f3af",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "Each player may choose any creature type, even if they don't have any creature cards of that type in their graveyard."
    }
  ],
