izard"},{"cmc":3.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{X}{2}{G}","name":"Tribal Unity","oracle_id":"6b4ee935-4474-4757-9fab-978a2e1e72a0","oracle_text":"Creatures of the creature type of your choice get +X/+X until end of turn.","power":null,"produced_mana":[],"released_at":"2009-09-04","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"It will trigger \"enters\" abilities and \"leaves the battlefield\" abilities. Note that the card does not go to the graveyard, so it will not trigger \"goes to the graveyard\" abilities.","oracle_id":"19ea326f-45ff-4bc0-a957-7d3f22dd8c6f","published_at":"2004-10-04","source":"wotc"},{"comment":"This could be used to make the target of another spell or ability illegal if this wasn't a sorcery (which makes it really hard to do that). This is because the Flickered permanent leaves the battlefield and then returns as a completely different permanent, and the targeted spell will not recognize it.","oracle_id":"19ea326f-45ff-4bc0-a957-7d3f22dd8c6f","published_at":"2004-10-04","source":"wotc"},{"comment":"This spell effectively \"resets\" the permanent to being just like it was freshly cast. All counters, Auras, effects, and so on are removed when it is exiled. Then it comes back onto the battlefield like new.","oracle_id":"19ea326f-45ff-4bc0-a957-7d3f22dd8c6f","published_at":"2005-08-01","source":"wotc"},{"comment":"The trigger occurs when you use the Morph ability to turn the card face up, or when an effect turns it face up. It will not trigger on being revealed or on leaving the battlefield.","oracle_id":"245934d9-c7b7-4a97-9c56-7760d934ef27","published_at":"2004-10-04","source":"wotc"},{"comment":"A spell or ability that counters spells can still target spells that can't be countered. When that spell or ability resolves, the uncounterable spell won't be countered, but any additional effects of the countering spell or ability will still happen.","oracle_id":"98295bdc-db58-4e1f-ad4c-63092aea207e","published_at":"2020-06-23","source":"wotc"},{"comment":"Allosaurus Shepherd's last ability overwrites all previous effects that set the affected creatures' power and/or toughness to specific values. Other effects that set these characteristics to specific values that start to apply after the ability resolves will overwrite that part of the effect.","oracle_id":"98295bdc-db58-4e1f-ad4c-63092aea207e","published_at":"2020-06-23","source":"wotc"},{"comment":"Effects that modify an affected creature's power or toughness without setting it will apply no matter when they started to take effect. The same is true for counters that change the creature's power or toughness.","oracle_id":"98295bdc-db58-4e1f-ad4c-63092aea207e","published_at":"2020-06-23","source":"wotc"},{"comment":"The affected creatures don't lose any abilities when they become Dinosaurs.","oracle_id":"98295bdc-db58-4e1f-ad4c-63092aea207e","published_at":"2020-06-23","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
