  "rulings": [
    {
      "comment": "The ability of this card does not do anything to stop Trample damage from being assigned to the defending player.",
      "oracle_id": "4d9d5dbb-25ab-41a5-a277-3ee5f9ef579b",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "You can use this ability as much as you want prior to damage being dealt.",
      "oracle_id": "4d9d5dbb-25ab-41a5-a277-3ee5f9ef579b",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "It is possible to redirect more damage to a creature than that creature\u2019s toughness.",
      "oracle_id": "4d9d5dbb-25ab-41a5-a277-3ee5f9ef579b",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "It can redirect damage to itself.",
      "oracle_id": "4d9d5dbb-25ab-41a5-a277-3ee5f9ef579b",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "When you redirect combat damage it is still combat damage.",
      "oracle_id": "4d9d5dbb-25ab-41a5-a277-3ee5f9ef579b",
      "published_at": "2013-07-01",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat.",
      "oracle_id": "8e0cea9c-3110-4728-9378-76849e33bb90",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "If you choose White, the enchanted creature will have Protection from White. This will cause any other white Auras attached to that creature to be put into their owner's graveyard, but Flickering Ward will remain on the battlefield.",
      "oracle_id": "3e2ae59a-40a1-46ca-8f24-3231ebd4e4eb",
      "published_at": "2009-10-01",
      "source": "wotc"
    }
  ],
