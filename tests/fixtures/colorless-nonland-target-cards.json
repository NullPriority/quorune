  "rulings": [
    {
      "oracle_id": "1c3b5d50-6b5c-49a3-b64b-5bee51d22725",
      "published_at": "2015-08-25",
      "source": "wotc",
      "comment": "Other cards and abilities can give a card with devoid color. If that happens, it’s just the new color, not that color and colorless."
    },
    {
      "oracle_id": "1c3b5d50-6b5c-49a3-b64b-5bee51d22725",
      "published_at": "2015-08-25",
      "source": "wotc",
      "comment": "If a card loses devoid, it will still be colorless. This is because effects that change an object’s color (like the one created by devoid) are considered before the object loses devoid."
    },
    {
      "oracle_id": "1c3b5d50-6b5c-49a3-b64b-5bee51d22725",
      "published_at": "2015-08-25",
      "source": "wotc",
      "comment": "Devoid works in all zones, not just on the battlefield."
    },
    {
      "oracle_id": "1c3b5d50-6b5c-49a3-b64b-5bee51d22725",
      "published_at": "2015-08-25",
      "source": "wotc",
      "comment": "Cards with devoid use frames that are variations of the transparent frame traditionally used for Eldrazi. The top part of the card features some color over a background based on the texture of the hedrons that once imprisoned the Eldrazi. This coloration is intended to aid deckbuilding and game play."
    },
    {
      "oracle_id": "1c3b5d50-6b5c-49a3-b64b-5bee51d22725",
      "published_at": "2015-08-25",
      "source": "wotc",
      "comment": "A card with devoid is just colorless. It’s not colorless and the colors of mana in its mana cost."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Gift of Tusks resolves, it will keep that ability."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Gift of Tusks doesn’t counter abilities that have already triggered or been activated. In particular, there is no way to cast this spell to stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "The creature will lose all other colors and creature types, but it will retain any other card types (such as artifact) or supertypes (such as legendary) it may have."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Gift of Tusks overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Gift of Tusks resolves will overwrite this effect."
    },
    {
      "oracle_id": "1962d9b3-f057-4d2c-9c5b-386d9a66148a",
      "published_at": "2018-09-11",
      "source": "scryfall",
      "comment": "This card preview was provided to Scryfall courtesy of Wizards of the Coast. Thank you!"
    }
  ]
