ghness":null,"type_line":"Artifact"},{"cmc":2.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":["Protection"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{G}","name":"Tel-Jilad Chosen","oracle_id":"de6854d1-bdb0-4b9a-b442-08d4d90a538d","oracle_text":"Protection from artifacts","power":"2","produced_mana":[],"released_at":"2003-10-02","toughness":"1","type_line":"Creature — Elf Warrior"},{"cmc":2.0,"color_identity":[],"colors":[],"defense":null,"keywords":["Equip"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}","name":"Throwing Knife","oracle_id":"c3973121-ed59-48b3-8efa-754a1b2c704d","oracle_text":"Equipped creature gets +2/+0.\nWhenever equipped creature attacks, you may sacrifice this Equipment. If you do, this Equipment deals 2 damage to any target.\nEquip {2} ({2}: Attach to target creature you control. Equip only as a sorcery.)","power":null,"produced_mana":[],"released_at":"2015-07-17","toughness":null,"type_line":"Artifact — Equipment"},{"cmc":3.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Equip"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{W}","name":"Thunder Lasso","oracle_id":"d98cc18b-6ebb-4f55-9d0d-b8fbe9a92bc1","oracle_text":"When this Equipment enters, attach it to target creature you control.\nEquipped creature gets +1/+1.\nWhenever equipped creature attacks, tap target creature defending player controls.\nEquip {2}","power":null,"produced_mana":[],"released_at":"2024-04-19","toughness":null,"type_line":"Artifact — Equipment"},{"cmc":2.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":["Enchant"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{R}","name":"Thunderous Might","oracle_id":"d08117ec-e6ec-4c63-91d4-1bda59446c54","oracle_text":"Enchant creature\nWhenever enchanted creature attacks, it gets +X/+0 until end of turn, where X is your devotion to red. (Each {R} in the mana costs of permanents you control counts toward your devotion to red.)","power":null,"produced_mana":[],"released_at":"2014-02-07","toughness":null,"type_line":"Enchantment — Aura"},{"cmc":3.0,"color_identity":[],"colors":[],"defense":null,"keywords":["Equip"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}","name":"Sword of Fire and Ice","oracle_id":"2ccdc60a-49a9-44b9-a7af-0ebf18b26785","oracle_text":"Equipped creature gets +2/+2 and has protection from red and from blue.\nWhenever equipped creature deals combat damage to a player, this Equipment deals 2 damage to any target and you draw a card.\nEquip {2}","power":null,"produced_mana":[],"released_at":"2020-08-07","toughness":null,"type_line":"Artifact — Equipment"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"An ability that triggers when something \"attacks and isn't blocked\" triggers in the declare blockers step after blockers are declared if (1) that creature is attacking and (2) no creatures are declared to block it. It will trigger even if that creature was put onto the battlefield attacking rather than having been declared as an attacker in the declare attackers step.","oracle_id":"10733767-1c97-4e2e-b02b-54bf346f6583","published_at":"2013-04-15","source":"wotc"},{"comment":"It triggers only once even if blocked by more than one creature.","oracle_id":"399af8ea-7a6f-4f43-bd39-dc29a6e75e06","published_at":"2004-10-04","source":"wotc"},{"comment":"Scry appears on some spells and abilities with one or more targets. If all of the spell or ability's targets are illegal when it tries to resolve, it won't resolve and none of its effects will happen. You won't scry.","oracle_id":"3378fef3-4d8c-4d9e-a338-4abb6f70d410","published_at":"2013-09-15","source":"wotc"},{"comment":"When you scry, you may put all the cards you look at back on top of your library, you may put all of those cards on the bottom of your library, or you may put some of those cards on top and the rest of them on the bottom.","oracle_id":"3378fef3-4d8c-4d9e-a338-4abb6f70d410","published_at":"2013-09-15","source":"wotc"},{"comment":"You choose how to order cards returned to your library after scrying no matter where you put them.","oracle_id":"3378fef3-4d8c-4d9e-a338-4abb6f70d410","published_at":"2013-09-15","source":"wotc"},{"comment":"You perform the actions stated on a card in sequence. For some spells and abilities, that means you'll scry last. For others, that means you'll scry and then perform other actions.","oracle_id":"3378fef3-4d8c-4d9e-a338-4abb6f70d410","published_at":"2013-09-15","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won't return to the battlefield.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"If you move Armory of Iroas from one creature to another, any +1/+1 counters on the first creature remain where they are.","oracle_id":"7ac1aab0-9d2d-4fb7-b0bb-0af3e6d665db","published_at":"2020-11-10","source":"wotc"},{"comment":"The +1/+1 counter is put on the equipped creature before combat damage is dealt.","oracle_id":"7ac1aab0-9d2d-4fb7-b0bb-0af3e6d665db","published_at":"2020-11-10","source":"wotc"},{"comment":"A creature attacks alone if it's the only creature declared as an attacker during the declare attackers step. For example, Bilbo's Ring's second ability won't trigger if you attack with multiple creatures and all but one of them are removed from combat.","oracle_id":"a7cc0f6b-6b17-4e76-b2a6-6a6ee2519b61","published_at":"2023-06-16","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"},{"comment":"A creature attacks alone if it's the only creature declared as an attacker during the declare attackers step (including creatures controlled by your teammates, if applicable). For example, Sigil of Valor's ability won't trigger if you attack with multiple creatures and all but one of them are removed from combat.","oracle_id":"b9447f25-f285-4b62-8976-4a49363dfdd7","published_at":"2015-06-22","source":"wotc"},{"comment":"Count the number of creatures you control other than the equipped creature as Sigil of Valor's ability resolves to determine the amount of the bonus. Once the ability resolves, the bonus won't change, even if the number of creatures you control does.","oracle_id":"b9447f25-f285-4b62-8976-4a49363dfdd7","published_at":"2015-06-22","source":"wotc"},{"comment":"When the equipped creature attacks alone, it causes both abilities to trigger.","oracle_id":"bc2ea8c8-5360-4256-91c5-d821b5e59c0f","published_at":"2021-07-23","source":"wotc"},{"comment":"Throwing Knife is the source of the damage dealt because of its triggered ability. For example, you could sacrifice Throwing Knife to deal 2 damage to a creature with protection from red, even if Throwing Knife is equipped to a red creature.","oracle_id":"c3973121-ed59-48b3-8efa-754a1b2c704d","published_at":"2015-06-22","source":"wotc"},{"comment":"Throwing Knife's triggered ability triggers before blockers are declared. If you use the ability and destroy the targeted creature with lethal damage, it won't be on the battlefield to block.","oracle_id":"c3973121-ed59-48b3-8efa-754a1b2c704d","published_at":"2015-06-22","source":"wotc"},{"comment":"Hybrid mana symbols, monocolored hybrid mana symbols, and Phyrexian mana symbols do count toward your devotion to their color(s).","oracle_id":"d08117ec-e6ec-4c63-91d4-1bda59446c54","published_at":"2013-09-15","source":"wotc"},{"comment":"If an activated ability or triggered ability has an effect that depends on your devotion to a color, you count the number of mana symbols of that color among the mana costs of permanents you control as the ability resolves. The permanent with that ability will be counted if it’s still on the battlefield at that time.","oracle_id":"d08117ec-e6ec-4c63-91d4-1bda59446c54","published_at":"2013-09-15","source":"wotc"},{"comment":"Mana symbols in the text boxes of permanents you control don’t count toward your devotion to any color.","oracle_id":"d08117ec-e6ec-4c63-91d4-1bda59446c54","published_at":"2013-09-15","source":"wotc"},{"comment":"Numeric mana symbols ({0}, {1}, and so on) in mana costs of permanents you control don’t count toward your devotion to any color.","oracle_id":"d08117ec-e6ec-4c63-91d4-1bda59446c54","published_at":"2013-09-15","source":"wotc"},{"comment":"If some of the targets become illegal for Ral's second ability, the original division of damage still applies, and the damage that would have been dealt to illegal targets isn't dealt at all.","oracle_id":"d7b10518-b6dc-4a39-881a-edd346034f28","published_at":"2018-10-05","source":"wotc"},{"comment":"You may target a creature that is already tapped with Thunder Lasso's third ability.","oracle_id":"d98cc18b-6ebb-4f55-9d0d-b8fbe9a92bc1","published_at":"2024-04-12","source":"wotc"},{"comment":"Heart-Piercer Bow (not the equipped creature) is the source of the triggered ability and the source of the damage. This means that a creature with protection from green may be targeted even if Heart-Piercer Bow is equipped to a green creature, but a creature with protection from artifacts may not.","oracle_id":"ebe9dad7-d74d-4fa8-b17a-88ff79209379","published_at":"2019-07-12","source":"wotc"},{"comment":"If a creature is attacking a planeswalker, the controller of that planeswalker is the defending player. If a creature is attacking a battle, the protector of that battle is the defending player.","oracle_id":"ebe9dad7-d74d-4fa8-b17a-88ff79209379","published_at":"2023-07-28","source":"wotc"},{"comment":"Kor Firewalker's triggered ability resolves before the red spell that caused it to trigger.","oracle_id":"fb37ff1c-7461-4a16-b27f-6eef0db937fe","published_at":"2018-03-16","source":"wotc"},{"comment":"If the chosen target is an illegal target by the time the triggered ability tries to resolve, the ability won't resolve. You won't draw a card.","oracle_id":"2ccdc60a-49a9-44b9-a7af-0ebf18b26785","published_at":"2020-08-07","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
