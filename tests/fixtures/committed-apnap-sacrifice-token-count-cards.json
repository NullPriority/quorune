yalty":null,"mana_cost":"{2}{B}{B}","name":"Leyline of the Void","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","oracle_text":"If this card is in your opening hand, you may begin the game with it on the battlefield.\nIf a card would be put into an opponent's graveyard from anywhere, exile it instead.","power":null,"produced_mana":[],"released_at":"2024-09-27","toughness":null,"type_line":"Enchantment"},{"cmc":0.0,"color_identity":["W"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Plains","oracle_id":"bc71ebf6-2056-41f7-be35-b2e5c34afa99","oracle_text":"({T}: Add {W}.)","power":null,"produced_mana":["W"],"released_at":"2026-11-13","toughness":null,"type_line":"Basic Land — Plains"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Rest in Peace","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","oracle_text":"When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.","power":null,"produced_mana":[],"released_at":"2024-04-19","toughness":null,"type_line":"Enchantment"},{"cmc":5.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}{B}","name":"Syphon Flesh","oracle_id":"bc7c3151-ad07-429a-8af8-e4f24b7d9f6b","oracle_text":"Each other player sacrifices a creature. You create a 2/2 black Zombie creature token for each creature sacrificed this way.","power":null,"produced_mana":[],"released_at":"2021-09-24","toughness":null,"type_line":"Sorcery"},{"cmc":6.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["Flying","Food"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}{B}{B}","name":"Voracious Fell Beast","oracle_id":"2e037c5e-3e07-4ffc-a388-7976459f6ff7","oracle_text":"Flying\nWhen this creature enters, each opponent sacrifices a creature of their choice. Create a Food token for each creature sacrificed this way. (It's an artifact with \"{2}, {T}, Sacrifice this token: You gain 3 life.\")","power":"4","produced_mana":[],"released_at":"2023-06-23","toughness":"4","type_line":"Creature — Drake Beast"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If Rest in Peace is destroyed by a spell, Rest in Peace will be exiled and then the spell will be put into its owner's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"If a card is discarded while Rest in Peace is on the battlefield, abilities that function when a card is discarded (such as madness) still work, even though that card never reaches a graveyard. In addition, spells or abilities that check the characteristics of a discarded card (such as Chandra Ablaze's first ability) can find that card in exile.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"While Rest in Peace is on the battlefield, abilities that trigger whenever a creature dies won't trigger because cards and tokens are never put into a player's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"Food is an artifact type. Even though it appears on some creatures, it's never a creature type.","oracle_id":"2e037c5e-3e07-4ffc-a388-7976459f6ff7","published_at":"2024-11-08","source":"wotc"},{"comment":"Whatever you do, don't eat the delicious cards.","oracle_id":"2e037c5e-3e07-4ffc-a388-7976459f6ff7","published_at":"2024-11-08","source":"wotc"},{"comment":"You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability.","oracle_id":"2e037c5e-3e07-4ffc-a388-7976459f6ff7","published_at":"2024-11-08","source":"wotc"},{"comment":"A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"If your opponent discards a card while you control Leyline of the Void, abilities that check whether a card is discarded (such as Hollow One, or a madness ability of the discarded card) still work, even though that card never reaches that player's graveyard. In addition, spells or abilities that check the characteristics of the discarded card can find that card in exile.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"Tokens can still die while Leyline of the Void is on the battlefield.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"While Leyline of the Void is on the battlefield, nontoken creatures your opponents control won't die. They'll be exiled instead. Abilities that would trigger when those creatures die won't trigger.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
