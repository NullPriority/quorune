  "rulings": [
    {
      "oracle_id": "5825997b-10d7-4a36-972c-a80ddd90b8ed",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If a permanent on the battlefield has {X} in its mana cost, X is 0 for the purpose of determining its mana value."
    },
    {
      "oracle_id": "5825997b-10d7-4a36-972c-a80ddd90b8ed",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If the target permanent is an illegal target by the time Feed the Swarm tries to resolve, the spell doesn't resolve. You don't lose any life. If the target is legal but not destroyed (most likely because it has indestructible), you do lose life."
    },
    {
      "oracle_id": "5825997b-10d7-4a36-972c-a80ddd90b8ed",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "The amount of life you lose is determined by the permanent's mana value as it last existed on the battlefield."
    },
    {
      "oracle_id": "afaef788-34d1-460b-b884-9d7ae6ddeb18",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "All creatures on the battlefield when Toxic Deluge resolves are affected. Ones that enter the battlefield or become creatures later in the turn are not."
    },
    {
      "oracle_id": "afaef788-34d1-460b-b884-9d7ae6ddeb18",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "If you cast Toxic Deluge without paying its mana cost, you'll still choose a value for X and pay X life. This is because it doesn't have {X} in its mana cost."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You can't attempt to use a dredge ability if you don't have enough cards in your library."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Once you've announced that you're applying a card's dredge ability to replace a draw, players can't take any actions until you've put that card into your hand and milled cards."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If an effect puts a card into your hand without specifically using the word \"draw,\" you're not drawing a card. Dredge can't replace this event."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If you're drawing multiple cards, each draw is performed one at a time. For example, if you're instructed to draw two cards and you replace the first draw with a dredge ability, another card with a dredge ability (including one that was milled by the first dredge ability) may be used to replace the second draw."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "One card draw can't be replaced by multiple dredge abilities."
    },
    {
      "oracle_id": "ac8fba34-512c-4f24-999a-ab72f1ce4acb",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Dredge can replace any card draw, not only the one during your draw step."
    }
  ],
  "source": "Pinned modal, targeted-removal, alternative-cost, announced-life and Dredge spell consumers."
}
