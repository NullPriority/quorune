  "rulings": [
    {
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If there are two Doubling Seasons on the battlefield, then the number of tokens or counters is four times the original number. If there are three on the battlefield, then the number of tokens or counters is eight times the original number, and so on."
    },
    {
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Battles will enter with double the normal number of defense counters."
    },
    {
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Everything that is specified by the effect creating the original token or tokens will also be true about the additional token or tokens created by Doubling Season's replacement effect. For example, if an effect tells you to create a token \"tapped and attacking,\" the additional tokens will also be tapped and attacking."
    },
    {
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Doubling Season affects permanents that enter with counters."
    },
    {
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Planeswalkers will enter with double the normal number of loyalty counters. However, if you activate an ability whose cost has you put loyalty counters on a planeswalker, the number you put on isn't doubled. This is because those counters are put on as a cost, not as an effect."
    },
    {
      "oracle_id": "22f1a4a4-c423-4d1c-8775-0ed604a9fa51",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the target of any of Deathrite Shaman's three abilities is an illegal target when that ability tries to resolve, it won't resolve and none of its effects will happen. You won't add mana, no opponent will lose life, or you won't gain life, as appropriate."
    },
    {
      "oracle_id": "22f1a4a4-c423-4d1c-8775-0ed604a9fa51",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Because the first ability requires a target, it is not a mana ability. It uses the stack and can be responded to."
    },
    {
      "oracle_id": "68715465-6cf9-4006-87e9-31f227fe9ed3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If you have two of these on the battlefield, the damage is multiplied by 4."
    },
    {
      "oracle_id": "68715465-6cf9-4006-87e9-31f227fe9ed3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The multiplied damage counts in all ways as if it came from the original source. Furnace of Rath is not the source."
    },
    {
      "oracle_id": "68715465-6cf9-4006-87e9-31f227fe9ed3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If a spell or ability damages multiple things, divide up the damage before applying this effect. This means you can’t normally end up with an odd amount of damage on something."
    },
    {
      "oracle_id": "68715465-6cf9-4006-87e9-31f227fe9ed3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The trample rules cause damage to be divided before it is doubled."
    },
    {
      "oracle_id": "68715465-6cf9-4006-87e9-31f227fe9ed3",
      "published_at": "2005-08-01",
      "source": "wotc",
      "comment": "If multiple effects modify how damage will be dealt, the player who would be dealt damage or the controller of the creature that would be dealt damage chooses the order to apply the effects. For example, Mending Hands says, “Prevent the next 4 damage that would be dealt to any target this turn.” Suppose a spell would deal 5 damage to a player who has cast Mending Hands targeting themselves. That player can either (a) prevent 4 damage first and then let Furnace of Rath double the remaining 1 damage, taking 2 damage, or (b) double the damage to 10 and then prevent 4 damage, taking 6 damage."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Worldwaker Helm's first ability applies to all kinds of artifact tokens that its controller creates, not just Map tokens."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If the copied token has {X} in its mana cost, X is 0. (Most tokens don't have a mana cost unless they're copying something else.)"
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "The additional Map token won't have any abilities the other tokens were created with. Anything else specified in the effect creating the token (such as tapped or \"Exile that token at end of combat\") applies to both the original tokens and the Map."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "You don't need to control the spell or ability that creates the tokens, but you do have to be the one creating the tokens for Worldwaker Helm's first ability to apply."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If the copied token is copying something else, then the new token enters the battlefield as whatever that token copied."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Any enters-the-battlefield abilities of the copied token will trigger when the token enters the battlefield. Any \"as [this permanent] enters the battlefield\" or \"[this permanent] enters the battlefield with\" abilities of the copied token will also work."
    },
    {
      "oracle_id": "9573c85a-e574-4b4e-aae0-2165c45fd27e",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "The new token created by Worldwaker Helm's last ability copies the original characteristics of the target token as stated by the effect that created the target token and nothing else (unless that token is copying something else; see below). It doesn't copy whether the target token is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."
    },
    {
      "oracle_id": "c232d974-9c65-4bce-b045-e5a7cc0c62e0",
      "published_at": "2019-08-23",
      "source": "wotc",
      "comment": "You can activate Idol of Oblivion's first ability even if the token you've created was created before Idol of Oblivion entered the battlefield or if the token has left the battlefield."
    },
    {
      "oracle_id": "ca204b66-8d0c-431a-8d34-282f7c2d17da",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "If a creature enters the battlefield under your control and gains haste, but then loses it before attacking, it won't be able to attack that turn. This means that you can't use one Lightning Greaves to allow two new creatures to attack in the same turn."
    },
    {
      "oracle_id": "ca204b66-8d0c-431a-8d34-282f7c2d17da",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "You can't simply unequip Equipment from a creature. If Lightning Greaves is attached to the only creature you control, you won't be able to attach other equipment to it (or target it with anything else) until you have another creature to which you can attach Lightning Greaves."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Each of these Equipment has a triggered ability that says \"Whenever a [creature type] creature enters, you may attach [this Equipment] to it.\" This triggers whenever any creature of the specified creature type enters, no matter who controls it. You may attach your Equipment to another player's creature this way, even though you can't do so with the equip ability."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Each of these Equipment has two subtypes listed on its type line. The first one is a creature type, which in this case is also a subtype of kindred. The second one is Equipment, which is a subtype of artifact."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "If you attach an Equipment you control to another player's creature, you retain control of the Equipment, but you don't control the creature. Only you can activate the Equipment's equip ability, and if the Equipment's ability triggers again, you choose whether to move the Equipment. Only the creature's controller can activate any activated abilities the Equipment grants to the creature, and \"you\" in any abilities granted to the creature refers to that player."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "While it appears only on cards that already have other card types, kindred is a card type and will be counted by effects that refer to the number of card types among cards in a zone."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "This cards was originally printed with the \"tribal\" card type. That card type has been replaced with \"kindred\". This change does not affect the gameplay function of this card."
    },
    {
      "oracle_id": "dae4815e-9025-4993-ab46-52a3f1a7219e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Kindred is a card type that allows noncreature cards to have creature types. For example, Echoes of Eternity is an Eldrazi (although not a creature) while on the battlefield and an Eldrazi card (although not a creature card) in zones other than the battlefield."
    },
    {
      "oracle_id": "8e0cea9c-3110-4728-9378-76849e33bb90",
      "published_at": "2012-07-01",
      "source": "wotc",
      "comment": "If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    },
    {
      "oracle_id": "234a734b-ba28-4f1b-9d01-3c3e7d516590",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "If the target is still legal as it resolves but the spell can't be countered for some reason, its controller will still create two Treasure tokens."
    },
    {
      "oracle_id": "234a734b-ba28-4f1b-9d01-3c3e7d516590",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "If the target is no longer legal as An Offer You Can't Refuse resolves, no Treasure tokens are created."
    }
  ]
}
