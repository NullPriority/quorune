  "rulings": [
    {
      "oracle_id": "180e1a7e-890d-477c-80a5-da8a5f2857b3",
      "published_at": "2016-09-20",
      "source": "wotc",
      "comment": "In a Two-Headed Giant game, Reckless Fireweaver's ability causes 2 damage total to be dealt to the opposing team."
    },
    {
      "oracle_id": "1e943e04-e213-4781-b1a7-935aad8790e1",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If multiple creatures enter the battlefield at one time, this ability triggers once for each of those creatures."
    },
    {
      "oracle_id": "55eca80c-dcd8-4c2f-aa0f-fb0aec7b80f7",
      "published_at": "2013-10-17",
      "source": "wotc",
      "comment": "Ophiomancer's ability checks if you control a Snake at the beginning of each upkeep. If you do, the ability won't trigger."
    },
    {
      "oracle_id": "55eca80c-dcd8-4c2f-aa0f-fb0aec7b80f7",
      "published_at": "2013-10-17",
      "source": "wotc",
      "comment": "If the ability does trigger, but you control a Snake when it tries to resolve, the ability will do nothing. No Snake token will be created."
    },
    {
      "oracle_id": "55eca80c-dcd8-4c2f-aa0f-fb0aec7b80f7",
      "published_at": "2013-10-17",
      "source": "wotc",
      "comment": "Ophiomancer's ability considers any creature you control with the creature type Snake, not just the tokens Ophiomancer creates."
    },
    {
      "oracle_id": "76b003e0-15af-4f22-bdf2-1ade5430964a",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If another creature you control dies at the same time as Zulaport Cutthroat, its ability triggers for that creature."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "If Scute Swarm leaves the battlefield before its triggered ability resolves, the token will still enter the battlefield as a copy of Scute Swarm, using Scute Swarm's copiable values from when it was last on the battlefield."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "The token copy will have Scute Swarm's ability. It will also be able to create copies of itself."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "The token copy won't copy counters or damage marked on Scute Swarm, nor will it copy other effects that have changed Scute Swarm's power, toughness, types, color, and so on. Normally, this means the token will simply be a Scute Swarm, but if any copy effects have affected the original Scute Swarm, the token will take those into account."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability triggers whenever a land you control enters for any reason. It triggers whenever you play a land, as well as whenever a spell or ability puts a land onto the battlefield under your control."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whenever a land you control enters, each landfall ability of the permanents you control will trigger. You can put them   on the stack in any order. The last ability you put on the stack will be the first one to resolve (As a result, you can have those abilities resolve in the order of your choosing.)."
    },
    {
      "oracle_id": "aa854d50-444c-49d9-bfb1-5476b33c1c0b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability doesn't trigger if a permanent already on the battlefield becomes a land."
    },
    {
      "oracle_id": "c450f6b7-bb2a-4b8c-aec7-d27555137b63",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability doesn't trigger if a permanent already on the battlefield becomes a land."
    },
    {
      "oracle_id": "c450f6b7-bb2a-4b8c-aec7-d27555137b63",
