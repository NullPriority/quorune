  "rulings": [
    {
      "oracle_id": "e49771ab-cabb-4a5f-aef3-a0ac8147e6bf",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The ability works even if you sacrifice your last swamp to activate it. It only checks for a swamp on activation."
    },
    {
      "oracle_id": "884260cf-b3f3-43a4-82b6-4f6a0b19cc75",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "You can activate Kuldotha Phoenix's ability only if it's in your graveyard."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "In a multiplayer game, if the owner of In the Trenches leaves the game, the exiled card will return to the battlefield. Because the one-shot effect that returns the card isn't an ability that goes on the stack, it won't cease to exist along with the leaving player's spells and abilities on the stack."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "The activated ability can only be activated once per game. If the ability is countered or otherwise fails to resolve after being activated, it can't be activated again."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "If a token is exiled, it ceases to exist. It won't be returned to the battlefield."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "If In the Trenches leaves the battlefield and later returns to the battlefield, it is a new object on the battlefield with no memory of the last time it was there. Its ability may be activated, even if it was activated a previous time it was on the battlefield."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "If In the Trenches leaves the battlefield before its activated ability resolves, the target permanent won't be exiled."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "The activated ability is a single ability that creates two one-shot effects: one that exiles the permanent when the ability resolves, and another that returns the exiled card to the battlefield immediately after In the Trenches leaves the battlefield."
    },
    {
      "oracle_id": "1612a08f-fc1f-45cf-ae03-5f021a46869d",
      "published_at": "2022-10-14",
      "source": "wotc",
      "comment": "Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to an exiled creature will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."
    },
    {
      "oracle_id": "76ae3779-c821-4cd3-8d0f-8c42d1206ce4",
      "published_at": "2019-01-25",
      "source": "wotc",
      "comment": "Damage dealt to a player causes that player to lose that much life."
    },
    {
      "oracle_id": "76ae3779-c821-4cd3-8d0f-8c42d1206ce4",
      "published_at": "2019-01-25",
      "source": "wotc",
      "comment": "In a multiplayer game, if an opponent loses life during your turn and then leaves the game, you can activate Gutterbones's ability."
    },
    {
      "oracle_id": "a1f55890-31c5-4ed4-a2cd-7a4a9f05f8ca",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If the spell Reverberate copies has an X whose value was determined as it was cast (like Earthquake does), the copy has the same value of X."
    },
    {
      "oracle_id": "a1f55890-31c5-4ed4-a2cd-7a4a9f05f8ca",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal)."
    },
    {
      "oracle_id": "a1f55890-31c5-4ed4-a2cd-7a4a9f05f8ca",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Reverberate can target (and copy) any instant or sorcery spell, not just one with targets. It doesn't matter who controls it."
    },
    {
      "oracle_id": "a1f55890-31c5-4ed4-a2cd-7a4a9f05f8ca",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "When Reverberate resolves, it creates a copy of a spell. You control the copy. That copy is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy will then resolve like a normal spell, after players get a chance to cast spells and activate abilities."
    },
    {
      "oracle_id": "a1f55890-31c5-4ed4-a2cd-7a4a9f05f8ca",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If the copy says that it affects \"you,\" it affects the controller of the copy, not the controller of the original spell. Similarly, if the copy says that it affects an \"opponent,\" it affects an opponent of the copy's controller, not an opponent of the original spell's controller."
    },
    {
