  "rulings": [
    {
      "oracle_id": "e740ce2f-2134-473c-afa1-1b6d2d1e38ef",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "This card now uses the Reach keyword ability to enable the blocking of flying creatures. This works because a creature with flying can only be blocked by creatures with flying or reach."
    },
    {
      "oracle_id": "365548fb-5acc-4a8a-b20b-26d28b7d029f",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "You must sacrifice exactly one creature to cast this spell; you can't cast it without sacrificing a creature, and you can't sacrifice additional creatures."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2010-06-15",
      "source": "wotc",
      "comment": "This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\"."
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "An ability that triggers when a creature “attacks while saddled” will trigger only if that creature was saddled when it was declared as an attacker.",
