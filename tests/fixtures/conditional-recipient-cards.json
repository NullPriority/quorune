  "rulings": [
    {
      "oracle_id": "beaf7a85-426a-4a33-80c8-33ad01614ad3",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "A “land creature” is a permanent that’s both a land and a creature."
    },
    {
      "oracle_id": "beaf7a85-426a-4a33-80c8-33ad01614ad3",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Damage remains marked on creatures until the turn ends. If Sylvan Advocate’s ability stops applying (because Sylvan Advocate leaves the battlefield or you no longer control six or more lands), then any land creatures that needed the toughness bonus to stay alive will be destroyed."
    },
    {
      "oracle_id": "502575f4-7c56-44bc-a77f-ae28d66c8e1f",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "Lieutenant abilities refer only to whether you control your commander, not any other player’s commander."
    },
    {
      "oracle_id": "502575f4-7c56-44bc-a77f-ae28d66c8e1f",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If a triggered ability granted by a lieutenant ability triggers, and in response to that trigger you lose control of your commander (causing the lieutenant to lose that ability), that triggered ability will still resolve."
    },
    {
      "oracle_id": "502575f4-7c56-44bc-a77f-ae28d66c8e1f",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "Lieutenant abilities apply only if your commander is on the battlefield and under your control."
    },
    {
      "oracle_id": "502575f4-7c56-44bc-a77f-ae28d66c8e1f",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If you gain control of a creature with a lieutenant ability owned by another player, that ability will check to see if you control your commander and will apply if you do. It won’t check whether its owner controls their commander."
    },
    {
      "oracle_id": "502575f4-7c56-44bc-a77f-ae28d66c8e1f",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If you lose control of your commander, lieutenant abilities of creatures you control will immediately stop applying. If this causes a creature’s toughness to become less than or equal to the amount of damage marked on it, the creature will be destroyed."
    },
    {
      "oracle_id": "f55334d9-1ec2-4667-bf28-5a0384d6f053",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "Lieutenant abilities apply only if your commander is on the battlefield and under your control."
    },
    {
      "oracle_id": "f55334d9-1ec2-4667-bf28-5a0384d6f053",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If you lose control of your commander, lieutenant abilities of creatures you control will immediately stop applying. If this causes a creature's toughness to become less than or equal to the amount of damage marked on it, the creature will be destroyed."
    },
    {
      "oracle_id": "f55334d9-1ec2-4667-bf28-5a0384d6f053",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If a triggered ability granted by a lieutenant ability triggers, and in response to that trigger you lose control of your commander (causing the lieutenant to lose that ability), that triggered ability will still resolve."
    },
    {
      "oracle_id": "f55334d9-1ec2-4667-bf28-5a0384d6f053",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "Lieutenant abilities refer only to whether you control your commander, not any other player's commander."
    },
    {
      "oracle_id": "f55334d9-1ec2-4667-bf28-5a0384d6f053",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If you gain control of a creature with a lieutenant ability owned by another player, that ability will check to see if you control your commander and will apply if you do. It won't check whether its owner controls their commander."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "7e8f5b34-fd16-4307-9104-17b584b25b14",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If Awakener Druid and the Treefolk are dealt lethal damage at the same time, both will be destroyed. However, if Awakener Druid leaves the battlefield before the Treefolk is dealt damage, it will immediately revert to being just a land and thus can't be dealt damage."
    },
    {
      "oracle_id": "7e8f5b34-fd16-4307-9104-17b584b25b14",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "Awakener Druid's ability affects a land with the land type Forest, not necessarily a land with the name Forest."
    },
    {
      "oracle_id": "7e8f5b34-fd16-4307-9104-17b584b25b14",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If the targeted Forest entered this turn, it will be affected by \"summoning sickness\" once it becomes a Treefolk. You won't be able to attack with it or use its activated abilities that have {T} in the cost (including its mana ability)."
    },
    {
      "oracle_id": "7e8f5b34-fd16-4307-9104-17b584b25b14",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "Awakener Druid's ability is mandatory. When it enters, you must target a Forest (if there is one), even if you don't control that Forest."
    },
    {
      "oracle_id": "7e8f5b34-fd16-4307-9104-17b584b25b14",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If Awakener Druid leaves the battlefield before its \"enters\" ability resolves, nothing happens to the targeted Forest when that ability resolves. It won't become a creature."
    },
    {
      "oracle_id": "6b3cc59a-7ea5-4eb5-9bf9-5a9c07f80e2b",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Although Mutavault has all creature types while it's animated, it does not have the changeling keyword ability."
    },
    {
      "oracle_id": "6b3cc59a-7ea5-4eb5-9bf9-5a9c07f80e2b",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "A noncreature permanent that turns into a creature can attack, and its {T} abilities can be activated, only if its controller has continuously controlled that permanent since the beginning of their most recent turn. It doesn't matter how long the permanent has been a creature."
    },
    {
      "oracle_id": "24227761-b50e-4b9e-93a2-e82d053b3e3d",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "Players can only respond once this spell has been cast and all its costs have been paid. No one can try to interfere with the creature you sacrificed to prevent you from casting this spell."
    },
    {
      "oracle_id": "24227761-b50e-4b9e-93a2-e82d053b3e3d",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "You must sacrifice exactly one creature to cast this spell; you can't cast it without sacrificing a creature, and you can't sacrifice additional creatures."
    },
    {
      "oracle_id": "24227761-b50e-4b9e-93a2-e82d053b3e3d",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Use the sacrificed creature's power as it last existed on the battlefield to determine how much damage Fling deals."
    },
    {
      "oracle_id": "30e99293-3212-4e3f-b543-b1c7c416575d",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "This has the supertype world. When a world permanent enters, any world permanents that were already on the battlefield are put into their owners' graveyards. This is a state-based action called the \"world rule.\" The new world permanent stays on the battlefield. If two world permanents enter at the same time, they're both put into their owners' graveyards."
    },
    {
      "oracle_id": "30e99293-3212-4e3f-b543-b1c7c416575d",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "A noncreature permanent that turns into a creature is subject to the \"summoning sickness\" rule: It can only attack, and its {T} abilities can only be activated, if its controller has continuously controlled that permanent since the beginning of their most recent turn."
    }
  ]
