  "rulings": [
    {
      "oracle_id": "3270265f-fa9f-4ef0-a1a3-a68fc2349bf1",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "If Iridescent Hornbeetle leaves the battlefield before your end step, its ability won’t trigger at all. You won’t create any tokens."
    },
    {
      "oracle_id": "3270265f-fa9f-4ef0-a1a3-a68fc2349bf1",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "If a creature enters the battlefield under your control with +1/+1 counters on it, Iridescent Hornbeetle’s ability counts those counters."
    },
    {
      "oracle_id": "3270265f-fa9f-4ef0-a1a3-a68fc2349bf1",
      "published_at": "2020-09-25",
      "source": "wotc",
      "comment": "Iridescent Hornbeetle’s ability counts the number of +1/+1 counters you’ve put on your creatures, even if that happened before Iridescent Hornbeetle was on the battlefield, and even if those creatures are no longer on the battlefield or under your control (and, in some rare cases, even if those creatures aren’t creatures anymore)."
    },
    {
      "comment": "You may choose the same creature for both targets. You may also choose two different creatures. This is because the word “target” is used twice.",
      "oracle_id": "d52e9255-62e7-479f-8def-e92b96efdb89",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "A card with devoid is just colorless. It’s not colorless and the colors of mana in its mana cost.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Cards with devoid use frames that are variations of the transparent frame traditionally used for Eldrazi. The top part of the card features some color over a background based on the texture of the hedrons that once imprisoned the Eldrazi. This coloration is intended to aid deckbuilding and game play.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Devoid works in all zones, not just on the battlefield.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Gaining control of a creature doesn’t cause you to gain control of any Auras or Equipment attached to it.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "If a card loses devoid, it will still be colorless. This is because effects that change an object’s color (like the one created by devoid) are considered before the object loses devoid.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Other cards and abilities can give a card with devoid color. If that happens, it’s just the new color, not that color and colorless.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Turn Against can target any creature, even one that’s untapped or one you already control.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    }
  ],
