ds":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{0}","name":"Memnite","oracle_id":"7663ac7c-1de3-4250-b96a-fae9dbd66a27","oracle_text":"","power":"1","produced_mana":[],"released_at":"2011-05-14","toughness":"1","type_line":"Artifact Creature — Construct"},{"cmc":2.0,"color_identity":["G","W"],"colors":["G","W"],"defense":null,"keywords":["Persist"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{G/W}","name":"Safehold Elite","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","oracle_text":"Persist (When this creature dies, if it had no -1/-1 counters on it, return it to the battlefield under its owner's control with a -1/-1 counter on it.)","power":"2","produced_mana":[],"released_at":"2018-12-07","toughness":"2","type_line":"Creature — Elf Scout"},{"cmc":4.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}","name":"Vedalken Orrery","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","oracle_text":"You may cast spells as though they had flash.","power":null,"produced_mana":[],"released_at":"2022-07-08","toughness":null,"type_line":"Artifact"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"You get the bonus if all of your creatures are white or artifact even if they also have other colors or qualities. So, if your only creature is a white and green creature, or a red artifact creature, you would get the bonus.","oracle_id":"3485109b-251f-4bef-a069-308031f47912","published_at":"2004-10-04","source":"wotc"},{"comment":"Affected creatures lose all other colors and are mono-black.","oracle_id":"5667376e-e59c-4b17-b096-5d92cdfe3db1","published_at":"2013-04-15","source":"wotc"},{"comment":"The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2004-12-01","source":"wotc"},{"comment":"This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2010-06-15","source":"wotc"},{"comment":"If a creature with persist stops being a creature, persist will still work.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"If a creature with persist that has +1/+1 counters on it receives enough -1/-1 counters to cause it to be destroyed by lethal damage or put into its owner’s graveyard for having 0 or less toughness, persist won’t trigger and the card won’t return to the battlefield. That’s because persist checks the creature’s existence just before it leaves the battlefield, and it still has all those counters on it at that point.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"If a permanent has multiple instances of persist, they’ll each trigger separately, but the redundant instances will have no effect. If one instance returns the card to the battlefield, the next to resolve will do nothing.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"If a token with no -1/-1 counters on it has persist, the ability will trigger when the token is put into the graveyard. However, the token will cease to exist and can’t return to the battlefield.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"If multiple creatures with persist are put into the graveyard at the same time (due to combat damage or a spell that destroys all creatures, for example), the active player (the player whose turn it is) puts all of their persist triggers on the stack in any order, then each other player in turn order does the same. The last trigger put on the stack is the first one that resolves. That means that in a two-player game, the nonactive player’s persist creatures will return to the battlefield first, then the active player’s persist creatures do the same. The creatures return to the battlefield one at a time.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"The persist ability triggers when the permanent is put into a graveyard. Its last known information (that is, how the creature last existed on the battlefield) is used to determine whether it had a -1/-1 counter on it.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"When a permanent with persist returns to the battlefield, it’s a new object with no memory of or connection to its previous existence.","oracle_id":"68ca91ba-31fb-47e0-9b32-e4f3504cbbca","published_at":"2013-06-07","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
