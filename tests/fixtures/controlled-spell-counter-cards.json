  "rulings": [
    {
      "oracle_id": "baf80db7-2ca8-4bfc-b5b6-25ed51878dd7",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A spell or ability counters a spell only if it specifically contains the word \"counter\" in its text. If a spell or ability you control causes all the targets of a spell to become illegal, that spell doesn't resolve but it's not countered."
    },
    {
      "oracle_id": "baf80db7-2ca8-4bfc-b5b6-25ed51878dd7",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The cost reduction applies only to generic mana in the cost of instant and sorcery spells you cast."
    },
    {
      "oracle_id": "baf80db7-2ca8-4bfc-b5b6-25ed51878dd7",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as a flashback cost), add any cost increases (such as kicker costs), then apply any cost reductions (such as that of Baral's first ability). The mana value of the spell is determined by only its mana cost, no matter what the total cost to cast that spell was."
    },
    {
      "oracle_id": "ece44a82-dcf0-4439-bdd9-a09c99a6f159",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "The token that a resolving copy of a spell becomes isn’t said to have been “created.”"
    },
    {
      "oracle_id": "ece44a82-dcf0-4439-bdd9-a09c99a6f159",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "If a creature spell is copied, it’s put onto the battlefield as a token as the spell resolves rather than putting the copy of the spell onto the battlefield. The rules that apply to a permanent spell becoming a permanent apply to a copy of a spell becoming a token."
    },
    {
      "comment": "An activated ability has a \"Cost: Effect\" format. Look for the colon. A triggered ability starts with \"when\", \"whenever\", or \"at\".",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "It can target delayed triggered abilities. For example, a card that says \"Whenever a player cycles a card, you may exile target creature. If you do, return that creature to the battlefield at the beginning of the end step.\" triggers when a player cycles a card and creates a delayed trigger that happens at the beginning of the end step. You can choose to target the \"at the beginning of the end step\" trigger when it is placed on the stack at end of turn.",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Turn-based actions and special actions like the normal card draw, combat damage, or turning a face-down creature face up can't be targeted.",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    }
  ]
