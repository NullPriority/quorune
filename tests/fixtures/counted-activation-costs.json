  "rulings": [
    {
      "oracle_id": "00225c40-27ff-410f-a591-5c788c6a2bd6",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "You can sacrifice Ruthless Knave to pay the cost for its first ability."
    },
    {
      "oracle_id": "00225c40-27ff-410f-a591-5c788c6a2bd6",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "The Treasures you sacrifice to activate Ruthless Knave's last ability can't also be sacrificed for mana."
    },
    {
      "oracle_id": "37445e06-88a1-4e2e-a432-383736c9b977",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "The two cards are exiled as the cost of Grim Lavamancer's ability is paid. Players can't respond to the paying of costs by trying to move those cards to another zone."
    },
    {
      "oracle_id": "0f3c3e5f-6af3-4af2-8703-4ccc8ed8f675",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "Because discarding two cards is an additional cost, you can't cast Cathartic Reunion if you don't have at least two other cards in hand."
    },
    {
      "oracle_id": "10a66403-606d-4814-9583-50cdcd6976e0",
      "published_at": "2019-01-25",
      "source": "wotc",
      "comment": "You must sacrifice exactly two creatures to cast Bankrupt in Blood; you can’t cast it without sacrificing two creatures, and you can’t sacrifice additional creatures."
    },
    {
      "oracle_id": "10a66403-606d-4814-9583-50cdcd6976e0",
      "published_at": "2019-01-25",
      "source": "wotc",
      "comment": "Players can respond only after Bankrupt in Blood has been cast and all its costs have been paid. No one can try to destroy the creatures you sacrificed to prevent you from casting this spell."
    },
    {
      "oracle_id": "c1161505-1623-4475-a88e-2e48072cc2f1",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The token Goblins can be sacrificed to the Warrens to generate new Goblins."
    },
    {
      "oracle_id": "8191342b-b25e-4c4d-8f69-aee662148ff4",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You may sacrifice Teysa itself to help pay for its first ability, but Teysa dying won't cause its second ability to trigger. Any other white and black creatures you sacrifice to pay for the first ability will cause the second ability to trigger."
    },
    {
      "oracle_id": "bdb94ccd-1bb5-4bb7-9539-e1b1c97c19c5",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "If Pashalik Mons and one or more other Goblins you control die at the same time, its ability will trigger for each of those creatures."
    },
    {
      "oracle_id": "bdb94ccd-1bb5-4bb7-9539-e1b1c97c19c5",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "You can sacrifice Pashalik Mons to pay the cost of its last ability."
    }
  ]
}
