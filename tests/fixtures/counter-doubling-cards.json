  "rulings": [
    {
      "oracle_id": "7bd36106-04fe-481f-b16e-e076dcbb183b",
      "published_at": "2013-07-01",
      "source": "wotc",
      "comment": "To double the number of +1/+1 counters on a creature, determine how many +1/+1 counters are on the creature and put that many more on it. Effects that interact with counters (such as the one created by Corpsejack Menace's ability) may change the number of counters ultimately put on the creature."
    },
    {
      "oracle_id": "559903cd-5cba-47a5-8b5b-7067e393e76a",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "To double the number of +1/+1 counters on a creature, put a number of +1/+1 counters on it equal to the number it already has. Other cards that interact with putting counters on it will interact with this effect accordingly."
    },
    {
      "oracle_id": "559903cd-5cba-47a5-8b5b-7067e393e76a",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "If Hydra's Growth leaves the battlefield before its enters-the-battlefield triggered ability resolves, the creature it last enchanted before it left gets the +1/+1 counter."
    },
    {
      "oracle_id": "5daac63a-1534-4194-8cb7-506508e364f4",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "To double the number of +1/+1 counters on a creature, put a number of +1/+1 counters on it equal to the number it already has. Other cards that interact with putting counters on it will interact with this effect accordingly."
    },
    {
      "oracle_id": "84122d81-9634-4d3f-85a5-f6cf4303691a",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If Mossborn Hydra somehow enters at the same time as one or more other lands you control, its last ability triggers for each of those lands."
    },
    {
      "oracle_id": "84122d81-9634-4d3f-85a5-f6cf4303691a",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability doesn't trigger if a permanent already on the battlefield becomes a land."
    },
    {
      "oracle_id": "84122d81-9634-4d3f-85a5-f6cf4303691a",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "To double the number of +1/+1 counters on Mossborn Hydra, put a number of +1/+1 counters on it equal to the number it already has. Other cards that interact with putting counters on it will interact with this effect accordingly."
    },
    {
      "oracle_id": "84122d81-9634-4d3f-85a5-f6cf4303691a",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whenever a land you control enters, each landfall ability of the permanents you control will trigger. You can put them \u00a0\u00a0on the stack in any order. The last ability you put on the stack will be the first one to resolve (As a result, you can have those abilities resolve in the order of your choosing.)."
    },
    {
      "oracle_id": "84122d81-9634-4d3f-85a5-f6cf4303691a",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability triggers whenever a land you control enters for any reason. It triggers whenever you play a land, as well as whenever a spell or ability puts a land onto the battlefield under your control."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one."
    },
    {
      "oracle_id": "1f250443-8d5e-46c9-920e-8e9373780e32",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "If The Millenium Calendar's last ability is countered or otherwise removed from the stack, it will just trigger again immediately if The Millenium Calendar still has 1,000 or more time counters on it."
    },
    {
      "oracle_id": "1f250443-8d5e-46c9-920e-8e9373780e32",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "The Millenium Calendar's first ability triggers during the untap step. However, since no player gets priority during the untap step, the ability waits to be put on the stack until the upkeep starts. At that time, any \"beginning of upkeep\" triggers will also trigger. Those abilities and The Millenium Calendar's ability are put onto the stack at that time."
    },
    {
      "oracle_id": "4022e540-8fa0-4eee-bcf1-df5046289f2b",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "\u201cDouble\u201d has its normal English meaning. If Solarion had three +1/+1 counters on it, it would end up with six +1/+1 counters on it."
    }
  ]
