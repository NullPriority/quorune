ss":"1","type_line":"Creature — Human Wizard Sorcerer"},{"cmc":4.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}","name":"Rod of Ruin","oracle_id":"c29a04ab-4e14-45d8-a993-3fffd0e2f6eb","oracle_text":"{3}, {T}: This artifact deals 1 damage to any target.","power":null,"produced_mana":[],"released_at":"2013-07-19","toughness":null,"type_line":"Artifact"},{"cmc":1.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{R}","name":"Shock","oracle_id":"a9d288b8-cdc1-4e55-a0c9-d6edfc95e65d","oracle_text":"Shock deals 2 damage to any target.","power":null,"produced_mana":[],"released_at":"2026-06-26","toughness":null,"type_line":"Instant"},{"cmc":7.0,"color_identity":["B","W"],"colors":["B","W"],"defense":null,"keywords":["Vigilance","Protection"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{5}{W}{B}","name":"Teysa, Envoy of Ghosts","oracle_id":"98b283dc-96a6-45a3-8a3f-11458497f358","oracle_text":"Vigilance, protection from creatures\nWhenever a creature deals combat damage to you, destroy that creature. Create a 1/1 white and black Spirit creature token with flying.","power":"4","produced_mana":[],"released_at":"2021-04-23","toughness":"4","type_line":"Legendary Creature — Human Advisor"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"The ability triggers whenever you're dealt any damage (not just combat damage) by any permanent (not just creatures). This includes permanents you control.","oracle_id":"35426427-4268-4c8f-9fe1-270f2ce43d97","published_at":"2011-01-01","source":"wotc"},{"comment":"Being untapped is a targeting restriction. If the target is tapped before this spell resolves, then this spell doesn’t resolve.","oracle_id":"3db9bf7b-da4e-428f-aa5d-a0cd1afeb16c","published_at":"2004-10-04","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won't return to the battlefield.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"Protection from creatures means that Teysa, Envoy of Ghosts can’t be the target of abilities of creatures or abilities of creature cards in other zones, such as bloodrush abilities. Teysa also can’t be blocked by creatures, and all damage that would be dealt to Teysa by creatures is prevented.","oracle_id":"98b283dc-96a6-45a3-8a3f-11458497f358","published_at":"2013-04-15","source":"wotc"},{"comment":"Teysa’s controller gets the Spirit creature token, not the controller of the creature that dealt combat damage.","oracle_id":"98b283dc-96a6-45a3-8a3f-11458497f358","published_at":"2013-04-15","source":"wotc"},{"comment":"Teysa’s last ability doesn’t target the creature. It will destroy a creature with hexproof or protection from white, for example.","oracle_id":"98b283dc-96a6-45a3-8a3f-11458497f358","published_at":"2013-04-15","source":"wotc"},{"comment":"You get a Spirit creature token even if Teysa’s triggered ability doesn’t destroy the creature (perhaps because it regenerated or has indestructible).","oracle_id":"98b283dc-96a6-45a3-8a3f-11458497f358","published_at":"2013-07-01","source":"wotc"},{"comment":"No Mercy’s ability triggers whenever any creature, including creatures you control, deals damage to you, not only combat damage.","oracle_id":"b9538d53-480b-481a-abbf-83ab17e1a45b","published_at":"2022-12-08","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
