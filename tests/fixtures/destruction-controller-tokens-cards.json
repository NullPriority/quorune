  "rulings": [
    {
      "comment": "Creatures destroyed this way count toward the life gained even if they're put into a zone other than a graveyard.",
      "oracle_id": "b17ea905-0696-4e58-b564-557e87236e27",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "You won't gain 1 life for a creature that isn't actually destroyed, such as a creature with indestructible.",
      "oracle_id": "b17ea905-0696-4e58-b564-557e87236e27",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If a permanent has indestructible, it isn’t destroyed this way and its controller won’t create a Centaur token for it. If it is destroyed but put into a zone other than a graveyard, its controller does create a Centaur token for it.",
      "oracle_id": "5dc34e93-97e3-434b-9f12-f45c6d556f13",
      "published_at": "2019-01-25",
      "source": "wotc"
    },
    {
      "comment": "All of the artifacts and enchantments that are destroyed leave the battlefield before any Centaurs are created, and their abilities can’t affect or trigger on these tokens entering the battlefield.",
      "oracle_id": "5dc34e93-97e3-434b-9f12-f45c6d556f13",
      "published_at": "2019-01-25",
      "source": "wotc"
    }
  ],
