  "rulings": [
    {
      "oracle_id": "5483f787-7aca-4efe-a39a-ea29f8c07f0d",
      "published_at": "2024-02-02",
      "source": "wotc",
      "comment": "You can sacrifice any creature you control that dealt damage this turn to pay Treacherous Greed's additional cost, even if the permanent it dealt damage to is no longer on the battlefield or the player it dealt damage to is no longer in the game."
    },
    {
      "comment": "If Triskelion has damage marked on it, activating its ability may cause that damage to become lethal. For example, say a Triskelion with two +1/+1 counters on it has been dealt 2 damage earlier in the turn. If you activate its ability by removing a +1/+1 counter from it, it now has 2 toughness and is destroyed as a state-based action. You won’t be able to remove the other +1/+1 counter from it to activate its ability again. The first activation of the ability will still resolve.",
      "oracle_id": "74f67dcf-5afb-45aa-8d4b-3cdb23f6f2a1",
      "published_at": "2022-12-08",
      "source": "wotc"
    },
    {
      "comment": "If you activate the ability of an attacking or blocking Triskelion during the declare blockers step, it will deal less combat damage as a result. If you wait until the combat damage step, but Triskelion is dealt lethal damage, it’ll be destroyed before you get a chance to activate its ability.",
      "oracle_id": "74f67dcf-5afb-45aa-8d4b-3cdb23f6f2a1",
      "published_at": "2022-12-08",
      "source": "wotc"
    },
    {
      "comment": "Casting a Trap by paying its alternative cost doesn't change its mana cost or mana value. The only difference is the cost you actually pay.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "Effects that increase or reduce the cost to cast a Trap will apply to whichever cost you chose to pay.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "Inferno Trap's alternative cost condition checks for any damage, not just combat damage.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "The alternative cost condition doesn't check who controlled the creatures that dealt damage to you. Damage dealt to you by your own creatures counts.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "The alternative cost condition is satisfied only if two different creatures dealt damage to you, not if one creature dealt damage to you twice. The damage may have been dealt to you simultaneously (as with combat damage), or at separate times.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "You may ignore a Trap's alternative cost condition and simply cast it for its normal mana cost. This is true even if its alternative cost condition has been met.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "comment": "You may target any creature, not just one that dealt damage to you this turn.",
      "oracle_id": "83a71000-942b-4472-9521-0e1070a3343b",
      "published_at": "2009-10-01",
      "source": "wotc"
    },
    {
      "oracle_id": "9d08af23-9f4a-4097-9abc-3b17475ab744",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Act of Treason can target any creature, even one that's untapped or one you already control."
    },
    {
      "oracle_id": "9d08af23-9f4a-4097-9abc-3b17475ab744",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    }
  ],
