mander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{G}","name":"Grizzly Bears","oracle_id":"14c8f55d-d177-4c25-a931-ebeb9e6062a0","oracle_text":"","power":"2","produced_mana":[],"released_at":"2007-07-13","toughness":"2","type_line":"Creature \u2014 Bear"},{"cmc":0,"color_identity":["W"],"colors":[],"keywords":[],"layout":"normal","legalities":{"commander":"legal"},"mana_cost":"","name":"Generic Bound Plains","oracle_id":"00000000-0000-4000-8000-000000000651","oracle_text":"({T}: Add {W}.)","produced_mana":["W"],"released_at":"2026-01-01","type_line":"Basic Land \u2014 Plains"},{"cmc":1.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{R}","name":"Magnetic Theft","oracle_id":"9b22cc97-003f-4227-acdc-7a0857674b67","oracle_text":"Attach target Equipment to target creature. (Control of the Equipment doesn't change.)","power":null,"produced_mana":[],"released_at":"2004-06-04","toughness":null,"type_line":"Instant"},{"cmc":3.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}","name":"Brass Squire","oracle_id":"5a10c3a5-6724-4e5a-ae4f-b27dde12735a","oracle_text":"{T}: Attach target Equipment you control to target creature you control.","power":"1","produced_mana":[],"released_at":"2020-11-20","toughness":"3","type_line":"Artifact Creature \u2014 Myr"},{"cmc":0.0,"color_identity":["U"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Island","oracle_id":"b2c6aa39-2d2a-459c-a555-fb48ba993373","oracle_text":"({T}: Add {U}.)","power":null,"produced_mana":["U"],"released_at":"2026-06-26","toughness":null,"type_line":"Basic Land \u2014 Island"}],"fixture_kind":"pinned-original-event-damage-dealers","rulings":[{"comment":"If lethal damage is dealt to the enchanted creature, Pain for All\u2019s last ability still triggers.","oracle_id":"4eedf21c-0ad1-48da-a9fe-2ffdbf8371e9","published_at":"2025-07-25","source":"wotc"},{"comment":"If the enchanted creature leaves the battlefield before Pain for All\u2019s second ability resolves, use its power as it last existed on the battlefield to determine how much damage is dealt.","oracle_id":"4eedf21c-0ad1-48da-a9fe-2ffdbf8371e9","published_at":"2025-07-25","source":"wotc"},{"comment":"If the enchanted creature is dealt damage by multiple sources at once, such as by two creatures blocking it, Pain for All\u2019s last ability triggers only once. When that triggered ability resolves, the enchanted creature deals damage equal to the total amount of damage dealt to it to each opponent.","oracle_id":"4eedf21c-0ad1-48da-a9fe-2ffdbf8371e9","published_at":"2025-07-25","source":"wotc"},{"comment":"A creature can be dealt an amount of damage greater than its toughness. For example, if the equipped creature has 1 toughness and is dealt 3 damage, it deals 3 damage, not 1, to the chosen target.","oracle_id":"46c77100-ab2e-43eb-b1cb-c22ed114213e","published_at":"2020-11-10","source":"wotc"},{"comment":"If your life total is brought to 0 or less at the same time that the equipped creature is dealt damage, you lose the game before Blazing Sunsteel's middle ability goes on the stack.","oracle_id":"46c77100-ab2e-43eb-b1cb-c22ed114213e","published_at":"2020-11-10","source":"wotc"},{"comment":"Blazing Sunsteel is the source of the middle triggered ability, but the equipped creature is the source of the damage. For example, if the equipped creature is green, that ability can't target a permanent with protection from red, but it can target one with protection from green, though the damage would be prevented.","oracle_id":"46c77100-ab2e-43eb-b1cb-c22ed114213e","published_at":"2020-11-10","source":"wotc"},{"comment":"Opponents who have left the game aren't counted by Blazing Sunsteel's first ability.","oracle_id":"46c77100-ab2e-43eb-b1cb-c22ed114213e","published_at":"2020-11-10","source":"wotc"},{"comment":"Abilities that Slivers grant, as well as power/toughness boosts, are cumulative. However, for some abilities, like indestructible and the ability granted by Belligerent Sliver, having more than one instance of the ability doesn\u2019t provide any additional benefit.","oracle_id":"e4fe33e7-b952-4152-8c83-81d948756d2f","published_at":"2014-07-18","source":"wotc"},{"comment":"If you change the creature type of a Sliver you control so it\u2019s no longer a Sliver, it will no longer be affected by its own ability. Its ability will continue to affect other Sliver creatures you control.","oracle_id":"e4fe33e7-b952-4152-8c83-81d948756d2f","published_at":"2014-07-18","source":"wotc"},{"comment":"Slivers in this set affect only Sliver creatures you control. They don\u2019t grant bonuses to your opponents\u2019 Slivers. This is the same way Slivers from the Magic 2014 core set worked, while Slivers in earlier sets granted bonuses to all Slivers.","oracle_id":"e4fe33e7-b952-4152-8c83-81d948756d2f","published_at":"2014-07-18","source":"wotc"},{"comment":"Damage dealt to a Sliver with indestructible is still marked on that creature. If it has lethal damage marked on it and it loses indestructible (perhaps because Sliver Hivelord leaves the battlefield), it will be destroyed.","oracle_id":"e4fe33e7-b952-4152-8c83-81d948756d2f","published_at":"2014-07-18","source":"wotc"},{"comment":"If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\"","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2021-03-19","source":"wotc"},{"comment":"When the card returns to the battlefield, it will be a new object with no connection to the card that was exiled. Auras attached to the exiled creature will be put into their owners' graveyards. Any Equipment will become unattached and remain on the battlefield. Any counters on the exiled creature will cease to exist.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2022-12-08","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won't return to the battlefield.","oracle_id":"a3ec6b5d-08ec-4ae0-b1db-c4b87a1849c7","published_at":"2022-12-08","source":"wotc"},{"comment":"If you Donate an Aura, it stays where it is, but the targeted player now controls it.","oracle_id":"049d1fb2-cce7-40e7-a633-e84cf9782d89","published_at":"2004-10-04","source":"wotc"},{"comment":"Whip of Erebos grants haste to the creature that's returned to the battlefield. However, neither of the \"exile\" abilities is granted to that creature. If that creature loses all its abilities, it will still be exiled at the beginning of the end step, and if it would leave the battlefield, it is still exiled instead.","oracle_id":"53987a39-c18c-4c13-b1ea-fd1b2a369f9e","published_at":"2013-09-15","source":"wotc"},{"comment":"At the beginning of the next end step, the creature returned to the battlefield with Whip of Erebos is exiled. This is a delayed triggered ability. If the ability is countered, the creature will stay on the battlefield and the delayed trigger won't trigger again. However, the replacement effect will still exile the creature when it eventually leaves the battlefield.","oracle_id":"53987a39-c18c-4c13-b1ea-fd1b2a369f9e","published_at":"2013-09-15","source":"wotc"},{"comment":"If a creature returned to the battlefield with Whip of Erebos would leave the battlefield for any reason, it's exiled instead. However, if that creature is already being exiled, then the replacement effect won't apply. If the spell or ability that exiles it later returns it to the battlefield (as Chained to the Rocks might, for example), the creature card will return to the battlefield as a new object with no relation to its previous existence. The effects from Whip of Erebos will no longer apply to it.","oracle_id":"53987a39-c18c-4c13-b1ea-fd1b2a369f9e","published_at":"2013-09-15","source":"wotc"},{"comment":"The exiled creature is never put into the graveyard. Any abilities the creature has that trigger when it dies won't trigger.","oracle_id":"53987a39-c18c-4c13-b1ea-fd1b2a369f9e","published_at":"2013-09-15","source":"wotc"},{"comment":"If there are fewer than twenty cards in the targeted player's library, that player puts all the cards from their library into their graveyard.","oracle_id":"cc2b6e58-2d6f-495e-95f3-9496105c4cba","published_at":"2009-10-01","source":"wotc"},{"comment":"If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat.","oracle_id":"8e0cea9c-3110-4728-9378-76849e33bb90","published_at":"2012-07-01","source":"wotc"},{"comment":"The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2004-12-01","source":"wotc"},{"comment":"This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2010-06-15","source":"wotc"},{"comment":"If a creature enters the battlefield under your control and gains haste, but then loses it before attacking, it won't be able to attack that turn. This means that you can't use one Lightning Greaves to allow two new creatures to attack in the same turn.","oracle_id":"ca204b66-8d0c-431a-8d34-282f7c2d17da","published_at":"2020-08-07","source":"wotc"},{"comment":"You can't simply unequip Equipment from a creature. If Lightning Greaves is attached to the only creature you control, you won't be able to attach other equipment to it (or target it with anything else) until you have another creature to which you can attach Lightning Greaves.","oracle_id":"ca204b66-8d0c-431a-8d34-282f7c2d17da","published_at":"2020-08-07","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"The decision whether or not to tap or untap is made on resolution. This is not a modal spell.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"Magnetic Theft can cause an Equipment one player controls to be attached to a creature another player controls. The controller of the Equipment can pay the equip cost to move the Equipment to a creature they control (but only any time that player could cast a sorcery).","oracle_id":"9b22cc97-003f-4227-acdc-7a0857674b67","published_at":"2004-12-01","source":"wotc"},{"comment":"Unlike the equip ability, Brass Squire's ability can be activated whenever you could cast an instant.","oracle_id":"5a10c3a5-6724-4e5a-ae4f-b27dde12735a","published_at":"2011-06-01","source":"wotc"},{"comment":"If one of the targets is illegal when the activated ability resolves, nothing will happen and the Equipment won't move. Notably, if an opponent gains control of either target in response, the Equipment won't move.","oracle_id":"5a10c3a5-6724-4e5a-ae4f-b27dde12735a","published_at":"2011-06-01","source":"wotc"}],"schema_version":1,"source":{"description":"Pinned Oracle/rulings; explicit synthetic basic-land deck fixture"}}
