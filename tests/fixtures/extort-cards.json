  "rulings": [
    {
      "comment": "The amount of life you gain from extort is based on the total amount of life lost, not necessarily the number of opponents you have. For example, if your opponent's life total can't change (perhaps because that player controls Platinum Emperion), you won't gain any life.",
      "oracle_id": "06b1fd96-a3ad-4ebd-9ea4-b3cfb4c9c43d",
      "published_at": "2024-01-12",
      "source": "wotc"
    },
    {
      "comment": "The extort ability doesn't target any player.",
      "oracle_id": "06b1fd96-a3ad-4ebd-9ea4-b3cfb4c9c43d",
      "published_at": "2024-01-12",
      "source": "wotc"
    },
    {
      "comment": "The extort ability resolves before the spell that caused it to trigger. The ability resolves even if that spell is countered.",
      "oracle_id": "06b1fd96-a3ad-4ebd-9ea4-b3cfb4c9c43d",
      "published_at": "2024-01-12",
      "source": "wotc"
    },
