ard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{R}","name":"Shock","oracle_id":"a9d288b8-cdc1-4e55-a0c9-d6edfc95e65d","oracle_text":"Shock deals 2 damage to any target.","power":null,"produced_mana":[],"released_at":"2026-06-26","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["First strike","Protection"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}{W}","name":"Silver Knight","oracle_id":"aa7cd6e6-35a6-4c18-9d66-dc2a95206401","oracle_text":"First strike, protection from red","power":"2","produced_mana":[],"released_at":"2011-04-01","toughness":"2","type_line":"Creature — Human Knight"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"It can redirect damage to itself.","oracle_id":"1245b165-e26f-4839-8468-2e95148fc6f6","published_at":"2004-10-04","source":"wotc"},{"comment":"It is possible to redirect more damage to a creature than that creature’s toughness.","oracle_id":"1245b165-e26f-4839-8468-2e95148fc6f6","published_at":"2004-10-04","source":"wotc"},{"comment":"The ability of this card does not do anything to stop Trample damage from being assigned to the defending player.","oracle_id":"1245b165-e26f-4839-8468-2e95148fc6f6","published_at":"2004-10-04","source":"wotc"},{"comment":"You can use this ability as much as you want prior to damage being dealt.","oracle_id":"1245b165-e26f-4839-8468-2e95148fc6f6","published_at":"2004-10-04","source":"wotc"},{"comment":"When you redirect combat damage it is still combat damage.","oracle_id":"1245b165-e26f-4839-8468-2e95148fc6f6","published_at":"2013-07-01","source":"wotc"},{"comment":"After Outrider en-Kor's activated ability has resolved, if multiple sources would deal damage to Outrider en-Kor simultaneously that turn (which can happen if Outrider en-Kor is blocked by multiple creatures, for example), you choose which source has its 1 damage redirected. If Outrider en-Kor's ability has resolved more than once that turn, you may choose a different source for each redirection effect.","oracle_id":"644b7aba-a7b8-4861-9e83-73329cf85be2","published_at":"2021-03-19","source":"wotc"},{"comment":"If the targeted creature leaves the battlefield after the activated ability resolves but before Outrider en-Kor would be dealt damage, the damage isn't redirected away from Outrider en-Kor. The same is true if the target is no longer a creature (or a planeswalker) at that time.","oracle_id":"644b7aba-a7b8-4861-9e83-73329cf85be2","published_at":"2021-03-19","source":"wotc"},{"comment":"The damage dealt to the target is dealt by the original source of damage, not by Outrider en-Kor.","oracle_id":"644b7aba-a7b8-4861-9e83-73329cf85be2","published_at":"2021-03-19","source":"wotc"},{"comment":"It can redirect damage to itself.","oracle_id":"b8d395a3-0bfe-45c3-bb3a-820d4f235b88","published_at":"2004-10-04","source":"wotc"},{"comment":"It is possible to redirect more damage to a creature than that creature's toughness.","oracle_id":"b8d395a3-0bfe-45c3-bb3a-820d4f235b88","published_at":"2004-10-04","source":"wotc"},{"comment":"The ability of this card does not do anything to stop Trample damage from being assigned to the defending player.","oracle_id":"b8d395a3-0bfe-45c3-bb3a-820d4f235b88","published_at":"2004-10-04","source":"wotc"},{"comment":"You can use this ability as much as you want prior to damage being dealt.","oracle_id":"b8d395a3-0bfe-45c3-bb3a-820d4f235b88","published_at":"2004-10-04","source":"wotc"},{"comment":"When you redirect combat damage it is still combat damage.","oracle_id":"b8d395a3-0bfe-45c3-bb3a-820d4f235b88","published_at":"2013-07-01","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won’t return to the battlefield.","oracle_id":"d5b9d250-92f5-40d8-b962-4ae4adb466c8","published_at":"2020-01-24","source":"wotc"},{"comment":"If an Aura is put onto the battlefield without being cast, the Aura’s controller-to-be chooses what it will enchant as it comes back onto the battlefield. An Aura put onto the battlefield this way doesn’t target anything (so it could be attached to an opponent’s permanent with hexproof, for example), but the Aura’s enchant ability restricts what it can be attached to. If the Aura can’t legally be attached to anything, it remains in its current zone.","oracle_id":"d5b9d250-92f5-40d8-b962-4ae4adb466c8","published_at":"2020-01-24","source":"wotc"},{"comment":"Once the exiled permanent returns, it’s considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners’ graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.","oracle_id":"d5b9d250-92f5-40d8-b962-4ae4adb466c8","published_at":"2020-01-24","source":"wotc"},{"comment":"It can redirect damage to itself.","oracle_id":"ef49dc78-9fd9-4cf8-af10-5a6b8ef7fc57","published_at":"2004-10-04","source":"wotc"},{"comment":"It is possible to redirect more damage to a creature than that creature’s toughness.","oracle_id":"ef49dc78-9fd9-4cf8-af10-5a6b8ef7fc57","published_at":"2004-10-04","source":"wotc"},{"comment":"The ability of this card does not do anything to stop Trample damage from being assigned to the defending player.","oracle_id":"ef49dc78-9fd9-4cf8-af10-5a6b8ef7fc57","published_at":"2004-10-04","source":"wotc"},{"comment":"You can use this ability as much as you want prior to damage being dealt.","oracle_id":"ef49dc78-9fd9-4cf8-af10-5a6b8ef7fc57","published_at":"2004-10-04","source":"wotc"},{"comment":"When you redirect combat damage it is still combat damage.","oracle_id":"ef49dc78-9fd9-4cf8-af10-5a6b8ef7fc57","published_at":"2013-07-01","source":"wotc"},{"comment":"It can redirect damage to itself.","oracle_id":"f066174a-a959-4365-920f-c04506d94a5a","published_at":"2004-10-04","source":"wotc"},{"comment":"It is possible to redirect more damage to a creature than that creature’s toughness.","oracle_id":"f066174a-a959-4365-920f-c04506d94a5a","published_at":"2004-10-04","source":"wotc"},{"comment":"The ability of this card does not do anything to stop Trample damage from being assigned to the defending player.","oracle_id":"f066174a-a959-4365-920f-c04506d94a5a","published_at":"2004-10-04","source":"wotc"},{"comment":"You can use this ability as much as you want prior to damage being dealt.","oracle_id":"f066174a-a959-4365-920f-c04506d94a5a","published_at":"2004-10-04","source":"wotc"},{"comment":"When you redirect combat damage it is still combat damage.","oracle_id":"f066174a-a959-4365-920f-c04506d94a5a","published_at":"2013-07-01","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
