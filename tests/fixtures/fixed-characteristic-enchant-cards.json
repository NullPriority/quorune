  "rulings": [
    {
      "oracle_id": "31c30c4f-12f4-4cbc-b7c1-123f36b8df75",
      "published_at": "2013-04-15",
      "source": "wotc",
      "comment": "If the enchanted creature's power increases to 4 or greater, Runner's Bane will be put into its owner's graveyard as a state-based action."
    },
    {
      "oracle_id": "31c30c4f-12f4-4cbc-b7c1-123f36b8df75",
      "published_at": "2013-04-15",
      "source": "wotc",
      "comment": "The enchanted creature can still be untapped in other ways, such as by Aurelia, the Warleader."
    },
    {
      "oracle_id": "55746bf4-86e0-489b-b9dc-eba5f5b401dd",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "Activated abilities contain a colon. They're generally written \u201c[Cost]: [Effect].\u201d Some keyword abilities are activated abilities and will have colons in their reminder text. Triggered abilities (starting with \u201cwhen,\u201d \u201cwhenever,\u201d or \u201cat\u201d) are unaffected by Trapped in the Tower."
    },
    {
      "oracle_id": "55746bf4-86e0-489b-b9dc-eba5f5b401dd",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "If the enchanted creature gains flying, Trapped in the Tower is put into your graveyard as a state-based action. The creature won't get stuck in the tower again when it loses flying."
    },
    {
      "oracle_id": "9d86735c-12e5-457a-beb4-057ab220d18b",
      "published_at": "2005-02-01",
      "source": "wotc",
      "comment": "Creatures on the battlefield treat {X} in their mana cost as 0 for the purposes of calculating mana values."
    },
    {
      "oracle_id": "9d86735c-12e5-457a-beb4-057ab220d18b",
      "published_at": "2005-02-01",
      "source": "wotc",
      "comment": "Threads of Disloyalty can't target a creature with mana value 3 or greater. If it somehow enchants a creature with mana value 3 or greater, Threads of Disloyalty is put into the graveyard the next time state-based actions are checked."
    },
    {
      "oracle_id": "9d86735c-12e5-457a-beb4-057ab220d18b",
      "published_at": "2005-02-01",
      "source": "wotc",
      "comment": "Tokens usually have a mana value of 0."
    },
    {
      "oracle_id": "f7518456-45ed-41d4-bd3c-5aacea28eb35",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "To work as an evasion ability, an attacking creature must already have flying when the declare blockers step begins. Once a creature has become blocked, giving it flying won\u2019t change that."
    }
  ]
}
