  "rulings": [
    {
      "oracle_id": "894a220b-1372-4a76-b38f-bf0d7001af41",
      "published_at": "2017-03-14",
      "source": "wotc",
      "comment": "The delayed triggered ability that exiles the token isn’t a characteristic of the token. If an effect such as populate copies the token, the new token won’t be exiled."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "Conspire represents both an additional cost and a triggered ability that triggers when you cast the spell if you paid that cost."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "Each creature you tap for conspire must share a color with Rally the Galadhrim For example, you could tap two green creatures, two blue creatures, or one of each. For either or both of the creatures, you may tap a multicolored creature that's green and/or blue, and possibly other colors as well."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If a spell with conspire has targets, you may choose new targets for the copy."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "Any enters-the-battlefield abilities of the copied creature will trigger when the token enters the battlefield. Any \"as [this creature] enters the battlefield\" or \"[this creature] enters the battlefield with\" abilities of the copied creature will also work."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "The triggered ability that creates the copy can itself be countered by anything that can counter a triggered ability. If it is countered, no copies will be put onto the stack."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If the copied creature is a token, the token that's created copies the original characteristics of that token as stated by the effect that created that token."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If the copied creature is copying something else, then the token enters the battlefield as whatever that creature copied."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "The token copies exactly what was printed on the original creature and nothing else (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "The copy that conspire creates is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If the copied creature has {X} in its mana cost, X is 0."
    },
    {
      "oracle_id": "84b2d0f6-ad98-4a71-a3d5-645b0f2db6c6",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with conspire won't affect the copy, and vice versa."
    },
    {
      "oracle_id": "09c96077-3804-4f12-a613-5bebc5e0413f",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It affects all players, including you."
    },
    {
      "oracle_id": "04e9ac31-3377-4a4c-9337-53ee0ada882a",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "If you use conspire to copy Traitor’s Roar, but you don’t change its target, the copy will resolve just fine but the original doesn’t resolve. That’s because the copy will resolve first, and as part of its resolution, it will tap the targeted creature. Then, when the original Traitor’s Roar tries to resolve, it will have an illegal target (since it must target an untapped creature)."
    },
    {
      "oracle_id": "223fa044-d387-4884-bf4e-75f1b61c6a46",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "\"You\" refers to the controller of Curiosity, which may be different from the controller of the enchanted creature. \"An opponent\" refers to an opponent of Curiosity's controller."
    },
    {
      "oracle_id": "223fa044-d387-4884-bf4e-75f1b61c6a46",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "Any damage dealt by the enchanted creature to an opponent will cause Curiosity to trigger, not just combat damage."
    },
    {
      "oracle_id": "223fa044-d387-4884-bf4e-75f1b61c6a46",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "Curiosity doesn't trigger if the enchanted creature deals damage to a planeswalker or to a battle."
    },
    {
      "oracle_id": "223fa044-d387-4884-bf4e-75f1b61c6a46",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "You draw one card each time the enchanted creature deals damage to an opponent, no matter how much damage it deals."
    },
    {
      "oracle_id": "223fa044-d387-4884-bf4e-75f1b61c6a46",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If you control Curiosity and it's enchanting an opponent's creature, you won't draw a card when that creature deals damage to you. The creature has to deal damage to one of your opponents for the ability to trigger."
    }
  ]
}
