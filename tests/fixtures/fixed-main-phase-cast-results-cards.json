name":"Twincast","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","oracle_text":"Copy target instant or sorcery spell. You may choose new targets for the copy.","power":null,"produced_mana":[],"released_at":"2009-07-17","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":3.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{G}","name":"Garruk's Uprising","oracle_id":"3127ae9b-a7a7-43ec-89d7-688f8445b33d","oracle_text":"When this enchantment enters, if you control a creature with power 4 or greater, draw a card.\nCreatures you control have trample. (Each of those creatures can deal excess combat damage to the player or planeswalker it's attacking.)\nWhenever a creature you control with power 4 or greater enters, draw a card.","power":null,"produced_mana":[],"released_at":"2026-01-23","toughness":null,"type_line":"Enchantment"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"faces":[],"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Disenchant","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","oracle_text":"Destroy target artifact or enchantment.","power":null,"produced_mana":[],"released_at":"2024-11-15","toughness":null,"type_line":"Instant"},{"cmc":4.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{W}{W}","name":"Return to Dust","oracle_id":"3029df1d-d02a-4fed-8ab4-000a2096f823","oracle_text":"Exile target artifact or enchantment. If you cast this spell during your main phase, you may exile up to one other target artifact or enchantment.","power":null,"produced_mana":[],"released_at":"2024-09-27","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If a spell or ability copies Careful Consideration, the target player discards three cards for the copy after drawing four cards. This is because the copy wasn't cast at all.","oracle_id":"2b34b361-7b0e-4464-874c-ceb501bc5ecc","published_at":"2021-03-19","source":"wotc"},{"comment":"Aethersnatch can target any spell, even one without targets.","oracle_id":"45892ec2-8996-444f-a61c-5151926baa0b","published_at":"2015-11-04","source":"wotc"},{"comment":"Combat damage dealt by a commander is tracked without regard to who controlled the commander at the time it dealt damage. For example, say a commander deals 10 combat damage to a player, leaves the battlefield, is recast, and you gain control of it with Aethersnatch. If it deals another 11 combat damage to that same player, they will lose the game.","oracle_id":"45892ec2-8996-444f-a61c-5151926baa0b","published_at":"2015-11-04","source":"wotc"},{"comment":"If you gain control of a commander spell, the commander’s owner chooses whether to put it in the command zone if it later leaves the battlefield.","oracle_id":"45892ec2-8996-444f-a61c-5151926baa0b","published_at":"2015-11-04","source":"wotc"},{"comment":"If you gain control of an instant or sorcery spell, it will be put into its owner’s graveyard as it resolves.","oracle_id":"45892ec2-8996-444f-a61c-5151926baa0b","published_at":"2015-11-04","source":"wotc"},{"comment":"You may change any or none of the spell’s targets. If you change a target, you must choose a legal target for the spell. If you can’t, you must leave the target unchanged (even if the current target is illegal). Notably, if you were originally chosen as a “target opponent” for a spell you gain control with Aethersnatch, you are now an illegal target as you aren’t your own opponent.","oracle_id":"45892ec2-8996-444f-a61c-5151926baa0b","published_at":"2015-11-04","source":"wotc"},{"comment":"If the spell has damage divided as it was cast, the division can't be changed, although the targets receiving that damage still can. The same is true of spells that distribute counters.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"If the spell that's copied has an X whose value was determined as it was cast, the copy will have the same value of X.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"If the spell that's copied is modal (that is, it says \"Choose one —\" or the like), the copy will have the same mode. A different mode can't be chosen.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"The copy is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy will resolve before the original spell does.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal).","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"Twincast can copy any instant or sorcery spell, not just one with targets.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"You can't choose to pay any alternative or additional costs for the copy. However, effects based on any alternative or additional costs that were paid for the original spell are copied as though those same costs were paid for the copy.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"Addendum abilities of instant spells apply while the spell is resolving, not immediately after casting it. If the spell is countered, you don't get the addendum bonus.","oracle_id":"ae198ce9-097b-4204-b599-12bdb36f5195","published_at":"2024-01-12","source":"wotc"},{"comment":"If an effect copies a spell with an addendum ability while it's on the stack, the copy wasn't cast at all, so you won't get the addendum bonus.","oracle_id":"ae198ce9-097b-4204-b599-12bdb36f5195","published_at":"2024-01-12","source":"wotc"},{"comment":"If an effect copies Might of Old Krosa while it's on the stack, the copy will give the creature only +2/+2, even if the original spell was cast during your main phase. This is because the copy is created on the stack and wasn't cast at all.","oracle_id":"b50a6db0-16ce-4e98-afbd-ec37e1653e7c","published_at":"2021-03-19","source":"wotc"},{"comment":"If one or more static abilities that apply to a creature entering change its power, those abilities are considered when determining whether Garruk's Uprising's last ability triggers. The same is true for replacement effects that apply to it, such as entering with one or more +1/+1 counters or entering as a copy of another creature.","oracle_id":"3127ae9b-a7a7-43ec-89d7-688f8445b33d","published_at":"2024-11-08","source":"wotc"},{"comment":"If you don't control a creature with power 4 or greater immediately after Garruk's Uprising enters, its first ability won't trigger. If you don't control one as the ability resolves, you don't draw a card. They don't have to be the same creature both times, however.","oracle_id":"3127ae9b-a7a7-43ec-89d7-688f8445b33d","published_at":"2024-11-08","source":"wotc"},{"comment":"Once the last ability of Garruk's Uprising has triggered, lowering the power of the creature or removing it from the battlefield won't stop you from drawing a card.","oracle_id":"3127ae9b-a7a7-43ec-89d7-688f8445b33d","published_at":"2024-11-08","source":"wotc"},{"comment":"The first ability of Garruk's Uprising has you draw just one card, no matter how many creatures you control with power 4 or greater.","oracle_id":"3127ae9b-a7a7-43ec-89d7-688f8445b33d","published_at":"2024-11-08","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"},{"comment":"Return to Dust can always target a second artifact or enchantment; it just won't exile it if it's not your main phase when you cast Return to Dust.","oracle_id":"3029df1d-d02a-4fed-8ab4-000a2096f823","published_at":"2021-03-19","source":"wotc"},{"comment":"If a spell or ability copies Return to Dust, the copy exiles only the first target artifact or enchantment. This is because the copy wasn't cast at all.","oracle_id":"3029df1d-d02a-4fed-8ab4-000a2096f823","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
