na_cost":"{G}","name":"Tail Swipe","oracle_id":"525d98d6-b117-44f4-b19c-3dd26e7c9fd4","oracle_text":"Choose target creature you control and target creature you don't control. If you cast this spell during your main phase, the creature you control gets +1/+1 until end of turn. Then those creatures fight each other. (Each deals damage equal to its power to the other.)","power":null,"produced_mana":[],"released_at":"2022-09-09","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}{U}","name":"Twincast","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","oracle_text":"Copy target instant or sorcery spell. You may choose new targets for the copy.","power":null,"produced_mana":[],"released_at":"2009-07-17","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Addendum abilities of instant spells apply while the spell is resolving, not immediately after casting it. If the spell is countered, you don't get the addendum bonus.","oracle_id":"275d0b90-a8d6-4388-b7db-34615287f532","published_at":"2024-01-12","source":"wotc"},{"comment":"If an effect copies a spell with an addendum ability while it's on the stack, the copy wasn't cast at all, so you won't get the addendum bonus.","oracle_id":"275d0b90-a8d6-4388-b7db-34615287f532","published_at":"2024-01-12","source":"wotc"},{"comment":"If the spell has damage divided as it was cast, the division can't be changed, although the targets receiving that damage still can. The same is true of spells that distribute counters.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"If the spell that's copied has an X whose value was determined as it was cast, the copy will have the same value of X.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"If the spell that's copied is modal (that is, it says \"Choose one —\" or the like), the copy will have the same mode. A different mode can't be chosen.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"The copy is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy will resolve before the original spell does.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal).","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"Twincast can copy any instant or sorcery spell, not just one with targets.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"},{"comment":"You can't choose to pay any alternative or additional costs for the copy. However, effects based on any alternative or additional costs that were paid for the original spell are copied as though those same costs were paid for the copy.","oracle_id":"8f878efc-850f-43d2-a6fe-5ea8d1dd5afb","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
