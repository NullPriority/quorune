ords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{W}","name":"Solitary Confinement","oracle_id":"d41ab41d-07c8-4f6d-be5e-7aec9f5f6365","oracle_text":"At the beginning of your upkeep, sacrifice this enchantment unless you discard a card.\nSkip your draw step.\nYou have shroud. (You can't be the target of spells or abilities.)\nPrevent all damage that would be dealt to you.","power":null,"produced_mana":[],"released_at":"2021-06-18","toughness":null,"type_line":"Enchantment"},{"cmc":9.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{6}{R}{R}{R}","name":"Worldfire","oracle_id":"ae0b8c13-0a71-4a60-bf9f-6e2da9503e9c","oracle_text":"Exile all permanents. Exile all cards from all hands and graveyards. Each player's life total becomes 1.","power":null,"produced_mana":[],"released_at":"2012-07-13","toughness":null,"type_line":"Sorcery"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"The cycling ability and the triggered ability are separate. If the triggered ability doesn't resolve (because, for example, it has been countered, or all of its targets have become illegal), the cycling ability will still resolve, and you'll draw a card.","oracle_id":"6679b462-3c90-418c-8727-acd1a61d988b","published_at":"2022-12-08","source":"wotc"},{"comment":"When you cycle this card, first the cycling ability goes on the stack, then the triggered ability goes on the stack on top of it. The triggered ability will resolve before you draw a card from the cycling ability.","oracle_id":"6679b462-3c90-418c-8727-acd1a61d988b","published_at":"2022-12-08","source":"wotc"},{"comment":"If your life total is greater than 1 when Worldfire resolves, the change in life total will count as life loss. Other effects that interact with life loss will interact with this effect accordingly.","oracle_id":"ae0b8c13-0a71-4a60-bf9f-6e2da9503e9c","published_at":"2012-07-01","source":"wotc"},{"comment":"These actions are performed in order, but no triggered abilities resolve in between them and no player may cast spells or activate abilities in between them. This means that if a permanent’s ability triggers on a player losing life, that permanent will be exiled first and won’t be on the battlefield when your life total becomes 1. Leaves-the-battlefield triggers won’t resolve until you’re done resolving Worldfire entirely.","oracle_id":"ae0b8c13-0a71-4a60-bf9f-6e2da9503e9c","published_at":"2012-07-01","source":"wotc"},{"comment":"Worldfire won’t be exiled. It will go to your graveyard as the final part of its resolution.","oracle_id":"ae0b8c13-0a71-4a60-bf9f-6e2da9503e9c","published_at":"2012-07-01","source":"wotc"},{"comment":"Solitary Confinement prevents all damage that would be dealt to you, not just combat damage.","oracle_id":"d41ab41d-07c8-4f6d-be5e-7aec9f5f6365","published_at":"2021-06-18","source":"wotc"},{"comment":"The draw step happens after the upkeep step. If you choose not to pay Solitary Confinement's upkeep cost, you'll sacrifice it. That turn's draw step will happen.","oracle_id":"d41ab41d-07c8-4f6d-be5e-7aec9f5f6365","published_at":"2021-06-18","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
