  "rulings": [
    {
      "oracle_id": "dac85722-d741-4584-8b98-8ac220958a38",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "You can sacrifice the creature Demonmail Hauberk is equipping in order to equip it to another creature."
    },
    {
      "oracle_id": "ba5d8c0d-3e4e-4652-86d2-80ce2f48dc0f",
      "published_at": "2011-06-01",
      "source": "wotc",
      "comment": "You can sacrifice Piston Sledge to pay its own equip cost. It won't become attached as it will be in your graveyard."
    },
    {
      "oracle_id": "ba5d8c0d-3e4e-4652-86d2-80ce2f48dc0f",
      "published_at": "2011-06-01",
      "source": "wotc",
      "comment": "If there are no creatures on the battlefield that Piston Sledge could be attached to when its \"enters\" triggered ability resolves, it remains on the battlefield unattached."
    },
    {
      "oracle_id": "3aa3526b-bd06-417f-af29-5a9ff0844923",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "Removing a charge counter from Sigil of Distinction is the only way to pay for its equip ability. If it has no charge counters on it, its equip ability can't be activated."
    },
    {
      "oracle_id": "3aa3526b-bd06-417f-af29-5a9ff0844923",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If Sigil of Distinction is attached to a creature when its equip ability is activated targeting a different creature, the first creature will immediately get a little smaller because a charge counter has been removed from Sigil of Distinction as a cost. Then, when the equip ability resolves, Sigil of Distinction will move to the new creature and the first creature will lose the entire bonus the Equipment was giving it."
    },
    {
      "oracle_id": "364fc1a7-b91d-470b-80fe-275828f36cfc",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If the target creature becomes an illegal target, Inventor's Axe remains on the battlefield unattached."
    },
    {
      "oracle_id": "364fc1a7-b91d-470b-80fe-275828f36cfc",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Inventor's Axe doesn't enter the battlefield attached to a creature. Instead, Inventor's Axe enters the battlefield and then its triggered ability attaches it to a creature. You may cast Inventor's Axe even if you don't control any creatures."
    },
    {
      "oracle_id": "eda09ed4-7509-4d1e-b169-2b7c1c87e936",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "You may pay the Equipment's equip cost as normal to move it from the Hero token to another creature you control."
    },
    {
      "oracle_id": "eda09ed4-7509-4d1e-b169-2b7c1c87e936",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "The Hero token enters as a 1/1 creature, then the Equipment becomes attached to it. Abilities that trigger when a creature enters the battlefield see that a 1/1 creature entered the battlefield."
    },
    {
      "oracle_id": "eda09ed4-7509-4d1e-b169-2b7c1c87e936",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "If the job select ability causes two Hero tokens to be created (due to an effect such as that of Doubling Season), the Equipment becomes attached to only one of them."
    },
    {
      "oracle_id": "eda09ed4-7509-4d1e-b169-2b7c1c87e936",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "If the Hero token is destroyed, the Equipment stays on the battlefield."
    }
  ]
