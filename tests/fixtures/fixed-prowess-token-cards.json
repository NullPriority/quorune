    {
      "oracle_id": "f621dcaa-c500-4a17-a65a-60d9b5516a3b",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "The tokens are named \"Goblin Wizard Token\" and have the creature types \"Goblin\" and \"Wizard.\""
    },
    {
      "oracle_id": "8629fdef-dbbe-4a97-a7e1-6b1646f4ca0b",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with storm won’t affect the copies."
    },
    {
      "oracle_id": "8629fdef-dbbe-4a97-a7e1-6b1646f4ca0b",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Spells cast from zones other than a player’s hand and spells that were countered or otherwise failed to resolve are counted by the storm ability."
    },
    {
      "oracle_id": "8629fdef-dbbe-4a97-a7e1-6b1646f4ca0b",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "The copies of Elemental Eruption created by its storm ability are put directly onto the stack. They aren’t cast and won’t be counted by other spells with storm cast later in the turn."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "Prowess goes on the stack on top of the spell that caused it to trigger. It will resolve before that spell."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "Prowess triggers only once for any spell, even if that spell has multiple types."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "Casting a noncreature spell will cause both prowess and Monastery Mentor's other ability to trigger. You can put these abilities on the stack in either order. Whichever ability is put on the stack last will resolve first."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "Any spell you cast that doesn't have the type creature will cause prowess to trigger. If a spell has multiple types, and one of those types is creature (such as an artifact creature), casting it won't cause prowess to trigger. Playing a land also won't cause prowess to trigger."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "Once it triggers, prowess isn't connected to the spell that caused it to trigger. If that spell is countered, prowess will still resolve."
    },
    {
      "oracle_id": "3979067a-9c68-443d-a85f-d9f07be880b9",
      "published_at": "2014-11-24",
      "source": "wotc",
      "comment": "The spell that causes Monastery Mentor's second ability to trigger will not cause the prowess ability of the Monk token that's created to trigger."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "Each Class starts with only the first of its three class abilities. As the first level ability resolves, the Class becomes level 2 and gains the second class ability. As the second level ability resolves, the Class becomes level 3 and gains the third class ability."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "The level 3 class ability of Stormchaser's Talent resolves before the spell or ability that caused it to trigger. It resolves even if that spell is countered."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "There's no restriction on how many Class permanents you can control, whether they're the same or different classes. Each Class permanent tracks its own level separately."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "You can't activate the first level ability of a Class unless that Class is level 1. Similarly, you can't activate the second level ability of a Class unless that Class is level 2."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "Each Class has five abilities. The three in the major sections of its text box are class abilities. Class abilities can be static, activated, or triggered abilities. The other two are level abilities, one activated ability to advance the Class to level 2 and another to advance the Class to level 3."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "Gaining a level won't remove abilities that a Class had at a previous level."
    },
    {
      "oracle_id": "00c1788d-c52f-4839-9cd8-11fb86c418b6",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "Gaining a level is a normal activated ability. It uses the stack and can be responded to."
    },
    {
      "oracle_id": "61b6b1d1-4350-41c1-ac47-835b2831f24a",
      "published_at": "2025-04-04",
      "source": "wotc",
      "comment": "If a copy of a spell is returned to its owner’s hand, it’s moved there, then it will cease to exist as a state-based action. It can’t be recast."
    },
    {
      "oracle_id": "61b6b1d1-4350-41c1-ac47-835b2831f24a",
      "published_at": "2025-04-04",
      "source": "wotc",
      "comment": "If a spell is returned to its owner’s hand, it’s removed from the stack and thus will not resolve. The spell isn’t countered; it just no longer exists. This works even against a spell that can’t be countered."
    }
  ]
}
