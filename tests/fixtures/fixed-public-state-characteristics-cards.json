":6.0},{"cmc":2.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{U}","name":"Turn to Frog","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","oracle_text":"Until end of turn, target creature loses all abilities and becomes a blue Frog with base power and toughness 1/1.","power":null,"produced_mana":[],"released_at":"2024-02-23","toughness":null,"type_line":"Instant"},{"oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","name":"Disenchant","mana_cost":"{1}{W}","type_line":"Instant","oracle_text":"Destroy target artifact or enchantment.","power":null,"toughness":null,"loyalty":null,"defense":null,"layout":"normal","released_at":"2024-11-15","colors":["W"],"color_identity":["W"],"keywords":[],"produced_mana":[],"legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"faces":[],"cmc":2.0}],"fixture_kind":"public_exact-list_card_data","rulings":[{"oracle_id":"52e3bcc0-0c1f-4846-bf52-4af66b7abd6f","published_at":"2014-04-26","source":"wotc","comment":"Nyx Infusion continuously checks to see whether the creature it's enchanting is an enchantment or not. If the creature isn't an enchantment and becomes one, or it is an enchantment and stops being one, the effect will change."},{"oracle_id":"5b0cb089-087d-4b91-9e63-8186dc737a00","published_at":"2004-10-04","source":"wotc","comment":"The effect does not receive a new timestamp when the creature goes from attacking to not attacking or the other way around."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"Turn to Frog overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Turn to Frog resolves will overwrite this effect."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"The creature will lose all other colors and creature types, but it will retain any other card types (such as artifact) or supertypes (such as legendary) it may have."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"If the affected creature gains an ability after Turn to Frog resolves, it will keep that ability."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"If one of the Theros block Gods is affected by Turn to Frog, it will be a legendary 1/1 blue Frog enchantment creature with no abilities. If it stops being a creature, perhaps because your devotion to its color(s) decreased, it will be a legendary blue enchantment with no abilities. The way continuous effects work, the God’s type-changing ability is applied before the effect that removes that ability is applied."},{"oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc","comment":"Turn to Frog doesn’t counter abilities that have already triggered or been activated. In particular, there is no way to cast this spell to stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."},{"oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc","comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."}],"schema_version":1,"source":"Scryfall Oracle subset for fixed public-state characteristic tests"}
