    {
      "oracle_id": "0c367958-729e-416d-988b-098e90e7a1fd",
      "published_at": "2023-07-28",
      "source": "wotc",
      "comment": "If there are additional costs to cast a spell, or if the cost to cast a spell is increased by an effect (such as the one created by Thalia, Guardian of Thraben's ability), apply those increases before applying cost reductions."
