  "rulings": [
    {
      "oracle_id": "cdfa9de4-7d7d-4638-8ac4-793ece6372dd",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "The copies that replicate creates are created on the stack, so they're not \"cast.\" Abilities that trigger when a player casts a spell won't trigger."
    },
    {
      "oracle_id": "cdfa9de4-7d7d-4638-8ac4-793ece6372dd",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "The replicate triggered ability that creates the copies can itself be countered by anything that can counter a triggered ability. If the ability countered, no copies will be put onto the stack."
    },
    {
      "oracle_id": "cdfa9de4-7d7d-4638-8ac4-793ece6372dd",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with replicate won't affect the copies."
    },
    {
      "oracle_id": "cdfa9de4-7d7d-4638-8ac4-793ece6372dd",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "As the replicate triggered ability resolves, you'll copy Changing Loyalty for each time you paid its replicate cost, even if the original spell is no longer on the stack at that time (perhaps because it was countered)."
    },
    {
      "oracle_id": "16c39265-72d9-4c86-a961-8dd38ff9adcd",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with replicate won't affect the copies."
    },
    {
      "oracle_id": "16c39265-72d9-4c86-a961-8dd38ff9adcd",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Triggered abilities use the word \"when,\" \"whenever,\" or \"at.\" They're often written as \"[Trigger condition], [effect].\" Some keywords (such as prowess) are triggered abilities and will use \"when,\" \"whenever,\" or \"at\" in their reminder text."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "1cea6439-7ae5-4887-8c33-7da9fb36e2d4",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "The copies that replicate creates are created on the stack, so they're not “cast.” Abilities that trigger when a player casts a spell won't trigger."
    },
    {
      "oracle_id": "1cea6439-7ae5-4887-8c33-7da9fb36e2d4",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "As the replicate triggered ability resolves, you'll copy Lose Focus for each time you paid its replicate cost, even if the original spell is no longer on the stack at that time (perhaps because it was countered)."
    },
    {
      "oracle_id": "65259ba4-956d-46a3-abd9-791d02015b41",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If a permanent has {X} in its mana cost, X is 0 when determining its mana value."
    },
    {
      "oracle_id": "65259ba4-956d-46a3-abd9-791d02015b41",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "If the target nonland permanent is an illegal target as Mists of Lórien tries to resolve, it won't resolve and none of its effects will happen. No permanents will be returned to their owners' hands."
    },
    {
      "oracle_id": "65259ba4-956d-46a3-abd9-791d02015b41",
      "published_at": "2023-11-03",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with replicate won't affect the copies."
    },
    {
      "oracle_id": "371da0d8-3845-458e-9b0a-6477017b890e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with replicate won't affect the copies."
    },
    {
      "oracle_id": "0c367958-729e-416d-988b-098e90e7a1fd",
      "published_at": "2023-07-28",
      "source": "wotc",
      "comment": "The ability can't reduce the amount of colored mana you pay for a spell. It reduces only the generic mana component of that cost."
