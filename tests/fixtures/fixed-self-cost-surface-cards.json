  "rulings": [
    {
      "oracle_id": "18a5fe34-0c97-486c-b09a-80535a99e982",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If a spell or ability targets Cactarantula more than once, its last ability still triggers only once."
    },
    {
      "oracle_id": "18a5fe34-0c97-486c-b09a-80535a99e982",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Cactarantula still costs only {1} less to cast if you control multiple Deserts."
    },
    {
      "oracle_id": "18a5fe34-0c97-486c-b09a-80535a99e982",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Cactarantula’s last ability resolves before the spell or ability that caused it to trigger. It resolves even if that spell is countered."
    },
    {
      "oracle_id": "18a5fe34-0c97-486c-b09a-80535a99e982",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Once you announce that you’re casting Cactarantula, no player may take actions until the spell has been paid for. Notably, opponents can’t try to change whether you control a Desert."
    },
    {
      "oracle_id": "4dc8e91a-2c00-4de2-bada-80f323a4ec9d",
      "published_at": "2019-06-14",
      "source": "wotc",
      "comment": "Igneous Elemental costs only {2} less to cast if you have more than one land card in your graveyard."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": " If an effect creates a copy of an instant or sorcery spell, this will also cause the magecraft ability to trigger."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": " Some effects instruct you to copy an instant or sorcery card in a zone other than the stack. These copies do not cause magecraft abilities to trigger. However, most effects that do this also allow you to cast the copy, and casting the copy will cause magecraft abilities to trigger."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": " For example, if you control Archmage Emeritus and cast an instant or sorcery spell, Archmage Emeritus's magecraft ability will trigger and you will draw a card."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": " Each magecraft ability has a different effect, although they all have the same trigger condition, whenever you cast or copy an instant or sorcery spell."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": " If an effect creates multiple copies of an instant or sorcery spell, magecraft abilities trigger once for each copy created by the effect."
    },
    {
      "oracle_id": "65681a2a-8395-4390-845f-9be974994dcb",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "If a player casts a spell that targets multiple permanents their opponent controls with ward, each of those ward abilities will trigger. If that player doesn't pay for all of them, the spell will be countered."
    },
    {
      "oracle_id": "98e36c6e-a868-4679-a5b5-6f02097f560b",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions (such as that of Serpent of the Pass's second ability). The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast that spell was."
    },
    {
      "oracle_id": "98e36c6e-a868-4679-a5b5-6f02097f560b",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "Serpent of the Pass's second ability cannot reduce the {U}{U} in its cost."
    },
    {
      "oracle_id": "ea43fd04-e9fa-42fb-ba20-22dcc21c6c43",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "Stormwing Entity's cost reduction applies just once, no matter how many instant and sorcery spells you've cast this turn."
    },
    {
      "oracle_id": "ea43fd04-e9fa-42fb-ba20-22dcc21c6c43",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "Stormwing Entity's cost reduction applies even if the instant or sorcery spell you cast was countered or didn't resolve."
    },
    {
      "oracle_id": "ea43fd04-e9fa-42fb-ba20-22dcc21c6c43",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions (such as that of Stormwing Entity). The mana value of the spell remains unchanged, no matter what the total cost to cast it was."
    },
    {
      "oracle_id": "256b8c23-589e-429d-9e6e-433d55079eb4",
      "published_at": "2017-04-18",
      "source": "wotc",
      "comment": "Desert is a land subtype with no special meaning. It doesn’t grant the land an intrinsic mana ability. Other cards may care about which lands are Deserts."
    },
    {
      "oracle_id": "24472823-d33c-4d96-add1-233116f6f4f7",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "While casting a spell with convoke, if you sacrifice Wild Cantor to add mana, Wild Cantor won't be on the battlefield when you pay that spell's costs. It can't be tapped to help cast that spell using convoke."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "You must be able to target a card in a graveyard to cast Cremate."
    },
    {
      "oracle_id": "81f06f84-1580-43c0-89d5-08d34541a519",
      "published_at": "2017-03-14",
      "source": "wotc",
      "comment": "Two Goblin Electromancers will make instant and sorcery spells you cast cost {2} less to cast, and so on."
    },
    {
      "oracle_id": "81f06f84-1580-43c0-89d5-08d34541a519",
      "published_at": "2018-10-05",
      "source": "wotc",
      "comment": "Goblin Electromancer's effect reduces only generic mana in the spell's total cost."
    },
    {
      "oracle_id": "81f06f84-1580-43c0-89d5-08d34541a519",
      "published_at": "2018-10-05",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell remains unchanged, no matter what the total cost to cast it was."
    },
    {
      "oracle_id": "0fe16212-66c3-4e45-a641-7391e9b2e304",
      "published_at": "2015-06-22",
      "source": "wotc",
      "comment": "The damage dealt to you is part of the second mana ability. It doesn't use the stack and can't be responded to."
    },
    {
      "oracle_id": "0fe16212-66c3-4e45-a641-7391e9b2e304",
      "published_at": "2015-06-22",
      "source": "wotc",
      "comment": "Like most lands, each land in this cycle is colorless. The damage dealt to you is dealt by a colorless source."
    },
    {
      "oracle_id": "b22de128-6dad-4e15-a547-1c9ca08df5ff",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "If you bring a card into the game from outside the game in a Constructed tournament (or a Constructed game played under tournament conditions), you may select only a card from your sideboard. In casual Constructed games, the card comes from your collection."
    },
    {
      "oracle_id": "b22de128-6dad-4e15-a547-1c9ca08df5ff",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "If you bring a card into the game from outside the game in a Sealed Deck or Booster Draft event, you may select only a card that is in the card pool that you built your deck from."
    },
    {
      "oracle_id": "b22de128-6dad-4e15-a547-1c9ca08df5ff",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "You choose whether you want the creature to gain reach until end of turn as Academic Dispute resolves."
    },
    {
      "oracle_id": "b22de128-6dad-4e15-a547-1c9ca08df5ff",
      "published_at": "2021-04-16",
      "source": "wotc",
      "comment": "The controller of the creature chooses which attacking creature that creature blocks."
