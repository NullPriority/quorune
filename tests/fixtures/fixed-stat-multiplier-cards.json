  "rulings": [
    {
      "oracle_id": "2ef063d2-8702-43a3-a7d0-fc255f8512d3",
      "published_at": "2025-09-19",
      "source": "wotc",
      "comment": "To double a creature's power, that creature gets +X/+0, where X is that creature's power as Double Trouble resolves."
    },
    {
      "oracle_id": "d53ef172-8c26-4469-94c6-bf7fe4d48dbf",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "If a creature's power is less than 0 when it's doubled, instead that creature gets -X/-0, where X is how much less than 0 its power is. For example, if an effect has given a 2/2 creature -4/-0 so that it's a -2/2 creature, doubling its power and toughness gives it -2/+2, and it becomes a -4/4 creature."
    },
    {
      "oracle_id": "d53ef172-8c26-4469-94c6-bf7fe4d48dbf",
      "published_at": "2021-07-23",
      "source": "wotc",
      "comment": "If an effect instructs you to \"double\" a creature's power, that creature gets +X/+0, where X is its power as that effect begins to apply. The same is true for toughness."
    },
    {
      "oracle_id": "4eaa100c-f1ef-4a2b-9370-5dad7f3a95f2",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "If an effect instructs you to \"double\" a creature's power, that creature gets +X/+0, where X is its power as that effect begins to apply. If its power is negative, instead it gets -X/-0 where X is how far below 0 its power is. The value of X won't change if another effect alters the creature's power later in the turn."
    }
  ]
