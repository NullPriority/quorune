  "rulings": [
    {
      "oracle_id": "3bc46467-323f-4cbf-9d0a-f3d2ae3c3a34",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "Bender's Waterskin untaps at the same time as the active player's permanents. You can't choose to not untap it at that time."
    },
    {
      "oracle_id": "3bc46467-323f-4cbf-9d0a-f3d2ae3c3a34",
      "published_at": "2025-10-02",
      "source": "wotc",
      "comment": "Some effects state that an artifact doesn't untap during its controller's untap step. These effects won't apply and stop Bender's Waterskin from untapping during another player's untap step."
    },
    {
      "oracle_id": "3f8182e5-4df5-4beb-a3b7-387ed1e86c99",
      "published_at": "2006-07-15",
      "source": "wotc",
      "comment": "Rimescale Dragon’s last ability affects all permanents with ice counters on them, whether or not it put the ice counters on them."
    },
    {
      "oracle_id": "61d28182-498f-4bbc-bb7a-c5e1ef872dda",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "Multiple Murkfiend Lieges are redundant when it comes to the untap effect. You can't untap your permanents more than once in a single untap step."
    },
    {
      "oracle_id": "61d28182-498f-4bbc-bb7a-c5e1ef872dda",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "All your green and/or blue creatures untap during each other player's untap step. You have no choice about what untaps. Those creatures untap at the same time as the active player's permanents."
    },
    {
      "oracle_id": "61d28182-498f-4bbc-bb7a-c5e1ef872dda",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "During each other player's untap step, effects that would otherwise cause your green and/or blue creatures to stay tapped don't apply because they only apply during *your* untap step. For example, if you control Nettle Sentinel (a green creature that says \"Nettle Sentinel doesn't untap during your untap step\"), you untap it during each other player's untap step."
    },
    {
      "oracle_id": "61d28182-498f-4bbc-bb7a-c5e1ef872dda",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "The abilities are separate and cumulative. If another creature you control is both of the listed colors, it will get a total of +2/+2."
    },
    {
      "oracle_id": "db1ea6e0-4076-49dd-92f7-7e6d7eb65a27",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Activating the second activated ability after a creature has legally been declared as an attacker or blocker won't change or undo that attack or block."
    },
    {
      "oracle_id": "db1ea6e0-4076-49dd-92f7-7e6d7eb65a27",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Endbringer untaps at the same time as the active player's permanents. You can't choose to not untap it at that time."
    },
    {
      "oracle_id": "db1ea6e0-4076-49dd-92f7-7e6d7eb65a27",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "If an effect states that Endbringer doesn't untap during your untap step, that effect won't apply during another player's untap step."
    },
    {
      "oracle_id": "f064a39e-ebb3-47b5-bd06-f39b02b95eaf",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "Thousand Moons Infantry untaps at the same time as the active player's permanents. You can't choose not to untap it at that time."
    },
    {
      "oracle_id": "f064a39e-ebb3-47b5-bd06-f39b02b95eaf",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "Thousand Moons Infantry still untaps during your untap step as normal."
    },
    {
      "oracle_id": "f064a39e-ebb3-47b5-bd06-f39b02b95eaf",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "If an effect states that Thousand Moons Infantry doesn't untap during your untap step, that effect won't apply during another player's untap step."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Snow is a supertype, not a card type. It has no rules meaning or function by itself, but spells and abilities may refer to it."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "The {S} symbol is a generic mana symbol. It represents a cost that can be paid by one mana that was produced by a snow source. That mana can be any color or colorless."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Snow isn't a type of mana. If an effect says you may spend mana as though it were any type, you can't pay for {S} using mana that wasn't produced by a snow source."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Some cards have additional effects for each {S} spent to cast them. You can cast these spells even if you don't spend any snow mana to cast them; their additional effects simply won't do anything."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "In a Limited event (usually Booster Draft or Sealed Deck), you can't add basic snow lands to your card pool as you would other basic lands. You can play with basic snow lands only if you open them in your sealed deck or draft them."
    },
    {
      "oracle_id": "5b2460a5-6ae5-4cad-ba94-1a9e98e6e4c0",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "The Kaldheim set doesn't have any cards with mana costs that include {S}, but some previous sets do. If an effect says such a spell costs {1} less to cast, that reduction doesn't apply to any {S} costs. This is also true for activated abilities that include {S} in their activation costs and effects that reduce those costs."
    },
    {
      "oracle_id": "256b8c23-589e-429d-9e6e-433d55079eb4",
      "published_at": "2017-04-18",
      "source": "wotc",
      "comment": "Desert is a land subtype with no special meaning. It doesn’t grant the land an intrinsic mana ability. Other cards may care about which lands are Deserts."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "With a Humility and two Opalescences on the battlefield, if Humility has the latest timestamp, then all creatures are 1/1 with no abilities. If the timestamp order is Opalescence, Humility, Opalescence, the second Opalescence is 1/1, and the Humility and first Opalescence are 4/4. If Humility has the earliest timestamp, then everything is 4/4."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2007-02-01",
      "source": "wotc",
      "comment": "Removes all creature abilities. This includes mana abilities. Animated lands will also lose the ability to tap for mana."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "This is the current interaction between Humility and Opalescence: The type-changing effect applies at layer 4, but the rest happens in the applicable layers. The rest of it will apply even if the permanent loses its ability before it's finished applying. So if Opalescence, Humility, and Worship are on the battlefield and Opalescence entered before Humility, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments. (Opalescence). Layer 6: Humility and Worship each lose their abilities. (Humility) Layer 7b: Humility becomes 4/4 and Worship becomes 4/4. (Opalescence). Humility becomes 1/1 and Worship becomes 1/1 (Humility). But if Humility entered before Opalescence, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments (Opalescence). Layer 6: Humility and Worship each lose their abilities (Humility). Layer 7b: Humility becomes 1/1 and Worship becomes 1/1 (Humility). Humility becomes 4/4 and Worship becomes 4/4 (Opalescence)."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "You must be able to target a card in a graveyard to cast Cremate."
    },
    {
      "oracle_id": "24472823-d33c-4d96-add1-233116f6f4f7",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "While casting a spell with convoke, if you sacrifice Wild Cantor to add mana, Wild Cantor won't be on the battlefield when you pay that spell's costs. It can't be tapped to help cast that spell using convoke."
    },
    {
      "oracle_id": "0004ebd0-dfd6-4276-b4a6-de0003e94237",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If there are two of these on the battlefield, they do not add together. The result is that only two permanents can be untapped."
    },
    {
      "oracle_id": "3608f1f7-8dc5-4dd1-ae91-c830e1de9529",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Once a player announces that they're casting a spell or activating an ability, no player may take other actions until the spell or ability has been paid for. Notably, other players can't try to tap that player's permanents to stop them from paying {T} or to stop them from producing enough mana."
