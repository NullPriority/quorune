  "rulings": [
    {
      "oracle_id": "3e44226b-51a2-4099-aff8-a5befab720cb",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "A permanent card is an artifact, battle, creature, enchantment, land, or planeswalker card."
    },
    {
      "oracle_id": "3e44226b-51a2-4099-aff8-a5befab720cb",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whatever you do, don't eat the delicious cards."
    },
    {
      "oracle_id": "3e44226b-51a2-4099-aff8-a5befab720cb",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."
    },
    {
      "oracle_id": "3e44226b-51a2-4099-aff8-a5befab720cb",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If an effect refers to a Food, it means any Food artifact, not just a Food artifact token. For example, you can sacrifice Tough Cookie (an Artifact Creature — Food Golem) to activate Maraleaf Rider's ability (an ability with \"Sacrifice a Food\" in its cost)."
    },
    {
      "oracle_id": "3e44226b-51a2-4099-aff8-a5befab720cb",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Food is an artifact type. Even though it appears on some creatures, it's never a creature type."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "Activating Gingerbrute's middle ability after it has become blocked by a creature without haste won't cause it to become unblocked."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If an effect refers to a Food, it means any Food artifact, not just a Food artifact token. For example, you can sacrifice Tough Cookie (an Artifact Creature — Food Golem) to activate Maraleaf Rider's ability (an ability with \"Sacrifice a Food\" in its cost)."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Food is an artifact type. Even though it appears on some creatures, it's never a creature type."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whatever you do, don't eat the delicious cards."
    },
    {
      "comment": "If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat.",
      "oracle_id": "8e0cea9c-3110-4728-9378-76849e33bb90",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "If Rest in Peace is destroyed by a spell, Rest in Peace will be exiled and then the spell will be put into its owner's graveyard.",
      "oracle_id": "087f9ad7-e74f-40e2-8102-1ed2925d0418",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "If a card is discarded while Rest in Peace is on the battlefield, abilities that function when a card is discarded (such as madness) still work, even though that card never reaches a graveyard. In addition, spells or abilities that check the characteristics of a discarded card (such as Chandra Ablaze's first ability) can find that card in exile.",
      "oracle_id": "087f9ad7-e74f-40e2-8102-1ed2925d0418",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "While Rest in Peace is on the battlefield, abilities that trigger whenever a creature dies won't trigger because cards and tokens are never put into a player's graveyard.",
      "oracle_id": "087f9ad7-e74f-40e2-8102-1ed2925d0418",
      "published_at": "2018-03-16",
      "source": "wotc"
    }
  ],
