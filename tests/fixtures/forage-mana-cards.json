  "rulings": [
    {
      "oracle_id": "7b18cfad-a1cf-46c2-bcdd-7762c13d50e5",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "Once you announce that you're casting a spell or activating an ability, players can't take actions until you've finished doing so. Notably, opponents can't try to remove cards from your graveyard or Foods you control to stop you from foraging."
    },
    {
      "oracle_id": "7b18cfad-a1cf-46c2-bcdd-7762c13d50e5",
      "published_at": "2024-07-26",
      "source": "wotc",
      "comment": "If you don't have enough cards in your graveyard or a Food on the battlefield, you can't choose to forage."
    },
    {
      "oracle_id": "7b18cfad-a1cf-46c2-bcdd-7762c13d50e5",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Food is an artifact type. Even though it appears on some creatures, it's never a creature type."
    },
    {
      "oracle_id": "7b18cfad-a1cf-46c2-bcdd-7762c13d50e5",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whatever you do, don't eat the delicious cards."
    },
    {
      "oracle_id": "7b18cfad-a1cf-46c2-bcdd-7762c13d50e5",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2019-10-04",
      "source": "wotc",
      "comment": "Activating Gingerbrute's middle ability after it has become blocked by a creature without haste won't cause it to become unblocked."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If an effect refers to a Food, it means any Food artifact, not just a Food artifact token. For example, you can sacrifice Tough Cookie (an Artifact Creature — Food Golem) to activate Maraleaf Rider's ability (an ability with \"Sacrifice a Food\" in its cost)."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Food is an artifact type. Even though it appears on some creatures, it's never a creature type."
    },
    {
      "oracle_id": "10b8d4c7-7553-4d76-b643-d98b80701e13",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whatever you do, don't eat the delicious cards."
    },
    {
      "comment": "The decision whether or not to tap or untap is made on resolution. This is not a modal spell.",
      "oracle_id": "773ad2ef-5acc-49ea-8d85-056330e87039",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.",
      "oracle_id": "773ad2ef-5acc-49ea-8d85-056330e87039",
      "published_at": "2004-10-04",
      "source": "wotc"
    }
  ],
