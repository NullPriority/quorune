  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Battles will enter with double the normal number of defense counters.",
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "Doubling Season affects permanents that enter with counters.",
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "Everything that is specified by the effect creating the original token or tokens will also be true about the additional token or tokens created by Doubling Season's replacement effect. For example, if an effect tells you to create a token \"tapped and attacking,\" the additional tokens will also be tapped and attacking.",
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "If there are two Doubling Seasons on the battlefield, then the number of tokens or counters is four times the original number. If there are three on the battlefield, then the number of tokens or counters is eight times the original number, and so on.",
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "Planeswalkers will enter with double the normal number of loyalty counters. However, if you activate an ability whose cost has you put loyalty counters on a planeswalker, the number you put on isn't doubled. This is because those counters are put on as a cost, not as an effect.",
      "oracle_id": "01546b7d-a233-4176-8843-d732074dc5b6",
      "published_at": "2024-11-08",
      "source": "wotc"
    },
    {
      "comment": "Casting the card again due to rebound's delayed triggered ability is optional. If you choose not to cast the card, or if you can't (perhaps because there are no legal targets available), the card will stay exiled. You won't get another chance to cast it on a future turn. If you do cast the card, it's put into its owner's graveyard as normal once it resolves.",
      "oracle_id": "0fd57894-b917-41c8-a394-360d1d31b236",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "If a spell with rebound that you cast from your hand is countered or doesn't resolve (most likely because its targets have become illegal), none of its effects will happen, including rebound. The spell will be put into its owner's graveyard and you won't get to cast it again on your next turn.",
      "oracle_id": "0fd57894-b917-41c8-a394-360d1d31b236",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield.",
      "oracle_id": "0fd57894-b917-41c8-a394-360d1d31b236",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "Once the exiled creature returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled creature will be put into their owners' graveyards. Equipment attached to the exiled creature will become unattached and remain on the battlefield. Any counters on the exiled creature will cease to exist.",
      "oracle_id": "0fd57894-b917-41c8-a394-360d1d31b236",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "The +1/+1 counter won't affect Llanowar Reborn in any way unless another effect turns it into a creature.",
      "oracle_id": "92acb789-0e42-465c-ac16-40fefec48805",
      "published_at": "2007-05-01",
      "source": "wotc"
    },
    {
      "comment": "Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    }
  ],
