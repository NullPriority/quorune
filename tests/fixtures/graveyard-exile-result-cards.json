  "rulings": [
    {
      "comment": "The targeted player chooses which card to exile when the ability resolves.",
      "oracle_id": "868b5315-da38-4918-b8e4-70762811605b",
      "published_at": "2011-09-22",
      "source": "wotc"
    },
    {
      "comment": "If an effect sets your life total to a specific number, and that number is higher than your current life total, the effect will cause you to gain life equal to the difference. Rhox Faithmender will then double that number. For example, if you have 3 life and an effect says that your life total \"becomes 10,\" your life total will actually become 17.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "If you control two Rhox Faithmenders, life you gain will be multiplied by four. Three Rhox Faithmenders will multiply any life gain by eight, and so on.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "In a Two-Headed Giant game, only Rhox Faithmender's controller is affected by it. If that player's teammate gains life, Rhox Faithmender will have no effect, even when that life gain is applied to the shared team life total.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    }
  ]
