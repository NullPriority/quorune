intage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Twiddle","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","oracle_text":"You may tap or untap target artifact, creature, or land.","power":null,"produced_mana":[],"released_at":"2003-07-28","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":4.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}","name":"Vedalken Orrery","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","oracle_text":"You may cast spells as though they had flash.","power":null,"produced_mana":[],"released_at":"2022-07-08","toughness":null,"type_line":"Artifact"},{"cmc":0.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Wastes","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","oracle_text":"{T}: Add {C}.","power":null,"produced_mana":["C"],"released_at":"2025-08-01","toughness":null,"type_line":"Basic Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Duggan, Private Detective's last ability can be activated only once during the game. However, if Duggan leaves and later returns to the battlefield, he's considered a new permanent (with a new set of abilities) and it can be activated again.","oracle_id":"0fbe3805-b59b-47fc-ab21-f05a4aa4cfe0","published_at":"2023-10-13","source":"wotc"},{"comment":"Lethal damage, damage from a source with deathtouch, and effects that say \"destroy\" won't cause a creature with indestructible to be put into the graveyard. However, a creature with indestructible can be put into the graveyard for a number of reasons. The most likely reasons are if it's sacrificed or if its toughness is 0 or less. (In these cases, of course, Darksteel Colossus would be shuffled into its owner's library instead of being put into its owner's graveyard.)","oracle_id":"1b09d0cf-403c-4a15-aeee-602a1bdaf0c1","published_at":"2013-07-01","source":"wotc"},{"comment":"A spell's mana value is determined only by its mana cost. Ignore any alternative costs, additional costs, cost increases, or cost reductions.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"Cascade triggers when you cast the spell, meaning that it resolves before that spell. If you end up casting the exiled card, it will go on the stack above the spell with cascade.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"Due to a 2021 rules change to cascade, not only do you stop exiling cards if you exile a nonland card with lesser mana value than the spell with cascade, but the resulting spell you cast must also have lesser mana value. Previously, in cases where a card's mana value differed from the resulting spell, such as with some modal double-faced cards or cards with an Adventure, you could cast a spell with a higher mana value than the exiled card.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"If a spell with cascade is countered, the cascade ability will still resolve normally.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"If the card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"If you cast a card \"without paying its mana cost,\" you can't choose to cast it for any alternative costs. You can, however, pay additional costs. If the card has any mandatory additional costs, you must pay those to cast the card.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"The spell you cast due to cascade resolves before Noise Marine, so when its enters-the-battlefield ability resolves it will count that spell as a spell you've cast this turn.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"Two new cards in this set give the next spell you cast cascade. This means that the next spell you cast gains cascade as you begin to cast it by putting it on the stack, and the cascade ability will trigger when you finish casting that spell.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"When the cascade ability resolves, you must exile cards. The only optional part of the ability is whether or not you cast the last card exiled.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"You exile the cards face up. All players will be able to see them.","oracle_id":"1f7e85cf-afee-4041-9436-1fb69b4ec292","published_at":"2022-10-07","source":"wotc"},{"comment":"If Caldera Pyremaw leaves the battlefield in response to its ability, use its power the last time it existed on the battlefield to determine how much damage it deals as its ability resolves.","oracle_id":"3eb5ae68-7f76-4874-80a4-80058b10fc7a","published_at":"2025-04-04","source":"wotc"},{"comment":"The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2004-12-01","source":"wotc"},{"comment":"This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2010-06-15","source":"wotc"},{"comment":"The decision whether or not to tap or untap is made on resolution. This is not a modal spell.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat.","oracle_id":"8e0cea9c-3110-4728-9378-76849e33bb90","published_at":"2012-07-01","source":"wotc"},{"comment":"As the triggered ability resolves, count each Locus on the battlefield regardless of who controls it.","oracle_id":"92c9aad6-35ec-425d-be7d-393328992820","published_at":"2011-01-01","source":"wotc"},{"comment":"If the enchanted creature can't attack for any reason (such as being tapped or having come under that player's control that turn), then it doesn't attack. If there's a cost associated with having it attack, the player isn't forced to pay that cost, so it doesn't have to attack in that case either.","oracle_id":"94366283-3b28-4d6a-96e7-c04e5aead5a6","published_at":"2020-01-24","source":"wotc"},{"comment":"If Gimli, Counter of Kills dies at the same time as one or more creatures an opponent controls, the last ability will trigger for each of those other creatures.","oracle_id":"96ebcd8b-ae3c-47b0-b895-bfc9848713e5","published_at":"2023-06-16","source":"wotc"},{"comment":"If Sharpshooter Elf leaves the battlefield while its triggered ability is on the stack, use its power as it last existed on the battlefield to determine how much damage it deals.","oracle_id":"a25308ae-d757-4868-883d-62bbb00d6cbe","published_at":"2022-06-10","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"},{"comment":"After an escaped spell resolves, it returns to its owner's graveyard if it's not a permanent spell. If it is a permanent spell, it enters the battlefield and will return to its owner's graveyard if it dies later. Perhaps it will escape again—good underworld security is so hard to come by these days.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"Escape's permission doesn't change when you may cast the spell from your graveyard.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"If Chainweb Aracnir leaves the battlefield before its triggered ability resolves, use its power as it last existed on the battlefield to determine how much damage it deals.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"If a card has multiple abilities giving you permission to cast it, such as two escape abilities or an escape ability and a flashback ability, you choose which one to apply. The others have no effect.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"If a card with escape is put into your graveyard during your turn, you'll be able to cast it right away if it's legal to do so, before an opponent can take any actions.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"If you cast a spell with its escape permission, you can't choose to apply any other alternative costs or to cast it without paying its mana cost. If it has any additional costs, you must pay those.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"Once you begin casting a spell with escape, it immediately moves to the stack. Players can't take any other actions until you're done casting the spell.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as an escape cost), add any cost increases, then apply any cost reductions. The mana value of the spell remains unchanged, no matter what the total cost to cast it was and no matter whether an alternative cost was paid.","oracle_id":"c45423ad-1920-46f7-bcc1-ecade5880821","published_at":"2020-01-24","source":"wotc"},{"comment":"If a creature with renown deals combat damage to its controller because that damage was redirected, renown will trigger.","oracle_id":"cad1cd10-4810-495e-9305-0ae812596f6a","published_at":"2015-06-22","source":"wotc"},{"comment":"If a renown ability triggers, but the creature leaves the battlefield before that ability resolves, the creature doesn’t become renowned. Any ability that triggers “whenever a creature becomes renowned” won’t trigger.","oracle_id":"cad1cd10-4810-495e-9305-0ae812596f6a","published_at":"2015-06-22","source":"wotc"},{"comment":"Once an attacking creature with menace is legally blocked by two or more creatures, removing one or more of those blockers from combat won’t change or undo that block.","oracle_id":"cad1cd10-4810-495e-9305-0ae812596f6a","published_at":"2015-06-22","source":"wotc"},{"comment":"Renown won’t trigger when a creature deals combat damage to a planeswalker or another creature. It also won’t trigger when a creature deals noncombat damage to a player.","oracle_id":"cad1cd10-4810-495e-9305-0ae812596f6a","published_at":"2015-06-22","source":"wotc"},{"comment":"Putting a fourth oil counter on Ichor Synthesizer after it has become blocked will not cause it to become unblocked.","oracle_id":"e82f46f3-143b-46ae-ab5d-4aa177437a64","published_at":"2023-02-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
