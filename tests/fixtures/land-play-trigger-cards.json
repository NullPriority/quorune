  "rulings": [
    {
      "oracle_id": "608293f1-34aa-4e55-8389-73f975858de6",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "A spell or ability that tells a player to “put a land onto the battlefield” does not count as playing a land."
    },
    {
      "oracle_id": "65d4ebdb-8757-4e5e-9411-d78597e20d57",
      "published_at": "2023-05-12",
      "source": "wotc",
      "comment": "Once a Thopter that came under your control this turn has legally attacked, causing it to lose haste by removing Pia Nalaar won't remove that Thopter from combat. It will just keep attacking. Good Thopter."
    },
    {
      "oracle_id": "88cf4c1a-5863-45fc-b76d-7ad33b175b2b",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Playing a land will trigger it, but putting a land onto the battlefield as part of an effect will not."
    },
    {
      "oracle_id": "b8181d53-1954-4f46-8670-8696440208e8",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Playing a land will trigger it, but putting a land onto the battlefield as part of an effect will not."
    },
    {
      "oracle_id": "57ee0730-3ac5-4f17-ac82-bd4a6673c2bb",
      "published_at": "2025-07-25",
      "source": "wotc",
      "comment": "The Endstone’s first ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered or otherwise leaves the stack without resolving."
    },
    {
      "oracle_id": "57ee0730-3ac5-4f17-ac82-bd4a6673c2bb",
      "published_at": "2025-07-25",
      "source": "wotc",
      "comment": "For your life total to become a certain value, you will gain or lose the appropriate amount of life. For example, if your starting life total is 20 and your life total is 17 when The Endstone’s last ability resolves, you will lose 7 life and your life total will become 10. Other abilities that interact with life gain or life loss will interact with this effect accordingly."
    },
    {
      "oracle_id": "0c2841bb-038c-4fbf-8360-bc0a1522b58d",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Exploration’s ability is cumulative with other effects that allow you to play additional lands, including ones created by other Explorations you control."
    },
    {
      "oracle_id": "584cf0fd-112a-4ca6-9c0e-1f3228a7d325",
      "published_at": "2021-11-19",
      "source": "wotc",
      "comment": "You must still pay all costs to cast those spells and follow normal casting permissions. For example, if one of the exiled cards is a sorcery, this effect doesn't allow you to cast it during an opponent's turn."
    },
    {
      "oracle_id": "4493828f-144f-49cf-9fd2-61de86e632ec",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability doesn't trigger if a permanent already on the battlefield becomes a land."
    },
    {
      "oracle_id": "4493828f-144f-49cf-9fd2-61de86e632ec",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "Whenever a land you control enters, each landfall ability of the permanents you control will trigger. You can put them   on the stack in any order. The last ability you put on the stack will be the first one to resolve (As a result, you can have those abilities resolve in the order of your choosing.)."
    },
    {
      "oracle_id": "4493828f-144f-49cf-9fd2-61de86e632ec",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "A landfall ability triggers whenever a land you control enters for any reason. It triggers whenever you play a land, as well as whenever a spell or ability puts a land onto the battlefield under your control."
    }
  ]
}
