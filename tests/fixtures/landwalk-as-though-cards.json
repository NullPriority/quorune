  "rulings": [
    {
      "oracle_id": "537162d5-a2c2-4ad4-9fae-d2ec7a269dcc",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Allows any creature controlled by any player to block Swampwalking creatures as if they did not have this ability. It is not limited to just Ur-Drago."
    },
    {
      "oracle_id": "59258149-1c18-421b-b940-d0aa29da572a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The statement that creatures with Plainswalk or Forestwalk can be blocked applies to all creatures on the battlefield blocking them, and not just to Lord Magnus."
    },
    {
      "oracle_id": "5d13386e-faac-4440-96c3-11c60872ceec",
      "published_at": "2006-05-01",
      "source": "wotc",
      "comment": "“Landwalk abilities” are abilities such as “forestwalk” or “legendary landwalk” that have “walk” in the name."
    },
    {
      "oracle_id": "86af21ba-58ad-45e8-a316-5411c870e415",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It does not remove Landwalk from creatures. It just makes creatures with landwalk blockable as if they did not have the ability."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "The Kaldheim set doesn't have any cards with mana costs that include {S}, but some previous sets do. If an effect says such a spell costs {1} less to cast, that reduction doesn't apply to any {S} costs. This is also true for activated abilities that include {S} in their activation costs and effects that reduce those costs."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Snow is a supertype, not a card type. It has no rules meaning or function by itself, but spells and abilities may refer to it."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "In a Limited event (usually Booster Draft or Sealed Deck), you can't add basic snow lands to your card pool as you would other basic lands. You can play with basic snow lands only if you open them in your sealed deck or draft them."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Snow isn't a type of mana. If an effect says you may spend mana as though it were any type, you can't pay for {S} using mana that wasn't produced by a snow source."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "The {S} symbol is a generic mana symbol. It represents a cost that can be paid by one mana that was produced by a snow source. That mana can be any color or colorless."
    },
    {
      "oracle_id": "d8239a86-7184-4005-ba1e-2dddcd756c47",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Some cards have additional effects for each {S} spent to cast them. You can cast these spells even if you don't spend any snow mana to cast them; their additional effects simply won't do anything."
    },
    {
      "oracle_id": "f7518456-45ed-41d4-bd3c-5aacea28eb35",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "To work as an evasion ability, an attacking creature must already have flying when the declare blockers step begins. Once a creature has become blocked, giving it flying won’t change that."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    },
    {
      "oracle_id": "d5b9d250-92f5-40d8-b962-4ae4adb466c8",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "If a token is exiled this way, it will cease to exist and won’t return to the battlefield."
    },
    {
      "oracle_id": "d5b9d250-92f5-40d8-b962-4ae4adb466c8",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "If an Aura is put onto the battlefield without being cast, the Aura’s controller-to-be chooses what it will enchant as it comes back onto the battlefield. An Aura put onto the battlefield this way doesn’t target anything (so it could be attached to an opponent’s permanent with hexproof, for example), but the Aura’s enchant ability restricts what it can be attached to. If the Aura can’t legally be attached to anything, it remains in its current zone."
    },
    {
      "oracle_id": "d5b9d250-92f5-40d8-b962-4ae4adb466c8",
      "published_at": "2020-01-24",
      "source": "wotc",
      "comment": "Once the exiled permanent returns, it’s considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners’ graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."
    }
  ]
}
