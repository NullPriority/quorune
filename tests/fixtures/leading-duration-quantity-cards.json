  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "The number of creatures you control is counted only when Chorus of Might resolves.",
      "oracle_id": "0765c18b-25a0-4f79-aa1e-7adba7f5c91e",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "The bonus from Gran Pulse Ochu's last ability is determined at the time it resolves. Once the ability resolves, the bonus applied by that instance of the ability doesn't change even if the number of permanent cards in your graveyard changes.",
      "oracle_id": "09b71c95-7b5d-4cee-a505-e0dda72715b7",
      "published_at": "2025-06-06",
      "source": "wotc"
    },
    {
      "comment": "If you target a creature you control with Get a Leg Up, remember to count that creature.",
      "oracle_id": "a80519c4-f778-4b8e-9920-64013e98c95b",
      "published_at": "2024-02-02",
      "source": "wotc"
    },
    {
      "comment": "The number of creatures you control is checked only once, as Get a Leg Up resolves. The bonus won't change if the number of creatures you control changes later in the turn.",
      "oracle_id": "a80519c4-f778-4b8e-9920-64013e98c95b",
      "published_at": "2024-02-02",
      "source": "wotc"
    },
    {
      "comment": "Domain abilities count the number of basic land types among lands you control, not how many lands you control or how many of any type.",
      "oracle_id": "c47ae79c-4e07-47f2-8920-2ab62b471e4f",
      "published_at": "2022-09-09",
      "source": "wotc"
    },
    {
      "comment": "The basic land types are Plains, Island, Swamp, Mountain, and Forest. Land types other than basic land types (such as Desert) don\u2019t contribute to domain abilities.",
      "oracle_id": "c47ae79c-4e07-47f2-8920-2ab62b471e4f",
      "published_at": "2022-09-09",
      "source": "wotc"
    }
  ],
