  "rulings": [
    {
      "oracle_id": "5794b58e-f3b6-4637-b288-283b3a72a718",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "The only difference between a colored artifact and a colorless artifact is, obviously, its color. Unlike most artifacts, a colored artifact requires colored mana to cast. Also unlike most artifacts, a colored artifact has a color in all zones. It will interact with cards that care about color. Other than that, a colored artifact behaves just like any other artifact. It will interact as normal with any card that cares about artifacts, such as Shatter or Arcbound Ravager."
    },
    {
      "oracle_id": "5794b58e-f3b6-4637-b288-283b3a72a718",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If an effect says \"Search your library . . . then shuffle your library,\" you shuffle you libraries even though you can't search."
    },
    {
      "oracle_id": "5794b58e-f3b6-4637-b288-283b3a72a718",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "Effects that instruct you to reveal or look at cards from the top of you library will still work. Only effects that use the word \"search\" are affected."
    },
    {
      "oracle_id": "5794b58e-f3b6-4637-b288-283b3a72a718",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If an effect says \"You may search your library . . . If you do, shuffle your library\" or \"You may search your library . . . then shuffle your library,\" you can't choose to search, so you won't shuffle."
    },
    {
      "oracle_id": "b4b724bb-4c1c-4002-8eb8-bc8dd3f88e62",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "If an effect says \"Search your library . . . then shuffle your library,\" you shuffle you libraries even though you can't search."
    },
    {
      "oracle_id": "b4b724bb-4c1c-4002-8eb8-bc8dd3f88e62",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "If an effect says \"You may search your library . . . If you do, shuffle your library\" or \"You may search your library . . . then shuffle your library,\" you can't choose to search, so you won't shuffle."
    },
    {
      "oracle_id": "b4b724bb-4c1c-4002-8eb8-bc8dd3f88e62",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "Effects that instruct you to reveal or look at cards from the top of you library will still work. Only effects that use the word \"search\" are affected."
    },
    {
      "oracle_id": "d9517c5d-66d0-4178-96fb-a8c04f311ad8",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "For effects that check whether a player searched a library or may search a library, searching the top four cards of that library counts as searching that library."
    },
    {
      "oracle_id": "d9517c5d-66d0-4178-96fb-a8c04f311ad8",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "After the search is complete, the entire library is shuffled."
    },
    {
      "oracle_id": "d9517c5d-66d0-4178-96fb-a8c04f311ad8",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Each search works exactly the same as normal except that the opponent doing the searching sees only the top four cards of that library. They can't look at the other cards in that library at all. Cards not in the top four cards of the library can't be found in the search, even if they're identifiable in some manner."
    },
    {
      "oracle_id": "d9517c5d-66d0-4178-96fb-a8c04f311ad8",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If an effect uses the word \"search\" once but allows an opponent to search for multiple cards, the top four cards remain the same throughout the entire search. Finding one card won't cause the fifth card to become included in the search."
    },
    {
      "oracle_id": "82004860-e589-4e38-8d61-8c0210e4ea39",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You pick a card on resolution."
    },
    {
      "oracle_id": "82004860-e589-4e38-8d61-8c0210e4ea39",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You don't reveal the card to your opponent."
    },
    {
      "oracle_id": "82004860-e589-4e38-8d61-8c0210e4ea39",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This card is put directly into your hand. It is not drawn."
    },
    {
      "oracle_id": "8539f295-5d58-4436-a73a-b9277c4c7795",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The land does not count toward your one per turn limit because it was put onto the battlefield by an effect."
    },
    {
      "oracle_id": "8b755881-a72d-4e21-a369-d2924eb4585a",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If you choose to find only one basic land card, you put it onto the battlefield tapped."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    },
    {
      "oracle_id": "7c3944fa-7c86-4979-85a9-86196aa94594",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "If the permanent was an Aura or an Equipment, it becomes unattached from whatever it was attached to."
    },
    {
      "oracle_id": "7c3944fa-7c86-4979-85a9-86196aa94594",
      "published_at": "2014-11-07",
      "source": "wotc",
      "comment": "The enchanted permanent loses any card types, subtypes, and colors it previously had. It keeps any supertypes it had and its name remains unchanged. It gains “{T}: Add {G}” and loses all other abilities from its rules text. It will still have any abilities it gained from other effects."
    },
    {
      "oracle_id": "04d8615c-3883-4251-9790-1d8a4a40e142",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Unlike the normal cycling ability, Plainscycling doesn't allow you to draw a card. Instead, it lets you search your library for a Plains card. After you find a Plains card in your library, you reveal it, put it into your hand, then shuffle your library."
    },
    {
      "oracle_id": "04d8615c-3883-4251-9790-1d8a4a40e142",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Plainscycling is an activated ability. Effects that interact with activated abilities (such as Stifle or Rings of Brighthearth) will interact with Plainscycling. Effects that interact with spells (such as Remove Soul or Faerie Tauntings) will not."
    },
    {
      "oracle_id": "04d8615c-3883-4251-9790-1d8a4a40e142",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "You can choose to find any card with the Plains land type, including nonbasic lands. You can also choose not to find a card, even if there is a Plains card in your library."
    },
    {
      "oracle_id": "04d8615c-3883-4251-9790-1d8a4a40e142",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Plainscycling is a form of cycling. Any ability that triggers on a card being cycled also triggers on Plainscycling this card. Any ability that stops a cycling ability from being activated also stops Plainscycling from being activated."
    },
    {
      "oracle_id": "cc2b6e58-2d6f-495e-95f3-9496105c4cba",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If there are fewer than twenty cards in the targeted player's library, that player puts all the cards from their library into their graveyard."
    },
    {
      "oracle_id": "f4da7a43-e9d5-47ea-b2f0-3cf55a156f4a",
      "published_at": "2007-10-01",
      "source": "wotc",
      "comment": "To activate the second ability, you choose a value of X equal to or less than the number of loyalty counters on Chandra Nalaar. You may choose 0. You can’t choose a negative number."
    },
    {
      "oracle_id": "74b7fe23-5d3a-4092-8d78-7c0eba8f6f73",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "This has the mana abilities associated with both of its basic land types."
    },
    {
      "oracle_id": "74b7fe23-5d3a-4092-8d78-7c0eba8f6f73",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "This has basic land types, but it isn't a basic land. Things that affect basic lands don't affect it. Things that affect basic land types do."
    }
  ]
}
