  "rulings": [
    {
      "oracle_id": "ea86abfa-6cab-4ef0-8463-34136fc25b59",
      "source": "wotc",
      "published_at": "2020-08-07",
      "comment": "Duplicant's base power and toughness change to the imprinted card's power and toughness. Counters and other effects that modify Duplicant's power and toughness still apply."
    },
    {
      "oracle_id": "ea86abfa-6cab-4ef0-8463-34136fc25b59",
      "source": "wotc",
      "published_at": "2020-08-07",
      "comment": "If a melded permanent or a merged permanent is exiled by Duplicant's triggered ability, that ability's controller chooses the relative timestamp of the exiled cards. Duplicant looks at the information of the one with the latest timestamp."
    },
    {
      "oracle_id": "ea86abfa-6cab-4ef0-8463-34136fc25b59",
      "source": "wotc",
      "published_at": "2020-08-07",
      "comment": "Abilities that define a * in a creature's power and toughness apply while that card is in exile, but abilities that add or subtract power and toughness don't. For example, the ability of Crusader of Odric applies to determine Duplicant's power and toughness, but the ability of Death's Shadow doesn't."
    },
    {
      "oracle_id": "ea86abfa-6cab-4ef0-8463-34136fc25b59",
      "source": "wotc",
      "published_at": "2020-08-07",
      "comment": "Duplicant's power and toughness are constantly updated if the exiled card's power and/or toughness change."
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "source": "wotc",
      "published_at": "2006-09-25",
      "comment": "If Pull from Eternity affects a suspended card, the card loses its time counters and is no longer suspended. (This doesn\u2019t trigger the last ability of suspend.)"
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "source": "wotc",
      "published_at": "2006-09-25",
      "comment": "Pull from Eternity targets a card in the exile zone. A card is only face down in the exile zone if the effect that put it there specifically says so."
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "source": "wotc",
      "published_at": "2006-09-25",
      "comment": "If Pull from Eternity affects a card that\u2019s haunting a creature, the haunt effect ends."
    }
  ],
