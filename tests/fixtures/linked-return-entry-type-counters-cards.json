ype_line":"Basic Land — Plains"},{"cmc":4.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}{W}","name":"Semester's End","oracle_id":"3aeba3c2-5517-4870-8802-29b0fa70ffae","oracle_text":"Exile any number of target creatures and/or planeswalkers you control. At the beginning of the next end step, return each of them to the battlefield under its owner's control. Each of them enters with an additional +1/+1 counter on it if it's a creature and an additional loyalty counter on it if it's a planeswalker.","power":null,"produced_mana":[],"released_at":"2023-08-04","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Llanowar Loamspeaker's second ability doesn't untap the land that becomes a creature.","oracle_id":"08377424-619e-48ae-bc3c-fb199cd77cf9","published_at":"2022-09-09","source":"wotc"},{"comment":"Use the characteristics of each permanent as it returns to the battlefield to determine if it should enter with an additional +1/+1 counter, an additional loyalty counter, or in very unusual cases, both. Notably, if you exile a creature that was only a creature because of a type-changing effect, it will enter as a noncreature permanent and won't get any additional +1/+1 counters from the effect of Semester's End.","oracle_id":"3aeba3c2-5517-4870-8802-29b0fa70ffae","published_at":"2021-04-16","source":"wotc"},{"comment":"The creature comes back onto the battlefield as a new creature, with one +1/+1 counter on it (plus any other counters that it would normally enter with).","oracle_id":"4a080242-412d-4968-ad57-2667dab977f5","published_at":"2004-12-01","source":"wotc"},{"comment":"Any Aura attached to the creature is put into its owner's graveyard as a state-based action. Equipment attached to the creature become unattached but remain on the battlefield.","oracle_id":"4a080242-412d-4968-ad57-2667dab977f5","published_at":"2005-08-01","source":"wotc"},{"comment":"If Otherworldly Journey is cast during an end step, the creature won't return until the beginning of the next end step.","oracle_id":"4a080242-412d-4968-ad57-2667dab977f5","published_at":"2005-08-01","source":"wotc"},{"comment":"Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"If there are fewer than twenty cards in the targeted player's library, that player puts all the cards from their library into their graveyard.","oracle_id":"cc2b6e58-2d6f-495e-95f3-9496105c4cba","published_at":"2009-10-01","source":"wotc"},{"comment":"Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it.","oracle_id":"cd0d7141-46d2-4aa3-bc77-6b3b4513803e","published_at":"2016-06-08","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
