_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Master Decoy","oracle_id":"94a16609-8529-4301-8a3d-47ced194f7cd","oracle_text":"{W}, {T}: Tap target creature.","power":"1","produced_mana":[],"released_at":"2015-05-06","toughness":"2","type_line":"Creature — Human Soldier"},{"cmc":0.0,"color_identity":["W"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Plains","oracle_id":"bc71ebf6-2056-41f7-be35-b2e5c34afa99","oracle_text":"({T}: Add {W}.)","power":null,"produced_mana":["W"],"released_at":"2026-11-13","toughness":null,"type_line":"Basic Land — Plains"},{"cmc":1.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"banned","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"banned","modern":"not_legal","oathbreaker":"banned","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"banned","vintage":"restricted"},"loyalty":null,"mana_cost":"{1}","name":"Sol Ring","oracle_id":"6ad8011d-3471-4369-9d68-b264cc027487","oracle_text":"{T}: Add {C}{C}.","power":null,"produced_mana":["C"],"released_at":"2026-06-26","toughness":null,"type_line":"Artifact"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Effects that modify a creature's power and/or toughness, such as the ones created by Titanic Growth or a +1/+1 counter, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch power and toughness.","oracle_id":"02628058-c9d8-4265-afd1-3fb697ec89f7","published_at":"2014-07-18","source":"wotc"},{"comment":"If the artifact was already a creature, its base power and toughness will each become 5. This overwrites any previous effects that set the creature's base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Ensoul Artifact becomes attached to the artifact will overwrite this effect.","oracle_id":"02628058-c9d8-4265-afd1-3fb697ec89f7","published_at":"2014-07-18","source":"wotc"},{"comment":"The artifact retains any types, subtypes, or supertypes it has. Notably, if an Equipment becomes an artifact creature, it usually can't be attached to another creature. If it was attached to a creature, it becomes unattached.","oracle_id":"02628058-c9d8-4265-afd1-3fb697ec89f7","published_at":"2014-07-18","source":"wotc"},{"comment":"The resulting artifact creature will be able to attack on your turn if it's been under your control continuously since the turn began. That is, it doesn't matter how long it's been a creature, just how long it's been on the battlefield.","oracle_id":"02628058-c9d8-4265-afd1-3fb697ec89f7","published_at":"2014-07-18","source":"wotc"},{"comment":"Since Heritage Druid’s activated ability doesn’t have a tap symbol in its cost, you can tap creatures that haven’t been under your control since your most recent turn began (including Heritage Druid itself) to pay the cost.","oracle_id":"0b7f9c71-6f3c-4056-9bed-04b9f2296f3b","published_at":"2016-06-08","source":"wotc"},{"comment":"If an activated ability with {T} in its cost is granted to a creature by an effect (such as Hypervolt Grasp’s effect, for instance), Magewright’s Stone can untap that creature.","oracle_id":"9e500094-c430-4c10-89cc-97f4f18b08bc","published_at":"2006-05-01","source":"wotc"},{"comment":"This looks for the {T} symbol. The phrase “tap an untapped creature you control” isn’t the same and doesn’t count.","oracle_id":"9e500094-c430-4c10-89cc-97f4f18b08bc","published_at":"2006-05-01","source":"wotc"},{"comment":"Gilder Bairn’s ability will replicate each kind of counter on the targeted permanent, not just +1/+1 or -1/-1 counters.","oracle_id":"a4441c7d-e22a-4e19-8365-34d52da9fe86","published_at":"2008-08-01","source":"wotc"},{"comment":"If the permanent is already untapped, you can’t activate its {Q} ability. That’s because you can’t pay the “Untap this permanent” cost.","oracle_id":"a4441c7d-e22a-4e19-8365-34d52da9fe86","published_at":"2008-08-01","source":"wotc"},{"comment":"The “summoning sickness” rule applies to {Q}. If a creature with an {Q} ability hasn’t been under your control since your most recent turn began, you can’t activate that ability. Ignore this rule if the creature also has haste.","oracle_id":"a4441c7d-e22a-4e19-8365-34d52da9fe86","published_at":"2008-08-01","source":"wotc"},{"comment":"When you activate an {Q} ability, you untap the creature with that ability as a cost. The untap can’t be responded to. (The actual ability can be responded to, of course.)","oracle_id":"a4441c7d-e22a-4e19-8365-34d52da9fe86","published_at":"2008-08-01","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
