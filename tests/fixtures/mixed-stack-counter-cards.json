  "rulings": [
    {
      "oracle_id": "16c39265-72d9-4c86-a961-8dd38ff9adcd",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with replicate won't affect the copies."
    },
    {
      "oracle_id": "16c39265-72d9-4c86-a961-8dd38ff9adcd",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Triggered abilities use the word \"when,\" \"whenever,\" or \"at.\" They're often written as \"[Trigger condition], [effect].\" Some keywords (such as prowess) are triggered abilities and will use \"when,\" \"whenever,\" or \"at\" in their reminder text."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "cc2b6e58-2d6f-495e-95f3-9496105c4cba",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If there are fewer than twenty cards in the targeted player's library, that player puts all the cards from their library into their graveyard."
    },
    {
      "oracle_id": "42d8ab49-703a-4fd3-84d0-0a3ac1eafca8",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "Activated abilities contain a colon. They're generally written \"[Cost]: [Effect].\" Some keyword abilities (such as equip) are activated abilities and will have a colon in their reminder text."
    },
    {
      "oracle_id": "42d8ab49-703a-4fd3-84d0-0a3ac1eafca8",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "Triggered abilities use the word \"when,\" \"whenever,\" or \"at.\" They're often written as \"[Trigger condition], [effect].\" Some keywords (such as prowess) are triggered abilities and will use \"when,\" \"whenever,\" or \"at\" in their reminder text."
    },
    {
      "oracle_id": "8ebb6fe0-3ed1-4cc9-bcb1-5317de199efc",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Triggered abilities use the word \"when,\" \"whenever,\" or \"at.\" They're often written as \"[Trigger condition], [effect].\" Some keyword abilities are triggered abilities and will have \"when,\" \"whenever,\" or \"at\" in their reminder text."
    },
    {
      "oracle_id": "8ebb6fe0-3ed1-4cc9-bcb1-5317de199efc",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Tale's End can't target an activated or triggered mana ability. An activated mana ability is one that could add mana as it resolves, doesn't have a target, and isn't a loyalty ability. A triggered mana ability is one that could add mana as it resolves and triggers on an activated mana ability."
    },
    {
      "oracle_id": "8ebb6fe0-3ed1-4cc9-bcb1-5317de199efc",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "If you counter a delayed triggered ability that triggered at the beginning of the \"next\" occurrence of a specified step or phase, that ability won't trigger again the following time that step or phase occurs."
    },
    {
      "oracle_id": "8ebb6fe0-3ed1-4cc9-bcb1-5317de199efc",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Activated abilities are written in the form \"[Cost]: [Effect].\" Some keyword abilities (such as equip) are activated abilities and will have colons in their reminder texts, if applicable."
    },
    {
      "oracle_id": "8ebb6fe0-3ed1-4cc9-bcb1-5317de199efc",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Abilities that create replacement effects, such as a permanent entering the battlefield tapped or with counters on it, can't be targeted. Abilities that apply \"as [this creature] enters the battlefield\" are also replacement effects and can't be targeted."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step."
    },
    {
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2010-06-15",
      "source": "wotc",
      "comment": "This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\"."
