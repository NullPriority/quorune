  "rulings": [
    {
      "oracle_id": "03fde598-5b6b-4c7f-ba13-c06ed1fa918a",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "A “land creature” is a permanent that’s both a land and a creature."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Casting a spell with split second won't affect spells and abilities that are already on the stack."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "After a spell with split second resolves (or otherwise leaves the stack), players may again cast spells and activate abilities before the next object on the stack resolves."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Split second doesn't stop triggered abilities from triggering, such as that of Chalice of the Void. If one does, its controller puts it on the stack and chooses targets for it, if any. Those abilities will resolve as normal."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Players still get priority while a spell with split second is on the stack; their options are just limited to mana abilities and certain special actions."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Players may turn face-down creatures face up while a spell with split second is on the stack."
    },
    {
      "oracle_id": "4e07d30a-d29a-49bc-ab49-41ea4116a18c",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If the resolution of a triggered ability involves casting a spell, that spell can't be cast if a spell with split second is on the stack."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping a multicolored creature using convoke will pay for {1} or one mana of your choice of any of that creature's colors."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You can tap any untapped creature you control to convoke a spell, even one you haven't controlled continuously since the beginning of your most recent turn."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Because convoke isn't an alternative cost, it can be used in conjunction with alternative costs."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If a creature you control has a mana ability with {T} in the cost, activating that ability while casting a spell with convoke will result in the creature being tapped before you pay the spell's costs. You won't be able to tap it again for convoke. Similarly, if you sacrifice a creature to activate a mana ability while casting a spell with convoke, that creature won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for convoke."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping an untapped creature that's attacking or blocking to convoke a spell won't cause that creature to stop attacking or blocking."
    },
    {
      "oracle_id": "674202f0-6832-4392-a118-d513162bcd03",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Convoke applies after the total cost is calculated. Convoke doesn't change a spell's mana cost or mana value."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You can tap any untapped creature you control to convoke a spell, even one you haven't controlled continuously since the beginning of your most recent turn."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If a creature you control has a mana ability with {T} in the cost, activating that ability while casting a spell with convoke will result in the creature being tapped before you pay the spell's costs. You won't be able to tap it again for convoke. Similarly, if you sacrifice a creature to activate a mana ability while casting a spell with convoke, that creature won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for convoke."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Because convoke isn't an alternative cost, it can be used in conjunction with alternative costs."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping an untapped creature that's attacking or blocking to convoke a spell won't cause that creature to stop attacking or blocking."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping a multicolored creature using convoke will pay for {1} or one mana of your choice of any of that creature's colors."
    },
    {
      "oracle_id": "d8b3bcf2-1be1-46ed-9531-ca4ce98e3b3c",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Convoke applies after the total cost is calculated. Convoke doesn't change a spell's mana cost or mana value."
    },
    {
      "oracle_id": "e53fb128-bf90-4af6-b998-ef9c250001cb",
      "published_at": "2026-01-27",
      "source": "wotc",
      "comment": "Spells can only be cast for their sneak costs any time you could play an instant during the declare blockers step on your turn (after your opponent has decided whether to block)."
    },
    {
      "oracle_id": "e53fb128-bf90-4af6-b998-ef9c250001cb",
      "published_at": "2026-01-27",
      "source": "wotc",
      "comment": "If a creature spell's sneak cost was paid, the creature it becomes enters tapped and attacking the same player, planeswalker, or battle as the creature that was returned to its owner's hand to pay its sneak cost. This is a rule specific to sneak; in other cases, when a creature is put onto the battlefield attacking, that creature's controller chooses which player, planeswalker, or battle it's attacking."
    },
    {
      "oracle_id": "e53fb128-bf90-4af6-b998-ef9c250001cb",
      "published_at": "2026-01-27",
      "source": "wotc",
      "comment": "Although a creature put onto the battlefield this way is attacking, it was never declared as an attacking creature. Abilities that trigger whenever a creature attacks won't trigger when that creature enters attacking."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2023-04-14",
      "source": "wotc",
      "comment": "If you choose both modes, and the target of the first mode is an illegal target at the time Artistic Refusal tries to resolve (probably because that spell has been countered by something else), Artistic Refusal won't resolve and none of its effects will happen. You won't draw or discard any cards."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If a creature you control has a mana ability with {T} in the cost, activating that ability while casting a spell with convoke will result in the creature being tapped before you pay the spell's costs. You won't be able to tap it again for convoke. Similarly, if you sacrifice a creature to activate a mana ability while casting a spell with convoke, that creature won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for convoke."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping a multicolored creature using convoke will pay for {1} or one mana of your choice of any of that creature's colors."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You can tap any untapped creature you control to convoke a spell, even one you haven't controlled continuously since the beginning of your most recent turn."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Tapping an untapped creature that's attacking or blocking to convoke a spell won't cause that creature to stop attacking or blocking."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Convoke applies after the total cost is calculated. Convoke doesn't change a spell's mana cost or mana value."
    },
    {
      "oracle_id": "ff192482-3808-4291-a31e-3dfaeb49cda2",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Because convoke isn't an alternative cost, it can be used in conjunction with alternative costs."
    },
    {
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Abilities that Slivers grant, as well as power/toughness boosts, are cumulative. However, for some abilities, like indestructible and the ability granted by Belligerent Sliver, having more than one instance of the ability doesn’t provide any additional benefit."
    },
    {
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "If you change the creature type of a Sliver you control so it’s no longer a Sliver, it will no longer be affected by its own ability. Its ability will continue to affect other Sliver creatures you control."
    },
    {
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Slivers in this set affect only Sliver creatures you control. They don’t grant bonuses to your opponents’ Slivers. This is the same way Slivers from the Magic 2014 core set worked, while Slivers in earlier sets granted bonuses to all Slivers."
    },
    {
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Damage dealt to a Sliver with indestructible is still marked on that creature. If it has lethal damage marked on it and it loses indestructible (perhaps because Sliver Hivelord leaves the battlefield), it will be destroyed."
    },
    {
      "oracle_id": "8e0cea9c-3110-4728-9378-76849e33bb90",
      "published_at": "2012-07-01",
      "source": "wotc",
      "comment": "If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "If Dryad Arbor is changed into another basic land type (such as by Sea's Claim), it continues to be a creature and a Dryad."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2013-06-07",
      "source": "wotc",
      "comment": "Although originally printed with a characteristic-defining ability that defined its color, this card now has a color indicator. This color indicator can't be affected by text-changing effects (such as the one created by Crystal Spray), although color-changing effects can still overwrite it."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If Dryad Arbor is changed into another basic land type, it continues to be a green Dryad creature."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Due to its color indicator (appearing to the left of its type line), Dryad Arbor is green. Color indicators apply in all zones, not just the battlefield."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Dryad Arbor is played as a land. It doesn't use the stack, it's not a spell, it can't be responded to, it has no mana cost, and it counts as your land play for the turn."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Forest is a land type and Dryad is a creature type."
    },
    {
      "oracle_id": "e996cd67-739c-40f4-b276-0042acf26c71",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If a Dryad Arbor gains flash, or you have the ability to play Dryad Arbor as though it had flash (due to Teferi, Mage of Zhalfir or Scout's Warning, for example), you can ignore the normal timing rules for when during your turn you can play a land, but not any other restrictions. You can't play Dryad Arbor during another player's turn, and you can't play Dryad Arbor if you don't have any land plays remaining."
    },
    {
      "oracle_id": "dbd6a94b-62ff-4a10-9d52-bdd90b26e425",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "If multiple \"extra turn\" effects resolve in the same turn, take them in the reverse of the order that the effects resolved. In other words, the most recently created extra turn is taken first."
    }
  ]
}
