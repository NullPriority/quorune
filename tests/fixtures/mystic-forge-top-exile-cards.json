  "rulings": [
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Because you never \"cast\" a land card, Mystic Forge doesn't allow you to play an artifact land from the top of your library."
    },
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "Mystic Forge lets you look at the top card of your library whenever you want (with one restriction—see below), even if you don't have priority. This action doesn't use the stack. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand."
    },
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "You still pay all costs for a spell you cast from your library, including additional costs. You may also pay alternative costs."
    },
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "You must follow the normal timing permissions and restrictions of the spells you cast from your library."
    },
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "If the top card of your library changes while you're casting a spell, playing a land, or activating an ability, you can't look at the new top card until you finish doing so. This means that if you cast the top card of your library, you can't look at the next one until you're done paying for that spell."
    },
    {
      "oracle_id": "994bc16d-fdc6-475c-96df-beeb4d5aa03e",
      "published_at": "2019-07-12",
      "source": "wotc",
      "comment": "If the top card of your library has a morph ability, you can cast it face down from the top of your library, even if it's normally not a colorless card."
    },
    {
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It can target delayed triggered abilities. For example, a card that says \"Whenever a player cycles a card, you may exile target creature. If you do, return that creature to the battlefield at the beginning of the end step.\" triggers when a player cycles a card and creates a delayed trigger that happens at the beginning of the end step. You can choose to target the \"at the beginning of the end step\" trigger when it is placed on the stack at end of turn."
    },
    {
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "An activated ability has a \"Cost: Effect\" format. Look for the colon. A triggered ability starts with \"when\", \"whenever\", or \"at\"."
    },
    {
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Turn-based actions and special actions like the normal card draw, combat damage, or turning a face-down creature face up can't be targeted."
    },
    {
      "oracle_id": "70e165a1-494a-4728-8d7e-1a9f306414db",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If Whip-Spine Drake is face down and blocked by a creature without flying, turning it face up won't cause it to become unblocked or stop the blocking creature from dealing combat damage to it."
    }
  ]
}
