_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{B}","name":"Terror","oracle_id":"b81f041d-98db-4408-9472-c483e4a502bc","oracle_text":"Destroy target nonartifact, nonblack creature. It can't be regenerated.","power":null,"produced_mana":[],"released_at":"2023-01-13","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["First strike"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}{B}","name":"Vampire Hexmage","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","oracle_text":"First strike\nSacrifice this creature: Remove all counters from target permanent.","power":"2","produced_mana":[],"released_at":"2020-08-07","toughness":"1","type_line":"Creature — Vampire Shaman"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Cycling is an activated ability. Effects that interact with activated abilities (such as Stifle or Rings of Brighthearth) will interact with cycling. Effects that interact with spells (such as Remove Soul or Faerie Tauntings) will not.","oracle_id":"4b1fee86-360d-41d8-9238-eff216376732","published_at":"2008-10-01","source":"wotc"},{"comment":"Paying for echo is always optional. When the echo triggered ability resolves, if you can't pay the echo cost or choose not to, you sacrifice that permanent.","oracle_id":"69aa1ac7-17da-4fc9-a3dc-df8a52841f4a","published_at":"2021-06-18","source":"wotc"},{"comment":"Your permanent's echo ability will trigger at the beginning of your upkeep if it entered the battlefield since the beginning of your last upkeep, or if you gained control of it since the beginning of your last upkeep.","oracle_id":"69aa1ac7-17da-4fc9-a3dc-df8a52841f4a","published_at":"2021-06-18","source":"wotc"},{"comment":"If you pay the evoke cost, you can have Shriekmaw's own triggered ability resolve before the evoke triggered ability. You can cast spells after that ability resolves but before you have to sacrifice Shriekmaw.","oracle_id":"717bbb9d-0a5b-4979-a24b-9d54aac7657a","published_at":"2021-03-19","source":"wotc"},{"comment":"To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as an evoke cost), add any cost increases, then apply any cost reductions. The mana value of the spell is determined by only its mana cost, no matter what the total cost to cast that spell was.","oracle_id":"717bbb9d-0a5b-4979-a24b-9d54aac7657a","published_at":"2021-03-19","source":"wotc"},{"comment":"Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.","oracle_id":"bccd8298-e056-4b91-b090-408c75467b92","published_at":"2013-04-15","source":"wotc"},{"comment":"You must sacrifice exactly one creature to cast this spell; you cannot cast it without sacrificing a creature, and you cannot sacrifice additional creatures.","oracle_id":"bccd8298-e056-4b91-b090-408c75467b92","published_at":"2013-04-15","source":"wotc"},{"comment":"Nothing happens if there are no nonartifact, nonblack creatures on the battlefield when Nekrataal enters the battlefield, but if there is one, you must target it, even if it’s a creature you control.","oracle_id":"d40adf5d-5edf-48a0-98f3-fcdbf1b5f25c","published_at":"2016-06-08","source":"wotc"},{"comment":"Becoming an artifact doesn't change what color(s) a permanent is.","oracle_id":"f4bdc551-c2eb-4a34-a3e3-b4a017c925af","published_at":"2011-01-01","source":"wotc"},{"comment":"You may target any permanent with the ability, including an artifact.","oracle_id":"f4bdc551-c2eb-4a34-a3e3-b4a017c925af","published_at":"2011-01-01","source":"wotc"},{"comment":"Any permanent can be targeted by the second ability, not just one with counters on it.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"},{"comment":"Vampire Hexmage's ability can't target a permanent card in a zone other than the battlefield, such as a suspended card.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
