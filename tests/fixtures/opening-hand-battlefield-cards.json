    {
      "oracle_id": "bb87ec08-bb1b-43d8-8809-92904cbba685",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "If you cast a creature with bloodthirst while Leyline of Lightning is on the battlefield, you may use the Leyline's ability to deal damage to an opponent. If you do, that damage is dealt before the creature spell resolves, and the creature will enter with counters from its bloodthirst ability."
    },
    {
      "oracle_id": "bb87ec08-bb1b-43d8-8809-92904cbba685",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins."
    },
    {
      "oracle_id": "bb87ec08-bb1b-43d8-8809-92904cbba685",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "While resolving Leyline of Lightning's second ability, you can't pay {1} multiple times to deal damage multiple times."
    },
    {
      "oracle_id": "cbf2b19e-32a3-489f-9979-ba2748c52845",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If Leyline of Vitality and a creature enter under your control at the same time, Leyline of Vitality's third ability will trigger."
    },
    {
      "oracle_id": "cbf2b19e-32a3-489f-9979-ba2748c52845",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "With a Humility and two Opalescences on the battlefield, if Humility has the latest timestamp, then all creatures are 1/1 with no abilities. If the timestamp order is Opalescence, Humility, Opalescence, the second Opalescence is 1/1, and the Humility and first Opalescence are 4/4. If Humility has the earliest timestamp, then everything is 4/4."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2007-02-01",
      "source": "wotc",
      "comment": "Removes all creature abilities. This includes mana abilities. Animated lands will also lose the ability to tap for mana."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "This is the current interaction between Humility and Opalescence: The type-changing effect applies at layer 4, but the rest happens in the applicable layers. The rest of it will apply even if the permanent loses its ability before it's finished applying. So if Opalescence, Humility, and Worship are on the battlefield and Opalescence entered before Humility, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments. (Opalescence). Layer 6: Humility and Worship each lose their abilities. (Humility) Layer 7b: Humility becomes 4/4 and Worship becomes 4/4. (Opalescence). Humility becomes 1/1 and Worship becomes 1/1 (Humility). But if Humility entered before Opalescence, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments (Opalescence). Layer 6: Humility and Worship each lose their abilities (Humility). Layer 7b: Humility becomes 1/1 and Worship becomes 1/1 (Humility). Humility becomes 4/4 and Worship becomes 4/4 (Opalescence)."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects."
    },
    {
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc",
      "comment": "Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one."
    },
    {
      "oracle_id": "3608f1f7-8dc5-4dd1-ae91-c830e1de9529",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Once a player announces that they're casting a spell or activating an ability, no player may take other actions until the spell or ability has been paid for. Notably, other players can't try to tap that player's permanents to stop them from paying {T} or to stop them from producing enough mana."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Static abilities that prevent damage (including protection abilities) don't do so. If they have additional effects that don't depend on the amount of damage prevented, those additional effects will still work. Such effects are applied only once per source of damage."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If an effect says to set a player's life total to a certain number, and that number is higher than the player's current life total, that part of the effect won't do anything. (If the number is lower than the player's current life total, the effect will work as normal.)"
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Damage prevention shields don't have any effect. If a prevention effect has an additional effect, the additional effect will still work (if possible). Spells that create prevention effects can still be cast, and abilities that create prevention effects can still be activated."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Effects that would replace gaining life with some other effect won't be able to do anything because it's impossible for players to gain life."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Spells and abilities that would normally cause a player to gain life still resolve, but the life-gain part simply has no effect."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Effects that replace an event with gaining life (like Words of Worship's effect does) will end up replacing the event with nothing."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Effects that replace or redirect damage without using the word \"prevent\" are not affected by Leyline of Punishment."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If a creature is dealt lethal damage, it can still regenerate. If it does, the damage marked on it will be removed from it."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If a cost includes life gain (like Invigorate's alternative cost does), that cost can't be paid."
    },
    {
      "oracle_id": "2608df54-dfbe-417d-aef5-49afbdfb03da",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins."
    }
  ]
