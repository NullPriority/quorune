ator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Esper Sentinel","oracle_id":"5def9f38-0a0b-4e8d-9f9d-29dcb46520b4","oracle_text":"Whenever an opponent casts their first noncreature spell each turn, draw a card unless that player pays {X}, where X is this creature's power.","power":"1","produced_mana":[],"released_at":"2021-06-18","toughness":"1","type_line":"Artifact Creature — Human Soldier"},{"cmc":1.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{G}","name":"Giant Growth","oracle_id":"5748ebf1-24e3-499d-ab7c-c2cebd462a24","oracle_text":"Target creature gets +3/+3 until end of turn.","power":null,"produced_mana":[],"released_at":"2026-06-26","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{G}","name":"Shrink","oracle_id":"252330b1-67cf-4d9e-a413-917ba61e731f","oracle_text":"Target creature gets -5/-0 until end of turn.","power":null,"produced_mana":[],"released_at":"2008-09-22","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Cloudshift","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","oracle_text":"Exile target creature you control, then return that card to the battlefield under your control.","power":null,"produced_mana":[],"released_at":"2025-11-21","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If an opponent is instructed to draw multiple cards, that player draws all of them before deciding how many times to pay as the multiple triggered abilities from Smothering Tithe resolve.","oracle_id":"153376c9-dffd-458c-8ce3-a4c8269bc4e9","published_at":"2023-09-01","source":"wotc"},{"comment":"Rhystic Study's triggered ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered. The player gets the option to pay when this triggered ability resolves.","oracle_id":"53236dd7-845a-444c-96d5-f41ed7325d8f","published_at":"2023-09-01","source":"wotc"},{"comment":"You don't have to decide whether or not to draw a card until after the player decides whether or not to pay.","oracle_id":"53236dd7-845a-444c-96d5-f41ed7325d8f","published_at":"2023-09-01","source":"wotc"},{"comment":"Cumulative upkeep is a triggered ability that imposes an increasing cost on a permanent. \"Cumulative upkeep [cost]\" means \"At the beginning of your upkeep, if this permanent is on the battlefield, put an age counter on this permanent. Then you may pay [cost] for each age counter on it. If you don't, sacrifice it.\"","oracle_id":"8a52f3c0-2552-4425-b2e3-5496eb2232a7","published_at":"2025-10-02","source":"wotc"},{"comment":"Paying cumulative upkeep is always optional. If it's not paid, the permanent with cumulative upkeep is sacrificed. Partial payments of the total cumulative upkeep cost can't be made. For example, if Mystic Remora has three age counters on it when its cumulative upkeep ability triggers, it gets another age counter and then its controller chooses to either pay {4} or sacrifice it.","oracle_id":"8a52f3c0-2552-4425-b2e3-5496eb2232a7","published_at":"2025-10-02","source":"wotc"},{"comment":"If Esper Sentinel's has negative power when this ability resolves, then {X} is {0}. The opponent may still choose not to pay the cost if they want you to draw a card.","oracle_id":"5def9f38-0a0b-4e8d-9f9d-29dcb46520b4","published_at":"2021-06-18","source":"wotc"},{"comment":"If a noncreature spell was already cast by an opponent the turn Esper Sentinel enters the battlefield, that opponent already cast their first noncreature spell this turn, and Esper Sentinel's ability won't trigger for that opponent that turn.","oracle_id":"5def9f38-0a0b-4e8d-9f9d-29dcb46520b4","published_at":"2021-06-18","source":"wotc"},{"comment":"This ability checks Esper Sentinel's power when it resolves, not when the ability goes on the stack. If Esper Sentinel is no longer on the battlefield when it resolves, use the power it had the last time it was on the battlefield.","oracle_id":"5def9f38-0a0b-4e8d-9f9d-29dcb46520b4","published_at":"2021-06-18","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won't return to the battlefield.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
