    {
      "oracle_id": "2e0b838d-c858-4aa5-999e-c4ef9d29571b",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "You must sacrifice exactly one creature to cast Demon of Catastrophes; you can’t cast it without sacrificing a creature, and you can’t sacrifice additional creatures."
    },
    {
      "oracle_id": "2e0b838d-c858-4aa5-999e-c4ef9d29571b",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Players can respond only after Demon of Catastrophes has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "If you apply Fist of Suns's alternative cost to a spell with {X} in its mana cost, X is 0."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "Fist of Suns's ability is an alternative cost to cast a spell. You can't combine this with other alternative costs, such as flashback. You can pay additional costs, such as kicker, in addition to this alternative cost."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "If you cast a spell for which mana of any color can be spent to cast it, you may cast it for Fist of Suns's alternative cost and still spend any color of mana to cover that cost."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2014-02-01",
      "source": "wotc",
      "comment": "If you pay {W}{U}{B}{R}{G} rather than pay the mana cost of a spell with {X} in its mana cost, the only legal choice for X is 0."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Gift of Tusks resolves, it will keep that ability."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Gift of Tusks doesn’t counter abilities that have already triggered or been activated. In particular, there is no way to cast this spell to stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "The creature will lose all other colors and creature types, but it will retain any other card types (such as artifact) or supertypes (such as legendary) it may have."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "c0307f8d-b39a-4180-8a45-ddc019ee39f6",
      "published_at": "2016-01-22",
      "source": "wotc",
      "comment": "Gift of Tusks overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Gift of Tusks resolves will overwrite this effect."
    },
    {
      "oracle_id": "09c96077-3804-4f12-a613-5bebc5e0413f",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It affects all players, including you."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If a spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "You must follow the normal timing permissions and restrictions of each spell you cast."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If you cast a spell \"without paying its mana cost,\" you can't choose to cast it for any alternative costs. You can, however, pay additional costs, such as kicker costs. If the card has any mandatory additional costs, such as that of Tormenting Voice, those must be paid to cast the spell."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Once you cast Omniscience, if it's your turn, you'll have priority immediately after it resolves. You can cast another spell before any player can attempt to remove Omniscience with spells or abilities."
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If a spell's kicker cost was paid, the spell is \"kicked.\""
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If you copy a kicked spell on the stack, the copy is also kicked. If the copied spell is a permanent spell, the token the copy of that spell becomes when it enters is also kicked."
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "The kicker ability doesn't let you pay a kicker cost more than once."
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If you put a permanent with a kicker ability onto the battlefield without casting it, you can't kick it."
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "To determine a spell's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases (such as kicker), then apply any cost reductions. The spell's mana value remains unchanged, no matter what the total cost to cast it was."
    },
    {
      "oracle_id": "e5481431-c952-4ad9-94fe-355076ef632b",
      "published_at": "2024-11-08",
      "source": "wotc",
      "comment": "If a card or token enters as a copy of a permanent, the new permanent isn't kicked, even if the original was."
    }
  ]
