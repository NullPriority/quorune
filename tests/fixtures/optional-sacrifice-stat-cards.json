  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Fungal Sprouting doesn’t target any creature. The greatest power among creatures you control is determined when Fungal Sprouting resolves.",
      "oracle_id": "303d4533-0c6b-4f93-80e8-b1f5926f4cd4",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "Check the sacrificed creature’s toughness as it last existed on the battlefield to determine how many Wolves you put onto the battlefield.",
      "oracle_id": "48981194-6465-4900-8cea-206f8ab5d00e",
      "published_at": "2011-01-22",
      "source": "wotc"
    },
    {
      "comment": "You choose whether to sacrifice a nontoken creature and which creature to sacrifice when Feed the Pack’s ability resolves.",
      "oracle_id": "48981194-6465-4900-8cea-206f8ab5d00e",
      "published_at": "2011-01-22",
      "source": "wotc"
    },
    {
      "comment": "The sacrificed creature’s last known existence on the battlefield is checked to determine its power and its toughness.",
      "oracle_id": "6a5ce1b0-ac78-4a74-9eb7-4064e1687bf1",
      "published_at": "2010-06-15",
      "source": "wotc"
    },
    {
      "comment": "Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.",
      "oracle_id": "6a5ce1b0-ac78-4a74-9eb7-4064e1687bf1",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "You must sacrifice exactly one creature to cast this spell; you cannot cast it without sacrificing a creature, and you cannot sacrifice additional creatures.",
      "oracle_id": "6a5ce1b0-ac78-4a74-9eb7-4064e1687bf1",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If you control at least one other creature when the ability resolves, you must sacrifice one. If you don't control any other creatures at that time, the ability won't do anything.",
      "oracle_id": "8f2c8498-5b10-4ec7-8678-598c90987556",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "The creature's power as it last existed on the battlefield is the amount of life you gain and the number of cards you draw.",
      "oracle_id": "8f2c8498-5b10-4ec7-8678-598c90987556",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "An activated ability has a \"Cost: Effect\" format. Look for the colon. A triggered ability starts with \"when\", \"whenever\", or \"at\".",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "It can target delayed triggered abilities. For example, a card that says \"Whenever a player cycles a card, you may exile target creature. If you do, return that creature to the battlefield at the beginning of the end step.\" triggers when a player cycles a card and creates a delayed trigger that happens at the beginning of the end step. You can choose to target the \"at the beginning of the end step\" trigger when it is placed on the stack at end of turn.",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Turn-based actions and special actions like the normal card draw, combat damage, or turning a face-down creature face up can't be targeted.",
      "oracle_id": "b3b00911-ece7-4484-bc36-f211ce72b6cc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.",
      "oracle_id": "cb7baa46-7963-4d45-9a6e-e3c34db3c0e6",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "You must sacrifice exactly one creature to cast this spell; you can't cast it without sacrificing a creature, and you can't sacrifice additional creatures.",
      "oracle_id": "cb7baa46-7963-4d45-9a6e-e3c34db3c0e6",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it.",
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "If you don't have three cards in hand when instructed to discard three cards, you discard your hand.",
      "oracle_id": "dc0593c2-ccb4-4648-a592-c5bcd121dc72",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "Use the sacrificed creature's power as it last existed on the battlefield to determine how many cards you draw.",
      "oracle_id": "dc0593c2-ccb4-4648-a592-c5bcd121dc72",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "You draw and discard cards all while Greater Good's ability is resolving. Nothing can happen between the two, and no player may choose to take actions.",
      "oracle_id": "dc0593c2-ccb4-4648-a592-c5bcd121dc72",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "Abilities that Slivers grant, as well as power/toughness boosts, are cumulative. However, for some abilities, like indestructible and the ability granted by Belligerent Sliver, having more than one instance of the ability doesn’t provide any additional benefit.",
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "Damage dealt to a Sliver with indestructible is still marked on that creature. If it has lethal damage marked on it and it loses indestructible (perhaps because Sliver Hivelord leaves the battlefield), it will be destroyed.",
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "If you change the creature type of a Sliver you control so it’s no longer a Sliver, it will no longer be affected by its own ability. Its ability will continue to affect other Sliver creatures you control.",
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "Slivers in this set affect only Sliver creatures you control. They don’t grant bonuses to your opponents’ Slivers. This is the same way Slivers from the Magic 2014 core set worked, while Slivers in earlier sets granted bonuses to all Slivers.",
      "oracle_id": "e4fe33e7-b952-4152-8c83-81d948756d2f",
      "published_at": "2014-07-18",
      "source": "wotc"
    },
    {
      "comment": "In a multiplayer game, if a player loses the game, triggered abilities that player controls are removed from the stack and no more from that player can be added. This means that if a creature an opponent controls dies while you control Fecundity, and you lose the game before Fecundity’s triggered ability resolves (perhaps because you lost the game at the same time that the creature died), that player won’t draw a card.",
      "oracle_id": "ffa64ac6-fe55-48b8-b015-849982cd7ad8",
      "published_at": "2018-12-07",
      "source": "wotc"
    },
    {
      "comment": "If Blood Artist and one or more other creatures die at the same time, its ability will trigger for each of those creatures.",
      "oracle_id": "310f141c-7f37-4729-aed6-dd9c09db448d",
      "published_at": "2016-06-08",
      "source": "wotc"
    }
  ],
