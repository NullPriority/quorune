  "rulings": [
    {
      "comment": "The ability is mandatory. You can\u2019t choose to draw fewer cards than the number of lore counters on Mind Unbound.",
      "oracle_id": "0f12aec9-5898-4261-bebd-1b545e0aea68",
      "published_at": "2011-09-22",
      "source": "wotc"
    },
    {
      "comment": "If the permanent or player is an illegal target as Master the Way tries to resolve, Master the Way won\u2019t resolve and none of its effects will happen. You won\u2019t draw a card.",
      "oracle_id": "909a10f5-a607-474f-8b8b-0176fd840650",
      "published_at": "2014-09-20",
      "source": "wotc"
    },
    {
      "comment": "Use the number of cards in your hand after you draw the card to determine how much damage Master the Way deals to the target permanent or player. (Remember that Master the Way is not in your hand; it\u2019s on the stack.)",
      "oracle_id": "909a10f5-a607-474f-8b8b-0176fd840650",
      "published_at": "2014-09-20",
      "source": "wotc"
    },
    {
      "comment": "Although the common lands have basic land types, they aren't basic lands.",
      "oracle_id": "be811e70-aaaa-41f3-bf9e-5d3f9f719b49",
      "published_at": "2019-10-04",
      "source": "wotc"
    },
    {
      "comment": "No player may take actions between the time you draw a card and the time you lose life.",
      "oracle_id": "be811e70-aaaa-41f3-bf9e-5d3f9f719b49",
      "published_at": "2019-10-04",
      "source": "wotc"
    },
    {
      "comment": "Once the common lands (such as Mystic Sanctuary) enter the battlefield tapped, there's no way to untap them with a spell or ability to make their last ability trigger.",
      "oracle_id": "be811e70-aaaa-41f3-bf9e-5d3f9f719b49",
      "published_at": "2019-10-04",
      "source": "wotc"
    }
  ],
