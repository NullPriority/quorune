  "rulings": [
    {
      "comment": "Zhur-Taa Druid’s last ability isn’t a mana ability. It uses the stack and can be responded to.",
      "oracle_id": "5979310e-38c8-489f-ab9e-2723af98a3a5",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "Zhur-Taa Druid’s last ability doesn’t trigger if it becomes tapped for any other reason. However, if Zhur-Taa Druid gains another mana ability that requires you tap it, its ability will trigger.",
      "oracle_id": "5979310e-38c8-489f-ab9e-2723af98a3a5",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If you tap Zhur-Taa Druid for mana during the process of casting a spell or activating an ability, its triggered ability will resolve before that spell or ability.",
      "oracle_id": "5979310e-38c8-489f-ab9e-2723af98a3a5",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If a creature has multiple mana abilities with a cost of {T}, such as if you control two Cryptolith Rites, you can only activate one of them at a time. Tapping the creature doesn’t produce multiple mana.",
      "oracle_id": "043f869d-b11c-4c0d-9591-2bf0df7bde55",
      "published_at": "2016-04-08",
      "source": "wotc"
    }
  ],
