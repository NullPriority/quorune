not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}","name":"The Ozolith","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","oracle_text":"Whenever a creature you control leaves the battlefield, if it had counters on it, put those counters on The Ozolith.\nAt the beginning of combat on your turn, if The Ozolith has counters on it, you may move all counters from The Ozolith onto target creature.","power":null,"produced_mana":[],"released_at":"2020-04-24","toughness":null,"type_line":"Legendary Artifact"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["First strike"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}{B}","name":"Vampire Hexmage","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","oracle_text":"First strike\nSacrifice this creature: Remove all counters from target permanent.","power":"2","produced_mana":[],"released_at":"2020-08-07","toughness":"1","type_line":"Creature — Vampire Shaman"},{"cmc":1.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}","name":"Village Rites","oracle_id":"365548fb-5acc-4a8a-b20b-26d28b7d029f","oracle_text":"As an additional cost to cast this spell, sacrifice a creature.\nDraw two cards.","power":null,"produced_mana":[],"released_at":"2025-01-24","toughness":null,"type_line":"Instant"},{"cmc":6.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":["Haste","Trample"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}{G}{G}","name":"Vorinclex, Monstrous Raider","oracle_id":"5a3fdf5a-bff8-4896-b288-3f43f9a72d9b","oracle_text":"Trample, haste\nIf you would put one or more counters on a permanent or player, put twice that many of each of those kinds of counters on that permanent or player instead.\nIf an opponent would put one or more counters on a permanent or player, they put half that many of each of those kinds of counters on that permanent or player instead, rounded down.","power":"6","produced_mana":[],"released_at":"2021-02-05","toughness":"6","type_line":"Legendary Creature — Phyrexian Praetor"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"+1/+1 counters on The Ozolith have no effect unless it becomes a creature. Keyword counters on The Ozolith will grant it keywords that may have no practical effect. For example, flying on a noncreature artifact is just strange, but hexproof on a noncreature artifact is entirely useful.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"As The Ozolith's last ability resolves, you choose whether to move the counters.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"If The Ozolith leaves the battlefield after the last ability triggers but before it resolves, you can't move any counters from it onto the target creature.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"If the target creature is an illegal target by the time The Ozolith's last ability tries to resolve, the ability won't resolve. You won't remove any counters from The Ozolith.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"The Ozolith's first ability doesn't move counters off the creature that's left the battlefield. Rather, you put the same number of each kind of counter the creature had onto The Ozoloith. Notably, if you somehow control a second The Ozolith, each one will receive the same number and kinds of counters that were on the creature that left the battlefield. Similarly, if the creature has an ability that triggers when it leaves the battlefield that refers to the number of counters it had, that ability will use the number of counters that were on the permanent, even if The Ozolith's first ability resolves first.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"You can't move only some of the counters from The Ozolith onto the target creature.","oracle_id":"1946ded1-5f53-409f-b0a6-5433bb0357d2","published_at":"2020-04-17","source":"wotc"},{"comment":"You must sacrifice exactly one creature to cast this spell; you can't cast it without sacrificing a creature, and you can't sacrifice additional creatures.","oracle_id":"365548fb-5acc-4a8a-b20b-26d28b7d029f","published_at":"2021-02-05","source":"wotc"},{"comment":"If a permanent enters the battlefield with counters on it, the effect causing the permanent to be given counters may specify which player puts those counters on it. If the effect doesn’t specify a player, the object’s controller puts those counters on it.","oracle_id":"5a3fdf5a-bff8-4896-b288-3f43f9a72d9b","published_at":"2021-02-05","source":"wotc"},{"comment":"If two or more effects attempt to modify how many counters would be put onto a permanent you control, you choose the order to apply those effects, no matter who controls the sources of those effects.","oracle_id":"5a3fdf5a-bff8-4896-b288-3f43f9a72d9b","published_at":"2021-02-05","source":"wotc"},{"comment":"Unlike many similar effects, Vorinclex cares deeply about who is putting the counters on the permanent or player to determine which of its two last abilities applies.","oracle_id":"5a3fdf5a-bff8-4896-b288-3f43f9a72d9b","published_at":"2021-02-05","source":"wotc"},{"comment":"The two targets can have different card types. For example, you can target one artifact and one creature with Ghostly Flicker.","oracle_id":"ad0070db-6454-41cb-861f-8f5b8fc2a3b8","published_at":"2017-03-14","source":"wotc"},{"comment":"Any permanent can be targeted by the second ability, not just one with counters on it.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"},{"comment":"Vampire Hexmage's ability can't target a permanent card in a zone other than the battlefield, such as a suspended card.","oracle_id":"fcb2a95b-cef0-4b29-8b2b-538f380aff2b","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
