  "rulings": [
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "Casting Scourge of Nel Toth from your graveyard by paying the alternative cost doesn’t change when you can cast it. You can cast it only at the normal time you could cast a creature spell."
    },
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "If you cast Scourge of Nel Toth from your graveyard, it is a spell and can be countered."
    },
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "As soon as you start to cast Scourge of Nel Toth from your graveyard, it moves to the stack. At that point, it’s too late for an opponent to prevent you from casting it by removing it from your graveyard. It’s also too late for players to try to destroy the creatures you sacrifice to pay for the spell."
    },
    {
      "oracle_id": "d185c829-ef12-403a-a071-7520a0293d4a",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "If the enchanted creature dies during your turn, you receive priority before any other player does. If you're allowed to cast Demonic Embrace at that time, you may do so before any player can attempt to remove it from your graveyard."
    },
    {
      "oracle_id": "d185c829-ef12-403a-a071-7520a0293d4a",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "If another effect gives you permission to cast Demonic Embrace from your graveyard, you don't pay the additional cost imposed by its last ability if you use that permission."
    },
    {
      "oracle_id": "d185c829-ef12-403a-a071-7520a0293d4a",
      "published_at": "2020-06-23",
      "source": "wotc",
      "comment": "Casting Demonic Embrace with the permission granted by its last ability doesn't change when you can cast it."
    },
    {
      "oracle_id": "4b216b4d-f9cb-4ce2-af70-c91eef3db083",
      "published_at": "2022-10-07",
      "source": "wotc",
      "comment": "You still need to follow all normal timing restrictions when casting Helbrute from your graveyard using the permission granted by its last ability. Usually, this means you may only cast it during one of your own main phases while the stack is empty."
    },
    {
      "oracle_id": "67c50af9-bb8e-40b6-8b25-c209784b6865",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "As soon as you start to cast Worldheart Phoenix from your graveyard, the card moves onto the stack. At that point, it's too late for an opponent to prevent you from casting it by removing it from your graveyard."
    },
    {
      "oracle_id": "67c50af9-bb8e-40b6-8b25-c209784b6865",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "If you cast Worldheart Phoenix this way, it is a spell and can be countered."
    },
    {
      "oracle_id": "67c50af9-bb8e-40b6-8b25-c209784b6865",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Casting Worldheart Phoenix from your graveyard by paying its alternative cost doesn't change when you can cast it. You can cast it only at the normal time you could cast a creature spell."
    },
    {
      "oracle_id": "8587ec98-f35d-476c-ba67-0ef8bcd1f253",
      "published_at": "2015-02-25",
      "source": "wotc",
      "comment": "Once you start to cast Risen Executioner from your graveyard, you’ll finish casting it, including paying its cost, before any player receives priority. No one can respond in time to affect the cost you’ll pay (perhaps by destroying one of your other creatures)."
    },
    {
      "oracle_id": "8587ec98-f35d-476c-ba67-0ef8bcd1f253",
      "published_at": "2015-02-25",
      "source": "wotc",
      "comment": "Risen Executioner’s last ability doesn’t change when you can cast it."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If a spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "You must follow the normal timing permissions and restrictions of each spell you cast."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If you cast a spell \"without paying its mana cost,\" you can't choose to cast it for any alternative costs. You can, however, pay additional costs, such as kicker costs. If the card has any mandatory additional costs, such as that of Tormenting Voice, those must be paid to cast the spell."
    },
    {
      "oracle_id": "730e39e6-c61d-48b5-8827-bfd952bf1be7",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Once you cast Omniscience, if it's your turn, you'll have priority immediately after it resolves. You can cast another spell before any player can attempt to remove Omniscience with spells or abilities."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "You must be able to target a card in a graveyard to cast Cremate."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "If you apply Fist of Suns's alternative cost to a spell with {X} in its mana cost, X is 0."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "Fist of Suns's ability is an alternative cost to cast a spell. You can't combine this with other alternative costs, such as flashback. You can pay additional costs, such as kicker, in addition to this alternative cost."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "If you cast a spell for which mana of any color can be spent to cast it, you may cast it for Fist of Suns's alternative cost and still spend any color of mana to cover that cost."
    },
    {
      "oracle_id": "6fd5e591-fae8-4128-a4d3-a848c8a8ffda",
      "published_at": "2014-02-01",
      "source": "wotc",
      "comment": "If you pay {W}{U}{B}{R}{G} rather than pay the mana cost of a spell with {X} in its mana cost, the only legal choice for X is 0."
    }
  ]
