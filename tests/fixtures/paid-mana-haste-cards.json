  "rulings": [
    {
      "oracle_id": "32fe7ac4-86f5-44af-9f73-ee8f6a9ce2ba",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "The effect that grants haste doesn’t wear off at end of turn."
    },
    {
      "oracle_id": "32fe7ac4-86f5-44af-9f73-ee8f6a9ce2ba",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "The creature has haste if the mana is spent to cover any cost of the spell, even an additional cost."
    },
    {
      "oracle_id": "651c967c-8f71-4eb5-b22f-545e55ea050e",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "An instant or sorcery spell is not a creature spell, even if that spell creates Dragon creature tokens."
    },
    {
      "oracle_id": "651c967c-8f71-4eb5-b22f-545e55ea050e",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "If the mana is spent on a non-Dragon spell that becomes a Dragon later in the turn, that creature won't have haste."
    },
    {
      "oracle_id": "651c967c-8f71-4eb5-b22f-545e55ea050e",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "If the mana from Carnelian Orb of Dragonkind is spent to pay any part of the Dragon creature spell's cost, including an alternative or additional cost, the Dragon will gain haste until end of turn."
    },
    {
      "oracle_id": "651c967c-8f71-4eb5-b22f-545e55ea050e",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "The mana created by Carnelian Orb of Dragonkind can be spent on anything, not just Dragon creature spells."
    },
    {
      "oracle_id": "68ac061a-e4a3-46df-9169-62f6a8481584",
      "published_at": "2018-12-07",
      "source": "wotc",
      "comment": "An instant or sorcery spell is not a creature spell, even if that spell creates creature tokens."
    },
    {
      "oracle_id": "68ac061a-e4a3-46df-9169-62f6a8481584",
      "published_at": "2018-12-07",
      "source": "wotc",
      "comment": "If the mana is spent on two different creature spells, each of those spells (and resulting creatures) will gain haste until end of turn."
    },
    {
      "oracle_id": "68ac061a-e4a3-46df-9169-62f6a8481584",
      "published_at": "2018-12-07",
      "source": "wotc",
      "comment": "If the mana is spent on a noncreature spell that becomes a creature later in the turn, that creature won't have haste."
    },
    {
      "oracle_id": "68ac061a-e4a3-46df-9169-62f6a8481584",
      "published_at": "2018-12-07",
      "source": "wotc",
      "comment": "If a creature spell has generic mana only in its alternative or additional cost, the creature will still gain haste."
    },
    {
      "oracle_id": "5715ed43-395c-4877-99a7-8e28e7bf9dce",
      "published_at": "2025-11-17",
      "source": "wotc",
      "comment": "Sources of the chosen creature type include any objects with the chosen subtype. For example, if you chose Kithkin, you could spend the mana to activate the ability of a Kithkin permanent you control or a Kithkin card in your hand or graveyard."
    }
