  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "Sacrificing an animated land gives no mana since the converted mana cost was zero.",
      "oracle_id": "068b3692-411b-44d4-a7e9-005262760cfc",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.",
      "oracle_id": "068b3692-411b-44d4-a7e9-005262760cfc",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "You must sacrifice exactly one creature to cast this spell; you cannot cast it without sacrificing a creature, and you cannot sacrifice additional creatures.",
      "oracle_id": "068b3692-411b-44d4-a7e9-005262760cfc",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If a permanent has {X} in its mana cost, X is considered to be 0.",
      "oracle_id": "59c620fb-a58d-4038-a7e2-0185324b5123",
      "published_at": "2016-09-20",
      "source": "wotc"
    },
    {
      "comment": "If an effect copies Morbid Curiosity, the controller of the copy will draw the same number of cards as determined by the original. Its controller can't and doesn't have to sacrifice a permanent.",
      "oracle_id": "59c620fb-a58d-4038-a7e2-0185324b5123",
      "published_at": "2016-09-20",
      "source": "wotc"
    },
    {
      "comment": "To determine how many cards to draw, use the mana value of the permanent immediately before you sacrificed it.",
      "oracle_id": "59c620fb-a58d-4038-a7e2-0185324b5123",
      "published_at": "2016-09-20",
      "source": "wotc"
    },
    {
      "comment": "If a card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "If you cast a card this way, you may not cast it for any other alternative costs it has, but you may pay for additional costs, such as kicker costs. If the spell requires an additional cost, you must pay that cost.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "If your opponent discards a card while you control Dauthi Voidwalker, abilities that function when that card is discarded still work, even though that card never reaches that player's graveyard. In addition, spells or abilities that check the characteristics of the discarded card can find that card in exile.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "Playing a card with Dauthi Voidwalker's last ability is still subject to normal timing restrictions.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "Tokens still die while Dauthi Voidwalker is on the battlefield.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "While Dauthi Voidwalker is on the battlefield, nontoken creatures your opponents control won't die. They'll be exiled instead. Abilities that would trigger when those creatures die won't trigger.",
      "oracle_id": "f1c2dbe2-fbe0-4058-bdf1-91d1b1832786",
      "published_at": "2021-06-18",
      "source": "wotc"
    }
  ],
