  "rulings": [
    {
      "comment": "Gadrak's last ability counts creatures that died during the entire turn, even ones that died before Gadrak entered the battlefield.",
      "oracle_id": "42d7ec93-0943-43e2-9b65-b7edc3349410",
      "published_at": "2020-06-23",
      "source": "wotc"
    },
    {
      "comment": "Once Gadrak has attacked, it will remain an attacking creature even if you no longer control four or more artifacts.",
      "oracle_id": "42d7ec93-0943-43e2-9b65-b7edc3349410",
      "published_at": "2020-06-23",
      "source": "wotc"
    },
    {
      "comment": "The value of X is determined only as the triggered ability resolves. If Liliana's Standard Bearer dies while that ability's on the stack, it will count itself.",
      "oracle_id": "7b600c0e-5ad2-48a2-a147-346ca78c8629",
      "published_at": "2020-06-23",
      "source": "wotc"
    }
