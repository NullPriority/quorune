  "rulings": [
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Evoke doesn't change the timing of when you can cast the creature that has it. If you could cast that creature spell only when you could cast a sorcery, the same is true for cast it with evoke."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Effects that cause you to pay more or less to cast a spell will cause you to pay that much more or less while casting it for its evoke cost, too. That's because they affect the total cost of the spell, not its mana cost."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "When you cast a spell by paying its evoke cost, its mana cost doesn't change. You just pay the evoke cost instead."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "If a creature spell cast with evoke changes controllers before it enters, it will still be sacrificed when it enters. Similarly, if a creature cast with evoke changes controllers after it enters but before its sacrifice ability resolves, it will still be sacrificed. In both cases, the controller of the creature at the time it left the battlefield will control its leaves-the-battlefield ability."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "If you're casting a spell \"without paying its mana cost,\" you can't use its evoke ability."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "Whether evoke's sacrifice ability triggers when the creature enters depends on whether the spell's controller chose to pay the evoke cost, not whether they actually paid it (if it was reduced or otherwise altered by another ability, for example)."
    },
    {
      "oracle_id": "1be13ede-98f8-497e-800c-03e5802932b3",
      "published_at": "2018-12-07",
      "source": "wotc",
      "comment": "Reveillark's ability may target zero, one, or two creature cards in your graveyard. Each target must have power 2 or less."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If the chosen creature is copying something else (for example, if the chosen creature is another Mirror Image), then Mirror Image enters the battlefield as whatever the chosen creature copied."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Any enters-the-battlefield abilities of the copied creature will trigger when Mirror Image enters the battlefield. Any \"as [this creature] enters the battlefield\" or \"[this creature] enters the battlefield with\" abilities of the chosen creature will also work."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If Mirror Image somehow enters the battlefield at the same time as another creature, it can't become a copy of that creature. You may choose only a creature that's already on the battlefield."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Mirror Image copies exactly what was printed on the original creature (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or any Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If the copied creature has {X} in its mana cost, X is considered to be 0."
    },
    {
      "oracle_id": "7275fb8c-571a-4c4c-889a-829419332e51",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "If the chosen creature is a token, Mirror Image copies the original characteristics of that token as stated by the effect that put the token onto the battlefield. Mirror Image doesn't become a token in this case."
    },
    {
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card.",
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "You must be able to target a card in a graveyard to cast Cremate.",
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc"
    }
  ]
}
