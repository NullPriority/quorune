  "rulings": [
    {
      "comment": "Mana produced by Ancient Ziggurat can be spent on any part of a creature spell's total cost. This includes additional costs (such as kicker) and alternative costs (such as evoke or Worldheart Phoenix's alternative cost).",
      "oracle_id": "0baabe39-72ae-47bd-a095-cbf7eb8a6361",
      "published_at": "2009-02-01",
      "source": "wotc"
    },
    {
      "comment": "Mana produced by Ancient Ziggurat can't be spent on activated abilities that put a creature card directly onto the battlefield, such as unearth or ninjutsu.",
      "oracle_id": "0baabe39-72ae-47bd-a095-cbf7eb8a6361",
      "published_at": "2009-02-01",
      "source": "wotc"
    },
    {
      "comment": "The draw step is after the upkeep step, so you'll scry 1 before you draw for the turn.",
      "oracle_id": "5f2a3797-28aa-4c7a-ba2b-fd243a1747fd",
      "published_at": "2017-02-09",
      "source": "wotc"
    },
    {
      "comment": "Lifecrafter's Bestiary's second triggered ability resolves before the spell that caused it to trigger. The ability will resolve even if that spell is countered.",
      "oracle_id": "5f2a3797-28aa-4c7a-ba2b-fd243a1747fd",
      "published_at": "2017-02-09",
      "source": "wotc"
    },
    {
      "comment": "While resolving Lifecrafter's Bestiary's second triggered ability, you can't pay {G} multiple times to draw multiple cards.",
      "oracle_id": "5f2a3797-28aa-4c7a-ba2b-fd243a1747fd",
      "published_at": "2017-02-09",
      "source": "wotc"
    }]
