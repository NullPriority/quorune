  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "In a Commander game where this card is your commander, casting it from the Command zone does not count as casting it from your hand.",
      "oracle_id": "8e3eafd7-5823-4cc1-bdb8-c456580e395a",
      "published_at": "2013-07-01",
      "source": "wotc"
    },
    {
      "comment": "As a Saga with read ahead enters the battlefield, its controller chooses a number from one to that Saga\u2019s greatest chapter number. The Saga enters the battlefield with the chosen number of lore counters. Neither choosing the number nor putting the counters on the Saga use the stack, and neither can be responded to.",
      "oracle_id": "f5186d3f-52b2-43ef-be11-d183ab765663",
      "published_at": "2022-09-09",
      "source": "wotc"
    },
    {
      "comment": "If an ability triggers whenever you activate an exhaust ability, that ability resolves before the exhaust ability resolves.",
      "oracle_id": "582c7e54-d64c-4ffb-ae5f-d2752b3ed10b",
      "published_at": "2025-02-07",
      "source": "wotc"
    },
    {
      "comment": "If an exhaust ability of a permanent is activated, and then that permanent leaves the battlefield and returns to the battlefield, it becomes a new object so its exhaust ability can be activated again.",
      "oracle_id": "582c7e54-d64c-4ffb-ae5f-d2752b3ed10b",
      "published_at": "2025-02-07",
      "source": "wotc"
    },
    {
      "comment": "Exhaust abilities can be activated any time you could normally activate an ability.",
      "oracle_id": "582c7e54-d64c-4ffb-ae5f-d2752b3ed10b",
      "published_at": "2025-02-07",
      "source": "wotc"
    },
    {
      "comment": "If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one.",
      "oracle_id": "a1f3da21-af6d-450e-bf0b-985d158418e6",
      "published_at": "2023-09-01",
      "source": "wotc"
    },
    {
      "comment": "If the copied creature has {X} in its mana cost, X is considered to be 0.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "Clone copies exactly what was printed on the original creature and nothing else (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "Any enters abilities of the copied creature will trigger when Clone enters. Any \"as [this creature] enters\" or \"[this creature] enters with\" abilities of the chosen creature will also work.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "If Clone somehow enters at the same time as another creature, Clone can't become a copy of that creature. You may choose only a creature that's already on the battlefield.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "If the copied creature is a token, Clone copies the original characteristics of that token as stated by the effect that created the token.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "If the copied creature is copying something else (for example, if the copied creature is an Evil Twin), then Clone enters as whatever that creature copied.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "Clone's ability doesn't target the chosen creature.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    },
    {
      "comment": "You can choose not to copy anything. In that case, Clone enters as a 0/0 Shapeshifter creature, and is probably put into the graveyard immediately.",
      "oracle_id": "42226b87-0746-4ebf-9fd0-108d508462af",
      "published_at": "2025-10-02",
      "source": "wotc"
    }
  ],
