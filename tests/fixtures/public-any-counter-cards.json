  "rulings": [
    {
      "comment": "The activated ability can target a creature with any kind of counter on it, not just a +1/+1 counter.",
      "oracle_id": "34d5f249-df46-49d1-a692-da2348fbc51e",
      "published_at": "2007-10-01",
      "source": "wotc"
    },
    {
      "comment": "Backstreet Bruiser's ability looks for two or more individual counters. It doesn't matter if the counters are the same kind or different kinds or whether they are on the same permanent or different permanents.",
      "oracle_id": "354d9db1-18a6-4701-be3c-c4ded900e2ff",
      "published_at": "2022-04-29",
      "source": "wotc"
    },
    {
      "comment": "If the targeted creature no longer has any counters on it when the ability resolves, the ability won’t resolve because its only target is illegal. The creature will stay on the battlefield.",
      "oracle_id": "38a2ded4-77c5-4d2b-b411-7dca8108aa02",
      "published_at": "2008-08-01",
      "source": "wotc"
    },
    {
      "comment": "Razorfin Abolisher’s ability can target a creature with any kind of counter on it, not just a -1/-1 counter.",
      "oracle_id": "38a2ded4-77c5-4d2b-b411-7dca8108aa02",
      "published_at": "2008-08-01",
      "source": "wotc"
    },
    {
      "comment": "If Kyler enters the battlefield at the same time as other Humans you control, Kyler's first ability will trigger once for each of those Humans.",
      "oracle_id": "726cd041-5d0b-436c-bced-9335f56c0b0d",
      "published_at": "2021-09-24",
      "source": "wotc"
    },
    {
      "comment": "Kyler's second ability counts all counters, not just +1/+1 counters.",
      "oracle_id": "726cd041-5d0b-436c-bced-9335f56c0b0d",
      "published_at": "2021-09-24",
      "source": "wotc"
    },
    {
      "comment": "Each creature you control has Rishkar's mana ability as long as that creature has any kind of counter on it. The effect isn't limited to those with +1/+1 counters.",
      "oracle_id": "761021ce-4559-464e-aa03-85c2fe78e267",
      "published_at": "2017-02-09",
      "source": "wotc"
    },
    {
      "comment": "Rishkar can be a target of its own triggered ability.",
      "oracle_id": "761021ce-4559-464e-aa03-85c2fe78e267",
      "published_at": "2017-02-09",
      "source": "wotc"
    },
    {
      "comment": "You can't target the same creature twice to have one recipient get two +1/+1 counters.",
      "oracle_id": "761021ce-4559-464e-aa03-85c2fe78e267",
      "published_at": "2017-02-09",
      "source": "wotc"
    },
    {
      "comment": "You compare Formation Breaker’s power to the power of any creature trying to block it only as blockers are declared. Once Formation Breaker has been legally blocked by a creature, changing the power of either creature won’t change or undo the block.",
      "oracle_id": "82f59ac4-bf94-4fa2-9457-f0bec8360bd9",
      "published_at": "2025-04-04",
      "source": "wotc"
    },
    {
      "comment": "Once a creature’s ward ability has triggered, causing that creature to lose ward by removing Cathedral Acolyte won’t affect the ability. The appropriate player will still have to pay {1} or see their spell or ability countered.",
      "oracle_id": "85fa4ed3-14e3-4eb0-b31b-62e2088321d0",
      "published_at": "2024-03-08",
      "source": "wotc"
    },
    {
      "comment": "The effect of Cathedral Acolyte’s first ability applies to any creature you control with a counter on it, not just ones with +1/+1 counters.",
      "oracle_id": "85fa4ed3-14e3-4eb0-b31b-62e2088321d0",
      "published_at": "2024-03-08",
      "source": "wotc"
    }
  ]
