      "comment": "Saddled Rimestag’s effect checks each turn whether it applies during that turn. It doesn’t check only during the turn it enters the battlefield."
    },
    {
      "oracle_id": "731898d3-465b-4ecb-a346-b91881714ebc",
      "published_at": "2019-06-14",
      "source": "wotc",
      "comment": "Saddled Rimestag’s effect applies even if the other creature entered the battlefield under your control before Saddled Rimestag entered the battlefield, and it continues to apply even if that creature leaves the battlefield."
    },
    {
      "oracle_id": "731898d3-465b-4ecb-a346-b91881714ebc",
      "published_at": "2019-06-14",
      "source": "wotc",
      "comment": "Saddled Rimestag doesn’t get more than +2/+2 if you had more than one other creature enter the battlefield under your control during a turn."
    },
    {
      "oracle_id": "854278bc-2bcf-45dd-abd5-6aca7a1e5fc9",
