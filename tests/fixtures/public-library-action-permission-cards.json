  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Once you cast a spell from the top of your library, causing The Reality Chip to no longer be attached to a creature will have no effect on that spell."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Although it causes an Equipment to become attached to a creature, reconfigure is not an “equip ability” for the purpose of cards like Fighter Class and Leonin Shikari."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Reconfigure represents two activated abilities. Reconfigure [cost] means “[Cost]: Attach this permanent to another target creature you control. Activate only as a sorcery,” and “[Cost]: Unattach this permanent. Activate only if this permanent is attached to a creature and only as a sorcery.”"
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "An Equipment doesn't become tapped when the permanent it's attached to becomes tapped. For example, if you attack with a creature that is equipped with Acquisition Octopus, then use reconfigure to unattach Acquisition Octopus after combat, the Octopus will be untapped and could be used to block during your opponent's turn."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "If a permanent with reconfigure is somehow still a creature after it becomes attached (perhaps due to an effect like that of March of the Machines), it immediately becomes unattached from the equipped creature."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "If an Equipment with reconfigure somehow loses its abilities while it is attached, the effect causing it to not be a creature continues to apply until it becomes unattached."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "An Equipment creature with reconfigure can be attached to creatures by effects other than its reconfigure ability, such as the activated ability of Brass Squire."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Attaching an Equipment with reconfigure to a creature causes that Equipment to stop being a creature until it becomes unattached. It also loses any creature subtypes it had."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "The top card of your library is still in your library and not in your hand. You can't discard cards from the top of your library (for example, to activate their channel abilities)."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "You must pay all costs and follow all timing rules for cards played from the top of your library this way. For example, you may play a land this way only while the stack is empty during one of your own main phases, and only if you haven't played a land yet this turn."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "Similarly, if an Equipment is tapped, its reconfigure abilities may still be activated and it may still become attached to creatures. Becoming attached doesn't untap it. In most cases, an attached Equipment being tapped won't affect gameplay, but it will be relevant if it becomes unattached again before it untaps."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "An Equipment creature can never become attached to itself. If an effect tries to do this, nothing happens."
    },
    {
      "oracle_id": "751f22bc-bcea-4213-a37b-b5f72448a4c4",
      "published_at": "2022-02-18",
      "source": "wotc",
      "comment": "As soon as an Equipment creature with reconfigure stops being a creature, any Equipment and Auras with enchant creature abilities become unattached. Auras that can enchant an Equipment that isn't a creature remain attached to it."
    },
    {
      "oracle_id": "2ca9e6e5-5eec-4593-8816-5c4317c79eb0",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "You must follow all normal timing rules for spells cast using the second ability and must pay all costs for spells cast this way. To cast a spell this way, you may choose to pay any alternative costs or optional additional costs the spell may have (such as a kicker cost). You must pay any mandatory additional costs."
    },
    {
      "oracle_id": "2ca9e6e5-5eec-4593-8816-5c4317c79eb0",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "The top card of your library isn't in your hand, so you can't cycle it, discard it, or activate any of its abilities that could be activated from your hand."
    },
    {
      "oracle_id": "2ca9e6e5-5eec-4593-8816-5c4317c79eb0",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "If the top card of your library changes while you're casting a spell, playing a land, or activating an ability, you can't look at the new top card until you finish doing so. This means that if you cast the top card of your library, you can't look at the next one until you're done paying for that spell."
    },
    {
      "oracle_id": "2ca9e6e5-5eec-4593-8816-5c4317c79eb0",
      "published_at": "2025-06-06",
      "source": "wotc",
      "comment": "Summoning Materia lets you look at the top card of your library whenever you want (with one restriction—see below), even if you don't have priority. This action doesn't use the stack. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand."
    },
    {
      "oracle_id": "aece819e-3678-48bc-9677-d06ebfa58b4e",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "Verge Rangers doesn't allow you to play additional lands."
    },
    {
      "oracle_id": "aece819e-3678-48bc-9677-d06ebfa58b4e",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "Verge Rangers lets you look at the top card of your library whenever you want (with one restriction; see below), even if you don't have priority. This action doesn't use the stack. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand."
    },
    {
      "oracle_id": "aece819e-3678-48bc-9677-d06ebfa58b4e",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "If the top card of your library changes while you're casting a spell, playing a land, or activating an ability, you can't look at the new top card until you finish doing so. This means that if you play a land from the top of your library and it has a replacement effect that requires you to make a decision (such as that of Temple Garden), you must make that decision without knowing the next card of your library."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "The top card of your library isn't in your hand, so you can't suspend it, cycle it, discard it, or activate any of its activated abilities."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "You still pay all costs for that spell, including additional costs. You may also pay alternative costs."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "Augur of Autumn doesn't change the times when you can play a land card from the top of your library. You can play a land only during your main phase when you have priority and the stack is empty. Doing so counts as your land play for the turn."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "While you have three creatures with different powers, Augur of Autumn allows you to cast the top card of your library if it's a creature card, it's your main phase, and the stack is empty. If that creature card has flash, you'll be able to cast it any time you could cast an instant, even on an opponent's turn."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "Essentially, Augur of Autumn lets you play with the top card of your library revealed only to you. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand. You may look at the top card of your library whenever you want, even if you don't have priority. This action doesn't use the stack."
    },
    {
      "oracle_id": "9e774188-caa1-4b62-b9cc-547f8e444b7f",
      "published_at": "2021-09-24",
      "source": "wotc",
      "comment": "If the top card of your library changes during the process of casting a spell or activating an ability, you can't look at the new top card until the process of casting the spell or activating the ability ends (all targets are chosen, all costs are paid, and so on)."
    },
    {
      "oracle_id": "b81eaa2f-0554-41c6-bdf6-d1cb73b8f56f",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "If the top card of your library changes while you're casting a spell, playing a land, or activating an ability, you can't look at the new top card until you finish doing so. This means that if you cast a spell from the top of your library, you can't look at the next one until you're done paying for that spell."
    },
    {
      "oracle_id": "b81eaa2f-0554-41c6-bdf6-d1cb73b8f56f",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "You can look at the top card of your library whenever you want (with one restriction; see below), even if you don't have priority. This action doesn't use the stack. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand."
