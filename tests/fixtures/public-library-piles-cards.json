  "rulings": [
    {"comment":"You can choose to find fewer than four cards if you want. If you find one or two cards, your opponent must choose for them to be put into your graveyard, even if they don't want to.","oracle_id":"58aec411-167d-4709-8560-793eaaed62c5","published_at":"2017-03-14","source":"wotc"},
    {
