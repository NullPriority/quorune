      "source": "wotc",
      "comment": "Piles may be empty."
    },
    {
      "oracle_id": "0aa556a6-66aa-42f1-ba41-0001e10c20a4",
      "published_at": "2013-09-15",
      "source": "wotc",
      "comment": "If one of the piles is empty, the opponent will choose whether to put the cards from the other pile into your hand or into your graveyard."
