  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "If an effect sets your life total to a specific number, and that number is higher than your current life total, the effect will cause you to gain life equal to the difference. Rhox Faithmender will then double that number. For example, if you have 3 life and an effect says that your life total \"becomes 10,\" your life total will actually become 17.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "If you control two Rhox Faithmenders, life you gain will be multiplied by four. Three Rhox Faithmenders will multiply any life gain by eight, and so on.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "In a Two-Headed Giant game, only Rhox Faithmender's controller is affected by it. If that player's teammate gains life, Rhox Faithmender will have no effect, even when that life gain is applied to the shared team life total.",
      "oracle_id": "2abe9303-d498-4aad-b6b2-8b5064bd2ffd",
      "published_at": "2012-07-01",
      "source": "wotc"
    },
    {
      "comment": "If some (but not all) of the targets become illegal, the original division of damage still applies, but no damage is dealt to illegal targets. If all targets become illegal, including the target opponent for the life-gaining effect, Fiery Justice doesn't resolve. If each target for the damage-dealing effect becomes illegal while the target for the life-gaining effect remains legal, that player gains 5 life even though no damage is dealt.",
      "oracle_id": "333809cb-e196-45f2-8a67-31374438e56e",
      "published_at": "2017-03-14",
      "source": "wotc"
    },
    {
      "comment": "The target opponent for the life-gaining effect may also be a target for the damage-dealing effect. If this happens and the damage brings that player's life total to 0 or less, the life-gaining effect will raise their life total above 0 again before the player would lose the game.",
      "oracle_id": "333809cb-e196-45f2-8a67-31374438e56e",
      "published_at": "2017-03-14",
      "source": "wotc"
    },
    {
      "comment": "You choose how many targets Fiery Justice has and how the damage is divided as you cast it. Each target for its damage-dealing effect must receive at least 1 damage.",
      "oracle_id": "333809cb-e196-45f2-8a67-31374438e56e",
      "published_at": "2017-03-14",
      "source": "wotc"
    },
    {
      "comment": "Aria of Flame’s last ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered.",
      "oracle_id": "406fad02-e1a6-4c24-b46d-976c548e1c78",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "If Aria of Flame leaves the battlefield while its last ability is on the stack, use the number of verse counters it had on it immediately before it left the battlefield to determine how much damage it deals.",
      "oracle_id": "406fad02-e1a6-4c24-b46d-976c548e1c78",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "If the target player or planeswalker is an illegal target by the time Aria of Flame’s last ability tries to resolve, the ability doesn’t resolve. You don’t put a verse counter on Aria of Flame.",
      "oracle_id": "406fad02-e1a6-4c24-b46d-976c548e1c78",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "In a Two-Headed Giant game, Aria of Flame’s first ability causes the opposing team to gain 20 life.",
      "oracle_id": "406fad02-e1a6-4c24-b46d-976c548e1c78",
      "published_at": "2019-06-14",
      "source": "wotc"
    },
    {
      "comment": "In a Two-Headed Giant game, Centaur Peacemaker’s ability causes each team to gain 8 life.",
      "oracle_id": "495d95cf-dcce-4a15-a544-79aced7ef98d",
      "published_at": "2018-10-05",
      "source": "wotc"
    },
    {
      "comment": "Pestilent Cauldron’s second ability counts the total amount of life gained without considering any life you lost during that turn. For example, if you lost 2 life and gained 2 life earlier in the turn, your opponents will mill two cards.",
      "oracle_id": "78780f37-f215-4ae1-adce-6255b0146873",
      "published_at": "2021-04-16",
      "source": "wotc"
    },
    {
      "comment": "You may cast Restorative Burst with no targets. If you do, each player will gain 4 life and you’ll exile Restorative Burst. However, if you choose one or two target cards, and each of those cards is an illegal target as Restorative Burst tries to resolve (usually because something else moved them in response), Restorative Burst won’t resolve and none of its effects will happen. No one will gain life, and Restorative Burst won’t be exiled.",
      "oracle_id": "78780f37-f215-4ae1-adce-6255b0146873",
      "published_at": "2021-04-16",
      "source": "wotc"
    },
    {
      "comment": "You must be able to target four cards in a single graveyard in order to activate Pestilent Cauldron’s last ability.",
      "oracle_id": "78780f37-f215-4ae1-adce-6255b0146873",
      "published_at": "2021-04-16",
      "source": "wotc"
    },
    {
      "comment": "Use the power of the creature from when it was last on the battlefield to determine how much life is gained.",
      "oracle_id": "b1544f21-7e98-461b-aed5-e748b0168c52",
      "published_at": "2022-12-08",
      "source": "wotc"
    },
    {
      "comment": "If an effect would set your life total to a specific number that's higher than your current life total, that effect would cause you to gain life equal to the difference. Boon Reflection will then double the amount of life that effect would cause you to gain. For example, if you have 3 life and an effect says that your life total “becomes 10,” your life total will actually become 17.",
      "oracle_id": "b86d3142-568a-4eea-b1ae-5fcfc1453533",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "In a Two-Headed Giant game, only Boon Reflection's controller is affected by it. If that player's teammate gains life, Boon Reflection will have no effect, even when that life gain is applied to the shared team life total.",
      "oracle_id": "b86d3142-568a-4eea-b1ae-5fcfc1453533",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "comment": "The effects of multiple Boon Reflections are cumulative. For example, if you control two Boon Reflections, you'll gain four times the original amount of life. If you control three Boon Reflections, you'll gain eight times the original amount, and so on.",
      "oracle_id": "b86d3142-568a-4eea-b1ae-5fcfc1453533",
      "published_at": "2020-08-07",
      "source": "wotc"
    },
    {
      "oracle_id": "bdeb440d-a714-40e8-9038-f651e6ae45fb",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "You can tap a creature that hasn't been under your control since your most recent turn began to activate Springleaf Drum's ability."
    },
    {
      "oracle_id": "bdeb440d-a714-40e8-9038-f651e6ae45fb",
      "published_at": "2025-11-17",
      "source": "wotc",
      "comment": "You can tap a creature that hasn't been under your control since your most recent turn began to activate Springleaf Drum's ability."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card."
    },
    {
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "You must be able to target a card in a graveyard to cast Cremate."
    }
  ],
