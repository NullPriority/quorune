      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "The subtype Gate has no special rules significance, but other spells and abilities may refer to it.",
      "oracle_id": "ad1712d8-809f-410c-8b91-ffe6fb8a69a1",
