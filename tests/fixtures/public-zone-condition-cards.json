  "rulings": [
    {
      "oracle_id": "6e9d5e5e-d571-4a1a-be8c-6672fd6b582f",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Warden of the Beyond can't get more than +2/+2 from its last ability, no matter how many opponents own a card in exile or how many exiled cards they own."
    },
    {
      "oracle_id": "05ad7ec4-f48d-4cbe-be58-f871dc19702b",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "It doesn't matter which library has twenty or fewer cards in it, and you don't have to specify a library. If multiple libraries have twenty or fewer cards in them, Isleback Spawn will still get its bonus only once."
    },
    {
      "oracle_id": "13aa88a0-4b47-4012-ba50-002e51e637cf",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The mana value of this card is still 8, even if you only pay {U}{U} to cast it."
    },
    {
      "oracle_id": "dd99061d-510d-4935-b44e-54721505515f",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "You don't specify an opponent; the ability will check all of them to see if at least one meets the condition. The opponent that meets the condition when the ability triggers and the one who meets the condition when it resolves can be different players."
    },
    {
      "oracle_id": "dd99061d-510d-4935-b44e-54721505515f",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "Rekindled Flame's triggered ability has an \"intervening 'if' clause.\" That means (1) the ability won't trigger at all unless one of your opponents already has no cards in hand as your upkeep begins, and (2) the ability will do nothing if each of your opponents manages to get a card in hand by the time it resolves."
    },
    {
      "oracle_id": "f748b2fb-6c2a-400a-8e96-fa4e4a1dfe80",
      "published_at": "2007-10-01",
      "source": "wotc",
      "comment": "It doesn't matter which library has twenty or fewer cards in it, and you don't have to specify a library."
    },
    {
      "oracle_id": "f748b2fb-6c2a-400a-8e96-fa4e4a1dfe80",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "Hideaway now causes you to put the rest of the cards on the bottom of your library in a random order instead of any order."
    },
    {
      "oracle_id": "f748b2fb-6c2a-400a-8e96-fa4e4a1dfe80",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "\"Hideaway N\" means \"When this permanent enters the battlefield, look at the top N cards of your library. Exile one of them face down and put the rest on the bottom of your library in a random order. The exiled card gains 'The player who controls the permanent that exiled this card may look at this card in the exile zone.'\""
    },
    {
      "oracle_id": "f748b2fb-6c2a-400a-8e96-fa4e4a1dfe80",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "Previously, permanents with hideaway entered the battlefield tapped. This ability has been removed from the definition of hideaway. Older cards have received errata to have an additional paragraph that reads \"[This permanent] enters the battlefield tapped,\" and they now have hideaway 4."
    },
    {
      "oracle_id": "f748b2fb-6c2a-400a-8e96-fa4e4a1dfe80",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "Any player who has controlled a permanent with a hideaway ability since a card was exiled with it may look at that card."
    },
    {
      "oracle_id": "b1544f21-7e98-461b-aed5-e748b0168c52",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Use the power of the creature from when it was last on the battlefield to determine how much life is gained."
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "published_at": "2006-09-25",
      "source": "wotc",
      "comment": "If Pull from Eternity affects a suspended card, the card loses its time counters and is no longer suspended. (This doesn’t trigger the last ability of suspend.)"
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "published_at": "2006-09-25",
      "source": "wotc",
      "comment": "Pull from Eternity targets a card in the exile zone. A card is only face down in the exile zone if the effect that put it there specifically says so."
    },
    {
      "oracle_id": "2903bd66-6948-445b-a18a-12e2ce1a86c3",
      "published_at": "2006-09-25",
      "source": "wotc",
      "comment": "If Pull from Eternity affects a card that’s haunting a creature, the haunt effect ends."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "446a9d7e-9c1a-4e83-8342-2ed5acae2eed",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If there are fewer than five cards in the targeted player’s library, that player puts all the cards from their library into their graveyard."
    }
  ]
}
