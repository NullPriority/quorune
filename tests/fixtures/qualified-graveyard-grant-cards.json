  "rulings": [
    {
      "oracle_id": "4c9bcba6-87b5-4fb3-97ee-6fe5b739337d",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "You perform the actions stated on a card in sequence. For some spells and abilities, you'll surveil last. For others, you'll surveil and then perform other actions."
    },
    {
      "oracle_id": "f78db9ad-d4a3-4e49-a76e-bd31124b7837",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "You must pay all costs when casting a spell this way."
    },
    {
      "oracle_id": "f78db9ad-d4a3-4e49-a76e-bd31124b7837",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "If you play a land or cast a permanent spell from your graveyard using another permission, it won't count as the \"once during each of your turns\" for Kagha's effect."
    },
    {
      "oracle_id": "f78db9ad-d4a3-4e49-a76e-bd31124b7837",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "You must follow the normal timing rules of the card you play from your graveyard."
    },
    {
      "oracle_id": "f78db9ad-d4a3-4e49-a76e-bd31124b7837",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "Once you begin to cast the spell, losing control of Kagha won't affect it. You can finish casting it as normal."
    },
    {
      "oracle_id": "f78db9ad-d4a3-4e49-a76e-bd31124b7837",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "If you play a land or cast a permanent spell from your graveyard via Kagha, and then have a new Kagha come under your control in the same turn, you may do so again that turn."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "If you are instructed to put a card into your graveyard from your library without using the word “mill,” (by the effect of Rowan’s Grim Search from Wilds of Eldraine, for example), Raul’s first ability won’t allow you to cast it."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "You must follow the normal timing permissions and restrictions of the spell you cast from your graveyard."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "If you cast a spell from among cards in your graveyard that were milled this turn using the permission granted by Raul’s first ability and then have a new Raul, Trouble Shooter come under your control in the same turn, you may cast another spell from among cards in your graveyard that were milled this turn."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "Once you begin to cast the spell, losing control of Raul won’t affect the spell."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "If you cast a spell from among cards in your graveyard that were milled this turn using another permission, Raul’s effect doesn’t apply. You can cast another spell among cards in your graveyard that were milled this turn using the permission granted by Raul’s first ability."
    },
    {
      "oracle_id": "d247a86d-917d-4833-82c4-876943d54e2c",
      "published_at": "2024-03-08",
      "source": "wotc",
      "comment": "You must pay the costs to cast that spell. If it has an alternative cost, you may cast it for that cost instead."
    },
    {
      "oracle_id": "1cb0610b-a731-42c2-b93f-0a29f63cebf4",
      "published_at": "2023-02-04",
      "source": "wotc",
      "comment": "You must discard exactly one card to cast Thrill of Possibility; you can't cast it without discarding a card, and you can't discard additional cards."
    },
    {
      "oracle_id": "33c722cf-b4bf-431f-aefd-ee96241a7fbf",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Crucible of Worlds doesn't allow you to activate abilities (such as cycling) of land cards in your graveyard."
    },
    {
      "oracle_id": "33c722cf-b4bf-431f-aefd-ee96241a7fbf",
      "published_at": "2018-07-13",
      "source": "wotc",
      "comment": "Crucible of Worlds doesn't change the times when you can play those land cards. You can still play only one land per turn, and only during your main phase when you have priority and the stack is empty."
    },
    {
      "oracle_id": "0c2841bb-038c-4fbf-8360-bc0a1522b58d",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Exploration’s ability is cumulative with other effects that allow you to play additional lands, including ones created by other Explorations you control."
    },
    {
      "oracle_id": "dbd6a94b-62ff-4a10-9d52-bdd90b26e425",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "If multiple \"extra turn\" effects resolve in the same turn, take them in the reverse of the order that the effects resolved. In other words, the most recently created extra turn is taken first."
    }
  ]
}
