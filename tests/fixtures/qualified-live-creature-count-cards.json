  "rulings": [
    {
      "comment": "A creature that is equipped is considered modified no matter who controls the Equipment that's attached to it.",
      "oracle_id": "7d27c583-469c-42d7-a547-8c65654e9d95",
      "published_at": "2025-09-19",
      "source": "wotc"
    },
    {
      "comment": "A creature with a counter on it is considered modified no matter what kind of counter it is or which player put it on that creature.",
      "oracle_id": "7d27c583-469c-42d7-a547-8c65654e9d95",
      "published_at": "2025-09-19",
      "source": "wotc"
    },
    {
      "comment": "An Aura controlled by an opponent does not cause a creature you control to be modified.",
      "oracle_id": "7d27c583-469c-42d7-a547-8c65654e9d95",
      "published_at": "2025-09-19",
      "source": "wotc"
    },
    {
      "comment": "The number of modified creatures you control is counted at the time the ability resolves, not the time that damage was dealt.",
      "oracle_id": "7d27c583-469c-42d7-a547-8c65654e9d95",
      "published_at": "2025-09-19",
      "source": "wotc"
    },
    {
      "comment": "The value of X is determined only once, as Arabella's ability resolves.",
      "oracle_id": "7c4bbb1b-29c4-4e06-aed0-b361293a585b",
      "published_at": "2024-09-20",
      "source": "wotc"
    },
    {
      "comment": "A creature with a counter on it is considered modified no matter what kind of counter it is or which player put it on that creature.",
      "oracle_id": "3d713c11-36a7-4b19-8c42-a9b61ef5902c",
      "published_at": "2022-02-18",
      "source": "wotc"
    },
    {
      "comment": "An Aura controlled by an opponent does not cause a creature you control to be modified.",
      "oracle_id": "3d713c11-36a7-4b19-8c42-a9b61ef5902c",
      "published_at": "2022-02-18",
      "source": "wotc"
    },
    {
      "comment": "A creature that is equipped is considered modified no matter who controls the Equipment that's attached to it.",
      "oracle_id": "3d713c11-36a7-4b19-8c42-a9b61ef5902c",
      "published_at": "2022-02-18",
      "source": "wotc"
    },
    {
      "comment": "Gau's last ability checks at the moment it would trigger to see if a card left your graveyard this turn. If none did, the ability won't trigger at all. Once your end step begins, it's too late to make a card leave your graveyard in order to cause this ability to trigger.",
      "oracle_id": "9e96d12b-8381-4706-8089-3521aa2b5422",
      "published_at": "2025-06-06",
      "source": "wotc"
    },
    {
      "comment": "If Gau is no longer on the battlefield when its last ability resolves, use its power as it last existed on the battlefield to determine how much damage the ability deals.",
      "oracle_id": "9e96d12b-8381-4706-8089-3521aa2b5422",
      "published_at": "2025-06-06",
      "source": "wotc"
    }
