efense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{U}","name":"Turn to Frog","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","oracle_text":"Until end of turn, target creature loses all abilities and becomes a blue Frog with base power and toughness 1/1.","power":null,"produced_mana":[],"released_at":"2024-02-23","toughness":null,"type_line":"Instant"},{"cmc":3.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Flash"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{2}{W}","name":"Village Bell-Ringer","oracle_id":"d7b50175-b473-452a-bb30-19a71c42e649","oracle_text":"Flash (You may cast this spell any time you could cast an instant.)\nWhen this creature enters, untap all creatures you control.","power":"1","produced_mana":[],"released_at":"2023-04-21","toughness":"4","type_line":"Creature — Human Scout"},{"cmc":3.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":["Defender"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{R}{R}","name":"Wall of Stone","oracle_id":"cd4cadb4-3156-49bd-b36e-12ba5c85938b","oracle_text":"Defender (This creature can't attack.)","power":"0","produced_mana":[],"released_at":"2003-07-28","toughness":"8","type_line":"Creature — Wall"},{"cmc":0.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Wastes","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","oracle_text":"{T}: Add {C}.","power":null,"produced_mana":["C"],"released_at":"2025-08-01","toughness":null,"type_line":"Basic Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Once Lydia Frye has been blocked, increasing the blocking creature’s power to 3 or greater won’t cause Lydia Frye to become unblocked.","oracle_id":"0315f5e7-2867-428e-8e43-66dda0db57a0","published_at":"2024-07-05","source":"wotc"},{"comment":"The value of X is calculated only once, as Lydia Frye’s last ability resolves.","oracle_id":"0315f5e7-2867-428e-8e43-66dda0db57a0","published_at":"2024-07-05","source":"wotc"},{"comment":"Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Axebane Guardian’s activated ability is a mana ability. It doesn’t use the stack and can’t be responded to. The number of creatures with defender you control is counted, and the color(s) of mana produced chosen, immediately after the ability is activated when the ability resolves.","oracle_id":"060e0378-e335-4b3d-82aa-ae36639339f6","published_at":"2012-10-01","source":"wotc"},{"comment":"The tokens created by Crash the Party don't enter the battlefield attacking.","oracle_id":"337e322b-6144-4e0b-b998-df475166fcf6","published_at":"2022-04-29","source":"wotc"},{"comment":"Overgrown Battlement's last ability is a mana ability. It doesn't use the stack and can't be responded to (such as by removing creatures with defender you control).","oracle_id":"585f62dc-4461-42f1-a3a4-b19a1e550d2d","published_at":"2017-11-17","source":"wotc"},{"comment":"Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"If one of the Theros block Gods is affected by Turn to Frog, it will be a legendary 1/1 blue Frog enchantment creature with no abilities. If it stops being a creature, perhaps because your devotion to its color(s) decreased, it will be a legendary blue enchantment with no abilities. The way continuous effects work, the God’s type-changing ability is applied before the effect that removes that ability is applied.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"If the affected creature gains an ability after Turn to Frog resolves, it will keep that ability.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"The creature will lose all other colors and creature types, but it will retain any other card types (such as artifact) or supertypes (such as legendary) it may have.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"Turn to Frog doesn’t counter abilities that have already triggered or been activated. In particular, there is no way to cast this spell to stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"Turn to Frog overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Turn to Frog resolves will overwrite this effect.","oracle_id":"74c4c1e2-c50d-4c8f-889a-0d5674dc6d67","published_at":"2014-07-18","source":"wotc"},{"comment":"The number of untapped creatures you control is counted as the ability resolves, and the bonus is locked in at that time. By this point, other attacking creatures will already be tapped (unless they have vigilance).","oracle_id":"75efff64-ea9b-4e3e-a729-fc003ee3db1e","published_at":"2009-05-01","source":"wotc"},{"comment":"Can't target itself because you choose the target before you tap him. At that time he is not yet a legal target.","oracle_id":"9ed6f28f-a3db-48c5-9ab0-b90a7fba5f57","published_at":"2004-10-04","source":"wotc"},{"comment":"If the creature is no longer tapped when the Assassin's ability resolves, then the ability doesn't resolve.","oracle_id":"9ed6f28f-a3db-48c5-9ab0-b90a7fba5f57","published_at":"2004-10-04","source":"wotc"},{"comment":"Untapping an attacking creature doesn't remove it from combat.","oracle_id":"d7b50175-b473-452a-bb30-19a71c42e649","published_at":"2011-09-22","source":"wotc"},{"comment":"If other abilities trigger at the beginning of your end step, first those controlled by your opponents resolve, then yours resolve. Each player orders their triggers in any order.","oracle_id":"ea750169-1f6f-40c2-96e9-55719e103a63","published_at":"2017-04-18","source":"wotc"},{"comment":"In a Two-Headed Giant game, the triggered ability of Throne of the God-Pharaoh causes the opposing team to lose life equal to twice the number of tapped creatures you control. Tapped creatures your teammate controls aren’t counted.","oracle_id":"ea750169-1f6f-40c2-96e9-55719e103a63","published_at":"2017-04-18","source":"wotc"},{"comment":"Throne of the God-Pharaoh’s ability triggers at the beginning of each of your end steps, even if you control no tapped creatures. The number of tapped creatures you control is checked as the ability resolves.","oracle_id":"ea750169-1f6f-40c2-96e9-55719e103a63","published_at":"2017-04-18","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
