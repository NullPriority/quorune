  "rulings": [
    {
      "oracle_id": "0dd95516-893d-477e-a38c-3cc37c6e7ae0",
      "published_at": "2014-02-01",
      "source": "wotc",
      "comment": "If the target creature is an illegal target as Bile Blight tries to resolve, it won't resolve and none of its effects will happen. No creature will get -3/-3."
    },
    {
      "oracle_id": "0dd95516-893d-477e-a38c-3cc37c6e7ae0",
      "published_at": "2014-02-01",
      "source": "wotc",
      "comment": "Bile Blight has only one target. Other creatures with that name are not targeted. For example, a creature with hexproof will still get -3/-3 if it has the same name as the target creature."
    },
    {
      "oracle_id": "0dd95516-893d-477e-a38c-3cc37c6e7ae0",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "Unless a token is a copy of another permanent or was explicitly given a name by the effect that created it, its name is the subtypes it was given when it was created plus the word \"Token.\" For example, if an effect creates a 1/1 Soldier creature token, that token is named \"Soldier Token.\""
    },
    {
      "oracle_id": "359db1e6-bed9-412f-9e7c-f827ff6f2229",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "If the target creature is an illegal target by the time Echoing Courage tries to resolve, the spell doesn't resolve. No creatures get +2/+2."
    },
    {
      "oracle_id": "359db1e6-bed9-412f-9e7c-f827ff6f2229",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "A face-down creature has no name, so it can't share a name with anything. This includes other creatures with no name."
    },
    {
      "oracle_id": "359db1e6-bed9-412f-9e7c-f827ff6f2229",
      "published_at": "2018-03-16",
      "source": "wotc",
      "comment": "Echoing Courage has only one target. Other creatures with that name are not targeted. For example, a creature with protection from green will still get +2/+2 if it has the same name as the target creature."
    },
    {
      "oracle_id": "359db1e6-bed9-412f-9e7c-f827ff6f2229",
      "published_at": "2022-06-10",
      "source": "wotc",
      "comment": "Unless a token is a copy of another permanent or was explicitly given a name by the effect that created it, its name is the subtypes it was given when it was created plus the word \"Token.\" For example, if an effect creates a 1/1 Soldier creature token, that token is named \"Soldier Token.\""
