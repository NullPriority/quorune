  "rulings": [
    {
      "comment": "If the target creature is an illegal target as Deadly Embrace tries to resolve, it won't resolve and none of its effects will happen. You won't draw cards.",
      "oracle_id": "32ad99a9-b5ed-41a1-8060-22265f7c5da1",
      "published_at": "2025-06-06",
      "source": "wotc"
    },
    {
      "comment": "Green Goblin's last ability counts the number of cards you have discarded previously this turn, including the one you discard to Green Goblin's own ability. It doesn't matter if Green Goblin was on the battlefield at the time the cards were discarded.",
      "oracle_id": "67175889-02f9-4ad8-a9ab-11db44328b67",
      "published_at": "2025-09-19",
      "source": "wotc"
    },
    {
      "oracle_id": "cbc9c731-181a-4f00-a7b0-eb7e56eac2ea",
      "source": "wotc",
      "published_at": "2004-10-04",
      "comment": "You must show the card you bring out of the graveyard to your opponent."
    },
    {
      "oracle_id": "cbc9c731-181a-4f00-a7b0-eb7e56eac2ea",
      "source": "wotc",
      "published_at": "2004-10-04",
      "comment": "The creature being brought back is chosen on announcement and not on resolution of the spell because it is targeted."
    }
  ],
