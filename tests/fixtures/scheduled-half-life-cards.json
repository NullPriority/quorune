  "rulings": [
    {
      "oracle_id": "af0dd100-67f0-4d7c-a65b-b2c7149288f7",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "Effects that would replace gaining life with another effect won’t apply because it’s impossible for players to gain life."
    },
    {
      "oracle_id": "af0dd100-67f0-4d7c-a65b-b2c7149288f7",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "Spells and abilities that would cause a player to gain life still resolve, but the life-gain part has no effect."
    },
    {
      "oracle_id": "af0dd100-67f0-4d7c-a65b-b2c7149288f7",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "If an effect says to set a player’s life total to a certain number and that number is higher than the player’s current life total, that part of the effect won’t do anything. (If the number is lower than the player’s current life total, the effect will work as normal.)"
    },
    {
      "oracle_id": "af0dd100-67f0-4d7c-a65b-b2c7149288f7",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "The amount of life lost is calculated when the triggered ability resolves. For example, if a player has 20 life and there are two Havoc Festivals on the battlefield, the first ability will cause that player to lose 10 life and then the second ability will cause that player to lose 5 life."
    },
    {
      "oracle_id": "af0dd100-67f0-4d7c-a65b-b2c7149288f7",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "In a Two-Headed Giant game, the last ability triggers for each player. Any life loss is applied to the team’s life total. For example, if the team has 30 life, the first ability will cause the player (and thus the team) to lose 15 life and then the second ability will cause the other player (and thus the team) to lose 8 life. The team will end up having 7 life."
    },
    {
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it."
    }
  ]
