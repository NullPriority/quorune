      "rulings": [
        {
          "oracle_id": "c216b924-88ac-4853-9e95-0c345c09eeb6",
          "published_at": "2021-03-19",
          "source": "wotc",
          "comment": "Delve doesn't change a spell's mana cost or mana value. For example, Treasure Cruise's mana value is 8 even if you exiled three cards to cast it."
        },
        {
          "oracle_id": "c216b924-88ac-4853-9e95-0c345c09eeb6",
          "published_at": "2021-03-19",
          "source": "wotc",
          "comment": "You can exile cards to pay only for generic mana, and you can't exile more cards than the generic mana requirement of a spell with delve. For example, you can't exile more than seven cards from your graveyard to cast Treasure Cruise unless an effect has increased its cost."
        },
        {
          "oracle_id": "c216b924-88ac-4853-9e95-0c345c09eeb6",
          "published_at": "2021-03-19",
          "source": "wotc",
          "comment": "Because delve isn't an alternative cost, it can be used in conjunction with alternative costs, such as flashback. It can also be used to pay for additional costs that include generic mana."
        }
      ]
    }
