  "rulings": [
    {
      "comment": "The last ability of Burrenton Forge-Tender doesn’t target anything. You choose a source of damage as the ability resolves, if able. You can activate it even if there is no source to choose.",
      "oracle_id": "70bb275b-3458-4690-a50f-b231fbf0bccb",
      "published_at": "2017-11-17",
      "source": "wotc"
    },
    {
      "comment": "If a permanent spell is chosen as the source of damage, Burrenton Forge-Tender’s prevention effect continues to apply for the rest of the turn to the permanent that spell becomes once it has entered the battlefield.",
      "oracle_id": "70bb275b-3458-4690-a50f-b231fbf0bccb",
      "published_at": "2017-11-17",
      "source": "wotc"
    },
    {
      "comment": "If the red source you chose changes colors before it deals damage, the damage-prevention effect doesn’t apply.",
      "oracle_id": "70bb275b-3458-4690-a50f-b231fbf0bccb",
      "published_at": "2017-11-17",
      "source": "wotc"
    },
    {
      "comment": "If the creature becomes an illegal target by the time Chandra's Ignition tries to resolve (perhaps because another player controls it or it's left the battlefield), Chandra's Ignition won't resolve and none of its effects will happen. No damage will be dealt.",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "published_at": "2015-06-22",
      "source": "wotc"
    },
    {
      "comment": "The creature is the source of the damage, not Chandra's Ignition. For example, Chandra's Ignition can have a white creature deal damage to a creature with protection from red.",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "published_at": "2015-06-22",
      "source": "wotc"
    },
    {
      "comment": "Use the power of the target creature as Chandra's Ignition resolves to determine how much damage it deals to each other creature and each opponent.",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "published_at": "2015-06-22",
      "source": "wotc"
    },
    {
      "oracle_id": "d0dd425b-fdba-41b4-b9e6-f5161610bd7e",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "You choose which Beast is fighting which creature an opponent controls."
    },
    {
      "oracle_id": "d0dd425b-fdba-41b4-b9e6-f5161610bd7e",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "If Ezuri's Predation creates more than one token for any given creature (due to an effect such as the one Doubling Season creates), the extra tokens won't fight any creature."
    },
    {
      "oracle_id": "d0dd425b-fdba-41b4-b9e6-f5161610bd7e",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "Players can't cast spells or activate any abilities in between the Beasts entering the battlefield and fighting the other creatures. If the Beasts entering the battlefield cause any abilities to trigger, those abilities will be put onto the stack after Ezuri's Predation is finished resolving."
    },
    {
      "oracle_id": "d0dd425b-fdba-41b4-b9e6-f5161610bd7e",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "Each of the \"fights\" happens at the same time."
    }
  ],
