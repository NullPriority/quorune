  "rulings": [
    {
      "oracle_id": "716b3ea2-45b7-4a8f-af72-de7f4e510eff",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "If a spell targets Goldspan Dragon more than once, the triggered ability will trigger only once."
    },
    {
      "oracle_id": "716b3ea2-45b7-4a8f-af72-de7f4e510eff",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "An ability that triggers when a creature becomes the target of a spell resolves before the spell that caused it to trigger. Such an ability resolves even if that spell is countered."
    },
    {
      "oracle_id": "716b3ea2-45b7-4a8f-af72-de7f4e510eff",
      "published_at": "2021-02-05",
      "source": "wotc",
      "comment": "Players can cast spells and activate abilities after the triggered ability resolves but before the spell that caused it to trigger does."
    },
    {
      "oracle_id": "b5eb72bb-897f-4911-a797-3153c31df3e0",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "Since Goldhound is a creature, its {T} ability can't be activated the turn that it enters the battlefield or the turn a player gains control of it unless it has haste."
    },
    {
      "oracle_id": "b5eb72bb-897f-4911-a797-3153c31df3e0",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "If an effect refers to a Treasure, it means any Treasure artifact, not just a Treasure artifact token."
    },
    {
      "oracle_id": "b5eb72bb-897f-4911-a797-3153c31df3e0",
      "published_at": "2022-04-29",
      "source": "wotc",
      "comment": "Even when it is on a creature, Treasure is an artifact type and not a creature type. Similarly, Dog is always a creature type and not an artifact type."
    }
  ]
