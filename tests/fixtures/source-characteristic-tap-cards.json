    {
      "comment": "You can activate Iron-Shield Elf's ability even if Iron-Shield Elf is already tapped.",
      "oracle_id": "1c77b4da-b580-4ce9-b127-76de674f5694",
      "published_at": "2025-11-17",
      "source": "wotc"
    },
    {
      "comment": "You may activate the last ability even if Necromancer's Familiar is already tapped or it has indestructible.",
      "oracle_id": "ce8833ea-5f58-4ab9-b33d-8972f2215574",
      "published_at": "2021-06-18",
      "source": "wotc"
    },
    {
      "comment": "You can activate Unrooted Ancestor\u2019s last ability even if it is already tapped.",
      "oracle_id": "de5c6c9d-04a2-4287-8c6e-fdf56c411507",
      "published_at": "2025-04-04",
      "source": "wotc"
    },
    {
      "comment": "If you sacrifice Popular Egotist, its last ability will trigger. If you sacrifice other permanents at the same time, its last ability will trigger for each of those permanents as well.",
      "oracle_id": "e6377683-1c36-4786-bd8d-c62ff2d25767",
      "published_at": "2024-09-20",
      "source": "wotc"
    },
    {
      "comment": "If you sacrifice a permanent as part of casting a spell or activating an ability, Popular Egotist's last ability will resolve before that spell or ability. It will resolve even if that spell or ability is countered.",
      "oracle_id": "e6377683-1c36-4786-bd8d-c62ff2d25767",
      "published_at": "2024-09-20",
      "source": "wotc"
    },
    {
