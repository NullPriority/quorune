    {
      "oracle_id": "ac5c2069-0706-4b85-a811-a522db016e3e",
      "published_at": "2017-07-14",
      "source": "wotc",
      "comment": "Magmaroth’s second ability resolves before the spell that caused it to trigger. The ability will resolve even if that spell is countered."
    },
    {
      "oracle_id": "0158a440-6573-4f12-958b-a5f0cf190d5b",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "In a multiplayer game played with the limited range of influence option, Divine Intervention won’t necessarily end the entire game when its third ability resolves. All players within range of Divine Intervention will leave the game. They’ll neither win nor lose; as far as they’re concerned, the result of the game is a draw. All other players will continue playing."
    },
    {
      "oracle_id": "0158a440-6573-4f12-958b-a5f0cf190d5b",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "Divine Intervention’s third ability triggers only if its controller removes the last intervention counter from it. It doesn’t matter how that happens. For example, if you control Divine Intervention and the last intervention counter is removed as a result of a Clockspinning you control, the ability will trigger. On the other hand, if the last intervention counter is removed as a result of a Clockspinning another player controls, the ability won’t trigger (and won’t ever be able to)."
    },
    {
      "oracle_id": "0158a440-6573-4f12-958b-a5f0cf190d5b",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "When Divine Intervention’s third ability resolves, the game ends immediately. The game is a draw, meaning neither player wins and neither player loses."
    },
    {
      "oracle_id": "37b7f044-f57b-4d13-82be-46fd01f1dba6",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Witherscale Wurm’s second ability triggers when it deals any damage to an opponent, not just combat damage."
    },
    {
      "oracle_id": "37b7f044-f57b-4d13-82be-46fd01f1dba6",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Witherscale Wurm’s first ability does *not* give Witherscale Wurm wither."
    },
    {
      "oracle_id": "655ae8e7-372b-4d8d-b33f-4aca46831abb",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The effect does not prevent damage, it replaces it so the damage is neither dealt or prevented."
    },
    {
      "oracle_id": "655ae8e7-372b-4d8d-b33f-4aca46831abb",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If you take 6 damage at once, it will replace all 6 damage and put 6 counters on it. Then the second ability will trigger. Any additional damage you take before this ability resolves also results in counters, but once the ability resolves, this card is sacrificed."
    },
    {
      "oracle_id": "655ae8e7-372b-4d8d-b33f-4aca46831abb",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If you control more than one, each time you take damage you can decide which one replaces the damage, and that one replaces all of the damage. You can’t split the damage between them. You decide each time you take damage. Note that damage from multiple sources that happens at one time (such as combat damage) gives one choice, not one per source."
    },
    {
      "oracle_id": "bcb2f489-9d58-424d-96c1-a124a8d25a14",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Does a flat 3 damage, not 3 damage per counter."
    },
    {
      "oracle_id": "c2f6ddc2-86bc-43da-9bdd-0c2af79c62fd",
      "published_at": "2017-07-14",
      "source": "wotc",
      "comment": "Afflict causes the defending player to lose life; it's not damage or combat damage."
    },
    {
      "oracle_id": "c2f6ddc2-86bc-43da-9bdd-0c2af79c62fd",
      "published_at": "2017-07-14",
      "source": "wotc",
      "comment": "Ammit Eternal's middle ability will resolve before the spell that caused it to trigger. The ability will resolve even if that spell is countered."
    },
    {
      "oracle_id": "c2f6ddc2-86bc-43da-9bdd-0c2af79c62fd",
      "published_at": "2017-07-14",
      "source": "wotc",
      "comment": "Afflict resolves before combat damage is dealt. If this loss of life brings a player to 0 life or less, that player loses the game immediately. A blocking creature with lifelink won't deal combat damage in time to save that player."
    },
    {
      "oracle_id": "c2f6ddc2-86bc-43da-9bdd-0c2af79c62fd",
      "published_at": "2017-07-14",
      "source": "wotc",
      "comment": "If multiple creatures block a creature with afflict, afflict triggers only once."
    },
    {
