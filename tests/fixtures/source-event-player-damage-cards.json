    {
      "oracle_id": "492e0e6c-8c27-4376-938b-f8a8b6205810",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins."
    },
    {
      "oracle_id": "8e0cea9c-3110-4728-9378-76849e33bb90",
      "published_at": "2012-07-01",
      "source": "wotc",
      "comment": "If an attacking creature loses haste, perhaps because Fervor leaves the battlefield after attackers have been declared, it won't be removed from combat."
    },
    {
      "oracle_id": "cc2b6e58-2d6f-495e-95f3-9496105c4cba",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "If there are fewer than twenty cards in the targeted player's library, that player puts all the cards from their library into their graveyard."
