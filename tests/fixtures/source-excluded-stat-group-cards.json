not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Plains","oracle_id":"bc71ebf6-2056-41f7-be35-b2e5c34afa99","oracle_text":"({T}: Add {W}.)","power":null,"produced_mana":["W"],"released_at":"2026-11-13","toughness":null,"type_line":"Basic Land — Plains"},{"cmc":7.0,"color_identity":["B"],"colors":["B"],"defense":null,"keywords":["Flying","Cycling"],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{5}{B}{B}","name":"Shefet Archfiend","oracle_id":"06355d3f-a82d-4f12-a399-016a12824795","oracle_text":"Flying\nWhen this creature enters, all other creatures get -2/-2 until end of turn.\nCycling {2} ({2}, Discard this card: Draw a card.)","power":"5","produced_mana":[],"released_at":"2025-02-14","toughness":"5","type_line":"Creature — Demon"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Stifle","oracle_id":"b3b00911-ece7-4484-bc36-f211ce72b6cc","oracle_text":"Counter target activated or triggered ability. (Mana abilities can't be targeted.)","power":null,"produced_mana":[],"released_at":"2014-06-06","toughness":null,"type_line":"Instant"},{"cmc":0.0,"color_identity":["B"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Swamp","oracle_id":"56719f6a-1a6c-4c0a-8d21-18f7d7350b68","oracle_text":"({T}: Add {B}.)","power":null,"produced_mana":["B"],"released_at":"2026-06-26","toughness":null,"type_line":"Basic Land — Swamp"},{"cmc":0.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Wastes","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","oracle_text":"{T}: Add {C}.","power":null,"produced_mana":["C"],"released_at":"2025-08-01","toughness":null,"type_line":"Basic Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Demon of Dark Schemes's second triggered ability triggers whenever another creature dies for any reason, not just due to the first triggered ability.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2016-09-20","source":"wotc"},{"comment":"If Demon of Dark Schemes dies at the same time as another creature, its second triggered ability triggers.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2016-09-20","source":"wotc"},{"comment":"If a creature's owner leaves the game after you've put that creature onto the battlefield with Demon of Dark Schemes's last ability, the creature leaves with that player. If you leave the game before that player, the creature is exiled.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2016-09-20","source":"wotc"},{"comment":"The set of creatures affected by Demon of Dark Schemes's first triggered ability is determined as the ability resolves. Creatures that enter the battlefield later in the turn and noncreature permanents that become creatures later in the turn won't get -2/-2.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2016-09-20","source":"wotc"},{"comment":"Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana \"of any type\" can't give you energy counters.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"If a spell or ability with one or more targets states that you \"may pay\" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"Some triggered abilities state that you \"may pay\" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"Some triggered abilities that state that you \"may pay\" a certain amount of {E} describe an effect that happens \"If you do.\" In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase \"When you do,\" then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"{E} is the energy symbol. It represents one energy counter.","oracle_id":"2b2f2abd-6c0f-49a5-a44b-f366614c944d","published_at":"2024-06-07","source":"wotc"},{"comment":"All creatures on the battlefield when Nausea resolves are affected. Ones that enter the battlefield or become creatures later in the turn are not.","oracle_id":"2b8abae2-dd15-41ee-81ae-6a463723b43e","published_at":"2016-06-08","source":"wotc"},{"comment":"If a token is exiled this way, it will cease to exist and won't return to the battlefield.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.","oracle_id":"6879f5ce-7a1b-4606-bad1-885779b0d456","published_at":"2018-03-16","source":"wotc"},{"comment":"An activated ability has a \"Cost: Effect\" format. Look for the colon. A triggered ability starts with \"when\", \"whenever\", or \"at\".","oracle_id":"b3b00911-ece7-4484-bc36-f211ce72b6cc","published_at":"2004-10-04","source":"wotc"},{"comment":"It can target delayed triggered abilities. For example, a card that says \"Whenever a player cycles a card, you may exile target creature. If you do, return that creature to the battlefield at the beginning of the end step.\" triggers when a player cycles a card and creates a delayed trigger that happens at the beginning of the end step. You can choose to target the \"at the beginning of the end step\" trigger when it is placed on the stack at end of turn.","oracle_id":"b3b00911-ece7-4484-bc36-f211ce72b6cc","published_at":"2004-10-04","source":"wotc"},{"comment":"Turn-based actions and special actions like the normal card draw, combat damage, or turning a face-down creature face up can't be targeted.","oracle_id":"b3b00911-ece7-4484-bc36-f211ce72b6cc","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
