  "rulings": [
    {
      "oracle_id": "d07d3be3-f69d-4484-8467-cffd43871788",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "If Myr Retriever dies at the same time as another artifact you own, its ability can target that other artifact card."
    },
    {
      "oracle_id": "319ee221-bace-41e9-b386-6b528bd780c1",
      "published_at": "2020-11-10",
      "source": "wotc",
      "comment": "If another artifact card is put into your graveyard at the same time as Workshop Assistant, you can target it with Workshop Assistant's triggered ability."
    },
    {
      "oracle_id": "89599a64-19fc-47ad-a116-3ce0a10fa546",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "You choose a target when the ability triggers. You decide whether to pay {2} when the ability resolves."
    },
    {
      "oracle_id": "89599a64-19fc-47ad-a116-3ce0a10fa546",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If Carrion Thrash and another creature are put into a graveyard from the battlefield at the same time, you may target the other creature with Carrion Thrash’s ability."
    },
    {
      "oracle_id": "e98361d9-1e3a-464e-bac6-75314fc49f32",
      "published_at": "2007-05-01",
      "source": "wotc",
      "comment": "It targets a creature card in the graveyard. This target is selected when putting the triggered ability on the stack. The wording specifies it has to be a card other than the Hierophant."
    },
    {
      "oracle_id": "e98361d9-1e3a-464e-bac6-75314fc49f32",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "If you control Sylvan Hierophant when it goes to the graveyard, you exile the Hierophant and return a creature card from your graveyard to your hand. It doesn't matter whose graveyard the Hierophant goes to."
    },
    {
      "oracle_id": "e98361d9-1e3a-464e-bac6-75314fc49f32",
      "published_at": "2008-04-01",
      "source": "wotc",
      "comment": "If Sylvan Hierophant is removed from the graveyard before the ability resolves, you still return the targeted creature card from your graveyard to your hand."
    }
  ]
