  "rulings": [
    {
      "comment": "You’ll choose the target creature when the ability goes on the stack. You’ll choose whether or not to sacrifice Blind Zealot when the ability resolves.",
      "oracle_id": "30c7e304-ecfe-44c1-88d1-f507df63c080",
      "published_at": "2011-06-01",
      "source": "wotc"
    },
    {
      "comment": "The defending player gets to choose which cards they discard.",
      "oracle_id": "43abe1f3-7b92-411a-bf93-e158f949685c",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "An ability that triggers when something “attacks and isn’t blocked” triggers in the declare blockers step after blockers are declared if (1) that creature is attacking and (2) no creatures are declared to block it. It will trigger even if that creature was put onto the battlefield attacking rather than having been declared as an attacker in the declare attackers step.",
      "oracle_id": "43abe1f3-7b92-411a-bf93-e158f949685c",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "An ability that triggers when something \"attacks and isn't blocked\" triggers in the declare blockers step after blockers are declared if (1) that creature is attacking and (2) no creatures are declared to block it. It will trigger even if that creature was put onto the battlefield attacking rather than having been declared as an attacker in the declare attackers step.",
      "oracle_id": "ecae5eba-8407-4c71-aeae-ab10fb1e5226",
      "published_at": "2013-04-15",
      "source": "wotc"
    },
    {
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.",
      "oracle_id": "ecae5eba-8407-4c71-aeae-ab10fb1e5226",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Multiple instances of shadow on the same creature are redundant.",
      "oracle_id": "ecae5eba-8407-4c71-aeae-ab10fb1e5226",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Once a creature has been blocked, that creature remains blocked and will deal and be dealt combat damage even if it gains or loses shadow or if the blocking creature gains or loses shadow.",
      "oracle_id": "ecae5eba-8407-4c71-aeae-ab10fb1e5226",
      "published_at": "2021-03-19",
      "source": "wotc"
    }
  ],
