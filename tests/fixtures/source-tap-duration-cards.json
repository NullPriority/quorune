  "rulings": [
    {
      "oracle_id": "31da3df3-5b79-42d0-9018-76bc73411954",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It checks the creature type when the ability is announced and resolved, but once the effect is placed on the creature, if its creature type changes the effect still continues."
    },
    {
      "oracle_id": "3608f1f7-8dc5-4dd1-ae91-c830e1de9529",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Once a player announces that they're casting a spell or activating an ability, no player may take other actions until the spell or ability has been paid for. Notably, other players can't try to tap that player's permanents to stop them from paying {T} or to stop them from producing enough mana."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Turn to Frog overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Turn to Frog resolves will overwrite this effect."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "The creature will lose all other colors and creature types, but it will retain any other card types (such as artifact) or supertypes (such as legendary) it may have."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Turn to Frog resolves, it will keep that ability."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "If one of the Theros block Gods is affected by Turn to Frog, it will be a legendary 1/1 blue Frog enchantment creature with no abilities. If it stops being a creature, perhaps because your devotion to its color(s) decreased, it will be a legendary blue enchantment with no abilities. The way continuous effects work, the God’s type-changing ability is applied before the effect that removes that ability is applied."
    },
    {
      "oracle_id": "74c4c1e2-c50d-4c8f-889a-0d5674dc6d67",
      "published_at": "2014-07-18",
      "source": "wotc",
      "comment": "Turn to Frog doesn’t counter abilities that have already triggered or been activated. In particular, there is no way to cast this spell to stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If the ability resolves, then the creature gains flying later, Ice Floe’s effect will not end. (The ability checks whether the creature has flying only at the time you activate it and the time it resolves.)"
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If the affected creature is untapped by some other spell or ability, Ice Floe’s effect will not end. If you keep Ice Floe tapped, and that creature becomes tapped again, Ice Floe will continue to prevent it from being untapped during its controller’s untap step."
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "If Ice Floe untaps or leaves the battlefield, its effect will end. This has no immediate visible affect on the creature. (It doesn’t untap immediately, for example.) The creature will just untap as normal during its controller’s next untap step."
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "Ice Floe doesn’t track the creature’s controller. If the affected creature changes controllers, Ice Floe will prevent it from being untapped during its new controller’s untap step."
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "You may target a tapped creature with Ice Floe’s activated ability."
    },
    {
      "oracle_id": "cfaaead2-09e8-47cb-9e39-8570b8d8de86",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "The targeted creature is not removed from combat. Its attack will continue as normal."
    },
    {
      "oracle_id": "0cd5eef6-6830-4c6d-8578-2726900c39a5",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Only the artifacts that it tried to tap when the ability resolved are prevented from untapping. Artifacts that enter after that or permanents that become artifacts after that are not affected."
    },
    {
      "oracle_id": "0cd5eef6-6830-4c6d-8578-2726900c39a5",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Note that you can't choose to leave this card tapped during your untap step (unless some other effect says so)."
    },
    {
      "oracle_id": "c7f20899-2625-4b3a-8bd8-0bcee07ed86e",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "You may target a tapped artifact with Rust Tick’s activated ability."
    },
    {
      "oracle_id": "c7f20899-2625-4b3a-8bd8-0bcee07ed86e",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "If Rust Tick untaps or leaves the battlefield, its effect will end. This has no immediate visible effect on the affected artifact. (It doesn’t untap immediately, for example.) The artifact will just untap as normal during its controller’s next untap step."
    },
    {
      "oracle_id": "c7f20899-2625-4b3a-8bd8-0bcee07ed86e",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "If the affected artifact is untapped by some other spell or ability, Rust Tick’s effect will not end. If you keep Rust Tick tapped, and that artifact becomes tapped again, Rust Tick will continue to prevent it from being untapped during its controller’s untap step."
    },
    {
      "oracle_id": "c7f20899-2625-4b3a-8bd8-0bcee07ed86e",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "If you control both Rust Tick and the affected artifact, that artifact won’t untap during the untap step in which you choose to untap Rust Tick. (It will untap during your next one.)"
    },
    {
      "oracle_id": "c7f20899-2625-4b3a-8bd8-0bcee07ed86e",
      "published_at": "2011-01-01",
      "source": "wotc",
      "comment": "Rust Tick doesn’t track the artifact’s controller. If the affected artifact changes controllers, Rust Tick will prevent it from being untapped during its new controller’s untap step."
    },
    {
      "oracle_id": "cd8ae9f2-edac-473a-8846-c08219e617c3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Can be used on artifact creatures."
    },
    {
      "oracle_id": "5f71c09a-47fb-4bb2-9329-78f5bb195e5d",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Can be used on a creature that is already tapped."
    },
    {
      "oracle_id": "5f71c09a-47fb-4bb2-9329-78f5bb195e5d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Multiple instances of shadow on the same creature are redundant."
    },
    {
      "oracle_id": "5f71c09a-47fb-4bb2-9329-78f5bb195e5d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities."
    },
    {
      "oracle_id": "5f71c09a-47fb-4bb2-9329-78f5bb195e5d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Once a creature has been blocked, that creature remains blocked and will deal and be dealt combat damage even if it gains or loses shadow or if the blocking creature gains or loses shadow."
    },
    {
      "oracle_id": "dbd6a94b-62ff-4a10-9d52-bdd90b26e425",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "If multiple \"extra turn\" effects resolve in the same turn, take them in the reverse of the order that the effects resolved. In other words, the most recently created extra turn is taken first."
    }
  ]
}
