  "rulings": [
    {
      "oracle_id": "8e1eff5a-77e8-4ea2-96b8-547504f83b45",
      "published_at": "2020-11-10",
      "source": "wotc",
      "comment": "To move a counter from one creature to another, the counter is removed from the first creature and put onto the second. Any abilities that care about a counter being removed from or placed on a creature will apply."
    },
    {
      "oracle_id": "8e1eff5a-77e8-4ea2-96b8-547504f83b45",
      "published_at": "2020-11-10",
      "source": "wotc",
      "comment": "You choose a target creature as Scrounging Bandar's triggered ability is put onto the stack. You choose how many counters to move (if any) as that ability resolves. If that creature becomes an illegal target or if Scrounging Bandar has left the battlefield, you can't move any counters."
    },
    {
      "comment": "A card with devoid is just colorless. It’s not colorless and the colors of mana in its mana cost.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Cards with devoid use frames that are variations of the transparent frame traditionally used for Eldrazi. The top part of the card features some color over a background based on the texture of the hedrons that once imprisoned the Eldrazi. This coloration is intended to aid deckbuilding and game play.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Devoid works in all zones, not just on the battlefield.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Gaining control of a creature doesn’t cause you to gain control of any Auras or Equipment attached to it.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "If a card loses devoid, it will still be colorless. This is because effects that change an object’s color (like the one created by devoid) are considered before the object loses devoid.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Other cards and abilities can give a card with devoid color. If that happens, it’s just the new color, not that color and colorless.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    },
    {
      "comment": "Turn Against can target any creature, even one that’s untapped or one you already control.",
      "oracle_id": "634d6357-af76-4e25-8c63-81522bc726f5",
      "published_at": "2015-08-25",
      "source": "wotc"
    }
  ],
