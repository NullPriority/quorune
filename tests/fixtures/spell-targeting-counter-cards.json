[],"released_at":"2012-05-04","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Rebuff the Wicked","oracle_id":"f5822e53-ddec-4c77-bcf4-091e35c1e731","oracle_text":"Counter target spell that targets a permanent you control.","power":null,"produced_mana":[],"released_at":"2021-03-19","toughness":null,"type_line":"Instant"},{"cmc":5.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{5}","name":"Ring of Immortals","oracle_id":"468a8c2e-0cc2-4108-809d-42ca1eb25ff2","oracle_text":"{3}, {T}: Counter target instant or Aura spell that targets a permanent you control.","power":null,"produced_mana":[],"released_at":"1994-06-01","toughness":null,"type_line":"Artifact"},{"cmc":1.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Regenerate"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Vigilant Martyr","oracle_id":"122dfe9f-e0e2-4f69-9637-289c956fd54a","oracle_text":"Sacrifice this creature: Regenerate target creature.\n{W}{W}, {T}, Sacrifice this creature: Counter target spell that targets an enchantment.","power":"1","produced_mana":[],"released_at":"1996-10-08","toughness":"1","type_line":"Creature — Human Cleric"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Avoid Fate must target an instant spell or an Aura spell as it’s cast, and it must be targeting an instant or an Aura spell at the time it resolves. It will still resolve if it starts out targeting a spell of one type but the target changes to a spell of the other type (thanks to Shunt, for instance) before it resolves.","oracle_id":"c04dd88f-fb7f-43be-b586-7fc5642073dc","published_at":"2011-01-22","source":"wotc"},{"comment":"Cerulean Drake’s activated ability can target a spell that has multiple targets if at least one of those targets is you.","oracle_id":"ecd6587c-3548-4bc1-89e4-9f7fbbc2d2ad","published_at":"2019-07-12","source":"wotc"},{"comment":"Confound doesn’t resolve if the targeted spell has been countered or does not still target one or more permanents that are still creatures and are still on the battlefield. Confound is different from other such spells in that it actually specifies that the spell must target a creature, not just be able to target a creature or that the spell has a certain number of targets.","oracle_id":"ca8a0e81-f885-47ee-82bb-fb25ec61bb1c","published_at":"2004-10-04","source":"wotc"},{"comment":"Fugitive Droid's activated ability can target a spell that has multiple targets, as long as at least one of those targets is an artifact or creature you control.","oracle_id":"c04d4fd4-e5aa-431d-824b-8bc94245f103","published_at":"2026-01-27","source":"wotc"},{"comment":"If the artifact or creature you control targeted by the target spell leaves the battlefield, that spell is no longer a legal target for Fugitive Droid's activated ability. On the other hand, if that targeted artifact or creature becomes an illegal target for the target spell but remains on the battlefield under your control, the target spell is still a legal target for Fugitive Droid's activated ability.","oracle_id":"c04d4fd4-e5aa-431d-824b-8bc94245f103","published_at":"2026-01-27","source":"wotc"},{"comment":"Hindering Light can target a spell that has multiple targets, as long as at least one of those targets is you or a permanent you control.","oracle_id":"945ac15c-780b-44a9-8a8e-011cf1c30876","published_at":"2008-10-01","source":"wotc"},{"comment":"You may choose to target a spell that “can’t be countered.” If you do, the first part of Hindering Light’s effect won’t do anything, but you’ll still get to draw a card.","oracle_id":"945ac15c-780b-44a9-8a8e-011cf1c30876","published_at":"2008-10-01","source":"wotc"},{"comment":"If a spell is modal, use the target(s) of the current mode only for this check. Targets for the other modes are never selected.","oracle_id":"380b386f-90c8-45c5-a611-1ed6803b52d2","published_at":"2004-10-04","source":"wotc"},{"comment":"If the spell’s target leaves the battlefield before this spell resolves, Intervene won’t resolve since it no longer targets a spell that targets a creature.","oracle_id":"380b386f-90c8-45c5-a611-1ed6803b52d2","published_at":"2004-10-04","source":"wotc"},{"comment":"Intervene can only target a spell that is currently targeting a creature.","oracle_id":"380b386f-90c8-45c5-a611-1ed6803b52d2","published_at":"2004-10-04","source":"wotc"},{"comment":"It means “targeting at least one creature” not “exactly one creature”.","oracle_id":"380b386f-90c8-45c5-a611-1ed6803b52d2","published_at":"2004-10-04","source":"wotc"},{"comment":"A spell that can’t be countered is a legal target for Keep Safe. That spell won’t be countered when Keep Safe resolves, but you’ll still draw a card.","oracle_id":"5602c14d-cc22-47d7-a1b0-6491749f00dd","published_at":"2020-04-17","source":"wotc"},{"comment":"If the permanent you control targeted by the target spell leaves the battlefield, that spell is no longer a legal target for Keep Safe. On the other hand, if that target permanent becomes an illegal target for the target spell but remains on the battlefield under your control, the target spell is still a legal target for Keep Safe.","oracle_id":"5602c14d-cc22-47d7-a1b0-6491749f00dd","published_at":"2020-04-17","source":"wotc"},{"comment":"Keep Safe can target a spell that has multiple targets, as long as at least one of those targets is a permanent you control.","oracle_id":"5602c14d-cc22-47d7-a1b0-6491749f00dd","published_at":"2020-04-17","source":"wotc"},{"comment":"The spell you target could also target other things, as long as it also targets a player.","oracle_id":"eac02e36-15c8-4b6d-b9b4-da549a722336","published_at":"2012-05-01","source":"wotc"},{"comment":"If the permanent you control targeted by the target spell leaves the battlefield, that spell is no longer a legal target for Rebuff the Wicked. On the other hand, if that targeted permanent becomes an illegal target for the target spell but remains on the battlefield under your control, the target spell is still a legal target for Rebuff the Wicked.","oracle_id":"f5822e53-ddec-4c77-bcf4-091e35c1e731","published_at":"2021-03-19","source":"wotc"},{"comment":"Rebuff the Wicked can target a spell that has multiple targets, as long as at least one of those targets is a permanent you control.","oracle_id":"f5822e53-ddec-4c77-bcf4-091e35c1e731","published_at":"2021-03-19","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
