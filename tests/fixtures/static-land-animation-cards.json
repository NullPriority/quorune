  "rulings": [
    {
      "oracle_id": "30e99293-3212-4e3f-b543-b1c7c416575d",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "This has the supertype world. When a world permanent enters, any world permanents that were already on the battlefield are put into their owners' graveyards. This is a state-based action called the \"world rule.\" The new world permanent stays on the battlefield. If two world permanents enter at the same time, they're both put into their owners' graveyards."
    },
    {
      "oracle_id": "30e99293-3212-4e3f-b543-b1c7c416575d",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "A noncreature permanent that turns into a creature is subject to the \"summoning sickness\" rule: It can only attack, and its {T} abilities can only be activated, if its controller has continuously controlled that permanent since the beginning of their most recent turn."
    },
    {
      "oracle_id": "0df0503b-25e7-499b-a703-a867f2da790c",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "A noncreature permanent that turns into a creature can attack, and its {T} abilities can be activated, only if its controller has continuously controlled that permanent since the beginning of their most recent turn. It doesn’t matter how long the permanent has been a creature."
    },
    {
      "oracle_id": "8f0179fe-6d7d-49cc-ab06-d3b402c6fc8d",
      "published_at": "2008-08-01",
      "source": "wotc",
      "comment": "A noncreature permanent that turns into a creature can attack, and its {T} abilities can be activated, only if its controller has continuously controlled that permanent since the beginning of their most recent turn. It doesn't matter how long the permanent has been a creature."
    },
    {
      "oracle_id": "d2d477a5-f055-4d47-a852-26e8239f2a01",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The lands are both lands and creatures at the same time. They are affected by anything that affects either permanent type."
    },
    {
      "oracle_id": "d2d477a5-f055-4d47-a852-26e8239f2a01",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "It affects Swamps controlled by any and all players."
    },
