  "rulings": [
    {
      "oracle_id": "70e4025f-41de-4b47-a590-3c922dc1e209",
      "published_at": "2004-12-01",
      "source": "wotc",
      "comment": "Dosan’s ability only stops players from casting spells. It doesn’t stop activated or triggered abilities."
    },
    {
      "oracle_id": "aadd10d0-6dd0-4bdc-8d93-ff08e29a5863",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "Effects may put cards from other zones onto the battlefield under an opponent's control."
    },
    {
      "oracle_id": "aadd10d0-6dd0-4bdc-8d93-ff08e29a5863",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "If an effect says that an opponent may cast a spell from anywhere other than their hand, Drannith Magistrate's restriction overrules that permission."
    },
    {
      "oracle_id": "aadd10d0-6dd0-4bdc-8d93-ff08e29a5863",
      "published_at": "2020-04-17",
      "source": "wotc",
      "comment": "If a rule or effect allows them to do so, your opponents may play lands from zones other than their hand and activate abilities of cards in zones other than their hand."
    },
    {
      "oracle_id": "671458ac-7441-4332-9e59-a42ec8b62f31",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "City of Solitude can affect abilities of cards that are not on the battlefield because it prevents players from activating those abilities."
    },
    {
      "oracle_id": "671458ac-7441-4332-9e59-a42ec8b62f31",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "City of Solitude does not stop triggered abilities from being put on the stack. They are never “activated”."
    },
    {
      "oracle_id": "671458ac-7441-4332-9e59-a42ec8b62f31",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "This stops players from activating mana abilities."
    },
    {
      "oracle_id": "c749f23c-40c0-4159-b84c-a70cbb062c14",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "Grand Abolisher doesn't affect triggered abilities or static abilities."
    },
    {
      "oracle_id": "c749f23c-40c0-4159-b84c-a70cbb062c14",
      "published_at": "2011-09-22",
      "source": "wotc",
      "comment": "Grand Abolisher doesn't stop your opponents from activating abilities of artifact, creature, or entorchantment cards in zones other than the battlefield (like cycling abilities, for example)."
    },
    {
      "oracle_id": "ec3471ad-b65c-4e35-a7d1-68da9555a9ec",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "Ethersworn Canonist takes into account spells that were cast earlier in the turn before Ethersworn Canonist entered the battlefield, including any spells that are somehow still on the stack. However, any spells on the stack as Ethersworn Canonist enters the battlefield have already been cast by that point, so they're not affected by it."
    },
    {
      "oracle_id": "ec3471ad-b65c-4e35-a7d1-68da9555a9ec",
      "published_at": "2020-08-07",
      "source": "wotc",
      "comment": "Each turn, each player can cast any number of artifact spells plus a maximum of one nonartifact spell."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."
    },
    {
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability."
    },
    {
      "oracle_id": "cd0d7141-46d2-4aa3-bc77-6b3b4513803e",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "Gaining control of a creature doesn't cause you to gain control of any Auras or Equipment attached to it."
    },
    {
      "oracle_id": "326ba371-124c-4949-a048-3a0c8962e567",
      "published_at": "2008-10-01",
      "source": "wotc",
      "comment": "Cycling is an activated ability. Effects that interact with activated abilities (such as Stifle or Rings of Brighthearth) will interact with cycling. Effects that interact with spells (such as Remove Soul or Faerie Tauntings) will not."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as an overload cost), add any cost increases, then apply any cost reductions. The mana value of the spell remains unchanged, no matter what the total cost to cast it was."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "Because a spell with overload doesn't target when its overload cost is paid, it may affect permanents with hexproof or with protection from the appropriate color."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If you are instructed to cast a spell with overload \"without paying its mana cost,\" you can't choose to pay its overload cost instead."
    },
    {
      "oracle_id": "d75b9c82-1b49-4c3e-a1b5-aeef57d6644b",
      "published_at": "2024-01-12",
      "source": "wotc",
      "comment": "If you don't pay the overload cost of a spell with overload, that spell will have a single target. If you pay the overload cost, the spell won't have any targets."
    },
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "Casting Scourge of Nel Toth from your graveyard by paying the alternative cost doesn’t change when you can cast it. You can cast it only at the normal time you could cast a creature spell."
    },
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "If you cast Scourge of Nel Toth from your graveyard, it is a spell and can be countered."
    },
    {
      "oracle_id": "32972d7a-c7c6-437c-8e7c-6c7d56b130e4",
      "published_at": "2015-11-04",
      "source": "wotc",
      "comment": "As soon as you start to cast Scourge of Nel Toth from your graveyard, it moves to the stack. At that point, it’s too late for an opponent to prevent you from casting it by removing it from your graveyard. It’s also too late for players to try to destroy the creatures you sacrifice to pay for the spell."
    },
    {
      "oracle_id": "ab26fbe2-e808-48b9-8d0d-3fbb6c3d554f",
      "published_at": "2019-05-03",
      "source": "wotc",
      "comment": "Replacement effects (such as that of Underrealm Lich or the first ability of Jace, Wielder of Mysteries) can't be used to replace draws that Narset disallows. However, if an opponent's first draw is replaced (by Underrealm Lich's ability, for example), that draw didn't happen and Narset won't stop the next draw (which may also be replaced by Underrealm Lich's ability)."
    },
    {
      "oracle_id": "ab26fbe2-e808-48b9-8d0d-3fbb6c3d554f",
      "published_at": "2019-05-03",
      "source": "wotc",
      "comment": "If an opponent hasn't drawn any cards in a turn and a spell or ability instructs that player to draw multiple cards, that player will just draw one card. However, if the draws are optional, the player can't choose to draw, even if they could draw one card this way."
    },
    {
      "oracle_id": "ab26fbe2-e808-48b9-8d0d-3fbb6c3d554f",
      "published_at": "2019-05-03",
      "source": "wotc",
      "comment": "Your opponents can each draw a maximum of one card each on each player's turn. Subsequent card draws during that turn are ignored."
    },
    {
      "oracle_id": "ab26fbe2-e808-48b9-8d0d-3fbb6c3d554f",
      "published_at": "2019-05-03",
      "source": "wotc",
      "comment": "Narset will \"see\" cards drawn by opponents earlier in the turn she entered the battlefield, although Narset can't affect cards drawn before she entered the battlefield. For example, if an opponent draws two cards, then Narset enters the battlefield, that opponent can't draw more cards that turn, but the two drawn cards are unaffected."
    }
  ]
}
