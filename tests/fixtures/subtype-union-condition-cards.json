  "rulings": [
    {
      "oracle_id": "3608f1f7-8dc5-4dd1-ae91-c830e1de9529",
      "published_at": "2022-12-08",
      "source": "wotc",
      "comment": "Once a player announces that they're casting a spell or activating an ability, no player may take other actions until the spell or ability has been paid for. Notably, other players can't try to tap that player's permanents to stop them from paying {T} or to stop them from producing enough mana."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Vehicle is an artifact type, not a creature type. A Vehicle that's crewed won't normally have any creature type."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Any untapped creature you control can be tapped to pay a crew cost, even one that just came under your control."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "If an effect causes a Vehicle to become an artifact creature with a specified power and toughness, that effect overwrites the Vehicle's printed power and toughness."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "You may activate a crew ability of a Vehicle even if it's already an artifact creature. Doing so has no effect on the Vehicle. It doesn't change its power and toughness."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Once a Vehicle becomes a creature, it behaves exactly like any other artifact creature. It can't attack unless you've controlled it continuously since your turn began, it can block if it's untapped, it can be tapped to pay a Vehicle's crew cost, and so on."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "You may tap more creatures than necessary to activate a crew ability."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "If a permanent becomes a copy of a Vehicle, the copy won't be a creature, even if the Vehicle it's copying has become an artifact creature."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "For a Vehicle to be able to attack, it must be a creature as the declare attackers step begins, so the latest you can activate its crew ability to attack with it is during the beginning of combat step. For a Vehicle to be able to block, it must be a creature as the declare blockers step begins, so the latest you can activate its crew ability to block with it is during the declare attackers step. In either case, players may take actions after the crew ability resolves but before the Vehicle has been declared as an attacking or blocking creature."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Creatures that crew a Vehicle aren't attached to it or related in any other way. Effects that affect the Vehicle, such as by destroying it or giving it a +1/+1 counter, don't affect the creatures that crewed it."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Each Vehicle is printed with a power and toughness, but it's not a creature. If it becomes a creature (most likely through its crew ability), it will have that power and toughness."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "When a Vehicle becomes a creature, that doesn't count as having a creature enter the battlefield. The permanent was already on the battlefield; it only changed its types. Abilities that trigger whenever a creature enters the battlefield won't trigger."
    },
    {
      "oracle_id": "f2c43b85-8c42-4b23-84c2-bec8d6230039",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Once a player announces that they are activating a crew ability, no player may take other actions until the ability has been paid for. Notably, players can't try to stop the ability by changing a creature's power or by removing or tapping a creature."
    },
    {
      "oracle_id": "cd8ae9f2-edac-473a-8846-c08219e617c3",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Can be used on artifact creatures."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "If The Indomitable is countered or dies after being cast from your graveyard, it returns to the graveyard. It may be cast this way again later."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "Once you begin casting a spell from your graveyard, it immediately moves to the stack. Players can't take any actions until you've finished casting the spell."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "You still pay The Indomitable's costs when casting it from your graveyard."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "The casting permission granted by The Indomitable's last ability doesn't change when you may cast it from your graveyard."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "The Indomitable checks if you control three or more tapped Pirates and/or Vehicles only as you begin to cast it. Once you begin to cast The Indomitable from your graveyard, it doesn't matter what happens to the tapped Pirates and/or Vehicles you control."
    },
    {
      "oracle_id": "276dc5c8-c8cf-4b9c-ad75-31876e6e040a",
      "published_at": "2023-11-10",
      "source": "wotc",
      "comment": "Only tapped Pirates and tapped Vehicles count toward the casting permission from The Indomitable's last ability."
    }
  ]
}
