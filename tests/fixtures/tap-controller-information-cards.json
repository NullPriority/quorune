  "rulings": [
    {
      "oracle_id": "0c6f343a-0088-477a-a6b5-256783ad0c27",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Corrupted Roots doesn’t care why the enchanted land becomes tapped. If that land changes from being untapped to being tapped for any reason, the ability will trigger."
    },
    {
      "oracle_id": "0c6f343a-0088-477a-a6b5-256783ad0c27",
      "published_at": "2009-02-01",
      "source": "wotc",
      "comment": "Corrupted Roots can enchant only a Forest or a Plains. It checks the enchanted land’s subtypes, not its name. If at any time the enchanted land is neither a Forest nor a Plains (due to Unstable Frontier’s ability, perhaps), Corrupted Roots is put into its owner’s graveyard as a state-based action."
    },
    {
      "oracle_id": "474db5db-914e-474d-b0c2-7987d5986dc3",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "Chronic Flooding becoming attached to a tapped land won’t cause its ability to immediately trigger. That land must go from untapped to tapped."
    },
    {
      "oracle_id": "474db5db-914e-474d-b0c2-7987d5986dc3",
      "published_at": "2012-10-01",
      "source": "wotc",
      "comment": "Chronic Flooding’s ability will trigger whenever the enchanted land becomes tapped for any reason, not just because its controller taps it for mana."
    },
    {
      "oracle_id": "a60422e8-f2f4-4c37-a0f4-eedad27eb08c",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Whenever the land is tapped for any reason, the ability triggers."
    }
  ]
