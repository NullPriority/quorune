  "rulings": [
    {
      "oracle_id": "15bd8fa1-0858-4029-9973-e24c86e45af3",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "The triggered ability of Shapers’ Sanctuary resolves before the spell or ability that caused it to trigger."
    },
    {
      "oracle_id": "15bd8fa1-0858-4029-9973-e24c86e45af3",
      "published_at": "2017-09-29",
      "source": "wotc",
      "comment": "Players can cast spells and activate abilities after the triggered ability of Shapers’ Sanctuary resolves but before the spell or ability that caused it to trigger does. Notably, the card you draw may be able to counter that spell or ability."
    },
    {
      "oracle_id": "0ecd4493-dfb4-4d56-a90e-08b74b474f39",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "Tenured Concocter's second ability resolves before the spell or ability that caused it to trigger. It resolves even if that spell is countered or otherwise leaves the stack."
    },
    {
      "oracle_id": "0ecd4493-dfb4-4d56-a90e-08b74b474f39",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "If a spell or ability targets Tenured Concocter more than once, its second ability still triggers only once."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "Twincast can copy any instant or sorcery spell, not just one with targets."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell has damage divided as it was cast, the division can't be changed, although the targets receiving that damage still can. The same is true of spells that distribute counters."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal)."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell that's copied is modal (that is, it says \"Choose one —\" or the like), the copy will have the same mode. A different mode can't be chosen."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If the spell that's copied has an X whose value was determined as it was cast, the copy will have the same value of X."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "The copy is created on the stack, so it's not \"cast.\" Abilities that trigger when a player casts a spell won't trigger. The copy will resolve before the original spell does."
    },
    {
      "oracle_id": "8f878efc-850f-43d2-a6fe-5ea8d1dd5afb",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You can't choose to pay any alternative or additional costs for the copy. However, effects based on any alternative or additional costs that were paid for the original spell are copied as though those same costs were paid for the copy."
    },
    {
      "oracle_id": "74a7d880-5a49-412b-af4d-0b4cdb8453ee",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can’t choose a new legal target, then it remains unchanged (even if the current target is illegal)."
    },
    {
      "oracle_id": "74a7d880-5a49-412b-af4d-0b4cdb8453ee",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "Redirect can target any spell, not just an instant or sorcery spell. For example, you could use it to change the target of an Aura spell. However, if the targeted spell has no targets (for example, if it’s an instant or sorcery spell that doesn’t specifically use the word “target,” or if it’s a creature spell), Redirect won’t have any effect on it."
    },
    {
      "oracle_id": "74a7d880-5a49-412b-af4d-0b4cdb8453ee",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If the targeted spell is modal (that is, it says “Choose one —” or the like), you can’t choose a different mode."
    },
    {
      "oracle_id": "74a7d880-5a49-412b-af4d-0b4cdb8453ee",
      "published_at": "2010-08-15",
      "source": "wotc",
      "comment": "If you cast Redirect targeting a spell that targets a spell on the stack (like Cancel does, for example), you can’t change that spell’s target to itself. You can, however, change that spell’s target to Redirect. If you do, that spell won’t resolve when it tries to resolve because Redirect will have left the stack by then."
    },
    {
      "oracle_id": "f84637f0-1a04-4fd1-85d9-8e8f5d444800",
      "published_at": "2013-09-15",
      "source": "wotc",
      "comment": "Heroic abilities will resolve before the spell that caused them to trigger."
    },
    {
      "oracle_id": "f84637f0-1a04-4fd1-85d9-8e8f5d444800",
      "published_at": "2013-09-15",
      "source": "wotc",
      "comment": "Heroic abilities will trigger only once per spell, even if that spell targets the creature with the heroic ability multiple times."
    },
    {
      "oracle_id": "f84637f0-1a04-4fd1-85d9-8e8f5d444800",
      "published_at": "2013-09-15",
      "source": "wotc",
      "comment": "Heroic abilities won't trigger when a copy of a spell is created on the stack or when a spell's targets are changed to include a creature with a heroic ability."
    },
    {
      "oracle_id": "09cc0faa-71d7-428b-9fc4-5ba09e244e89",
      "published_at": "2014-04-26",
      "source": "wotc",
      "comment": "Heroic abilities won't trigger when a copy of a spell is created on the stack or when a spell's targets are changed to include a creature with a heroic ability."
    },
