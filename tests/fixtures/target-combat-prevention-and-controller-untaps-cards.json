  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "If you Donate an Aura, it stays where it is, but the targeted player now controls it.",
      "oracle_id": "049d1fb2-cce7-40e7-a633-e84cf9782d89",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Telekinesis\u2019 ability doesn\u2019t lock in who the creature\u2019s controller is when it resolves. If the creature changes controllers, it won\u2019t untap during its controller\u2019s untap step until it has not done so twice, regardless of who its controller was during any of those untap steps.",
      "oracle_id": "1b9dd2b6-d14d-4c1e-9885-00ab2c0bf8da",
      "published_at": "2007-09-16",
      "source": "wotc"
    },
    {
      "comment": "If a token is exiled this way, it will cease to exist and won't return to the battlefield.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "Once the exiled permanent returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to the exiled permanent will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "The returned card won't be the target of any spells or abilities that targeted it before. Any spells that don't target, such as Akroma's Vengeance, will still affect it.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "When an effect returns the exiled card \"under your control,\" you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Cloudshift's effect are exiled.",
      "oracle_id": "6879f5ce-7a1b-4606-bad1-885779b0d456",
      "published_at": "2018-03-16",
      "source": "wotc"
    },
    {
      "comment": "If multiple \"extra turn\" effects resolve in the same turn, take them in the reverse of the order that the effects resolved. In other words, the most recently created extra turn is taken first.",
      "oracle_id": "dbd6a94b-62ff-4a10-9d52-bdd90b26e425",
      "published_at": "2022-12-08",
      "source": "wotc"
    },
    {
      "comment": "If either target of Pit Fight is an illegal target when the ability tries to resolve, neither creature will deal or be dealt damage.",
      "oracle_id": "ef4b0ced-70a1-41d8-9aed-34e75f979c5f",
      "published_at": "2013-01-24",
      "source": "wotc"
    },
    {
      "comment": "The second target of Pit Fight can be another creature you control, but it can\u2019t be the same creature as the first target.",
      "oracle_id": "ef4b0ced-70a1-41d8-9aed-34e75f979c5f",
      "published_at": "2013-01-24",
      "source": "wotc"
    },
    {
      "comment": "Cycling is an activated ability. Effects that interact with activated abilities (such as Stifle or Rings of Brighthearth) will interact with cycling. Effects that interact with spells (such as Remove Soul or Faerie Tauntings) will not.",
      "oracle_id": "fa8f3827-8cd9-4896-ab0c-26fecacceb40",
      "published_at": "2008-10-01",
      "source": "wotc"
    }
  ],
