_at":"2023-01-13","toughness":"2","type_line":"Artifact Creature — Thopter"},{"cmc":1.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Oust","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","oracle_text":"Put target creature into its owner's library second from the top. Its controller gains 3 life.","power":null,"produced_mana":[],"released_at":"2024-02-23","toughness":null,"type_line":"Sorcery"},{"cmc":4.0,"color_identity":["R"],"colors":["R"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}{R}","name":"Structural Distortion","oracle_id":"bf0b6800-8e6b-4ccd-8e4d-96e61342f981","oracle_text":"Exile target artifact or land. Structural Distortion deals 2 damage to that permanent's controller.","power":null,"produced_mana":[],"released_at":"2016-04-08","toughness":null,"type_line":"Sorcery"},{"cmc":1.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"banned","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{W}","name":"Swords to Plowshares","oracle_id":"b1544f21-7e98-461b-aed5-e748b0168c52","oracle_text":"Exile target creature. Its controller gains life equal to its power.","power":null,"produced_mana":[],"released_at":"2026-06-26","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If the creature becomes an illegal target for Certain Death, no player gains or loses life. If it’s a legal target but isn’t destroyed, most likely due to having indestructible, its controller still loses 2 life and you gain 2 life.","oracle_id":"1d4b8a31-6500-4e3d-bcaf-f6f184d7743e","published_at":"2016-07-13","source":"wotc"},{"comment":"The targeted creature will have already left the battlefield before its controller loses 2 life and you gain 2 life. If it has any abilities that care about gaining or losing life, they won’t apply.","oracle_id":"1d4b8a31-6500-4e3d-bcaf-f6f184d7743e","published_at":"2016-07-13","source":"wotc"},{"comment":"Although you may want to include Lessons in your sideboard if you’re playing with cards that instruct you to learn, Lesson cards can be included in your main deck like other instant or sorcery cards.","oracle_id":"60e36f86-e284-468e-8073-07f19a3ed65e","published_at":"2021-04-16","source":"wotc"},{"comment":"Lesson is a spell subtype found on some instant and sorcery cards in the Strixhaven set. The Lesson subtype has no special rules associated with it.","oracle_id":"60e36f86-e284-468e-8073-07f19a3ed65e","published_at":"2021-04-16","source":"wotc"},{"comment":"You must target an artifact or enchantment to cast Destructive Revelry. If that artifact or enchantment is an illegal target when Destructive Revelry tries to resolve, it won't resolve and none of its effects will happen. No damage will be dealt. However, if Destructive Revelry resolves and the artifact or enchantment isn't destroyed (perhaps because it has indestructible), damage will be dealt.","oracle_id":"7165fade-ea96-4026-bc80-620729b8f70c","published_at":"2013-09-15","source":"wotc"},{"comment":"Although Darksteel Citadel is an artifact, it can't be cast as a spell. Playing it follows the normal rules for playing a land.","oracle_id":"8dc067bf-f78f-4ac4-b6e7-b305c42cf0bc","published_at":"2014-07-18","source":"wotc"},{"comment":"If the targeted creature becomes an illegal target before Call to Heel resolves, Call to Heel doesn’t resolve. No one draws a card.","oracle_id":"8ef3dd68-f6a1-43b9-8837-40b326019b1b","published_at":"2008-10-01","source":"wotc"},{"comment":"The player who draws a card is the player who controls the creature when Call to Heel resolves. This may not be the player whose hand the creature is put into.","oracle_id":"8ef3dd68-f6a1-43b9-8837-40b326019b1b","published_at":"2008-10-01","source":"wotc"},{"comment":"Cindervines can be the target of its own activated ability. The ability won't resolve since it won't have a legal target, and no player will be dealt damage, but this does allow you to sacrifice Cindervines without anything else to target if you want to.","oracle_id":"92d95e12-fa51-4360-88e4-9078ccc5d8d3","published_at":"2019-01-25","source":"wotc"},{"comment":"Cindervines's triggered ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered.","oracle_id":"92d95e12-fa51-4360-88e4-9078ccc5d8d3","published_at":"2019-01-25","source":"wotc"},{"comment":"If the target permanent is an illegal target by the time Cindervines's activated ability tries to resolve, the ability doesn't resolve. No player is dealt damage. If the target is legal but not destroyed (most likely because it has indestructible), its controller is dealt damage.","oracle_id":"92d95e12-fa51-4360-88e4-9078ccc5d8d3","published_at":"2019-01-25","source":"wotc"},{"comment":"Use the power of the creature from when it was last on the battlefield to determine how much life is gained.","oracle_id":"b1544f21-7e98-461b-aed5-e748b0168c52","published_at":"2022-12-08","source":"wotc"},{"comment":"Flesh Allergy counts each creature put into a graveyard from the battlefield that turn, including token creatures, the creature sacrificed to cast the spell, and the targeted creature (if it is destroyed).","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2011-01-01","source":"wotc"},{"comment":"If the targeted creature is an illegal target by the time Flesh Allergy resolves, the spell doesn't resolve. No player will lose life.","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2011-01-01","source":"wotc"},{"comment":"You can target a creature you control, then sacrifice that creature to pay the additional cost. However, if you do, Flesh Allergy won't resolve for having an illegal target. You won't lose any life.","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2011-01-01","source":"wotc"},{"comment":"Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2013-04-15","source":"wotc"},{"comment":"You must sacrifice exactly one creature to cast this spell; you cannot cast it without sacrificing a creature, and you cannot sacrifice additional creatures.","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2013-04-15","source":"wotc"},{"comment":"If Flesh Allergy resolves but the targeted creature is not destroyed (because it has indestructible or enchanted by an Aura with umbra armor, for example), its controller will still lose life.","oracle_id":"bd3ce6a2-9efc-4dab-a357-9f2aa0a4c0c6","published_at":"2013-07-01","source":"wotc"},{"comment":"If the targeted creature is a token, it will cease to exist after it’s put into its owner’s library.","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","published_at":"2010-06-15","source":"wotc"},{"comment":"If the targeted creature is an illegal target by the time Oust resolves, the spell doesn’t resolve. No one gains life.","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","published_at":"2010-06-15","source":"wotc"},{"comment":"If the targeted creature’s owner has no cards left in their library, that creature is put into that library as the only card there.","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","published_at":"2010-06-15","source":"wotc"},{"comment":"If the targeted creature’s owner has one or more cards in their library, that creature is put into that library directly under the top card.","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","published_at":"2010-06-15","source":"wotc"},{"comment":"Note that the creature’s controller, not its owner, is the one who gains life.","oracle_id":"efc12fda-054b-466a-a863-06cf54878172","published_at":"2010-06-15","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
