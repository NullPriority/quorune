U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Reach Through Mists","oracle_id":"c81ca8ff-92f3-481e-82f7-0673b6c74ea0","oracle_text":"Draw a card.","power":null,"produced_mana":[],"released_at":"2017-03-31","toughness":null,"type_line":"Instant — Arcane"},{"cmc":1.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"banned","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"banned","modern":"not_legal","oathbreaker":"banned","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"banned","vintage":"restricted"},"loyalty":null,"mana_cost":"{1}","name":"Sol Ring","oracle_id":"6ad8011d-3471-4369-9d68-b264cc027487","oracle_text":"{T}: Add {C}{C}.","power":null,"produced_mana":["C"],"released_at":"2026-06-26","toughness":null,"type_line":"Artifact"},{"cmc":1.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"banned","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"banned","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{G}","name":"Veil of Summer","oracle_id":"002965be-a36f-4a09-9ce0-c6535bca1703","oracle_text":"Draw a card if an opponent has cast a blue or black spell this turn. Spells you control can't be countered this turn. You and permanents you control gain hexproof from blue and from black until end of turn. (You and they can't be the targets of blue or black spells or abilities your opponents control.)","power":null,"produced_mana":[],"released_at":"2019-07-12","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"A spell or ability that counters spells can still target your spells after Veil of Summer resolves. When that spell or ability resolves, your spell won't be countered, but any additional effects of the countering spell or ability will still happen.","oracle_id":"002965be-a36f-4a09-9ce0-c6535bca1703","published_at":"2019-07-12","source":"wotc"},{"comment":"If your opponents have cast more than one blue or black spell, you still draw only one card as Veil of Summer resolves.","oracle_id":"002965be-a36f-4a09-9ce0-c6535bca1703","published_at":"2019-07-12","source":"wotc"},{"comment":"Veil of Summer has no effect until it resolves. It can be countered.","oracle_id":"002965be-a36f-4a09-9ce0-c6535bca1703","published_at":"2019-07-12","source":"wotc"},{"comment":"Mana produced by Ancient Ziggurat can be spent on any part of a creature spell's total cost. This includes additional costs (such as kicker) and alternative costs (such as evoke or Worldheart Phoenix's alternative cost).","oracle_id":"0baabe39-72ae-47bd-a095-cbf7eb8a6361","published_at":"2009-02-01","source":"wotc"},{"comment":"Mana produced by Ancient Ziggurat can't be spent on activated abilities that put a creature card directly onto the battlefield, such as unearth or ninjutsu.","oracle_id":"0baabe39-72ae-47bd-a095-cbf7eb8a6361","published_at":"2009-02-01","source":"wotc"},{"comment":"Maze of Ith can target an untapped attacking creature. It will still prevent the combat damage it would deal and be dealt.","oracle_id":"38a12bd7-4394-44a8-91a0-6a4ff7fa4f71","published_at":"2022-12-08","source":"wotc"},{"comment":"Maze of Ith doesn't have a mana ability. It doesn't tap for colorless mana.","oracle_id":"38a12bd7-4394-44a8-91a0-6a4ff7fa4f71","published_at":"2022-12-08","source":"wotc"},{"comment":"The creature isn't removed from combat; it just has its damage prevented. It's still an attacking creature until the combat phase is complete.","oracle_id":"38a12bd7-4394-44a8-91a0-6a4ff7fa4f71","published_at":"2022-12-08","source":"wotc"},{"comment":"You can activate Maze of Ith's ability targeting an attacking creature you control during the combat damage step or the end of combat step, even though it will already have dealt combat damage. This will untap the creature. The damage it dealt will be unaffected.","oracle_id":"38a12bd7-4394-44a8-91a0-6a4ff7fa4f71","published_at":"2022-12-08","source":"wotc"},{"comment":"If you play Mana Short in response to a spell, it will have no effect on that spell since the mana has already been paid.","oracle_id":"48207d1c-448a-4e1b-974a-642dfea75933","published_at":"2004-10-04","source":"wotc"},{"comment":"It even taps lands that do not produce mana.","oracle_id":"48207d1c-448a-4e1b-974a-642dfea75933","published_at":"2004-10-04","source":"wotc"},{"comment":"Since this is an instant, your opponent may use instants in response to the casting of this spell. Note that such spells and abilities will be resolved before mana is removed by Mana Short. This makes it useless as a countermeasure for spells. To use it effectively, you need to use it during Upkeep and even then it will not prevent the use of instant spells and abilities.","oracle_id":"48207d1c-448a-4e1b-974a-642dfea75933","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
