4-27","toughness":"1","type_line":"Creature — Rat"},{"cmc":3.0,"color_identity":["G"],"colors":["G"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{G}{G}","name":"Spike Feeder","oracle_id":"5b147eab-39dd-4c2a-8f59-d778037788aa","oracle_text":"This creature enters with two +1/+1 counters on it.\n{2}, Remove a +1/+1 counter from this creature: Put a +1/+1 counter on target creature.\nRemove a +1/+1 counter from this creature: You gain 2 life.","power":"0","produced_mana":[],"released_at":"2015-05-06","toughness":"0","type_line":"Creature — Spike"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Battles will enter with double the normal number of defense counters.","oracle_id":"01546b7d-a233-4176-8843-d732074dc5b6","published_at":"2024-11-08","source":"wotc"},{"comment":"Doubling Season affects permanents that enter with counters.","oracle_id":"01546b7d-a233-4176-8843-d732074dc5b6","published_at":"2024-11-08","source":"wotc"},{"comment":"Everything that is specified by the effect creating the original token or tokens will also be true about the additional token or tokens created by Doubling Season's replacement effect. For example, if an effect tells you to create a token \"tapped and attacking,\" the additional tokens will also be tapped and attacking.","oracle_id":"01546b7d-a233-4176-8843-d732074dc5b6","published_at":"2024-11-08","source":"wotc"},{"comment":"If there are two Doubling Seasons on the battlefield, then the number of tokens or counters is four times the original number. If there are three on the battlefield, then the number of tokens or counters is eight times the original number, and so on.","oracle_id":"01546b7d-a233-4176-8843-d732074dc5b6","published_at":"2024-11-08","source":"wotc"},{"comment":"Planeswalkers will enter with double the normal number of loyalty counters. However, if you activate an ability whose cost has you put loyalty counters on a planeswalker, the number you put on isn't doubled. This is because those counters are put on as a cost, not as an effect.","oracle_id":"01546b7d-a233-4176-8843-d732074dc5b6","published_at":"2024-11-08","source":"wotc"},{"comment":"Each additional Hardened Scales you control will increase the number of +1/+1 counters placed on a creature you control by one.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects.","oracle_id":"a1f3da21-af6d-450e-bf0b-985d158418e6","published_at":"2023-09-01","source":"wotc"},{"comment":"Rat Colony's last ability lets you ignore only the \"four-of\" rule. It doesn't let you ignore format legality. For example, during a Bloomburrow Limited event, you can't add Rat Colonies from your personal collection.","oracle_id":"ec77d23b-0165-450d-9aae-73b755163753","published_at":"2024-07-26","source":"wotc"},{"comment":"Because the “search” requires you to find a card with certain characteristics, you don’t have to find the card if you don’t want to.","oracle_id":"f21ec455-aaf6-4842-aea2-69a7fd99b80f","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
