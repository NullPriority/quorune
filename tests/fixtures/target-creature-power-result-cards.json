enny":"not_legal","pioneer":"not_legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{B}","name":"Tragic Slip","oracle_id":"fa6e2a47-a8cb-4224-ae3e-f61c90477285","oracle_text":"Target creature gets -1/-1 until end of turn.\nMorbid \u2014 That creature gets -13/-13 until end of turn instead if a creature died this turn.","power":null,"produced_mana":[],"released_at":"2025-01-24","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Defender"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Wall of Omens","oracle_id":"5f601f48-d24b-4883-9fde-b3f620e7c9ea","oracle_text":"Defender\nWhen this creature enters, draw a card.","power":"0","produced_mana":[],"released_at":"2025-04-11","toughness":"4","type_line":"Creature \u2014 Wall"},{"cmc":4.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":["Flying","Defender"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}{W}","name":"Wall of Reverence","oracle_id":"0810983f-818a-43e6-a7b5-ebe0bc8b9f6a","oracle_text":"Defender, flying\nAt the beginning of your end step, you may gain life equal to the power of target creature you control.","power":"1","produced_mana":[],"released_at":"2025-04-11","toughness":"6","type_line":"Creature \u2014 Spirit Wall"}],"rulings":[{"comment":"If an effect changes a creature\u2019s power \u201cuntil end of turn,\u201d it will still have the modified power during your end step.","oracle_id":"0810983f-818a-43e6-a7b5-ebe0bc8b9f6a","published_at":"2018-12-07","source":"wotc"},{"comment":"Soul's Majesty's only target is the creature. If that creature becomes an illegal target by the time Soul's Majesty would resolve, the entire spell doesn't resolve. You won't draw any cards.","oracle_id":"50fd4cf3-c347-4eb9-ab15-a9b0c5ea8b0f","published_at":"2009-02-01","source":"wotc"},{"comment":"A card's mana value is determined solely by the mana symbols printed in its upper right corner. The mana value is the total amount of mana in that cost, regardless of color. For example, a card with mana cost {1}{U}{U} has mana value 3. Ignore any alternative costs, additional costs, cost increases, or cost reductions that could apply to it. A card with no mana cost has a mana value of 0.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"Any triggered abilities that trigger while performing the Expertise spell's first effect won't be put onto the stack until after you're done casting your free spell. They're put onto the stack at the same time as any abilities that triggered while casting that spell regardless of the order in which those abilities triggered.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"Effects that allow you to \"cast\" a card don't allow you to play a land card.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"If the card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"If you cast a card \"without paying its mana cost,\" you can't choose to cast it for any alternative costs, such as emerge costs. You can, however, pay additional costs. If the card has any mandatory additional costs, such as that of Cathartic Reunion, you must pay those to cast the card.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"If you control no creatures with power greater than 0 as Rishkar's Expertise resolves, you draw no cards, but you may cast a card with mana value 5 or less from your hand without paying its mana cost.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"The greatest power among creatures you control is determined as Rishkar's Expertise resolves.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"While you're casting your free spell, the Expertise spell is still on the stack. It will be put into its owner's graveyard after the free spell is cast. The free spell can't target the Expertise card in your graveyard. It can target the Expertise spell on the stack, but the Expertise spell will become an illegal target before the free spell resolves.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"You may cast one of the cards drawn by Rishkar's Expertise's first effect while performing its second effect.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-02-09","source":"wotc"},{"comment":"The mana value of a split card is determined by the combined mana cost of its two halves. If an expertise spell allows you to cast a split card, you may cast either half or, if that split card has fuse, both halves.","oracle_id":"97407cd0-2bd2-4074-94d3-4ec3d243fa78","published_at":"2017-04-18","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
