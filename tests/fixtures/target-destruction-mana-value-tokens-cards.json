_line":"Enchantment Creature — Sheep"},{"cmc":0.0,"color_identity":["W"],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Plains","oracle_id":"bc71ebf6-2056-41f7-be35-b2e5c34afa99","oracle_text":"({T}: Add {W}.)","power":null,"produced_mana":["W"],"released_at":"2026-11-13","toughness":null,"type_line":"Basic Land — Plains"},{"cmc":2.0,"color_identity":["W"],"colors":["W"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{1}{W}","name":"Rest in Peace","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","oracle_text":"When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.","power":null,"produced_mana":[],"released_at":"2024-04-19","toughness":null,"type_line":"Enchantment"},{"cmc":3.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"not_legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}","name":"Sculpting Steel","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","oracle_text":"You may have this artifact enter as a copy of any artifact on the battlefield.","power":null,"produced_mana":[],"released_at":"2023-04-21","toughness":null,"type_line":"Artifact"},{"cmc":1.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"banned","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"banned","modern":"not_legal","oathbreaker":"banned","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"banned","vintage":"restricted"},"loyalty":null,"mana_cost":"{1}","name":"Sol Ring","oracle_id":"6ad8011d-3471-4369-9d68-b264cc027487","oracle_text":"{T}: Add {C}{C}.","power":null,"produced_mana":["C"],"released_at":"2026-06-26","toughness":null,"type_line":"Artifact"},{"cmc":0.0,"color_identity":["G"],"colors":[],"defense":null,"keywords":["Regenerate"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"not_legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Yavimaya Hollow","oracle_id":"53d6113d-acdb-4754-9641-f7991a96c7b9","oracle_text":"{T}: Add {C}.\n{G}, {T}: Regenerate target creature.","power":null,"produced_mana":["C"],"released_at":"2014-06-16","toughness":null,"type_line":"Legendary Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If Rest in Peace is destroyed by a spell, Rest in Peace will be exiled and then the spell will be put into its owner's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"If a card is discarded while Rest in Peace is on the battlefield, abilities that function when a card is discarded (such as madness) still work, even though that card never reaches a graveyard. In addition, spells or abilities that check the characteristics of a discarded card (such as Chandra Ablaze's first ability) can find that card in exile.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"While Rest in Peace is on the battlefield, abilities that trigger whenever a creature dies won't trigger because cards and tokens are never put into a player's graveyard.","oracle_id":"087f9ad7-e74f-40e2-8102-1ed2925d0418","published_at":"2018-03-16","source":"wotc"},{"comment":"This spell doesn't resolve and you get no Saprolings if the enchantment is an illegal target on resolution.","oracle_id":"19bb51dd-2b93-45f0-927d-bbafddadd0a3","published_at":"2004-10-04","source":"wotc"},{"comment":"Any \"enters\" abilities of the copied artifact will trigger when Sculpting Steel enters. Any \"as enters\" or \"enters with\" abilities of the chosen artifact will also work. For example, if Sculpting Steel copies an artifact creature with sunburst, the copy will get +1/+1 counters based on the number of different colors of mana used to pay Sculpting Steel's total cost. If Sculpting Steel copies a noncreature artifact with sunburst, the copy will get charge counters based on the number of different colors of mana used to pay Sculpting Steel's total cost.","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","published_at":"2004-12-01","source":"wotc"},{"comment":"If the chosen artifact is a token, your Sculpting Steel copies the original characteristics of that token as stated by the effect that put it onto the battlefield. Your Sculpting Steel is not considered to be a token.","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","published_at":"2007-07-15","source":"wotc"},{"comment":"If the chosen artifact is copying something else (for example, if the chosen artifact is another Sculpting Steel), then your Sculpting Steel enters as whatever the chosen artifact copied.","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","published_at":"2007-07-15","source":"wotc"},{"comment":"Sculpting Steel doesn't copy whether the original artifact is tapped or untapped. It also doesn't copy any counters on that artifact, any Auras or Equipment attached to that artifact, or any effects that are currently affecting that artifact — you get exactly what's printed on the chosen card and nothing more. So if you copy an animated Chimeric Staff, for example, you get a normal, nonanimated Chimeric Staff.","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","published_at":"2007-07-15","source":"wotc"},{"comment":"You can choose not to copy anything. In that case, Sculpting Steel stays on the battlefield as an artifact that doesn't do much of anything.","oracle_id":"6c85271c-c711-49b0-a72e-9e576c33714d","published_at":"2007-07-15","source":"wotc"},{"comment":"This spell is countered and you get no Saprolings if the artifact is an illegal target on resolution.","oracle_id":"e77e8768-3ea8-44f9-aba6-1e023e006946","published_at":"2004-10-04","source":"wotc"},{"comment":"A player's \"opening hand\" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"If your opponent discards a card while you control Leyline of the Void, abilities that check whether a card is discarded (such as Hollow One, or a madness ability of the discarded card) still work, even though that card never reaches that player's graveyard. In addition, spells or abilities that check the characteristics of the discarded card can find that card in exile.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"Tokens can still die while Leyline of the Void is on the battlefield.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"},{"comment":"While Leyline of the Void is on the battlefield, nontoken creatures your opponents control won't die. They'll be exiled instead. Abilities that would trigger when those creatures die won't trigger.","oracle_id":"f4e32fc1-1b8d-441e-8e76-71f19f98e925","published_at":"2024-09-20","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
