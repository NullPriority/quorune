olor_identity":["B"],"colors":["B"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}{B}","name":"Salt Road Skirmish","oracle_id":"f6e72f4e-d6e0-4537-93c1-7045385c8401","oracle_text":"Destroy target creature. Create two 1/1 red Warrior creature tokens. They gain haste until end of turn. Sacrifice them at the beginning of the next end step.","power":null,"produced_mana":[],"released_at":"2025-04-11","toughness":null,"type_line":"Sorcery"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":4.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"legal","pioneer":"not_legal","predh":"legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{4}","name":"Vedalken Orrery","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","oracle_text":"You may cast spells as though they had flash.","power":null,"produced_mana":[],"released_at":"2022-07-08","toughness":null,"type_line":"Artifact"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2004-12-01","source":"wotc"},{"comment":"This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".","oracle_id":"60d640a4-032b-4279-ac75-8f200ca776fb","published_at":"2010-06-15","source":"wotc"},{"comment":"All of the tokens enter the battlefield simultaneously. They’ll be created with the same name, color, type and subtype, abilities, power, toughness, and so on.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2017-04-18","source":"wotc"},{"comment":"If an effect creates more than one kind of token, it’ll create twice as many of each kind. For example, if you cast Bestial Menace while controlling Anointed Procession, you’ll create two Snake tokens, two Wolf tokens, and two Elephant tokens.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2017-04-18","source":"wotc"},{"comment":"If the effect creating the tokens instructs you to do something with those tokens at a later time, like exiling them at the end of combat, you’ll do that for all the tokens.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2017-04-18","source":"wotc"},{"comment":"If the token you create has any “as [this permanent] enters the battlefield” or “[this permanent] enters the battlefield with” abilities, first determine how many tokens are being created, then apply those abilities individually for each one. For example, if a token with “You may have [this permanent] enter the battlefield as a copy of any creature on the battlefield” would be created (such as an embalmed Vizier of Many Faces), the resulting two tokens can each copy a different creature.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2017-04-18","source":"wotc"},{"comment":"If you control two Anointed Processions, then the number of tokens created is four times the original number. If you control three, then the number of tokens created is eight times the original number, and so on.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2017-04-18","source":"wotc"},{"comment":"There are many important moments in the story, but the most crucial—called “story spotlights”—are shown on cards. These cards have the Planeswalker symbol in their text box; this symbol has no effect on gameplay. You can read more about these events in the official Magic fiction at http://www.mtgstory.com.","oracle_id":"7246d45b-2185-4cdd-981b-5419b7d52bce","published_at":"2018-01-19","source":"wotc"},{"comment":"If the target creature is an illegal target at the time Salt Road Skirmish tries to resolve, it won’t resolve and none of its effects will happen. However, if the target is still legal and the target isn’t destroyed (most likely because it has indestructible), you will still create two Warrior tokens.","oracle_id":"f6e72f4e-d6e0-4537-93c1-7045385c8401","published_at":"2025-04-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
