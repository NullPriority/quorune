  "fixture_kind": "focused_targeted_graveyard_return_cards",
  "rulings": [
    {
      "comment": "If this spell is copied, the copy will have the same mode as the original.",
      "oracle_id": "20cc0f3e-de69-4e5f-88b3-ae7e6c6b5996",
      "published_at": "2008-10-01",
      "source": "wotc"
    },
    {
      "comment": "While the spell is on the stack, treat it as though its only text is the chosen mode. The other two modes are treated as though they don't exist. You don't choose targets for those modes.",
      "oracle_id": "20cc0f3e-de69-4e5f-88b3-ae7e6c6b5996",
      "published_at": "2008-10-01",
      "source": "wotc"
    },
    {
      "comment": "You can choose a mode only if you can choose legal targets for that mode. If you can't choose legal targets for any of the modes, you can't cast the spell.",
      "oracle_id": "20cc0f3e-de69-4e5f-88b3-ae7e6c6b5996",
      "published_at": "2008-10-01",
      "source": "wotc"
    },
    {
      "comment": "If the target card is no longer in the graveyard when Cremate tries to resolve, it won't resolve and none of its effects will happen. You won't draw a card.",
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "You must be able to target a card in a graveyard to cast Cremate.",
      "oracle_id": "c6a2e410-b182-48d1-aeb2-bc8de27e9cd2",
      "published_at": "2012-10-01",
      "source": "wotc"
    },
    {
      "comment": "If the target card is an illegal target by the time Pulse of Murasa tries to resolve, the spell doesn’t resolve. You won’t gain 6 life.",
      "oracle_id": "d5b446a4-a761-42f0-acf0-ea0a1a9538d6",
      "published_at": "2019-07-12",
      "source": "wotc"
    },
    {
      "oracle_id": "0477b923-9f32-4e7f-ac08-c715cca819a4",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "The ability is not countered if both cards are missing from the graveyard on resolution and the creature target is there. This makes it possible to have two Spurnmage Advocates both target the same two cards and end up destroying two creatures."
    },
    {
      "oracle_id": "0477b923-9f32-4e7f-ac08-c715cca819a4",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You can\u2019t activate this ability unless a single opponent has at least two cards in their graveyard to target."
    },
    {
      "oracle_id": "06e4355b-02d4-4238-a6e6-b03a5773346c",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You can\u2019t activate this ability unless a single opponent has at least three cards in their graveyard to target and you have a creature card in your graveyard to target."
    },
    {
      "oracle_id": "558568a6-5e22-482f-9096-e76682965c21",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You can\u2019t activate this ability unless a single opponent has at least two cards in their graveyard to target."
    }
  ],
