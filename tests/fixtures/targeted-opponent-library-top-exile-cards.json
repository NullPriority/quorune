l","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Plains","oracle_id":"bc71ebf6-2056-41f7-be35-b2e5c34afa99","oracle_text":"({T}: Add {W}.)","power":null,"produced_mana":["W"],"released_at":"2026-11-13","toughness":null,"type_line":"Basic Land — Plains"},{"cmc":4.0,"color_identity":["U"],"colors":[],"defense":null,"keywords":["Flying","Devoid"],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"not_legal","paupercommander":"not_legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"not_legal","vintage":"legal"},"loyalty":null,"mana_cost":"{3}{U}","name":"Thought Harvester","oracle_id":"13f9a845-d0e9-4790-99e0-b857204ad1da","oracle_text":"Devoid (This card has no color.)\nFlying\nWhenever you cast a colorless spell, target opponent exiles the top card of their library.","power":"2","produced_mana":[],"released_at":"2016-01-22","toughness":"4","type_line":"Creature — Eldrazi Drone"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"If a creature with an {Q} ability hasn’t been under your control since your most recent turn began, you can’t activate that ability, unless the creature has haste.","oracle_id":"06af8e20-6f60-400d-9120-c99311232dde","published_at":"2008-05-01","source":"wotc"},{"comment":"If the permanent is already untapped, you can’t activate its {Q} ability. That’s because you can’t pay the “Untap this permanent” cost.","oracle_id":"06af8e20-6f60-400d-9120-c99311232dde","published_at":"2008-05-01","source":"wotc"},{"comment":"If you don’t play the exiled card that turn, it remains exiled but you can’t play it.","oracle_id":"06af8e20-6f60-400d-9120-c99311232dde","published_at":"2008-05-01","source":"wotc"},{"comment":"The exiled card is played using the normal timing rules for its card type, as well as any other applicable restrictions such as “Cast [this card] only during combat.” For example, you can’t play the card during an opponent’s turn unless it’s an instant or has flash. Similarly, if the exiled card is a land, you can’t play it if you’ve already played a land that turn. If it’s a nonland card, you’ll have to pay its mana cost. The only thing that’s different is you’re playing it from the Exile zone.","oracle_id":"06af8e20-6f60-400d-9120-c99311232dde","published_at":"2008-05-01","source":"wotc"},{"comment":"When you activate an {Q} ability, you untap the creature with that ability as a cost. The untap can’t be responded to. (The actual ability can be responded to, of course.)","oracle_id":"06af8e20-6f60-400d-9120-c99311232dde","published_at":"2008-05-01","source":"wotc"},{"comment":"The Battle for Zendikar colorless creature cards Blight Herder and Ruin Processor each have an ability that triggers when you cast it that allows you to put a card owned by an opponent from exile into that player’s graveyard. Both that ability and Thought Harvester’s ability trigger at the same time, so you can put them on the stack in any order. If Thought Harvester’s ability resolves first (meaning it went on the stack last), the card exiled by that ability can be “processed” by the other ability.","oracle_id":"13f9a845-d0e9-4790-99e0-b857204ad1da","published_at":"2016-01-22","source":"wotc"},{"comment":"The card is exiled face up.","oracle_id":"13f9a845-d0e9-4790-99e0-b857204ad1da","published_at":"2016-01-22","source":"wotc"},{"comment":"The triggered ability will resolve before the colorless spell that caused it to trigger.","oracle_id":"13f9a845-d0e9-4790-99e0-b857204ad1da","published_at":"2016-01-22","source":"wotc"},{"comment":"Cards exiled by Ornate Kanzashi’s ability are exiled face up.","oracle_id":"3c41c666-5cf4-4f35-9cb8-c41f1f78f31e","published_at":"2005-02-01","source":"wotc"},{"comment":"Cards exiled by Ornate Kanzashi’s ability stay exiled even if the Kanzashi leaves the battlefield.","oracle_id":"3c41c666-5cf4-4f35-9cb8-c41f1f78f31e","published_at":"2005-02-01","source":"wotc"},{"comment":"Normal restrictions apply to cards exiled by Ornate Kanzashi (you can’t cast an instant unless you have priority, etc.).","oracle_id":"3c41c666-5cf4-4f35-9cb8-c41f1f78f31e","published_at":"2005-02-01","source":"wotc"},{"comment":"You can’t play cards you exiled with Ornate Kanzashi on previous turns.","oracle_id":"3c41c666-5cf4-4f35-9cb8-c41f1f78f31e","published_at":"2005-02-01","source":"wotc"},{"comment":"You must pay all costs to play cards exiled by Ornate Kanzashi.","oracle_id":"3c41c666-5cf4-4f35-9cb8-c41f1f78f31e","published_at":"2005-02-01","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
