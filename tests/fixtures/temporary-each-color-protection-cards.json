  "rulings": [
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Overload doesn't change when you can cast the spell."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If you don't pay the overload cost of a spell, that spell will have a single target. If you pay the overload cost, the spell won't have any targets."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Kindred is a card type that allows noncreature cards to have creature types. For example, Echoes of Eternity is an Eldrazi (although not a creature) while on the battlefield and an Eldrazi card (although not a creature card) in zones other than the battlefield."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "While it appears only on cards that already have other card types, kindred is a card type and will be counted by effects that refer to the number of card types among cards in a zone."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If you are instructed to cast a spell with overload \"without paying its mana cost,\" you can't choose to pay its overload cost instead."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Effects that cause you to pay more or less for a spell will cause you to pay that much more or less while casting it for its overload cost, too."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "Because a spell with overload doesn't target when its overload cost is paid, it may affect permanents with hexproof or with protection from the appropriate color."
    },
    {
      "oracle_id": "7dce1e8c-5cfd-4626-9f23-7bb3f1b10c1e",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as an overload cost), add any cost increases, then apply any cost reductions. The mana value of the spell is determined by only its mana cost, no matter what the total cost to cast that spell was."
    },
    {
      "comment": "Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.",
      "oracle_id": "05d24b0c-904a-46b6-b42a-96a4d91a0dd4",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.",
      "oracle_id": "05d24b0c-904a-46b6-b42a-96a4d91a0dd4",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "comment": "Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.",
      "oracle_id": "05d24b0c-904a-46b6-b42a-96a4d91a0dd4",
      "published_at": "2021-03-19",
      "source": "wotc"
    },
    {
      "oracle_id": "7346337e-ac12-4dd2-826d-77ec0013e74f",
      "published_at": "2021-02-01",
      "source": "scryfall",
      "comment": "Spatial Contortion is banned in Pauper (not just non-legal), due to a special case on MTGO: https://magic.wizards.com/en/articles/archive/news/january-21-2019-banned-and-restricted-announcement"
    }
  ],
