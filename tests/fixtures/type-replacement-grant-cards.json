ty":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"not_legal","brawl":"not_legal","commander":"legal","competitivebrawl":"not_legal","duel":"legal","future":"not_legal","gladiator":"not_legal","historic":"not_legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"not_legal","predh":"legal","premodern":"legal","standard":"not_legal","standardbrawl":"not_legal","timeless":"not_legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Twiddle","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","oracle_text":"You may tap or untap target artifact, creature, or land.","power":null,"produced_mana":[],"released_at":"2003-07-28","toughness":null,"type_line":"Instant"},{"cmc":1.0,"color_identity":["U"],"colors":["U"],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"legal","pioneer":"legal","predh":"legal","premodern":"legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"{U}","name":"Unsummon","oracle_id":"837182db-1bf3-4a2c-bd01-1af9d9873561","oracle_text":"Return target creature to its owner's hand.","power":null,"produced_mana":[],"released_at":"2026-04-24","toughness":null,"type_line":"Instant"},{"cmc":0.0,"color_identity":[],"colors":[],"defense":null,"keywords":[],"layout":"normal","legalities":{"alchemy":"legal","brawl":"legal","commander":"legal","competitivebrawl":"legal","duel":"legal","future":"legal","gladiator":"legal","historic":"legal","legacy":"legal","modern":"legal","oathbreaker":"legal","oldschool":"not_legal","pauper":"legal","paupercommander":"legal","penny":"not_legal","pioneer":"legal","predh":"not_legal","premodern":"not_legal","standard":"legal","standardbrawl":"legal","timeless":"legal","tlr":"legal","vintage":"legal"},"loyalty":null,"mana_cost":"","name":"Wastes","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","oracle_text":"{T}: Add {C}.","power":null,"produced_mana":["C"],"released_at":"2025-08-01","toughness":null,"type_line":"Basic Land"}],"fixture_kind":"public_exact-list_card_data","rulings":[{"comment":"Because Wastes is a basic land, you can include as many of them as you like in your Constructed decks.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"In Limited events (including Sealed Deck and Booster Draft), Wastes must be in your card pool to be included in your deck. You can't add Wastes to your card pool in the same way that you can add other basic lands.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"Wastes is not a land type. If something asks you to name a land type, you can't choose Wastes.","oracle_id":"05d24b0c-904a-46b6-b42a-96a4d91a0dd4","published_at":"2021-03-19","source":"wotc"},{"comment":"A creature enchanted with Minimus Containment stops being a creature. Equipment attached to that creature become unattached. Auras attached to that creature will be put into their owner's graveyard (unless they could also enchant a Treasure artifact).","oracle_id":"0a5e6223-ca31-4605-9c33-9ce492aaf556","published_at":"2021-07-23","source":"wotc"},{"comment":"If an effect refers to a Treasure, it means any Treasure artifact, not just a Treasure artifact token.","oracle_id":"0a5e6223-ca31-4605-9c33-9ce492aaf556","published_at":"2021-07-23","source":"wotc"},{"comment":"The enchanted permanent still retains its name, colors, mana cost, and mana value. It isn't a token unless it already was one.","oracle_id":"0a5e6223-ca31-4605-9c33-9ce492aaf556","published_at":"2021-07-23","source":"wotc"},{"comment":"If One with the Stars enchants an enchantment that has no other card types, the enchanted permanent won\u2019t be affected.","oracle_id":"0ab43fc3-53ec-4686-873d-8dbeee2634f4","published_at":"2020-01-24","source":"wotc"},{"comment":"One with the Stars may enchant a permanent that is only temporarily a creature, such as a Vehicle. If this happens, One with the Stars\u2019s effect causes the enchanted permanent to remain an enchantment even after the temporary effect expires.","oracle_id":"0ab43fc3-53ec-4686-873d-8dbeee2634f4","published_at":"2020-01-24","source":"wotc"},{"comment":"The enchanted permanent keeps its abilities but has no power or toughness. If one of its abilities refers to them, it uses 0.","oracle_id":"0ab43fc3-53ec-4686-873d-8dbeee2634f4","published_at":"2020-01-24","source":"wotc"},{"comment":"The enchanted permanent loses any subtypes associated with the card types it lost. It keeps any supertypes, such as legendary.","oracle_id":"0ab43fc3-53ec-4686-873d-8dbeee2634f4","published_at":"2020-01-24","source":"wotc"},{"comment":"A creature enchanted with Sugar Coat stops being a creature. Equipment attached to that creature become unattached. Auras attached to that creature will be put into their owner's graveyard (unless they could also enchant a Food artifact).","oracle_id":"1caa8c8a-ff45-4eee-a834-6e5e1fb54721","published_at":"2024-07-26","source":"wotc"},{"comment":"The enchanted permanent still retains its name, mana cost, and mana value. It isn't a token unless it already was one.","oracle_id":"1caa8c8a-ff45-4eee-a834-6e5e1fb54721","published_at":"2024-07-26","source":"wotc"},{"comment":"Food is an artifact type. Even though it appears on some creatures, it's never a creature type.","oracle_id":"1caa8c8a-ff45-4eee-a834-6e5e1fb54721","published_at":"2024-11-08","source":"wotc"},{"comment":"Whatever you do, don't eat the delicious cards.","oracle_id":"1caa8c8a-ff45-4eee-a834-6e5e1fb54721","published_at":"2024-11-08","source":"wotc"},{"comment":"You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability.","oracle_id":"1caa8c8a-ff45-4eee-a834-6e5e1fb54721","published_at":"2024-11-08","source":"wotc"},{"comment":"After a spell with split second resolves (or otherwise leaves the stack), players may again cast spells and activate abilities before the next object on the stack resolves.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"Casting a spell with split second won't affect spells and abilities that are already on the stack.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"If the resolution of a triggered ability involves casting a spell, that spell can't be cast if a spell with split second is on the stack.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"Players may turn face-down creatures face up while a spell with split second is on the stack.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"Players still get priority while a card with split second is on the stack; their options are just limited to mana abilities and certain special actions.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"Split second doesn't allow players to cast the spell it's on at times when they otherwise wouldn't be able to cast it. An enchantment with split second may still be cast only during its controller's main phase when the stack is empty.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"Split second doesn't stop triggered abilities from triggering, such as that of Chalice of the Void. If one does, its controller puts it on the stack and chooses targets for it, if any. Those abilities will resolve as normal.","oracle_id":"2829ae08-9964-4679-80e8-46d5d33d10b9","published_at":"2022-04-29","source":"wotc"},{"comment":"At the time the permanent becomes enchanted, Imprisoned in the Moon causes it to lose all abilities except the noted mana ability. Any abilities the permanent gains after that point will work normally.","oracle_id":"339a7418-9a29-4eae-a3c2-ea590d175936","published_at":"2016-07-13","source":"wotc"},{"comment":"Becoming a land may cause other Auras to become illegally attached. These are put into their owner's graveyard, and any Equipment attached to the land become unattached and remain on the battlefield. Counters on the land remain on it even if they don't do anything.","oracle_id":"339a7418-9a29-4eae-a3c2-ea590d175936","published_at":"2016-07-13","source":"wotc"},{"comment":"If the enchanted permanent is a land and has land types, it retains those types even though it loses any intrinsic mana abilities associated with them. For example, a Plains enchanted by Imprisoned in the Moon is still a Plains, but it can't tap for {W}, only for {C}.","oracle_id":"339a7418-9a29-4eae-a3c2-ea590d175936","published_at":"2016-07-13","source":"wotc"},{"comment":"If you remove Imprisoned in the Moon from a planeswalker after tapping it for mana, you can still activate a loyalty ability of that planeswalker even though it's tapped.","oracle_id":"339a7418-9a29-4eae-a3c2-ea590d175936","published_at":"2016-07-13","source":"wotc"},{"comment":"The permanent will keep any supertypes it previously had. Notably, if Imprisoned in the Moon is enchanting a legendary permanent, that permanent will continue to be legendary.","oracle_id":"339a7418-9a29-4eae-a3c2-ea590d175936","published_at":"2016-07-13","source":"wotc"},{"comment":"The decision whether or not to tap or untap is made on resolution. This is not a modal spell.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not a toggle effect. If you use Twiddle to tap a card and before it takes effect your opponent taps it, Twiddle will not automatically untap the card.","oracle_id":"773ad2ef-5acc-49ea-8d85-056330e87039","published_at":"2004-10-04","source":"wotc"},{"comment":"This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.","oracle_id":"a7e97fa9-4b72-4548-b854-5be5f18a6f1a","published_at":"2004-10-04","source":"wotc"}],"schema_version":1,"source":"Scryfall Oracle/rulings subset for offline tests"}
