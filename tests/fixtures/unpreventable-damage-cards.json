  "rulings": [
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "If a cost includes life gain (like Invigorate's alternative cost does), that cost can't be paid."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Effects that would replace gaining life with some other effect won't be able to do anything because it's impossible for players to gain life."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Spells and abilities that replace or redirect damage aren't affected by Everlasting Torment's second ability. They'll work as normal."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "The last ability affects all damage, whether it's dealt by creatures, other permanents, spells, or cards that aren't on the battlefield. Wither works everywhere."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "If an effect says to set your life total to a certain number, and that number is higher than your current life total, that effect will normally cause you to gain life equal to the difference. With Everlasting Torment on the battlefield, that part of the effect won't do anything. (If the number is lower than your current life total, the effect will work as normal.)"
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Effects that replace an event with gaining life (like Words of Worship's effect does) will end up replacing the event with nothing."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "The \"damage can't be prevented\" statement overrides all forms of preventing damage, including protection abilities. Damage prevention spells and abilities can still be cast and played; they just don't do anything."
    },
    {
      "oracle_id": "de41081e-713c-4005-90f7-65d9426208f1",
      "published_at": "2008-05-01",
      "source": "wotc",
      "comment": "Spells and abilities that would normally cause a player to gain life still resolve, but the life-gain part simply has no effect."
    },
    {
      "oracle_id": "9911c2f8-fafb-4979-898e-e86b726e3538",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "Replacement effects that don’t use the word “prevent” can replace Excruciator’s damage with something else. See Phytohydra and Szadek, Lord of Secrets, for example."
    },
    {
      "oracle_id": "9911c2f8-fafb-4979-898e-e86b726e3538",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "An effect may redirect Excruciator’s damage."
    },
    {
      "oracle_id": "9911c2f8-fafb-4979-898e-e86b726e3538",
      "published_at": "2005-10-01",
      "source": "wotc",
      "comment": "Excruciator can deal damage to creatures with protection from red. (It can’t block creatures with protection from red, though.)"
