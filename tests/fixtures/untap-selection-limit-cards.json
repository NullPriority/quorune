  "rulings": [
    {
      "oracle_id": "0004ebd0-dfd6-4276-b4a6-de0003e94237",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "If there are two of these on the battlefield, they do not add together. The result is that only two permanents can be untapped."
    },
    {
      "oracle_id": "1dcbd583-3388-4b34-a7cd-131648aa6abd",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "All permanents untap during a player\u2019s untap step at once. If Winter Orb is tapped as your untap step begins, your lands will all untap."
    },
    {
      "oracle_id": "1dcbd583-3388-4b34-a7cd-131648aa6abd",
      "published_at": "2016-06-08",
      "source": "wotc",
      "comment": "You can\u2019t tap Winter Orb just because you want to. Another ability, such as that of Glare of Subdual, must instruct or allow you to do so."
    },
    {
      "oracle_id": "6b2184ce-d6b1-411e-80ac-05a6e5993a39",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Artifact creatures are artifacts. They are affected so only one may untap."
    },
    {
      "oracle_id": "6b2184ce-d6b1-411e-80ac-05a6e5993a39",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Damping Field does not prevent artifacts being untapped by spells or abilities at other times."
    },
    {
      "oracle_id": "8aa97d25-cd51-4ceb-b7eb-af64f0914a8c",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "Animated lands are affected by this spell. If on the battlefield with an effect that limits the number of land you untap, untapping an animated land will count as the one creature and the one land you can untap... thereby limiting you to one thing to be untapped."
    },
    {
      "oracle_id": "b50c865b-705f-489e-9ffc-ba8060ba262f",
      "published_at": "2017-03-14",
      "source": "wotc",
      "comment": "Noncreature permanents will untap as normal during their controllers\u2019 untap steps."
    },
    {
      "oracle_id": "b50c865b-705f-489e-9ffc-ba8060ba262f",
      "published_at": "2017-03-14",
      "source": "wotc",
      "comment": "If multiple Stoic Angels are on the battlefield, their effects are redundant. Each player will still be able to untap no more than one creature during their untap step."
    },
    {
      "oracle_id": "b922f057-1c91-43eb-b74a-8a933b1be2d2",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If Winter Moon is on the battlefield while another effect restricts untapping lands or permanents in a different way, their effects are cumulative. For example, if you control both Winter Moon and Static Orb, each player will be able to untap no more than two permanents, up to one of which can be a nonbasic land, during their untap step."
    },
    {
      "oracle_id": "b922f057-1c91-43eb-b74a-8a933b1be2d2",
      "published_at": "2024-06-07",
      "source": "wotc",
      "comment": "If multiple Winter Moons are on the battlefield, their effects are redundant. Each player will still be able to untap no more than one nonbasic land during their untap step."
    },
    {
      "comment": "If permanents you control become untapped during your untap step, Wake Thresher\u2019s ability will trigger that many times. However, since no player gets priority during the untap step, those abilities wait to be put on the stack until your upkeep starts. At that time, all your \u201cbeginning of upkeep\u201d triggers will also trigger. You can put them and Wake Thresher\u2019s abilities on the stack in any order.",
      "oracle_id": "f2d1e991-e13a-43c7-85aa-d53dd14822e6",
      "published_at": "2008-08-01",
      "source": "wotc"
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2006-02-01",
      "source": "wotc",
      "comment": "With a Humility and two Opalescences on the battlefield, if Humility has the latest timestamp, then all creatures are 1/1 with no abilities. If the timestamp order is Opalescence, Humility, Opalescence, the second Opalescence is 1/1, and the Humility and first Opalescence are 4/4. If Humility has the earliest timestamp, then everything is 4/4."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2007-02-01",
      "source": "wotc",
      "comment": "Removes all creature abilities. This includes mana abilities. Animated lands will also lose the ability to tap for mana."
    },
    {
      "oracle_id": "ed7bdb3e-5c51-4547-9266-76a791e0b2b0",
      "published_at": "2009-10-01",
      "source": "wotc",
      "comment": "This is the current interaction between Humility and Opalescence:\u00a0The type-changing effect applies at layer 4, but the rest happens in the applicable layers. The rest of it will apply even if the permanent loses its ability before it's finished applying. So if Opalescence, Humility, and Worship are on the battlefield and Opalescence entered before Humility, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments. (Opalescence). Layer 6: Humility and Worship each lose their abilities. (Humility) Layer 7b: Humility becomes 4/4 and Worship becomes 4/4. (Opalescence). Humility becomes 1/1 and Worship becomes 1/1 (Humility). But if Humility entered before Opalescence, the following is true: Layer 4: Humility and Worship each become creatures that are still enchantments (Opalescence). Layer 6: Humility and Worship each lose their abilities (Humility). Layer 7b: Humility becomes 1/1 and Worship becomes 1/1 (Humility). Humility becomes 4/4 and Worship becomes 4/4 (Opalescence)."
    }
  ]
}
