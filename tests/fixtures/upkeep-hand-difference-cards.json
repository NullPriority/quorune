  "fixture_kind": "public_exact-list_card_data",
  "rulings": [
    {
      "comment": "If you Donate an Aura, it stays where it is, but the targeted player now controls it.",
      "oracle_id": "049d1fb2-cce7-40e7-a633-e84cf9782d89",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "You choose one opposing player as this card enters, and it only affects that one player. This choice is not changed even if this card changes controllers. It becomes useless but stays on the battlefield if the chosen player leaves the game.",
      "oracle_id": "3d873e1d-4fac-42c4-bb31-77e76099e1ef",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "The controller of Vedalken Orrery can cast nonland artifact, creature, enchantment, and sorcery cards any time they could cast an instant. This includes on other players' turns and during the upkeep step, draw step, combat phase, and end step.",
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2004-12-01",
      "source": "wotc"
    },
    {
      "comment": "This applies only to casting spells. It does not, for example, change when you may activate abilities that can only be activated \"any time you could cast a sorcery\".",
      "oracle_id": "60d640a4-032b-4279-ac75-8f200ca776fb",
      "published_at": "2010-06-15",
      "source": "wotc"
    },
    {
      "comment": "It affects all opponents.",
      "oracle_id": "72a1e724-eb32-4781-b44d-3b1ed02a5a8b",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "The number of cards is counted during resolution.",
      "oracle_id": "7a3e6e84-a8c2-472d-99fb-7cd14850b5ce",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "Effects that modify a creature's power and/or toughness, such as the effect of Bleeding Edge, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness.",
      "oracle_id": "a9be16d1-5e53-4b85-8921-c6fe9473f923",
      "published_at": "2019-05-03",
      "source": "wotc"
    },
    {
      "comment": "If the affected creature gains an ability after Kasmina's Transmutation becomes attached to it, it will keep that ability.",
      "oracle_id": "a9be16d1-5e53-4b85-8921-c6fe9473f923",
      "published_at": "2019-05-03",
      "source": "wotc"
    },
    {
      "comment": "Kasmina's Transmutation overwrites all previous effects that set the creature's base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Kasmina's Transmutation becomes attached to a creature will overwrite this effect.",
      "oracle_id": "a9be16d1-5e53-4b85-8921-c6fe9473f923",
      "published_at": "2019-05-03",
      "source": "wotc"
    },
    {
      "comment": "Effects that modify a creature’s power and/or toughness, such as the effect of Seal of Strength, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "Humble doesn’t counter abilities that have already triggered or been activated. In particular, casting this spell won’t stop a creature’s ability that says “At the beginning of your upkeep,” “When this creature enters the battlefield,” or similar from triggering.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "Humble overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after Humble resolves will overwrite this effect.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "If the affected creature gains an ability after Humble resolves, it will keep that ability.",
      "oracle_id": "d2d41f12-18d8-473b-9308-3f02d7d791f0",
      "published_at": "2016-06-08",
      "source": "wotc"
    },
    {
      "comment": "You choose one opposing player as it enters and it only affects that one player. This choice is not changed even if Black Vise changes controllers. It becomes useless but stays on the battlefield if that player leaves the game.",
      "oracle_id": "de7839fb-7040-48ab-a6d4-d1952972943d",
      "published_at": "2004-10-04",
      "source": "wotc"
    },
    {
      "comment": "If the chosen player has four or fewer cards in their hand as Black Vise's ability resolves, the ability just won't do anything that turn.",
      "oracle_id": "de7839fb-7040-48ab-a6d4-d1952972943d",
      "published_at": "2009-10-01",
      "source": "wotc"
    }
  ],
