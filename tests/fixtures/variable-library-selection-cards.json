  "rulings": [
    {
      "oracle_id": "079b1f07-6910-491b-83ba-5ec41260f32d",
      "published_at": "2004-10-04",
      "source": "wotc",
      "comment": "You choose the order on the bottom of your library."
    },
    {
      "oracle_id": "079b1f07-6910-491b-83ba-5ec41260f32d",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "Domain abilities count the number of basic land types among lands you control, not how many lands you control or how many of any type."
    },
    {
      "oracle_id": "079b1f07-6910-491b-83ba-5ec41260f32d",
      "published_at": "2021-06-18",
      "source": "wotc",
      "comment": "The basic land types are Plains, Island, Swamp, Mountain, and Forest. Land types other than basic land types (such as Desert) don't contribute to domain abilities."
    },
    {
      "oracle_id": "3bcf54f8-fcd7-4ec0-b011-92b367411cdb",
      "published_at": "2026-03-20",
      "source": "wotc",
      "comment": "The value of X is determined only once, as Stirring Honormancer's triggered ability resolves."
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Exiling a card using its plot ability is a special action. Once you announce you’re taking that action, no other player can respond by trying to remove that card from your hand."
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "You can’t cast a plotted card on the same turn it became plotted. On any future turn, you may cast that card from exile without paying its mana cost during your main phase while the stack is empty."
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If a plotted card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "Plot abilities are written “Plot [cost],” which means “Any time you have priority during your main phase while the stack is empty, you may pay [cost] and exile this card from your hand. It becomes plotted.”"
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "If you’re casting a plotted card from exile without paying its mana cost, you can’t choose to cast it for any other alternative costs. You can, however, pay additional costs, such as kicker costs. If the plotted card has any mandatory additional costs, those must still be paid to cast the spell."
    },
    {
      "oracle_id": "91740570-1a97-4513-8af9-b32c363daf15",
      "published_at": "2024-04-12",
      "source": "wotc",
      "comment": "The value of X is determined only once, as Pillage the Bog resolves."
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."
    },
    {
      "oracle_id": "9196c8dc-bca6-4c35-949e-8c14a699a41d",
      "published_at": "2021-03-19",
      "source": "wotc",
      "comment": "To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."
    },
    {
      "oracle_id": "b03397e5-56af-47c0-ab9a-746a0c99c568",
      "published_at": "2014-04-26",
      "source": "wotc",
      "comment": "The value of X is calculated as the ability resolves."
    }
  ]
}
