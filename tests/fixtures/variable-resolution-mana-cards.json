  "rulings": [
    {
      "comment": "Each Shrine has an ability that counts the number of Shrines you control. These abilities include the Shrine they're printed on.",
      "oracle_id": "132859dd-de66-45c6-8af4-ab5e202a17b0",
      "published_at": "2020-06-23",
      "source": "wotc"
    },
    {
      "comment": "Shrines count only enchantments with the subtype Shrine. Other cards with \u201cshrine\u201d in their name (such as Jungle Shrine, Luxa River Shrine, and Nantuko Shrine) don't count.",
      "oracle_id": "132859dd-de66-45c6-8af4-ab5e202a17b0",
      "published_at": "2020-06-23",
      "source": "wotc"
    },
    {
      "comment": "This is not modal. If the target changes from an artifact to an enchantment or vice versa, this still destroys it.",
      "oracle_id": "a7e97fa9-4b72-4548-b854-5be5f18a6f1a",
      "published_at": "2004-10-04",
      "source": "wotc"
    }
