{
  "name": "quorune-web",
  "private": true,
  "version": "0.8.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run test:protocol && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:protocol": "node --test --experimental-strip-types unit/protocol.test.ts unit/choices.test.ts unit/tableAutomation.test.ts unit/tablePreferences.test.ts unit/tablePresentation.test.ts",
    "generate:types": "json2ts -i ../schemas/decision-packet.schema.json -o src/generated/decision-packet.ts && json2ts -i ../schemas/command-envelope.schema.json -o src/generated/command-envelope.ts",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2"
  }
}
